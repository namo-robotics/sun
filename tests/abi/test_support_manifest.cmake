# Verify the production manifest parser rejects malformed or unsupported input.
set(fixture "${SOURCE_DIR}/tmp/abi_support_manifest")
file(MAKE_DIRECTORY "${fixture}")
file(READ "${SOURCE_DIR}/cmake/abi/compiler_support.textproto" valid)

# Run the build tool and ensure failures preserve the previous generated output.
function(check_manifest content accepted)
    file(WRITE "${fixture}/support.textproto" "${content}")
    file(WRITE "${fixture}/support.h" "previous output")
    execute_process(COMMAND "${GENERATOR}" "${fixture}/support.textproto"
        "${fixture}/support.h" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if((accepted AND NOT result EQUAL 0) OR (NOT accepted AND result EQUAL 0))
        message(FATAL_ERROR "Unexpected compiler support validation result")
    endif()
    file(READ "${fixture}/support.h" output)
    if(NOT accepted AND NOT output STREQUAL "previous output")
        message(FATAL_ERROR "Rejected manifest replaced generated support")
    endif()
endfunction()
check_manifest("${valid}" TRUE)
check_manifest("schema: {" FALSE)
check_manifest("${valid}\nunknown_field: 1" FALSE)
check_manifest("schema: 1" FALSE)
string(REPLACE "moon_interface_v1" "unavailable" unavailable "${valid}")
check_manifest("${unavailable}" FALSE)
check_manifest("${valid}\nrules { name: \"moon.interface\" version: \"1\" binding: \"moon_interface_v1\" }" FALSE)
string(REPLACE "schema: 1" "schema: 2" future "${valid}")
check_manifest("${future}" FALSE)
file(REMOVE_RECURSE "${fixture}")
