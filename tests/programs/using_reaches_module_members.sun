// A file-level `using` serves every declaration in the file, including class
// fields and function signatures inside nested module blocks. Bodies always
// saw the import; the declaration pre-pass resolves these before bodies run
// and must see it too (issue #198).
using std;

/** Forwards its generic argument through another generic function. */
public module outer {

  /** Returns its generic argument so the caller can test specialization. */
  module inner {

    /** Owns a value whose imported type is resolved through an enclosing module. */
    class Holder {
      var v: Vec<i32>;

      /** Initializes the fixture fields used by this example or regression test. */
      init(alloc: const ref HeapAllocator) AllocationResult<void> {
        this.v = try Vec<i32>(alloc, 4);
      }

      /** Returns the number of elements in the fixture's vector. */
      public method count() i64 {
        return this.v.size();
      }
    }

    /** Builds a vector containing successive integers for the module-import test. */
    function fill(alloc: const ref HeapAllocator, n: i32) AllocationResult<Vec<i32>> {
      var v = try Vec<i32>(alloc, 4);
      var i = 0;
      while (i < n) {
        try v.push(i);
        i = i + 1;
      }
      return AllocationResult.Ok(v);
    }

    /** Returns the fixture vector's element count through an imported type annotation. */
    function total(v: ref Vec<i32>) i64 {
      return v.size();
    }

    /** Exercises names imported through enclosing modules and returns the resulting test value. */
    public function run() AllocationResult<i64> {
      var h = try Holder(global_allocator);
      var filled = try fill(global_allocator, 3);
      return AllocationResult.Ok(h.count() + total(filled));
    }
  }

  /** Exercises names imported through enclosing modules and returns the resulting test value. */
  public function run() AllocationResult<i64> {
    return inner.run();
  }
}

/** Runs the regression scenario and returns its observable result to the test harness. */
function main() i32 {
  return match outer.run() {
    AllocationResult.Ok(value) => _convert<i32>(value),
    _ => -1
  };
}
