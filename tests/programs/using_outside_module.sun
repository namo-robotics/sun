// Regression: a generic type that cannot be resolved must be a fatal compile
// error. Nothing imports std here, so Vec is not visible where this return
// type is written. That used to print an error and still emit a (hanging)
// binary.
public module namo {
  public function make(a: ref HeapAllocator) Vec<String> {
    var v = Vec<String>(a, 4);
    return v;
  }
}

function main() i32 {
  var alloc = make_heap_allocator();
  var v = namo.make(alloc);
  return _convert<i32>(v.size());
}
