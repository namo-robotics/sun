using std;

/** Exercises nested generic readers. */
public module m {

  /** Stores sample metadata. */
  public class Info {
    public var n: i32 = 0;

    /** Creates an empty fixture value for this example or regression test. */
    init() {}
  }

  /** Represents a decoder passed to a callback. */
  public class Decoder {
    /** Creates an empty fixture value for this example or regression test. */
    init() {}
  }

  /** Stores a decoding callback. */
  public class TypeSupport<T> {
    public var decode: function (ref Decoder, const ref HeapAllocator) T;

    /** Initializes the fixture fields used by this example or regression test. */
    init(decode: function (ref Decoder, const ref HeapAllocator) T) {
      this.decode = decode;
    }
  }

  /** Pairs metadata with an optional value. */
  public class Sample<T> {
    public var info: Info;
    public var data: Option<T>;

    /** Initializes the fixture fields used by this example or regression test. */
    init(info: Info, data: Option<T>) {
      this.info = info;
      this.data = data;
    }
  }

  /** Builds empty and populated sample vectors. */
  public class Reader<T> {
    public var support: TypeSupport<T>;
    public var state: Shared<Info>;

    /** Initializes the fixture fields used by this example or regression test. */
    init(support: TypeSupport<T>, state: Shared<Info>) {
      this.support = support;
      this.state = state;
    }

    /** Returns an empty sample vector. */
    public method empty() AllocationResult<Vec<Sample<T>>> {
      return AllocationResult.Ok(try Vec<Sample<T>>(global_allocator, 2));
    }

    /** Wraps a value in a populated sample vector. */
    public method make(v: T) AllocationResult<Vec<Sample<T>>> {
      var out = try Vec<Sample<T>>(global_allocator, 2);
      var none: Option<T> = Option.None;
      try out.push(Sample<T>(Info(), none));
      try out.push(Sample<T>(Info(), Option.Some(v)));
      return AllocationResult.Ok(out);
    }
  }

  /** Constructs a reader through a generic method. */
  public class Subscriber {
    /** Creates an empty fixture value for this example or regression test. */
    init() {}

    /** Constructs a reader for the supplied type. */
    public method create_datareader<T>(support: TypeSupport<T>, state: Shared<Info>) Reader<T> {
      return Reader<T>(support, state);
    }
  }
}

/** A message fixture used to test nested generic callback types. */
class Msg {
  public var v: i32;

  /** Initializes the fixture fields used by this example or regression test. */
  init(v: i32) {
    this.v = v;
  }
}

/** Returns a message fixture through the generic decoder callback signature. */
function decode(d: ref m.Decoder, a: const ref HeapAllocator) Msg {
  return Msg(7);
}

/** Runs the regression scenario and returns its observable result to the test harness. */
function run_main() AllocationResult<i32> {
  var s = m.Subscriber();
  var r = s.create_datareader<Msg>(
    m.TypeSupport<Msg>(decode),
    try Shared<m.Info>(global_allocator, m.Info())
  );
  var e = try r.empty();
  var out = try r.make(Msg(7));
  if (e.size() == 0 and out.size() == 2) {
    var sample = match out.remove(1) {
      AccessResult.Ok(value) => value,
      AccessResult.OutOfBounds(_) => {
        return AllocationResult.Ok(-100);
      }
    };
    return AllocationResult.Ok(
      match sample.data {
        Option.Some(value) => value.v - 7,
        Option.None => 1
      }
    );
  }
  return AllocationResult.Ok(1);
}

/** Reports entrypoint failures without requiring diagnostic allocation to succeed. */
function main() i32 {
  return match run_main() {
    AllocationResult.Ok(code) => code,
    (error: const ref std.IError) => {
      match error.message() {
        std.AllocationResult.Ok(message) => std.io.eprintln(message),
        _ => std.io.eprintln("unable to allocate error message")
      };
      1;
    }
  };
}

manifest {
  libraries: [
    "stdlib.moon"
  ]
}
