using std.http;

// tls/https_client.sun - Minimal HTTPS client on top of TlsStream
//
// Sends HTTP/1.1 requests with Connection: close and reads the response to
// end-of-stream. Bodies framed with Content-Length or chunked transfer
// encoding are both understood. Not in this version: redirects, compression,
// connection reuse.
//
// Usage:
//   using std;
//   using std.io;
//   using tls;
//
//   var client = HttpsClient(global_allocator);
//   var host = try String(global_allocator, "example.com");
//   var resp = try client.get(host, "/");
//   println(resp.status);
//   println(resp.body);

/** Groups the tls declarations exported by this source file. */
public module tls {

  using std;

  // -------------------------------------------------------------------
  // HttpClientResponse - parsed response
  // -------------------------------------------------------------------

  /** Owns the status, headers, and body received from an HTTP server. */
  public class HttpClientResponse {
    public var status: i32 = 0;
    public var headers: String;  // raw header block after the status line
    public var body: String;  // decoded body

    /** Creates the client or response with storage from the supplied allocator. */
    init(alloc: const ref HeapAllocator) AllocationResult<void> {
      this.headers = try String(alloc, "");
      this.body = try String(alloc, "");
    }
  }

  // -------------------------------------------------------------------
  // Response parsing
  // -------------------------------------------------------------------

  /**
   * The Content-Length value in a lowercased header block, or -1
   */
  function find_content_length(headers_lower: const ref String) i64 {
    var idx: i64 = match headers_lower.find("content-length:") {
      Option.Some(v) => v,
      Option.None => -1
    };
    if (idx < 0) {
      return -1;
    }
    var i: i64 = idx + 15;
    var n: i64 = headers_lower.length();
    while (i < n and unsafe { headers_lower.unsafe_at(i); } == b' ') {
      i = i + 1;
    }
    var val: i64 = 0;
    var saw_digit: bool = false;
    while (i < n) {
      var c: u8 = unsafe { headers_lower.unsafe_at(i); };
      if (c < 48 or c > 57) {
        break;
      }
      val = val * 10 + _convert<i64>(c) - 48;
      saw_digit = true;
      i = i + 1;
    }
    if (saw_digit == false) {
      return -1;
    }
    return val;
  }

  /**
   * Decode a chunked body from raw[start..] into out
   */
  function decode_chunked(raw: const ref String, start: i64, out: ref String) SystemResult<void> {
    var i: i64 = start;
    var n: i64 = raw.length();
    while (i < n) {
      // Chunk size is lowercase or uppercase hex
      var size: i64 = 0;
      var saw_digit: bool = false;
      while (i < n) {
        var c: u8 = unsafe { raw.unsafe_at(i); };
        var digit: i64 = -1;
        if (c >= b'0' and c <= b'9') {
          digit = _convert<i64>(c - b'0');
        }
        if (c >= b'a' and c <= b'f') {
          digit = _convert<i64>(c - b'a') + 10;
        }
        if (c >= b'A' and c <= b'F') {
          digit = _convert<i64>(c - b'A') + 10;
        }
        if (digit < 0) {
          break;
        }
        size = size * 16 + digit;
        saw_digit = true;
        i = i + 1;
      }
      if (saw_digit == false) {
        return SystemResult.Error(Error(-1, "malformed chunked body"));
      }
      // Skip any chunk extension up to the end of the size line
      while (i < n and unsafe { raw.unsafe_at(i); } != b'\n') {
        i = i + 1;
      }
      i = i + 1;
      if (size == 0) {
        return SystemResult.Ok;  // terminating chunk; any trailers are ignored
      }
      if (i + size > n) {
        return SystemResult.Error(Error(-1, "truncated chunked body"));
      }
      var end: i64 = i + size;
      while (i < end) {
        try out.append_char(unsafe { raw.unsafe_at(i); });
        i = i + 1;
      }
      i = i + 2;  // CRLF after the chunk data
    }
    return SystemResult.Error(Error(-1, "chunked body missing terminating chunk"));
  }

  /**
   * Split a raw response into status, header block, and decoded body.
   * Public like http.sun's request parser, so code driving a TlsStream
   * itself can reuse the framing.
   */
  public function parse_response(
    alloc: const ref HeapAllocator,
    raw: const ref String,
    resp: ref HttpClientResponse
  ) SystemResult<void> {
    var n: i64 = raw.length();
    var header_end: i64 = find_header_end(raw);
    if (header_end < 0) {
      return SystemResult.Error(Error(-1, "malformed HTTP response: missing header terminator"));
    }

    // Status code: the digits after the first space of "HTTP/1.1 200 OK"
    var i: i64 = 0;
    while (i < n and unsafe { raw.unsafe_at(i); } != b' ') {
      i = i + 1;
    }
    i = i + 1;
    var status: i64 = 0;
    var saw_digit: bool = false;
    while (i < n) {
      var c: u8 = unsafe { raw.unsafe_at(i); };
      if (c < 48 or c > 57) {
        break;
      }
      status = status * 10 + _convert<i64>(c) - 48;
      saw_digit = true;
      i = i + 1;
    }
    if (saw_digit == false) {
      return SystemResult.Error(Error(-1, "malformed HTTP response: no status code"));
    }
    resp.status = _convert<i32>(status);

    // Header block: after the status line, up to the CRLFCRLF terminator
    while (i < n and unsafe { raw.unsafe_at(i); } != b'\n') {
      i = i + 1;
    }
    i = i + 1;
    while (i < header_end) {
      try resp.headers.append_char(unsafe { raw.unsafe_at(i); });
      i = i + 1;
    }

    // Body: chunked when declared, else Content-Length, else read-to-end
    var body_start: i64 = header_end + 4;
    var lower: String = try resp.headers.clone(alloc);
    lower.to_lower();
    if (lower.contains("transfer-encoding: chunked")) {
      try decode_chunked(raw, body_start, resp.body);
      return SystemResult.Ok;
    }
    var content_length: i64 = find_content_length(lower);
    var body_end: i64 = n;
    if (content_length >= 0 and body_start + content_length < n) {
      body_end = body_start + content_length;
    }
    var j: i64 = body_start;
    while (j < body_end) {
      try resp.body.append_char(unsafe { raw.unsafe_at(j); });
      j = j + 1;
    }
    return SystemResult.Ok;
  }

  // -------------------------------------------------------------------
  // HttpsClient - one TLS connection per request
  // -------------------------------------------------------------------

  /** Sends HTTP requests over verified TLS connections and parses their responses. */
  public class HttpsClient {
    var alloc: HeapAllocator;

    /** Creates the client or response with storage from the supplied allocator. */
    init(allocator: const ref HeapAllocator) {
      this.alloc = allocator.copy();
    }

    /**
     * GET https://host{path} on port 443
     */
    public method get(host: ref String, path: static_ptr<u8>) ClientResult<HttpClientResponse> {
      return ClientResult.Ok((try this.get(host, 443, path)));
    }

    /** Sends an HTTPS GET request and returns the parsed response. */
    public method get(
      host: ref String,
      port: i32,
      path: static_ptr<u8>
    ) ClientResult<HttpClientResponse> {
      var req = try String(this.alloc, "GET ");
      try req.append(path);
      try req.append(" HTTP/1.1");
      try append_crlf(req);
      try this.append_common_headers(req, host);
      try append_crlf(req);
      return ClientResult.Ok((try this.exchange(host, port, req)));
    }

    /**
     * POST a body to https://host{path} on port 443
     */
    public method post(
      host: ref String,
      path: static_ptr<u8>,
      content_type: static_ptr<u8>,
      body: const ref String
    ) ClientResult<HttpClientResponse> {
      return ClientResult.Ok((try this.post(host, 443, path, content_type, body)));
    }

    /** Sends an HTTPS POST request with the supplied body and returns the response. */
    public method post(
      host: ref String,
      port: i32,
      path: static_ptr<u8>,
      content_type: static_ptr<u8>,
      body: const ref String
    ) ClientResult<HttpClientResponse> {
      var req = try String(this.alloc, "POST ");
      try req.append(path);
      try req.append(" HTTP/1.1");
      try append_crlf(req);
      try this.append_common_headers(req, host);
      try req.append("Content-Type: ");
      try req.append(content_type);
      try append_crlf(req);
      try req.append("Content-Length: ");
      try req.append(body.length());
      try append_crlf(req);
      try append_crlf(req);
      try req.append(body);
      return ClientResult.Ok((try this.exchange(host, port, req)));
    }

    /** Appends the HTTP headers shared by requests from this client. */
    method append_common_headers(req: ref String, host: ref String) AllocationResult<void> {
      try req.append("Host: ");
      try req.append(host);
      try append_crlf(req);
      try req.append("Connection: close");
      try append_crlf(req);
      try req.append("Accept: */*");
      try append_crlf(req);

      return AllocationResult.Ok;
    }

    /**
     * Connect, send the request, read to end-of-stream, and parse
     */
    method exchange(
      host: ref String,
      port: i32,
      request: ref String
    ) ClientResult<HttpClientResponse> {
      var stream = TlsStream();
      try stream.connect(host, port);
      try stream.send_string(request);

      var raw = try String(this.alloc, "");
      var chunk = try ContiguousBuffer<u8>(this.alloc, 8192);
      var done: bool = false;
      while (done == false) {
        var n: i64 = (try stream.recv(chunk));
        if (n <= 0) {
          done = true;
        } else {
          for (var i: i64 = 0; i < n; i = i + 1) {
            raw.append_char(unsafe { chunk.get_unchecked(i); });
          }
        }
      }
      stream.close();

      var resp = try HttpClientResponse(this.alloc);
      try parse_response(this.alloc, raw, resp);
      return ClientResult.Ok(resp);
    }
  }
}
