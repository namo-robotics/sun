// tls/openssl.sun - The tls bundle's OpenSSL C boundary
//
// Every libssl/libcrypto symbol the bundle calls is declared here exactly
// once, following the sys.sun pattern: none of it is public, the `c_` prefix
// is only for readability at the call site. Opaque OpenSSL handles
// (SSL_CTX*, SSL*, SSL_METHOD*) travel as raw_ptr<u8>.
//
// Minimum OpenSSL version: 1.1.1. Only real exported symbols are declared.
// C macros such as SSL_set_tlsext_host_name have no symbol of their own and
// are expressed through SSL_ctrl instead (see tls_stream.sun).

/** Groups the tls declarations exported by this source file. */
public module tls {
  // --- context ------------------------------------------------------------

  /** Returns the OpenSSL method used to create TLS client contexts. */
  extern "C" function c_tls_client_method() raw_ptr<u8> as "TLS_client_method";

  /** Allocates a TLS context that the caller must release. */
  extern "C" function c_ssl_ctx_new(method: raw_ptr<u8>) raw_ptr<u8> as "SSL_CTX_new";

  /** Releases an OpenSSL TLS context. */
  extern "C" function c_ssl_ctx_free(ctx: raw_ptr<u8>) void as "SSL_CTX_free";

  /** Configures certificate verification for a TLS context. */
  extern "C" function c_ssl_ctx_set_verify(ctx: raw_ptr<u8>, mode: i32, callback: raw_ptr<u8>) void as "SSL_CTX_set_verify";

  /** Loads the system certificate trust paths into a TLS context. */
  extern "C" function c_ssl_ctx_set_default_verify_paths(ctx: raw_ptr<u8>) i32 as "SSL_CTX_set_default_verify_paths";

  // --- connection ----------------------------------------------------------

  /** Allocates a TLS connection using the supplied context. */
  extern "C" function c_ssl_new(ctx: raw_ptr<u8>) raw_ptr<u8> as "SSL_new";

  /** Releases an OpenSSL TLS connection. */
  extern "C" function c_ssl_free(ssl: raw_ptr<u8>) void as "SSL_free";

  /** Connects a TLS session to an existing socket descriptor. */
  extern "C" function c_ssl_set_fd(ssl: raw_ptr<u8>, fd: i32) i32 as "SSL_set_fd";

  /** Sets the hostname that the peer certificate must match. */
  extern "C" function c_ssl_set1_host(ssl: raw_ptr<u8>, hostname: raw_ptr<u8>) i32 as "SSL_set1_host";

  /** Applies an OpenSSL control operation to a TLS connection. */
  extern "C" function c_ssl_ctrl(ssl: raw_ptr<u8>, cmd: i32, larg: i64, parg: raw_ptr<u8>) i64 as "SSL_ctrl";

  /** Performs the client side of the TLS handshake. */
  extern "C" function c_ssl_connect(ssl: raw_ptr<u8>) i32 as "SSL_connect";

  /** Reads decrypted bytes into caller-provided storage. */
  extern "C" function c_ssl_read(ssl: raw_ptr<u8>, buf: raw_ptr<u8>, num: i32) i32 as "SSL_read";

  /** Sends bytes through an established TLS connection. */
  extern "C" function c_ssl_write(ssl: raw_ptr<u8>, buf: raw_ptr<u8>, num: i32) i32 as "SSL_write";

  /** Sends or completes the TLS shutdown exchange. */
  extern "C" function c_ssl_shutdown(ssl: raw_ptr<u8>) i32 as "SSL_shutdown";

  // --- errors and verification ----------------------------------------------

  /** Classifies the result of the most recent TLS operation. */
  extern "C" function c_ssl_get_error(ssl: raw_ptr<u8>, ret: i32) i32 as "SSL_get_error";

  /** Returns the result of peer certificate verification. */
  extern "C" function c_ssl_get_verify_result(ssl: raw_ptr<u8>) i64 as "SSL_get_verify_result";

  /** Returns a message describing a certificate verification failure. */
  extern "C" function c_x509_verify_cert_error_string(code: i64) raw_ptr<u8> as "X509_verify_cert_error_string";

  /** Removes and returns the next OpenSSL error from the current thread's queue. */
  extern "C" function c_err_get_error() u64 as "ERR_get_error";

  /** Returns the next OpenSSL error without removing it from the queue. */
  extern "C" function c_err_peek_error() u64 as "ERR_peek_error";

  /** Formats an OpenSSL error into a bounded caller-provided buffer. */
  extern "C" function c_err_error_string_n(code: u64, buf: raw_ptr<u8>, len: i64) void as "ERR_error_string_n";

  // --- server --------------------------------------------------------------

  /** Returns the method for server TLS contexts. */
  extern "C" function c_tls_server_method() raw_ptr<u8> as "TLS_server_method";

  /** Loads a PEM certificate and its intermediate chain. */
  extern "C" function c_ssl_ctx_use_certificate_chain_file(ctx: raw_ptr<u8>, path: raw_ptr<u8>) i32 as "SSL_CTX_use_certificate_chain_file";

  /** Loads an unencrypted PEM private key. */
  extern "C" function c_ssl_ctx_use_private_key_file(ctx: raw_ptr<u8>, path: raw_ptr<u8>, kind: i32) i32 as "SSL_CTX_use_PrivateKey_file";

  /** Checks that the loaded key matches the certificate. */
  extern "C" function c_ssl_ctx_check_private_key(ctx: raw_ptr<u8>) i32 as "SSL_CTX_check_private_key";

  /** Applies protocol limits and I/O modes to a context. */
  extern "C" function c_ssl_ctx_ctrl(ctx: raw_ptr<u8>, cmd: i32, value: i64, data: raw_ptr<u8>) i64 as "SSL_CTX_ctrl";

  /** Installs an application-protocol selection callback. */
  extern "C" function c_ssl_ctx_set_alpn_select_cb(ctx: raw_ptr<u8>, cb: function (raw_ptr<u8>, raw_ptr<raw_ptr<u8>>, raw_ptr<u8>, raw_ptr<u8>, u32, raw_ptr<u8>) i32, arg: raw_ptr<u8>) void as "SSL_CTX_set_alpn_select_cb";

  /** Selects the first server-preferred protocol also offered by the client. */
  extern "C" function c_ssl_select_next_proto(out: raw_ptr<raw_ptr<u8>>, outlen: raw_ptr<u8>, server: raw_ptr<u8>, server_len: u32, client: raw_ptr<u8>, client_len: u32) i32 as "SSL_select_next_proto";

  /** Measures a validated, zero-terminated static ALPN list. */
  extern "C" function c_tls_strlen(data: raw_ptr<u8>) i64 as "strlen";

  /** Prepares a session to perform the server handshake. */
  extern "C" function c_ssl_set_accept_state(ssl: raw_ptr<u8>) void as "SSL_set_accept_state";

  /** Advances the configured client or server handshake. */
  extern "C" function c_ssl_do_handshake(ssl: raw_ptr<u8>) i32 as "SSL_do_handshake";

  /** Reports decrypted bytes that can be read without socket readiness. */
  extern "C" function c_ssl_pending(ssl: raw_ptr<u8>) i32 as "SSL_pending";

  /** Borrows the negotiated application protocol from a session. */
  extern "C" function c_ssl_get0_alpn_selected(ssl: raw_ptr<u8>, data: raw_ptr<raw_ptr<u8>>, len: raw_ptr<u32>) void as "SSL_get0_alpn_selected";

  /** Clears stale errors before an operation classified by SSL_get_error. */
  extern "C" function c_err_clear_error() void as "ERR_clear_error";

  /** Prevents interactive password prompts while loading server keys. */
  extern "C" function c_ssl_ctx_set_default_passwd_cb(ctx: raw_ptr<u8>, cb: function (raw_ptr<u8>, i32, i32, raw_ptr<u8>) i32) void as "SSL_CTX_set_default_passwd_cb";

  // --- nonblocking socket adapter -----------------------------------------

  /** Allocates a private BIO implementation; free after its BIOs are released. */
  extern "C" function c_bio_meth_new(kind: i32, name: raw_ptr<u8>) raw_ptr<u8> as "BIO_meth_new";

  /** Releases a private BIO implementation. */
  extern "C" function c_bio_meth_free(method: raw_ptr<u8>) void as "BIO_meth_free";

  /** Installs the adapter's send callback. */
  extern "C" function c_bio_meth_set_write(method: raw_ptr<u8>, cb: function (raw_ptr<u8>, raw_ptr<u8>, i32) i32) i32 as "BIO_meth_set_write";

  /** Installs the adapter's receive callback. */
  extern "C" function c_bio_meth_set_read(method: raw_ptr<u8>, cb: function (raw_ptr<u8>, raw_ptr<u8>, i32) i32) i32 as "BIO_meth_set_read";

  /** Installs the adapter's control callback. */
  extern "C" function c_bio_meth_set_ctrl(method: raw_ptr<u8>, cb: function (raw_ptr<u8>, i32, i64, raw_ptr<u8>) i64) i32 as "BIO_meth_set_ctrl";

  /** Creates an I/O adapter using the supplied implementation. */
  extern "C" function c_bio_new(method: raw_ptr<u8>) raw_ptr<u8> as "BIO_new";

  /** Borrows stable storage for the adapter's socket descriptor. */
  extern "C" function c_bio_set_data(bio: raw_ptr<u8>, data: raw_ptr<u8>) void as "BIO_set_data";

  /** Retrieves the adapter's borrowed descriptor storage. */
  extern "C" function c_bio_get_data(bio: raw_ptr<u8>) raw_ptr<u8> as "BIO_get_data";

  /** Marks an adapter ready for I/O. */
  extern "C" function c_bio_set_init(bio: raw_ptr<u8>, ready: i32) void as "BIO_set_init";

  /** Sets the readiness flags inspected by OpenSSL. */
  extern "C" function c_bio_set_flags(bio: raw_ptr<u8>, flags: i32) void as "BIO_set_flags";

  /** Clears readiness flags left by a previous I/O attempt. */
  extern "C" function c_bio_clear_flags(bio: raw_ptr<u8>, flags: i32) void as "BIO_clear_flags";

  /** Transfers ownership of the input and output adapters to a session. */
  extern "C" function c_ssl_set_bio(ssl: raw_ptr<u8>, read_bio: raw_ptr<u8>, write_bio: raw_ptr<u8>) void as "SSL_set_bio";

  /** Sends socket bytes with the platform's no-signal flag. */
  extern "C" function c_tls_send(fd: i32, data: raw_ptr<u8>, size: i64, flags: i32) i64 as "send";

  /** Receives socket bytes without allocating. */
  extern "C" function c_tls_recv(fd: i32, data: raw_ptr<u8>, size: i64, flags: i32) i64 as "recv";
}
