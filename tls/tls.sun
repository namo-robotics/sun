// tls/tls.sun - Entrypoint manifest for the tls.moon bundle
//
// TLS client support for Sun, backed by OpenSSL. Built as its own bundle so
// programs that do not use TLS never depend on OpenSSL.

manifest {
    suns: [
        "openssl.sun",
        "tls_stream.sun",
        "https_client.sun"
    ]
    moons: ["stdlib.moon"]
    target: {
        linux: {
            archives: ["$OPENSSL_LIBS_LINUX/libssl.a", "$OPENSSL_LIBS_LINUX/libcrypto.a"]
        }
        macos: {
            archives: ["$OPENSSL_LIBS_MACOS/libssl.a", "$OPENSSL_LIBS_MACOS/libcrypto.a"]
        }
    }
}
