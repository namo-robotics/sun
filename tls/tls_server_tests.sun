using std.net;
using std.io;

/** Regression coverage for nonblocking server TLS. */
public module tls {

  using std;

  /** Checks that unloaded contexts reject sockets instead of calling OpenSSL. */
  test_function server_context_requires_credentials() {
    var ctx = TlsServerContext();
    std.test.assert(not ctx.is_ready(), "context starts empty");
    var rejected: bool = false;
    try {
      ctx.accept(TcpStream());
      rejected = false;
    } catch (error: TlsError) {
      rejected = true;
    } catch {
      rejected = false;
    }
    std.test.assert(rejected, "accept requires credentials");
    ctx.close();
    ctx.close();
  }

  /** Checks that malformed ALPN lists fail before reading credential files. */
  test_function server_rejects_malformed_alpn() {
    var ctx = TlsServerContext();
    var path = String("missing.pem");
    var rejected: bool = false;
    try {
      ctx.load(path, path, "\x08h2");
      rejected = false;
    } catch (error: TlsError) {
      rejected = (error.message()).equals_literal(
        "invalid ALPN protocol list"
      );
    } catch {
      rejected = false;
    }
    std.test.assert(rejected, "ALPN lengths must fit the supplied list");
    rejected = false;
    try {
      ctx.load(path, path, "\x00");
    } catch (error: TlsError) {
      rejected = error.message().equals_literal("invalid ALPN protocol list");
    }
    std.test.assert(rejected, "empty protocol names are invalid");
    rejected = false;
    try {
      ctx.load(path, path, "\x02h\x00");
    } catch (error: TlsError) {
      rejected = error.message().equals_literal("ALPN protocol names cannot contain NUL");
    }
    std.test.assert(rejected, "embedded NUL is invalid");
  }
}

/** Local OpenSSL peers and credentials used only by the server tests. */
public module tls {

  using std;
  using tls;

  /** Configures the test client's advertised application protocols. */
  extern "C" function test_set_alpn(ssl: raw_ptr<u8>, data: raw_ptr<u8>, length: u32) i32 as "SSL_set_alpn_protos";

  /** Skips integration cases when the optional certificate tool is unavailable. */
  function have_openssl() bool throws {
    var alloc = make_heap_allocator();
    var command = std.process.Command(alloc, "openssl");
    command.add_arg("version");
    command.set_stdout(std.process.Stdio.Null);
    command.set_stderr(std.process.Stdio.Null);
    var available: bool = false;
    try {
      var code = command.status();
      available = code == 0;
    } catch {
      available = false;
    }
    if (available) {
      return true;
    }
    println("SKIP server TLS integration: openssl is not on PATH");
    return false;
  }

  /** Owns throwaway credentials, a listener, and a nonblocking OpenSSL client. */
  class Peer {
    var listener: TcpListener = TcpListener();
    var tcp: TcpStream = TcpStream();
    var ctx: raw_ptr<u8> = null;
    var ssl: raw_ptr<u8> = null;
    var dir: String;
    public var cert: String;
    public var key: String;
    public var encrypted_key: String;
    public var server: TlsServerContext = TlsServerContext();

    /** Creates a certificate and connected TCP pair; no handshake occurs yet. */
    init() throws {
      this.dir = String("");
      this.cert = String("");
      this.key = String("");
      this.encrypted_key = String("");
      var alloc = make_heap_allocator();
      this.listener.bind_loopback(0);
      this.listener.listen(4);
      var port: i32 = this.listener.local_port();
      this.dir = String("tmp/sun_tls_server_");
      this.dir.append(std.process.pid());
      this.dir.append_char(b'_');
      this.dir.append(port);
      // The source tree may not have a temporary directory in a fresh checkout.
      try {
        std.io.make_dir("tmp", 448);
      } catch {}
      std.io.make_dir(this.dir, 448);
      this.cert = this.dir.clone(alloc);
      this.cert.append("/cert.pem");
      this.key = this.dir.clone(alloc);
      this.key.append("/key.pem");
      this.encrypted_key = this.dir.clone(alloc);
      this.encrypted_key.append("/encrypted.pem");
      var command = std.process.Command(alloc, "openssl");
      command.add_arg("req");
      command.add_arg("-x509");
      command.add_arg("-newkey");
      command.add_arg("rsa:2048");
      command.add_arg("-nodes");
      command.add_arg("-days");
      command.add_arg("1");
      command.add_arg("-subj");
      command.add_arg("/CN=localhost");
      command.add_arg("-keyout");
      command.add_arg(this.key);
      command.add_arg("-out");
      command.add_arg(this.cert);
      command.set_stdout(std.process.Stdio.Null);
      command.set_stderr(std.process.Stdio.Null);
      if ((command.status()) != 0) {
        throw TlsError(-1, "could not create server test certificate");
      }
      this.server.load(this.cert, this.key, "\x02h2\x08http/1.1");
      this.tcp.connect_local(port);
      this.tcp.set_nonblocking(true);
      this.ctx = unsafe { c_ssl_ctx_new(c_tls_client_method()); };
      if (this.ctx == null) {
        throw TlsError(-1, "test client context allocation failed");
      }
      this.ssl = unsafe { c_ssl_new(this.ctx); };
      if (this.ssl == null) {
        throw TlsError(-1, "test client allocation failed");
      }
      if (unsafe { c_ssl_set_fd(this.ssl, this.tcp.get_fd()); } != 1) {
        throw TlsError(-1, "test client socket setup failed");
      }
      return;
    }

    /** Frees client state and removes all files created by this fixture. */
    deinit() {
      if (this.ssl != null) {
        unsafe { c_ssl_free(this.ssl); };
      }
      if (this.ctx != null) {
        unsafe { c_ssl_ctx_free(this.ctx); };
      }
      try {
        std.io.remove_file(this.cert);
      } catch {}
      try {
        std.io.remove_file(this.key);
      } catch {}
      try {
        std.io.remove_file(this.encrypted_key);
      } catch {}
      try {
        std.io.remove_dir(this.dir);
      } catch {}
    }

    /** Accepts the connected test socket into the public server API. */
    public method accept() TlsServerStream throws {
      return this.server.accept(this.listener.accept());
    }

    /** Offers an ALPN list before the client handshake begins. */
    public method offer(protocols: static_ptr<u8>) void throws {
      std.test.assert_eq(
        unsafe { test_set_alpn(this.ssl, protocols.raw(), _convert<u32>(protocols.length())); },
        0
      );
      return;
    }

    /** Advances both peers with a bounded wait, failing on any fatal result. */
    public method handshake(stream: ref TlsServerStream) void throws {
      var client_ready: bool = false;
      var server_ready: bool = false;
      var attempts: i32 = 0;
      while (attempts < 1000 and (not client_ready or not server_ready)) {
        if (not client_ready) {
          unsafe { c_err_clear_error(); };
          var result: i32 = unsafe { c_ssl_connect(this.ssl); };
          if (result == 1) {
            client_ready = true;
          } else {
            var reason: i32 = unsafe { c_ssl_get_error(this.ssl, result); };
            std.test.assert(
              reason == SSL_ERROR_WANT_READ or reason == SSL_ERROR_WANT_WRITE,
              "client handshake must succeed or need readiness"
            );
          }
        }
        if (not server_ready) {
          match stream.handshake() {
            ServerResult.Ok(n) => {
              server_ready = true;
            },
            ServerResult.WantRead => {},
            ServerResult.WantWrite => {},
            _ => {
              throw std.test.AssertionError("server handshake failed");
            }
          };
        }
        std.time.sleep(std.time.create_duration_millis(1));
        attempts = attempts + 1;
      }
      std.test.assert(
        client_ready and server_ready,
        "handshake must finish within the deadline"
      );
      return;
    }

    /** Writes a small application record from the test client. */
    public method send(data: static_ptr<u8>) void throws {
      unsafe { c_err_clear_error(); };
      std.test.assert_eq(
        unsafe { c_ssl_write(this.ssl, data.raw(), _convert<i32>(data.length())); },
        _convert<i32>(data.length())
      );
      return;
    }

    /** Drains client-side records, returning application bytes received so far. */
    public method receive(buf: ref ContiguousBuffer<u8>) i32 throws {
      unsafe { c_err_clear_error(); };
      var result: i32 = unsafe {
        c_ssl_read(this.ssl, buf.raw_data(), _convert<i32>(buf.size()));
      };
      if (result > 0) {
        return result;
      }
      var reason: i32 = unsafe { c_ssl_get_error(this.ssl, result); };
      std.test.assert(
        reason == SSL_ERROR_WANT_READ or reason == SSL_ERROR_WANT_WRITE or
          reason == SSL_ERROR_ZERO_RETURN,
        "client read must not fail"
      );
      return 0;
    }

    /** Sends a TLS close notification from the client. */
    public method shutdown() void {
      unsafe { c_err_clear_error(); c_ssl_shutdown(this.ssl); };
    }

    /** Sends plaintext to test rejection before the TLS handshake. */
    public method send_plaintext() void throws {
      this.tcp.send_str("GET / HTTP/1.1\r\n\r\n");
      return;
    }

    /** Writes an encrypted private key to test noninteractive loading failure. */
    public method encrypt_key() void throws {
      var command = std.process.Command(make_heap_allocator(), "openssl");
      command.add_arg("pkey");
      command.add_arg("-in");
      command.add_arg(this.key);
      command.add_arg("-aes-256-cbc");
      command.add_arg("-passout");
      command.add_arg("pass:test-password");
      command.add_arg("-out");
      command.add_arg(this.encrypted_key);
      command.set_stdout(std.process.Stdio.Null);
      command.set_stderr(std.process.Stdio.Null);
      if ((command.status()) != 0) {
        throw Error(1, "could not encrypt test key");
      }
      return;
    }

    /** Drops TCP without sending a TLS close notification. */
    public method disconnect() void {
      this.tcp.close();
    }
  }

  /** Requires a completed operation rather than a normal readiness notification. */
  function expect_completed(result: ServerResult<i64>) i64 throws {
    return match result {
      ServerResult.Ok(count) => count,
      _ => {
        throw std.test.AssertionError("expected completed TLS operation");
      }
    };
  }

  /** Retries a nonblocking read until data arrives, failing on errors or timeout. */
  function read_when_ready(stream: ref TlsServerStream, buf: ref ContiguousBuffer<u8>) i64 throws {
    var attempts: i32 = 0;
    while (attempts < 1000) {
      try {
        match stream.read(buf) {
          ServerResult.WantRead => {},
          ServerResult.WantWrite => {},
          ServerResult.Ok(n) => {
            return n;
          },
          ServerResult.Closed => {
            throw std.test.AssertionError("TLS stream closed before data arrived");
          }
        };
      } catch (error: TlsError) {
        throw std.test.AssertionError(error.message());
      } catch (error: AllocationError) {
        throw error;
      } catch (error: InvalidArgumentError) {
        throw error;
      } catch (error: OverflowError) {
        throw error;
      }
      std.time.sleep(std.time.create_duration_millis(1));
      attempts = attempts + 1;
    }
    throw std.test.AssertionError("TLS read did not finish within the deadline");
  }

  /** Exercises readiness, ALPN preference, bidirectional I/O, and context lifetime. */
  test_function handshake_io_and_context_lifetime() {
    if (not (have_openssl())) {
      return;
    }
    var peer = Peer();
    peer.offer("\x08http/1.1\x02h2");
    var stream = peer.accept();
    var needs_read: bool = match stream.handshake() {
      ServerResult.WantRead => true,
      _ => false
    };
    std.test.assert(needs_read, "server waits for the client hello");
    peer.server.close();
    peer.handshake(stream);
    std.test.assert((stream.alpn()).equals_literal("h2"), "server preference chooses h2");
    var alloc = make_heap_allocator();
    var buf = ContiguousBuffer<u8>(alloc, 2);
    std.test.assert(
      match stream.read(buf) {
        ServerResult.WantRead => true,
        _ => false
      },
      "an idle stream needs read readiness"
    );
    peer.send("ping");
    std.test.assert_eq(read_when_ready(stream, buf), 2);
    std.test.assert_eq(unsafe { _load<u8>(buf.raw_data(), 0); }, b'p');
    std.test.assert_eq(unsafe { _load<u8>(buf.raw_data(), 1); }, b'i');
    std.test.assert_eq(stream.pending(), 2);
    std.test.assert_eq(expect_completed(stream.read(buf)), 2);
    std.test.assert_eq(unsafe { _load<u8>(buf.raw_data(), 0); }, b'n');
    std.test.assert_eq(unsafe { _load<u8>(buf.raw_data(), 1); }, b'g');
    var empty = String("");
    std.test.assert_eq(expect_completed(stream.write(empty)), 0);
    var empty_buf = ContiguousBuffer<u8>(alloc, 0);
    std.test.assert_eq(expect_completed(stream.read(empty_buf)), 0);
    var response = String("pong");
    std.test.assert_eq(expect_completed(stream.write(response)), 4);
    var total: i32 = 0;
    var attempts: i32 = 0;
    while (total < 4 and attempts < 1000) {
      total = total + (peer.receive(buf));
      std.time.sleep(std.time.create_duration_millis(1));
      attempts = attempts + 1;
    }
    std.test.assert_eq(total, 4);
    peer.shutdown();
    var closed: bool = false;
    attempts = 0;
    while (not closed and attempts < 1000) {
      closed = match stream.read(buf) {
        ServerResult.Closed => true,
        ServerResult.WantRead => false,
        _ => {
          std.test.fail("expected close notification");
          false;
        }
      };
      std.time.sleep(std.time.create_duration_millis(1));
      attempts = attempts + 1;
    }
    std.test.assert(closed, "peer closure is visible");
    std.test.assert(
      match stream.shutdown() {
        ServerResult.Closed => true,
        _ => false
      },
      "shutdown completes after peer notification"
    );
    stream.close();
    std.test.assert(not stream.is_open(), "close releases the stream");
    std.test.assert_eq(stream.get_fd(), -1);
  }

  /** Checks absent ALPN overlap and detects an unauthenticated transport EOF. */
  test_function no_alpn_overlap_and_abrupt_eof() {
    if (not (have_openssl())) {
      return;
    }
    var peer = Peer();
    peer.offer("\x04test");
    var stream = peer.accept();
    peer.handshake(stream);
    std.test.assert_eq((stream.alpn()).length(), 0);
    peer.disconnect();
    var alloc = make_heap_allocator();
    var buf = ContiguousBuffer<u8>(alloc, 16);
    var failed: bool = false;
    var attempts: i32 = 0;
    while (not failed and attempts < 1000) {
      try {
        failed = match stream.read(buf) {
          ServerResult.WantRead => false,
          _ => {
            std.test.fail("abrupt EOF must be a TLS error");
            false;
          }
        };
      } catch (error: TlsError) {
        failed = true;
      }
      std.time.sleep(std.time.create_duration_millis(1));
      attempts = attempts + 1;
    }
    std.test.assert(failed and not stream.is_open(), "fatal errors close the stream");
  }

  /** A failed credential reload preserves the usable previous configuration. */
  test_function invalid_credentials_preserve_context() {
    if (not (have_openssl())) {
      return;
    }
    var peer = Peer();
    var exception_check_1 = false;
    try {
      peer.server.accept(TcpStream());
      exception_check_1 = false;
    } catch (error: Error) {
      exception_check_1 = true;
    } catch {
      exception_check_1 = false;
    }
    std.test.assert(
      exception_check_1,
      "closed sockets fail during setup"
    );
    peer.offer("\x02h2");
    var missing = String("tmp/nonexistent-server-certificate.pem");
    var exception_check_2 = false;
    try {
      peer.server.load(missing, peer.key);
      exception_check_2 = false;
    } catch (error: TlsError) {
      exception_check_2 = true;
    } catch {
      exception_check_2 = false;
    }
    std.test.assert(
      exception_check_2
    );
    std.test.assert(peer.server.is_ready());
    var exception_check_3 = false;
    try {
      peer.server.load(peer.cert, missing);
      exception_check_3 = false;
    } catch (error: TlsError) {
      exception_check_3 = true;
    } catch {
      exception_check_3 = false;
    }
    std.test.assert(
      exception_check_3
    );
    std.test.assert(peer.server.is_ready());
    peer.encrypt_key();
    var exception_check_4 = false;
    try {
      peer.server.load(peer.cert, peer.encrypted_key);
      exception_check_4 = false;
    } catch (error: TlsError) {
      exception_check_4 = true;
    } catch {
      exception_check_4 = false;
    }
    std.test.assert(
      exception_check_4,
      "encrypted keys fail without prompting"
    );
    var other = Peer();
    var exception_check_5 = false;
    try {
      peer.server.load(peer.cert, other.key);
      exception_check_5 = false;
    } catch (error: TlsError) {
      exception_check_5 = true;
    } catch {
      exception_check_5 = false;
    }
    std.test.assert(
      exception_check_5,
      "mismatched key must be rejected"
    );
    var stream = peer.accept();
    peer.handshake(stream);
    std.test.assert(
      (stream.alpn()).equals_literal("h2"),
      "failed reloads preserve ALPN configuration"
    );
  }

  /** Fills the transport to exercise partial writes and retry after WantWrite. */
  test_function write_backpressure_and_shutdown() {
    if (not (have_openssl())) {
      return;
    }
    var peer = Peer();
    var stream = peer.accept();
    peer.handshake(stream);
    var data = String("");
    for (var i: i32 = 0; i < 32768; i = i + 1) {
      data.append_char(b'x');
    }
    var first: i64 = expect_completed(stream.write(data));
    std.test.assert(
      first > 0 and first < data.length(),
      "large writes complete one record at a time"
    );
    var blocked: bool = false;
    var attempts: i32 = 0;
    while (not blocked and attempts < 10000) {
      blocked = match stream.write(data) {
        ServerResult.Ok(n) => false,
        ServerResult.WantWrite => true,
        _ => {
          std.test.fail("expected write progress or backpressure");
          false;
        }
      };
      attempts = attempts + 1;
    }
    std.test.assert(blocked, "a peer that does not read must apply backpressure");
    var buf = ContiguousBuffer<u8>(make_heap_allocator(), 65536);
    var resumed: bool = false;
    attempts = 0;
    while (not resumed and attempts < 1000) {
      var received: i32 = peer.receive(buf);
      if (received > 0) {
        std.test.assert_eq(unsafe { _load<u8>(buf.raw_data(), 0); }, b'x');
      }
      resumed = match stream.write(data) {
        ServerResult.Ok(n) => n > 0,
        ServerResult.WantWrite => false,
        _ => {
          std.test.fail("retry must preserve the pending write");
          false;
        }
      };
      std.time.sleep(std.time.create_duration_millis(1));
      attempts = attempts + 1;
    }
    std.test.assert(resumed, "reading at the peer releases backpressure");
    // Drain queued records before exchanging close notifications.
    var received: i32 = 1;
    while (received > 0) {
      received = peer.receive(buf);
    }
    std.test.assert(
      match stream.shutdown() {
        ServerResult.WantRead => true,
        _ => false
      },
      "server shutdown waits for peer notification"
    );
    peer.shutdown();
    var closed: bool = false;
    attempts = 0;
    while (not closed and attempts < 1000) {
      closed = match stream.shutdown() {
        ServerResult.Closed => true,
        ServerResult.WantRead => false,
        ServerResult.WantWrite => false,
        _ => {
          std.test.fail("clean shutdown must complete");
          false;
        }
      };
      std.time.sleep(std.time.create_duration_millis(1));
      attempts = attempts + 1;
    }
    std.test.assert(closed and not stream.is_open());
  }

  /** Plain HTTP input fails the handshake and releases the accepted socket. */
  test_function handshake_rejects_plaintext() {
    if (not (have_openssl())) {
      return;
    }
    var peer = Peer();
    var stream = peer.accept();
    peer.send_plaintext();
    var failed: bool = false;
    var attempts: i32 = 0;
    while (not failed and attempts < 1000) {
      try {
        failed = match stream.handshake() {
          ServerResult.WantRead => false,
          ServerResult.WantWrite => false,
          _ => {
            std.test.fail("plaintext must fail the TLS handshake");
            false;
          }
        };
      } catch (error: TlsError) {
        failed = true;
      }
      if (not failed) {
        std.time.sleep(std.time.create_duration_millis(1));
      }
      attempts = attempts + 1;
    }
    std.test.assert(
      failed and not stream.is_open(),
      "plaintext must be rejected within the deadline"
    );
    var rejected = false;
    try {
      stream.handshake();
    } catch (error: TlsError) {
      rejected = true;
    }
    std.test.assert(rejected, "closed sessions reject handshake retries");
  }
}
