using std.net;

// tls/tls_stream.sun - TLS client connection over a TcpStream
//
// Certificate verification is always on: the peer must present a chain that
// validates against the system CA store (SSL_CTX_set_default_verify_paths,
// which also honors the SSL_CERT_FILE and SSL_CERT_DIR environment
// variables), and the certificate must match the hostname passed to
// connect(). SNI is always sent.
//
// Usage:
//   using std;
//   using tls;
//
//   var stream = TlsStream();
//   var host = String("example.com");
//   stream.connect(host, 443);
//   stream.send_str("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n");
//   var buf = ContiguousBuffer<u8>(global_allocator, 4096);
//   var n = stream.recv(buf);
//   stream.close();

/** Groups the tls declarations exported by this source file. */
public module tls {

  using std;

  // SSL_CTX_set_verify mode
  const SSL_VERIFY_PEER: i32 = 1;
  // SSL_ctrl command + argument implementing the SSL_set_tlsext_host_name
  // macro (SNI); values are ABI-stable OpenSSL constants.
  const SSL_CTRL_SET_TLSEXT_HOSTNAME: i32 = 55;
  const TLSEXT_NAMETYPE_HOST_NAME: i64 = 0;
  // SSL_get_verify_result success
  const X509_V_OK: i64 = 0;
  // SSL_get_error codes
  const SSL_ERROR_ZERO_RETURN: i32 = 6;
  const SSL_ERROR_SYSCALL: i32 = 5;
  const SSL_ERROR_SSL: i32 = 1;
  // ERR_GET_REASON(code) == code & 0x7FFFFF (OpenSSL 3.x packing)
  const OPENSSL_REASON_MASK: u64 = 8388607;
  // SSL_R_UNEXPECTED_EOF_WHILE_READING
  const SSL_REASON_UNEXPECTED_EOF: u64 = 294;

  /**
   * Error carrying the OpenSSL error-queue text (or the X.509 verification
   * failure reason) for the operation that failed.
   */
  public exception TlsError implements IError {
    var code_: i32;
    var text_: array<u8, 96> = [
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8
    ];
    var text_length_: i32 = 0;

    /** Copies and truncates the supplied diagnostic without allocating. */
    init(code: i32, message: static_ptr<u8>) {
      this.code_ = code;
      this.text_length_ = 0;
      for (var i: i64 = 0; i < message.length() and i < 96; i += 1) {
        this.text_[i] = unsafe { _load<u8>(message.raw(), i); };
        this.text_length_ += 1;
      }
    }

    /** Copies and truncates the supplied diagnostic without allocating. */
    init(code: i32, message: const ref String) {
      this.code_ = code;
      this.text_length_ = 0;
      for (var i: i64 = 0; i < message.length() and i < 96; i += 1) {
        this.text_[i] = unsafe { message.unsafe_at(i); };
        this.text_length_ += 1;
      }
    }

    /** Returns the numeric failure code. */
    public const method code() i32 {
      return this.code_;
    }

    /** Copies the bounded diagnostic into an explicitly requested owned string. */
    public const method message() String throws {
      var text = String("");
      for (var i: i64 = 0; i < _convert<i64>(this.text_length_); i += 1) {
        text.append_char(this.text_[i]);
      }
      return text;
    }
  }

  /**
   * The queued OpenSSL error as text, with a fallback for an empty queue.
   */
  function take_openssl_error(reason: i32, context: static_ptr<u8>) TlsError {
    var error = TlsError(reason, context);
    var code: u64 = unsafe { c_err_get_error(); };
    if (code == 0) {
      return error;
    }
    var buffer: array<u8, 128> = [
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8
    ];
    unsafe { c_err_error_string_n(code, _address_of<u8>(buffer[0]), 128); };
    if (error.text_length_ < 96) {
      error.text_[error.text_length_] = b':';
      error.text_length_ += 1;
    }
    if (error.text_length_ < 96) {
      error.text_[error.text_length_] = b' ';
      error.text_length_ += 1;
    }
    for (var i: i64 = 0; i < 128 and error.text_length_ < 96; i += 1) {
      if (buffer[i] == 0u8) {
        break;
      }
      error.text_[error.text_length_] = buffer[i];
      error.text_length_ += 1;
    }
    return error;
  }

  /**
   * A TLS client connection that starts empty and owns its socket and OpenSSL
   * handles. Closing or dropping it releases them in order.
   */
  public class TlsStream {
    var tcp: TcpStream = TcpStream();
    var ctx: raw_ptr<u8> = null;  // SSL_CTX*
    var ssl: raw_ptr<u8> = null;  // SSL*

    /** Closes the TLS session and releases the resources still owned by the stream. */
    deinit() {
      this.close();
    }

    /**
     * Resolve the host, connect, and complete a verified TLS handshake.
     */
    public method connect(host: ref String, port: i32) void throws {
      var host_bytes = host.c_str();
      try {
        this.tcp.connect_host(host, port);

        var method: raw_ptr<u8> = unsafe { c_tls_client_method(); };
        this.ctx = unsafe { c_ssl_ctx_new(method); };
        if (this.ctx == null) {
          throw take_openssl_error(-1, "SSL_CTX_new failed");
        }
        unsafe { c_ssl_ctx_set_verify(this.ctx, SSL_VERIFY_PEER, null); };
        if (unsafe { c_ssl_ctx_set_default_verify_paths(this.ctx); } != 1) {
          throw take_openssl_error(-1, "failed to load system CA store");
        }

        this.ssl = unsafe { c_ssl_new(this.ctx); };
        if (this.ssl == null) {
          throw take_openssl_error(-1, "SSL_new failed");
        }

        // Verify the certificate against this hostname, and send it as SNI.
        if (unsafe { c_ssl_set1_host(this.ssl, host_bytes); } != 1) {
          throw take_openssl_error(-1, "SSL_set1_host failed");
        }
        unsafe {
          c_ssl_ctrl(
            this.ssl,
            SSL_CTRL_SET_TLSEXT_HOSTNAME,
            TLSEXT_NAMETYPE_HOST_NAME,
            host_bytes
          );
        };

        if (unsafe { c_ssl_set_fd(this.ssl, this.tcp.get_fd()); } != 1) {
          throw take_openssl_error(-1, "SSL_set_fd failed");
        }

        if (unsafe { c_ssl_connect(this.ssl); } != 1) {
          // A failed verification is the most useful thing to report.
          var verify: i64 = unsafe { c_ssl_get_verify_result(this.ssl); };
          if (verify != X509_V_OK) {
            throw TlsError(_convert<i32>(verify), "certificate verification failed");
          }
          throw take_openssl_error(-1, "TLS handshake failed");
        }
      } catch {
        this.close();
        throw;
      }
      return;
    }

    /**
     * Send string data
     */
    public method send_str(data: static_ptr<u8>) i64 throws {
      return (this.send_bytes(data.raw(), data.length()));
    }

    /**
     * Send a String's bytes without allocating a terminating NUL.
     */
    public method send_string(data: ref String) i64 throws {
      return (this.send_bytes(data.bytes(), data.length()));
    }

    /**
     * Send raw bytes; on a blocking socket SSL_write writes everything or
     * fails.
     */
    public method send_bytes(data: raw_ptr<u8>, len: i64) i64 throws {
      var result: i32 = unsafe { c_ssl_write(this.ssl, data, _convert<i32>(len)); };
      if (result <= 0) {
        throw take_openssl_error(result, "TLS write failed");
      }
      return _convert<i64>(result);
    }

    /**
     * Receive into a ContiguousBuffer. Returns the byte count, or 0 once
     * the peer has closed the connection.
     */
    public method recv(buf: ref ContiguousBuffer<u8>) i64 throws {
      var result: i32 = unsafe {
        c_ssl_read(this.ssl, buf.raw_data(), _convert<i32>(buf.size()));
      };
      if (result > 0) {
        return _convert<i64>(result);
      }
      var reason: i32 = unsafe { c_ssl_get_error(this.ssl, result); };
      if (reason == SSL_ERROR_ZERO_RETURN) {
        return 0;  // clean TLS shutdown
      }
      // Peers commonly drop the socket without a close_notify. OpenSSL 1.1.1
      // reports that as a syscall error with an empty queue, 3.x as an SSL
      // error with the unexpected-eof reason. Both are end-of-stream here:
      // framed protocols (Content-Length, chunked) detect real truncation
      // above this layer.
      if (reason == SSL_ERROR_SYSCALL and unsafe { c_err_peek_error(); } == 0) {
        return 0;
      }
      if (reason == SSL_ERROR_SSL) {
        var peeked: u64 = unsafe { c_err_peek_error(); };
        if ((peeked & OPENSSL_REASON_MASK) == SSL_REASON_UNEXPECTED_EOF) {
          return 0;
        }
      }
      throw take_openssl_error(reason, "TLS read failed");
    }

    /**
     * Shut the session down and release the handles. Safe to call twice.
     */
    public method close() void {
      if (this.ssl != null) {
        unsafe { c_ssl_shutdown(this.ssl); };
        unsafe { c_ssl_free(this.ssl); };
        this.ssl = null;
      }
      if (this.ctx != null) {
        unsafe { c_ssl_ctx_free(this.ctx); };
        this.ctx = null;
      }
      this.tcp.close();
    }

    /** Reports whether this TLS stream still owns an open connection. */
    public method is_open() bool {
      return this.ssl != null;
    }
  }
}
