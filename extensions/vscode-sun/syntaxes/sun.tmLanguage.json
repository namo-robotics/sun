{
    "name": "Sun",
    "scopeName": "source.sun",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.sun",
                    "begin": "//",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.sun"
                        }
                    },
                    "end": "$"
                },
                {
                    "name": "comment.block.sun",
                    "begin": "/\\*",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.begin.sun"
                        }
                    },
                    "end": "\\*/",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.end.sun"
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.sun",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.sun",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.sun",
                    "match": "b?'(\\\\(u\\{[0-9a-fA-F]{1,6}\\}|x[0-9a-fA-F]{2}|.)|[^'\\\\])'",
                    "captures": {
                        "1": {
                            "name": "constant.character.escape.sun"
                        }
                    }
                },
                {
                    "name": "string.quoted.other.sun",
                    "begin": "`",
                    "end": "`",
                    "patterns": [
                        {
                            "name": "constant.character.escape.sun",
                            "match": "\\\\."
                        },
                        {
                            "begin": "\\$\\{",
                            "beginCaptures": {
                                "0": {
                                    "name": "punctuation.section.interpolation.begin.sun"
                                }
                            },
                            "end": "\\}",
                            "endCaptures": {
                                "0": {
                                    "name": "punctuation.section.interpolation.end.sun"
                                }
                            },
                            "contentName": "meta.embedded.expression.sun",
                            "patterns": [
                                {
                                    "include": "#interpolation-braces"
                                },
                                {
                                    "include": "$self"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.sun",
                    "match": "\\b\\d+(?:\\.\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.sun",
                    "match": "\\b(?:0x[0-9a-fA-F](?:_?[0-9a-fA-F])*|0b[01](?:_?[01])*|[0-9](?:_?[0-9])*)(?:[iu](?:8|16|32|64))?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.sun",
                    "match": "\\b(?:if|else|for|while|break|continue|match|return|try|catch|throw|throws|unsafe|using)\\b"
                },
                {
                    "name": "storage.type.sun",
                    "match": "\\b(?:module|manifest|test_function|function|packed_class|class|interface|enum|var)\\b"
                },
                {
                    "name": "storage.modifier.sun",
                    "match": "\\b(?:const|partial|declare|public|extern|implements)\\b"
                },
                {
                    "name": "storage.type.sun",
                    "match": "\\bmethod(?=\\s+[A-Za-z_])"
                },
                {
                    "name": "keyword.operator.word.sun",
                    "match": "\\b(?:and|or|not)\\b"
                },
                {
                    "name": "constant.language.sun",
                    "match": "\\b(?:true|false|null)\\b"
                },
                {
                    "name": "variable.language.sun",
                    "match": "\\bthis\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.sun",
                    "match": "\\b(?:void|bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|char|array|ref|ptr|raw_ptr|static_ptr)\\b"
                },
                {
                    "name": "entity.name.type.sun",
                    "match": "\\b(?:string|[A-Z][A-Za-z0-9_]*)\\b"
                },
                {
                    "name": "entity.name.type.parameter.sun",
                    "match": "'[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.sun",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:\\(|<[^;{}()]*>\\s*\\())"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(class|packed_class|interface|enum)\\s+([A-Za-z][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.sun"
                        },
                        "2": {
                            "name": "entity.name.type.sun"
                        }
                    }
                },
                {
                    "match": "\\b(module)\\s+([A-Za-z][A-Za-z0-9_.]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.sun"
                        },
                        "2": {
                            "name": "entity.name.namespace.sun"
                        }
                    }
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.readwrite.sun",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "interpolation-braces": {
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                {
                    "include": "#interpolation-braces"
                },
                {
                    "include": "$self"
                }
            ]
        }
    }
}
