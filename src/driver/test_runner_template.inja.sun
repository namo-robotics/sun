// test_runner_template.inja.sun - Source template for the synthesized test
// runner (see Driver::applyTestHandling). Embedded into the compiler at
// build time and rendered with inja: `tests` is the list of collected
// dotted test names, in declaration order.
//
// Every test runs through std.test.run_one, each on its own thread by
// default (spawn must stay an unqualified call: only those infer their type
// arguments today); "--test-sequential" in argv runs them inline instead,
// and "--test-filter <pattern>" (repeatable) picks which tests run at all.
// Results are reported in declaration order either way, so the output is
// deterministic.
using std;
using std.test;
using std.thread;

function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
    var alloc = make_heap_allocator();
    var total: i64 = 0;
    var failed: i64 = 0;
    if (wants_sequential(argc, argv)) {
        {% for test in tests %}
        if (is_selected("{{ test }}", argc, argv)) {
            total = total + 1;
            var r{{ loop.index }} = run_one("{{ test }}", {{ test }});
            if (report(r{{ loop.index }}) == false) { failed = failed + 1; }
        }
        {% endfor %}
    } else {
        var threads = Vec<Thread<TestResult>>(alloc, {{ length(tests) }});
        {% for test in tests %}
        if (is_selected("{{ test }}", argc, argv)) {
            threads.push(spawn(run_one, "{{ test }}", {{ test }}));
        }
        {% endfor %}
        total = threads.size();
        var i: i64 = 0;
        while (i < threads.size()) {
            try {
                var t = threads.take(i);
                var r = t.join();
                if (report(r) == false) { failed = failed + 1; }
            } catch (e: IError) {
                failed = failed + 1;
            }
            i = i + 1;
        }
    }
    return finish(total, failed);
}
