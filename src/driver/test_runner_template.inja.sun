// test_runner_template.inja.sun - Source template for the synthesized test
// runner (see Driver::applyTestHandling). Embedded into the compiler at
// build time and rendered with inja: `tests` is the list of collected
// dotted test names and runner adapters, in declaration order.
//
// Each test runs through its result adapter, on its own thread by
// default; "--test-sequential" in argv runs them inline instead,
// and "--test-filter <pattern>" (repeatable) picks which tests run at all.
// Results are reported in declaration order either way, so the output is
// deterministic.
using std;
using std.test;
using std.thread;

/** Runs the generated test cases and returns their combined exit status. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
    var alloc = make_heap_allocator();
    var total: i64 = 0;
    var failed: i64 = 0;
    if (wants_sequential(argc, argv)) {
        {% for test in tests %}
        if (is_selected("{{ test.name }}", argc, argv)) {
            total = total + 1;
            var r{{ loop.index }} = {{ test.runner }}("{{ test.name }}", {{ test.name }});
            if (report(r{{ loop.index }}) == false) { failed = failed + 1; }
        }
        {% endfor %}
    } else {
        var threads = Vec<Thread<TestResult>>(alloc, {{ length(tests) }});
        {% for test in tests %}
        if (is_selected("{{ test.name }}", argc, argv)) {
            threads.push(std.thread.spawn(() => TestResult { return {{ test.runner }}("{{ test.name }}", {{ test.name }}); }));
        }
        {% endfor %}
        total = threads.size();
        var i: i64 = 0;
        while (i < threads.size()) {
            match threads.get(i) {
                AccessResult.Ok(thread) => {
                    var result = thread.join();
                    if (report(result) == false) { failed = failed + 1; }
                },
                AccessResult.OutOfBounds(_) => { failed = failed + 1; }
            };
            i = i + 1;
        }
    }
    return finish(total, failed);
}
