// stdlib/map_tests.sun - Tests for map.sun.
// Replaces the C++ suite(s) Stdlib_Collections_Map.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /** Groups tests for the map library behavior. */
  module map_tests {
    /** Checks create empty map. */
    test_function create_empty_map() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      try std.test.assert_eq(m.size(), 0);
    }

    /** Checks insert and get. */
    test_function insert_and_get() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      try std.test.assert_eq(try std.test.expect_lookup_value(m.get(42)), 100);
    }

    /** Checks insert multiple and get. */
    test_function insert_multiple_and_get() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(1, 10);
      m.insert(2, 20);
      m.insert(3, 30);
      try std.test.assert_eq((try std.test.expect_lookup_value(m.get(1))) + (try std.test.expect_lookup_value(m.get(2))) + (try std.test.expect_lookup_value(m.get(3))), 60);
    }

    /** Checks update existing key. */
    test_function update_existing_key() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      m.insert(42, 200);
      try std.test.assert_eq(try std.test.expect_lookup_value(m.get(42)), 200);
    }

    /** Checks contains key. */
    test_function contains_key() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      try std.test.assert(m.contains(42));
      try std.test.assert(m.contains(99) == false);
    }

    /** Checks size tracking. */
    test_function size_tracking() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      try std.test.assert_eq(m.size(), 0);
      m.insert(1, 10);
      try std.test.assert_eq(m.size(), 1);
      m.insert(2, 20);
      try std.test.assert_eq(m.size(), 2);
      m.insert(1, 15);  // Update, not new
      try std.test.assert_eq(m.size(), 2);
    }

    /** Checks get or default found. */
    test_function get_or_default_found() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      var fallback: i32 = -1;
      try std.test.assert_eq(m.get_or_default(42, fallback), 100);
    }

    /** Checks get or default not found. */
    test_function get_or_default_not_found() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      var fallback: i32 = -1;
      try std.test.assert_eq(m.get_or_default(99, fallback), -1);
    }

    /** Checks remove existing. */
    test_function remove_existing() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      var removed: i32 = try std.test.expect_lookup(m.remove(42));
      try std.test.assert_eq(removed, 100);
      try std.test.assert_eq(m.size(), 0);
    }

    /** Checks remove then contains. */
    test_function remove_then_contains() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      try std.test.expect_lookup(m.remove(42));
      try std.test.assert(m.contains(42) == false);
    }

    /** Checks remove and reinsert. */
    test_function remove_and_reinsert() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      try std.test.expect_lookup(m.remove(42));
      m.insert(42, 200);
      try std.test.assert_eq(try std.test.expect_lookup_value(m.get(42)), 200);
    }

    /** Checks clear. */
    test_function clear() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(1, 10);
      m.insert(2, 20);
      m.insert(3, 30);
      m.clear();
      try std.test.assert_eq(m.size(), 0);
      try std.test.assert(m.contains(1) == false);
    }

    /** Checks auto grow. */
    test_function auto_grow() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      // Insert past the initial capacity to force a resize.
      for (var i: i64 = 0; i < 20; i = i + 1) {
        m.insert(i, _convert<i32>(i) * 10);
      }
      var sum: i32 = 0;
      for (var i: i64 = 0; i < 20; i = i + 1) {
        sum = sum + (try std.test.expect_lookup_value(m.get(i)));
      }
      // 10 * (0 + 1 + ... + 19) = 1900
      try std.test.assert_eq(sum, 1900);
    }

    /** Checks many elements. */
    test_function many_elements() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      for (var i: i64 = 0; i < 100; i = i + 1) {
        m.insert(i, 1);
      }
      var sum: i32 = 0;
      for (var i: i64 = 0; i < 100; i = i + 1) {
        sum = sum + (try std.test.expect_lookup_value(m.get(i)));
      }
      try std.test.assert_eq(sum, 100);
      try std.test.assert_eq(m.size(), 100);
    }

    /** Checks custom capacity. */
    test_function custom_capacity() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 64);
      try std.test.assert_eq(m.capacity(), 64);
    }

    /** Checks get missing key throws. */
    test_function get_missing_key_throws() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      match m.get(99) {
        LookupResult.Ok(matched_value) => {
          var val: i32 = matched_value;
          try std.test.fail("expected error");
        },
        LookupResult.NotFound(e) => {}
      };
    }

    /** Checks remove missing key throws. */
    test_function remove_missing_key_throws() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(42, 100);
      match m.remove(99) {
        LookupResult.Ok(matched_value) => {
          var val: i32 = matched_value;
          try std.test.fail("expected error");
        },
        LookupResult.NotFound(e) => {}
      };
    }

    /** Checks hash collision handling. */
    test_function hash_collision_handling() {
      var allocator = make_heap_allocator();
      // Small capacity to force keys into the same bucket.
      var m = Map<i64, i32>(allocator, 4);
      m.insert(0, 1);
      m.insert(4, 2);
      m.insert(8, 3);
      m.insert(12, 4);
      try std.test.assert_eq((try std.test.expect_lookup_value(m.get(0))) + (try std.test.expect_lookup_value(m.get(4))) + (try std.test.expect_lookup_value(m.get(8))) + (try std.test.expect_lookup_value(m.get(12))), 10);
    }

    /** Checks iteration sum values. */
    test_function iteration_sum_values() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(1, 10);
      m.insert(2, 20);
      m.insert(3, 30);
      var sum: i32 = 0;
      for (var v: i32 in m) {
        sum = sum + v;
      }
      try std.test.assert_eq(sum, 60);
    }

    /** Checks iteration empty map. */
    test_function iteration_empty_map() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      var count: i32 = 0;
      for (var v: i32 in m) {
        count = count + 1;
      }
      try std.test.assert_eq(count, 0);
    }
  }  // module map_tests
}  // module std
