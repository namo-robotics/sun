// stdlib/env.sun - Owned snapshots of the process environment.

public module std {
  public module env {
    // Guards every touch of the native environment. setenv and unsetenv may
    // reallocate the environ array, so a thread walking it while another
    // thread mutates it reads freed memory. All Sun-side access goes through
    // this lock; C libraries calling getenv directly remain unguarded.
    var native_lock: std.thread.Mutex = std.thread.Mutex();

    /*
     * One owned name/value pair from the process environment.
     */
    public class EnvEntry {
      var name_: String;
      var value_: String;

      /*
       * Copy one native NAME=VALUE entry, splitting only at the first equals.
       */
      init(allocator: const ref HeapAllocator, raw: raw_ptr<u8>) {
        this.name_ = String(allocator, "");
        this.value_ = String(allocator, "");
        var in_value: bool = false;
        var index: i64 = 0;
        var done: bool = raw == null;
        while (not done) {
          var byte: u8 = unsafe { _load<u8>(raw, index); };
          if (byte == 0) {
            done = true;
          } else {
            if (not in_value and byte == b'=') {
              in_value = true;
            } else {
              if (in_value) {
                this.value_.append_char(byte);
              } else {
                this.name_.append_char(byte);
              }
            }
            index = index + 1;
          }
        }
      }

      /*
       * Borrow this entry's name.
       */
      public const method name() ref String {
        return this.name_;
      }

      /*
       * Borrow this entry's value.
       */
      public const method value() ref String {
        return this.value_;
      }
    }

    /*
     * An owned snapshot of the process environment in native order.
     */
    public class Env implements IIterable<ref EnvEntry, Env> {
      var alloc: HeapAllocator;
      var entries: Vec<EnvEntry>;

      /*
       * Capture the current process environment.
       */
      init(allocator: const ref HeapAllocator) {
        this.alloc = allocator.copy();
        this.entries = Vec<EnvEntry>(allocator, 16);
        this.refresh();
      }

      /*
       * Rebuild the snapshot from the native environment.
       */
      public method refresh() void {
        var guard = native_lock.acquire();
        this.refresh_locked();
      }

      /*
       * Rebuild the snapshot; the caller must hold native_lock.
       */
      method refresh_locked() void {
        this.entries.clear();
        var native: raw_ptr<raw_ptr<u8>> = environment_ptr();
        if (native == null) {
          return;
        }
        var index: i64 = 0;
        var done: bool = false;
        while (not done) {
          var raw: raw_ptr<u8> = unsafe { _load<raw_ptr<u8>>(native, index); };
          if (raw == null) {
            done = true;
          } else {
            this.entries.push(EnvEntry(this.alloc, raw));
            index = index + 1;
          }
        }
      }

      /*
       * Return the first value whose name matches a literal.
       */
      public method get(name: static_ptr<u8>) Option<ref String> {
        for (var index: i64 = 0; index < this.entries.size(); index = index + 1) {
          var entry: ref EnvEntry = this.entries.get_unchecked(index);
          if (entry.name().equals_literal(name)) {
            return Option.Some(entry.value());
          }
        }
        return Option.None;
      }

      /*
       * Return the first value whose name matches a String.
       */
      public method get(name: ref String) Option<ref String> {
        for (var index: i64 = 0; index < this.entries.size(); index = index + 1) {
          var entry: ref EnvEntry = this.entries.get_unchecked(index);
          if (entry.name().equals(name)) {
            return Option.Some(entry.value());
          }
        }
        return Option.None;
      }

      /*
       * Report whether a literal name appears in the snapshot.
       */
      public method has(name: static_ptr<u8>) bool {
        for (var index: i64 = 0; index < this.entries.size(); index = index + 1) {
          if (this.entries.get_unchecked(index).name().equals_literal(name)) {
            return true;
          }
        }
        return false;
      }

      /*
       * Report whether a String name appears in the snapshot.
       */
      public method has(name: ref String) bool {
        for (var index: i64 = 0; index < this.entries.size(); index = index + 1) {
          if (this.entries.get_unchecked(index).name().equals(name)) {
            return true;
          }
        }
        return false;
      }

      /*
       * Set a native variable and synchronize this snapshot.
       */
      method set_cstr(name: raw_ptr<u8>, value: raw_ptr<u8>) void throws IError {
        var guard = native_lock.acquire();
        if (unsafe { c_setenv(name, value, 1); } != 0) {
          throw Error(errno(), "failed to set environment variable");
        }
        this.refresh_locked();
      }

      /*
       * Set a literal name and literal value.
       */
      public method set(name: static_ptr<u8>, value: static_ptr<u8>) void throws IError {
        this.set_cstr(name.raw(), value.raw());
      }

      /*
       * Set a literal name and String value.
       */
      public method set(name: static_ptr<u8>, value: ref String) void throws IError {
        this.set_cstr(name.raw(), value.c_str());
      }

      /*
       * Set a String name and literal value.
       */
      public method set(name: ref String, value: static_ptr<u8>) void throws IError {
        this.set_cstr(name.c_str(), value.raw());
      }

      /*
       * Set a String name and String value.
       */
      public method set(name: ref String, value: ref String) void throws IError {
        this.set_cstr(name.c_str(), value.c_str());
      }

      /*
       * Remove a native variable and synchronize this snapshot.
       */
      method remove_cstr(name: raw_ptr<u8>) void throws IError {
        var guard = native_lock.acquire();
        if (unsafe { c_unsetenv(name); } != 0) {
          throw Error(errno(), "failed to unset environment variable");
        }
        this.refresh_locked();
      }

      /*
       * Remove a variable named by a literal.
       */
      public method remove(name: static_ptr<u8>) void throws IError {
        this.remove_cstr(name.raw());
      }

      /*
       * Remove a variable named by a String.
       */
      public method remove(name: ref String) void throws IError {
        this.remove_cstr(name.c_str());
      }

      /*
       * Return the number of captured native entries.
       */
      public const method size() i64 {
        return this.entries.size();
      }

      /*
       * Report whether the snapshot contains no entries.
       */
      public const method is_empty() bool {
        return this.entries.is_empty();
      }

      /*
       * Create an iterator at the start of the snapshot.
       */
      public const method iter() EnvIterator {
        return EnvIterator();
      }

      /*
       * Borrow an entry without checking its index.
       */
      const method entry_unchecked(index: i64) ref EnvEntry {
        return this.entries.get_unchecked(index);
      }

      /*
       * Copy the current working directory into this Env's allocator.
       */
      public method cwd() String throws IError {
        var buf: ContiguousBuffer<u8> = ContiguousBuffer<u8>(this.alloc, 4096);
        var got: raw_ptr<u8> = unsafe { c_getcwd(buf.raw_data(), 4096); };
        if (got == null) {
          throw Error(errno(), "failed to read working directory");
        }
        return from_c_str(this.alloc, got);
      }

      /*
       * Change the working directory to a literal path.
       */
      public method set_cwd(path: static_ptr<u8>) void throws IError {
        if (unsafe { c_chdir(path.raw()); } != 0) {
          throw Error(errno(), "failed to change working directory");
        }
      }

      /*
       * Change the working directory to a String path.
       */
      public method set_cwd(path: ref String) void throws IError {
        if (unsafe { c_chdir(path.c_str()); } != 0) {
          throw Error(errno(), "failed to change working directory");
        }
      }

      /*
       * Copy argv, including argv[0], into owned Strings.
       */
      public method args(argc: i32, argv: raw_ptr<raw_ptr<i8>>) Vec<String> {
        var out: Vec<String> = Vec<String>(this.alloc, _convert<i64>(argc));
        if (argv == null) {
          return out;
        }
        for (var index: i64 = 0; index < _convert<i64>(argc); index = index + 1) {
          var arg: raw_ptr<u8> = unsafe { _load<raw_ptr<u8>>(argv, index); };
          out.push(from_c_str(this.alloc, arg));
        }
        return out;
      }
    }

    /** Iterates over borrowed environment entries from the beginning. */
    public class EnvIterator implements IIterator<ref EnvEntry, Env> {
      var current: i64 = 0;

      /*
       * Borrow the next entry, or return None at the end.
       */
      public method next(environment: ref Env) Option<ref EnvEntry> {
        if (this.current >= environment.size()) {
          return Option.None;
        }
        var index: i64 = this.current;
        this.current = this.current + 1;
        return Option.Some(environment.entry_unchecked(index));
      }
    }
  }
}
