// stdlib/env.sun - Environment variables, working directory, program arguments
//
// Usage:
//   using sun.env;
//
//   var home = match get(alloc, "HOME") {
//       Option.Some(p) => p,
//       Option.None => String(alloc, "/")
//   };

public module sun {
  public module env {
    // The value of an environment variable, or None if it is not set.
    public function get(alloc: ref HeapAllocator, name: raw_ptr<u8>) Option<String> {
      var value: raw_ptr<u8> = unsafe { c_getenv(name); };
      if (value == null) {
        return Option.None;
      }
      return Option.Some(from_c_str(alloc, value));
    }

    // Is the variable set, whatever its value?
    public function has(name: raw_ptr<u8>) bool {
      return unsafe { c_getenv(name); } != null;
    }

    // Set a variable, replacing any existing value.
    public function set(name: raw_ptr<u8>, value: raw_ptr<u8>) void, IError {
      if (unsafe { c_setenv(name, value, 1); } != 0) {
        throw Error(errno(), "failed to set environment variable");
      }
    }

    // Remove a variable. Removing one that is not set is not an error.
    public function remove(name: raw_ptr<u8>) void, IError {
      if (unsafe { c_unsetenv(name); } != 0) {
        throw Error(errno(), "failed to unset environment variable");
      }
    }

    // The program's arguments, argv[0] first.
    //
    // argc and argv come from main; there is no way to discover them without
    // being handed them. Under the JIT the process is the compiler, so its own
    // argv is not the script's:
    //
    //   function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
    //       var a = make_heap_allocator();
    //       var cli = args(a, argc, argv);
    //       ...
    //   }
    public function args(alloc: ref HeapAllocator, argc: i32,
                         argv: raw_ptr<raw_ptr<i8>>) Vec<String> {
      var out: Vec<String> = Vec<String>(alloc, _convert<i64>(argc));
      if (argv == null) {
        return out;
      }
      for (var i: i64 = 0; i < _convert<i64>(argc); i = i + 1) {
        var arg: raw_ptr<u8> = unsafe { _load<raw_ptr<u8>>(argv, i); };
        out.push(from_c_str(alloc, arg));
      }
      return out;
    }

    // The current working directory.
    public function cwd(alloc: ref HeapAllocator) String, IError {
      var buf: ContiguousBuffer<u8> = ContiguousBuffer<u8>(alloc, 4096);
      var got: raw_ptr<u8> = unsafe { c_getcwd(buf.rawData(), 4096); };
      if (got == null) {
        throw Error(errno(), "failed to read working directory");
      }
      return from_c_str(alloc, got);
    }

    // Change the working directory. Process-wide, and it outlives the call —
    // anything resolving a relative path afterwards sees the new one.
    public function set_cwd(path: raw_ptr<u8>) void, IError {
      if (unsafe { c_chdir(path); } != 0) {
        throw Error(errno(), "failed to change working directory");
      }
    }
  }  // module sun.env
}
