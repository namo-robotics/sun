// stdlib/env.sun - Environment variables, working directory, program arguments
//
// Usage:
//   using std.env;
//
//   var home = match get(alloc, "HOME") {
//       Option.Some(p) => p,
//       Option.None => String(alloc, "/")
//   };

public module std {
  public module env {
    // Read a variable named by a C string, copying the value into a new String.
    // None when the variable is not set.
    function get_cstr(alloc: ref HeapAllocator, name: raw_ptr<u8>) Option<String> {
      var value: raw_ptr<u8> = unsafe { c_getenv(name); };
      if (value == null) {
        return Option.None;
      }
      return Option.Some(from_c_str(alloc, value));
    }

    // The value of an environment variable, or None if it is not set.
    public function get(alloc: ref HeapAllocator, name: static_ptr<u8>) Option<String> {
      return get_cstr(alloc, name.raw());
    }

    // Read a variable's value, or None when it is not set. The result is a copy,
    // so it survives a later change to the environment.
    public function get(alloc: ref HeapAllocator, name: ref String) Option<String> {
      return get_cstr(alloc, name.c_str());
    }

    // Is the variable set, whatever its value?
    public function has(name: static_ptr<u8>) bool {
      return unsafe { c_getenv(name.raw()); } != null;
    }

    // Report whether a variable is set, without copying its value.
    public function has(name: ref String) bool {
      return unsafe { c_getenv(name.c_str()); } != null;
    }

    // Set a variable from C strings. Throws if the name is empty or contains '='.
    function set_cstr(name: raw_ptr<u8>, value: raw_ptr<u8>) void throws IError {
      if (unsafe { c_setenv(name, value, 1); } != 0) {
        throw Error(errno(), "failed to set environment variable");
      }
    }

    // Set a variable, replacing any existing value.
    public function set(name: static_ptr<u8>, value: static_ptr<u8>) void throws IError {
      set_cstr(name.raw(), value.raw());
    }

    // Set a variable named by a literal to a value built at runtime.
    public function set(name: static_ptr<u8>, value: ref String) void throws IError {
      set_cstr(name.raw(), value.c_str());
    }

    // Set a variable named at runtime to a literal value.
    public function set(name: ref String, value: static_ptr<u8>) void throws IError {
      set_cstr(name.c_str(), value.raw());
    }

    // Set a variable, both name and value built at runtime.
    public function set(name: ref String, value: ref String) void throws IError {
      set_cstr(name.c_str(), value.c_str());
    }

    // Remove a variable. Removing one that is not set is not an error.
    public function remove(name: static_ptr<u8>) void throws IError {
      if (unsafe { c_unsetenv(name.raw()); } != 0) {
        throw Error(errno(), "failed to unset environment variable");
      }
    }

    // Unset a variable. Removing one that was never set is not an error.
    public function remove(name: ref String) void throws IError {
      if (unsafe { c_unsetenv(name.c_str()); } != 0) {
        throw Error(errno(), "failed to unset environment variable");
      }
    }

    // The program's arguments, argv[0] first.
    //
    // argc and argv come from main; there is no way to discover them without
    // being handed them. Under the JIT the process is the compiler, so its own
    // argv is not the script's:
    //
    //   function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
    //       var a = make_heap_allocator();
    //       var cli = collect_args(a, argc, argv);
    //       ...
    //   }
    public function collect_args(alloc: ref HeapAllocator, argc: i32, argv: raw_ptr<raw_ptr<i8>>) Vec<String> {
      var out: Vec<String> = Vec<String>(alloc, _convert<i64>(argc));
      if (argv == null) {
        return out;
      }
      for (var i: i64 = 0; i < _convert<i64>(argc); i = i + 1) {
        var arg: raw_ptr<u8> = unsafe { _load<raw_ptr<u8>>(argv, i); };
        out.push(from_c_str(alloc, arg));
      }
      return out;
    }

    // The current working directory.
    public function get_cwd(alloc: ref HeapAllocator) String throws IError {
      var buf: ContiguousBuffer<u8> = ContiguousBuffer<u8>(alloc, 4096);
      var got: raw_ptr<u8> = unsafe { c_getcwd(buf.raw_data(), 4096); };
      if (got == null) {
        throw Error(errno(), "failed to read working directory");
      }
      return from_c_str(alloc, got);
    }

    // Change the working directory. Process-wide, and it outlives the call —
    // anything resolving a relative path afterwards sees the new one.
    public function set_cwd(path: static_ptr<u8>) void throws IError {
      if (unsafe { c_chdir(path.raw()); } != 0) {
        throw Error(errno(), "failed to change working directory");
      }
    }

    // Change the working directory to a path built at runtime.
    public function set_cwd(path: ref String) void throws IError {
      if (unsafe { c_chdir(path.c_str()); } != 0) {
        throw Error(errno(), "failed to change working directory");
      }
    }
  }  // module std.env
}
