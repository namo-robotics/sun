// stdlib/string_tests.sun - Tests for string.sun.
// Replaces the C++ suite(s) Stdlib_Text_String.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /** Groups tests for the string library behavior. */
  module string_tests {
    /** Combines assertion failures with errors from borrowed reads. */
    enum TestError { Assertion(std.test.AssertionError), Read(IndexOutOfBoundsError) }

    /**
     * True when appending x as f64 text produces exactly the expected bytes.
     */
    function check_f64(alloc: const ref HeapAllocator, x: f64, expected: static_ptr<u8>) bool {
      var s = String(alloc, "");
      s.append_f64(x);
      return s.equals_literal(expected);
    }

    /**
     * Parse text as an i64, or hand back the fallback when parsing fails.
     */
    function parse_int_or(alloc: const ref HeapAllocator, text: static_ptr<u8>, fallback: i64) i64 {
      var s = String(alloc, text);
      return match s.parse_i64() {
        Option.Some(v) => v,
        Option.None => fallback
      };
    }

    /**
     * Parse text as an f64, or hand back the fallback when parsing fails.
     */
    function parse_float_or(alloc: const ref HeapAllocator, text: static_ptr<u8>, fallback: f64) f64 {
      var s = String(alloc, text);
      return match s.parse_f64() {
        Option.Some(v) => v,
        Option.None => fallback
      };
    }

    /**
     * Byte index of the needle in s, or -1 when absent.
     */
    function find_index(s: const ref String, needle: static_ptr<u8>) i64 {
      return match s.find(needle) {
        Option.Some(i) => i,
        Option.None => -1
      };
    }

    /** Return an owned short string so callers exercise a move out of a frame. */
    function returned_short_string() String {
      return String("short text");
    }

    /** Check returned inline storage survives container relocation and extraction. */
    test_function inline_string_moves_and_vec_relocation() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var values = Vec<String>(alloc, 1);
      values.push(returned_short_string());
      for (var i: i64 = 0; i < 100; i = i + 1) {
        values.push(`${i}`);
      }
      try std.test.assert((try values.get(0)).equals_literal("short text"));
      var moved = try std.test.expect_access(values.remove(0));
      try std.test.assert(moved.equals_literal("short text"));
      try std.test.assert((try values.get(0)).equals_literal("0"));
      try std.test.assert((try values.get(99)).equals_literal("99"));
      var view = moved[0:5];
      try std.test.assert(view.equals_literal("short"));
    }

    /** Clones the first string before releasing the borrow of its container. */
    function clone_first(values: ref Vec<String>, alloc: const ref HeapAllocator) _Result<String, IndexOutOfBoundsError> {
      var value: ref String = try values.get(0);
      return _Result.Ok(value.clone(alloc));
    }

    /** Replacing heap and inline strings repeatedly preserves unique ownership. */
    test_function inline_heap_replacement_and_clone() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var values = Vec<String>(alloc, 1);
      values.push(returned_short_string());
      for (var i: i64 = 0; i < 100; i = i + 1) {
        try std.test.expect_access_success(values.set(0, String("a long string that must use independently owned heap storage")));
        var copied = try clone_first(values, alloc);
        try std.test.expect_access_success(values.set(0, returned_short_string()));
        try std.test.assert(copied.equals_literal("a long string that must use independently owned heap storage"));
        try std.test.assert((try values.get(0)).equals_literal("short text"));
      }
      var short_copy = try clone_first(values, alloc);
      try std.test.expect_access_success(values.set(0, String("replacement")));
      try std.test.assert(short_copy.equals_literal("short text"));
    }

    /** Filling inline storage and adding a terminator preserves every byte. */
    test_function inline_capacity_boundary_and_c_string() _Result<void, std.string_tests.TestError> {
      var s = String("");
      var initial_capacity = s.capacity();
      for (var i: i64 = 0; i < initial_capacity; i = i + 1) {
        s.append_char(b'x');
      }
      try std.test.assert_eq(s.capacity(), initial_capacity);
      var c = s.c_str();
      try std.test.assert_eq(s.length(), initial_capacity);
      try std.test.assert(s.capacity() > initial_capacity);
      for (var i: i64 = 0; i < initial_capacity; i = i + 1) {
        try std.test.assert_eq(try std.test.expect_access(s.at(i)), b'x');
      }
      try std.test.assert_eq(unsafe { _load<u8>(c, initial_capacity); }, 0u8);
      s.append_literal("end");
      try std.test.assert(s.ends_with("end"));
      s.reserve(s.capacity() * 2);
      try std.test.assert_eq(try std.test.expect_access(s.at(0)), b'x');
      try std.test.assert(s.ends_with("end"));
    }

    /** Verify decimal widths and values immediately around each power of ten. */
    test_function decimal_power_boundaries() _Result<void, std.string_tests.TestError> {
      var power: i64 = 1;
      for (var exponent: i64 = 0; exponent < 19; exponent = exponent + 1) {
        for (var delta: i64 = -1; delta <= 1; delta = delta + 1) {
          var value = power + delta;
          var s = String("");
          s.append_i64(value);
          var valid = match s.parse_i64() {
            Option.Some(parsed) => parsed == value,
            Option.None => false
          };
          try std.test.assert(valid, "decimal boundary did not round trip");
          var expected_length = exponent + 1;
          if (delta == -1 and exponent > 0) {
            expected_length = exponent;
          }
          try std.test.assert_eq(s.length(), expected_length);
        }
        if (exponent < 18) {
          power = power * 10;
        }
      }
      var prefixed = String("a prefix near the inline storage boundary: ");
      prefixed.append_u64(18446744073709551615u64);
      prefixed.append_i64(-9223372036854775808i64);
      try std.test.assert(prefixed.equals_literal("a prefix near the inline storage boundary: 18446744073709551615-9223372036854775808"));
    }

    /** Checks construct from literal. */
    test_function construct_from_literal() _Result<void, std.string_tests.TestError> {
      var allocator = make_heap_allocator();
      var s = String(allocator, "Hello");
      try std.test.assert_eq(s.length(), 5);
    }

    /** Checks construct empty. */
    test_function construct_empty() _Result<void, std.string_tests.TestError> {
      var allocator = make_heap_allocator();
      var s = String(allocator, "");
      try std.test.assert_eq(s.length(), 0);
    }

    /** Checks construct from buffer. */
    test_function construct_from_buffer() _Result<void, std.string_tests.TestError> {
      var allocator = make_heap_allocator();
      var buf = ContiguousBuffer<u8>(allocator, 10);
      // Write "Hi" (72, 105) to the buffer
      unsafe { buf.set_unchecked(0, 72); };
      unsafe { buf.set_unchecked(1, 105); };
      var s = try std.test.expect_ok(String(allocator, buf, 2));
      try std.test.assert_eq(s.length(), 2);
      var h: i64 = try std.test.expect_access(s.at(0));
      try std.test.assert_eq(h, 72);
      var i: i64 = try std.test.expect_access(s.at(1));
      try std.test.assert_eq(i, 105);
    }

    /** Reject a negative copy length before constructing owned storage. */
    test_function construct_from_buffer_rejects_negative_length() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var buffer = ContiguousBuffer<u8>(alloc, 1);
      var caught = false;
      match String(alloc, buffer, -1) {
        _Result.Ok(_) => {},
        _Result.Err(e) => {
          caught = true;
          try std.test.assert_eq(e.code(), 3);
        }
      };
      try std.test.assert(caught);
    }

    /** Checks at access. */
    test_function at_access() _Result<void, std.string_tests.TestError> {
      var allocator = make_heap_allocator();
      var s = String(allocator, "ABCDE");
      var a: i64 = try std.test.expect_access(s.at(0));
      var c: i64 = try std.test.expect_access(s.at(2));
      var e: i64 = try std.test.expect_access(s.at(4));
      try std.test.assert_eq(a, 65);
      try std.test.assert_eq(c, 67);
      try std.test.assert_eq(e, 69);
    }

    /** Checks set at modify. */
    test_function set_at_modify() _Result<void, std.string_tests.TestError> {
      var allocator = make_heap_allocator();
      var s = String(allocator, "Hello");
      // Change 'H' (72) to 'J' (74)
      try std.test.expect_access_success(s.set_at(0, 74));
      var ch: i64 = try std.test.expect_access(s.at(0));
      try std.test.assert_eq(ch, 74);
    }

    /** Checks checked access rejects indices outside length. */
    test_function checked_access_rejects_indices_outside_length() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "abc");
      s.reserve(32);
      var indices: array<i64, 4> = [-1i64, 3i64, 4i64, 9223372036854775807i64];
      for (var j: i64 = 0; j < indices.dim(0); j = j + 1) {
        var caught_read = false;
        match s.at(indices[j]) {
          AccessResult.Ok(_) => {},
          AccessResult.OutOfBounds(e) => {
            caught_read = true;
            try std.test.assert_eq(e.code(), 3);
          }
        };
        try std.test.assert(caught_read, "invalid read must throw");
        var caught_write = false;
        match s.set_at(indices[j], b'X') {
          AccessResult.Ok => {},
          AccessResult.OutOfBounds(e) => {
            caught_write = true;
            try std.test.assert_eq(e.code(), 3);
          }
        };
        try std.test.assert(caught_write, "invalid write must throw");
      }
      try std.test.assert(s.equals_literal("abc"));
    }

    /** Checks empty string has no valid index. */
    test_function empty_string_has_no_valid_index() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "");
      var caught = false;
      match s.at(0) {
        AccessResult.Ok(_) => {},
        AccessResult.OutOfBounds(e) => {
          caught = true;
        }
      };
      try std.test.assert(caught);
      caught = false;
      match s.set_at(0, b'X') {
        AccessResult.Ok => {},
        AccessResult.OutOfBounds(e) => {
          caught = true;
        }
      };
      try std.test.assert(caught);
    }

    /** Checks unsafe access with valid indices. */
    test_function unsafe_access_with_valid_indices() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "abc");
      unsafe { s.unsafe_set_at(2, b'Z'); };
      try std.test.assert_eq(unsafe { s.unsafe_at(2); }, b'Z');
      try std.test.assert(s.equals_literal("abZ"));
    }

    /** Checks view access checks its own length. */
    test_function view_access_checks_its_own_length() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "abcd");
      var view = s[1:3];
      try std.test.assert_eq(try std.test.expect_access(view.at(0)), b'b');
      var caught = false;
      match view.at(2) {
        AccessResult.Ok(_) => {},
        AccessResult.OutOfBounds(e) => {
          caught = true;
        }
      };
      try std.test.assert(caught);
    }

