    /** Checks append f64 shortest round trip. */
    test_function append_f64_shortest_round_trip() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      try std.test.assert(check_f64(alloc, 0.1, "0.1"), "0.1");
      try std.test.assert(check_f64(alloc, 1.5, "1.5"), "1.5");
      try std.test.assert(check_f64(alloc, 100.0, "100"), "100");
      try std.test.assert(check_f64(alloc, 1e21, "1e+21"), "1e+21");
      try std.test.assert(check_f64(alloc, -2.5e-7, "-2.5e-07"), "-2.5e-07");
      try std.test.assert(check_f64(alloc, 3.141592653589793, "3.141592653589793"), "pi");
      try std.test.assert(check_f64(alloc, 1.0 / 3.0, "0.3333333333333333"), "one third");
      try std.test.assert(check_f64(alloc, -0.0, "-0"), "-0");
      var f: f32 = 2.5;
      var s = String(alloc, "");
      s.append(f);
      s.append(0.25);
      try std.test.assert(s.equals_literal("2.50.25"), "f32 and f64 append");
    }

    /** Checks parse i64 and parse f64. */
    test_function parse_i64_and_parse_f64() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      try std.test.assert_eq(parse_int_or(alloc, "42", -1), 42);
      try std.test.assert_eq(parse_int_or(alloc, "-42", -1), -42);
      try std.test.assert_eq(parse_int_or(alloc, "9223372036854775807", -1), 9223372036854775807);
      try std.test.assert_eq(parse_int_or(alloc, "-9223372036854775808", -1), -9223372036854775807 - 1);
      try std.test.assert_eq(parse_int_or(alloc, "9223372036854775808", -1), -1);
      try std.test.assert_eq(parse_int_or(alloc, "12a", -1), -1);
      try std.test.assert_eq(parse_int_or(alloc, "", -1), -1);
      try std.test.assert_eq(parse_int_or(alloc, "-", -1), -1);
      try std.test.assert_eq(parse_int_or(alloc, "1.5", -1), -1);
      try std.test.assert_eq(parse_float_or(alloc, "1.5", 0.0), 1.5);
      try std.test.assert_eq(parse_float_or(alloc, "-2.5e3", 0.0), -2500.0);
      try std.test.assert_eq(parse_float_or(alloc, "7", 0.0), 7.0);
      try std.test.assert_eq(parse_float_or(alloc, "0.1", 0.0), 0.1);
      try std.test.assert_eq(parse_float_or(alloc, "abc", -1.0), -1.0);
      try std.test.assert_eq(parse_float_or(alloc, "1e", -1.0), -1.0);
      try std.test.assert_eq(parse_float_or(alloc, "1.5x", -1.0), -1.0);
      try std.test.assert_eq(parse_float_or(alloc, ".", -1.0), -1.0);
    }

    /** Checks to lower and to upper. */
    test_function to_lower_and_to_upper() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "Hello, World 42!");
      s.to_lower();
      try std.test.assert(s.equals_literal("hello, world 42!"), "to_lower");
      s.to_upper();
      try std.test.assert(s.equals_literal("HELLO, WORLD 42!"), "to_upper");
      // Case conversion of a single byte keeps the u8 type
      var ch: u8 = 65;
      var lowered: u8 = ch + 32;
      var one = String(alloc, "");
      one.append_char(lowered);
      try std.test.assert(one.equals_literal("a"), "byte case conversion");
    }

    /** Checks trim variants. */
    test_function trim_variants() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "  \t hi \n ");
      s.trim();
      try std.test.assert(s.equals_literal("hi"), "trim both ends");

      var lead = String(alloc, "  hi  ");
      lead.trim_start();
      try std.test.assert(lead.equals_literal("hi  "), "trim_start");

      var trail = String(alloc, "  hi  ");
      trail.trim_end();
      try std.test.assert(trail.equals_literal("  hi"), "trim_end");

      var blank = String(alloc, "   ");
      blank.trim();
      try std.test.assert(blank.is_empty(), "trim all-whitespace");

      var none = String(alloc, "hi");
      none.trim();
      try std.test.assert(none.equals_literal("hi"), "trim nothing to remove");
    }

    /** Checks find and contains. */
    test_function find_and_contains() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "hello world");
      try std.test.assert_eq(find_index(s, "hello"), 0);
      try std.test.assert_eq(find_index(s, "world"), 6);
      try std.test.assert_eq(find_index(s, "o w"), 4);
      try std.test.assert_eq(find_index(s, "worlds"), -1);
      try std.test.assert_eq(find_index(s, ""), 0);
      try std.test.assert(s.contains("lo wo"), "contains literal");
      try std.test.assert(not s.contains("xyz"), "missing literal");

      var needle = String(alloc, "wor");
      try std.test.assert(s.contains(needle), "contains String");
      var missing = String(alloc, "cat");
      try std.test.assert(not s.contains(missing), "missing String");
      try std.test.assert(s.starts_with(String(alloc, "hell")), "starts_with String");
      try std.test.assert(s.ends_with(String(alloc, "rld")), "ends_with String");
      try std.test.assert(not s.starts_with(String(alloc, "world")), "wrong prefix");
    }

    /** Checks substr and clone. */
    test_function substr_and_clone() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "abcdef");
      var mid = try std.test.expect_access(s.substr(alloc, 2, 3));
      try std.test.assert(mid.equals_literal("cde"), "substr middle");
      var empty = try std.test.expect_access(s.substr(alloc, 6, 0));
      try std.test.assert(empty.is_empty(), "substr empty tail");

      var copy = s.clone(alloc);
      try std.test.assert(copy.equals(s), "clone equals source");
      copy.to_upper();
      try std.test.assert(s.equals_literal("abcdef"), "clone is independent");

      match s.substr(alloc, 4, 3) {
        AccessResult.Ok(matched_value) => {
          var bad = matched_value;
          try std.test.fail("expected error");
        },
        AccessResult.OutOfBounds(e) => {}
      };
    }

    /** Checks split on byte and string. */
    test_function split_on_byte_and_string() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var csv = String(alloc, "a,b,,c");
      var parts = csv.split(alloc, 44);  // ','
      try std.test.assert_eq(parts.size(), 4);
      try std.test.assert(unsafe { parts.get_unchecked(0); }.equals_literal("a"), "first piece");
      try std.test.assert(unsafe { parts.get_unchecked(2); }.is_empty(), "empty piece kept");
      try std.test.assert(unsafe { parts.get_unchecked(3); }.equals_literal("c"), "last piece");

      var plain = String(alloc, "no separators here");
      var whole = plain.split(alloc, 44);
      try std.test.assert_eq(whole.size(), 1);

      var text = String(alloc, "k1=v1;;k2=v2;");
      var fields = text.split(alloc, ";;");
      try std.test.assert_eq(fields.size(), 2);
      try std.test.assert(unsafe { fields.get_unchecked(0); }.equals_literal("k1=v1"), "first field");
      try std.test.assert(unsafe { fields.get_unchecked(1); }.equals_literal("k2=v2;"), "second field");

      var untouched = String(alloc, "abc");
      var one = untouched.split(alloc, "");
      try std.test.assert_eq(one.size(), 1);
      try std.test.assert(unsafe { one.get_unchecked(0); }.equals_literal("abc"), "empty separator");
    }

    /** Checks split nonempty skips empty pieces. */
    test_function split_nonempty_skips_empty_pieces() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var csv = String(alloc, ",a,,b,");
      var parts = csv.split_nonempty(alloc, 44);  // ','
      try std.test.assert_eq(parts.size(), 2);
      try std.test.assert(unsafe { parts.get_unchecked(0); }.equals_literal("a"), "first piece");
      try std.test.assert(unsafe { parts.get_unchecked(1); }.equals_literal("b"), "second piece");

      var seps = String(alloc, ",,,");
      var none = seps.split_nonempty(alloc, 44);
      try std.test.assert_eq(none.size(), 0);

      var text = String(alloc, ";;k1=v1;;;;k2=v2;;");
      var fields = text.split_nonempty(alloc, ";;");
      try std.test.assert_eq(fields.size(), 2);
      try std.test.assert(unsafe { fields.get_unchecked(0); }.equals_literal("k1=v1"), "first field");
      try std.test.assert(unsafe { fields.get_unchecked(1); }.equals_literal("k2=v2"), "second field");

      var abc = String(alloc, "abc");
      var one = abc.split_nonempty(alloc, "");
      try std.test.assert_eq(one.size(), 1);
      try std.test.assert(unsafe { one.get_unchecked(0); }.equals_literal("abc"), "empty separator");

      var blank = String(alloc, "");
      var nothing = blank.split_nonempty(alloc, "");
      try std.test.assert_eq(nothing.size(), 0);
    }

    /**
     * The five split entry points share one implementation, so the empty
     * separator and empty subject cases are pinned here.
     */
    test_function split_edge_cases() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "abc");
      var empty = String(alloc, "");

      // An empty separator cuts nothing: the whole string is one piece
      var whole = s.split(alloc, "");
      try std.test.assert_eq(whole.size(), 1);
      try std.test.assert(unsafe { whole.get_unchecked(0); }.equals_literal("abc"), "one whole piece");
      try std.test.assert_eq(s.split_nonempty(alloc, "").size(), 1);

      // An empty subject yields one empty piece, or none when empty pieces
      // are dropped
      try std.test.assert_eq(empty.split(alloc, "").size(), 1);
      try std.test.assert_eq(empty.split_nonempty(alloc, "").size(), 0);
      try std.test.assert_eq(empty.split(alloc, b',').size(), 1);
      try std.test.assert_eq(empty.split_nonempty(alloc, b',').size(), 0);
      try std.test.assert_eq(empty.split_whitespace(alloc).size(), 0);
    }

    /** Checks split whitespace collapses runs. */
    test_function split_whitespace_collapses_runs() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "  one\ttwo  \n three\r\n");
      var words = s.split_whitespace(alloc);
      try std.test.assert_eq(words.size(), 3);
      try std.test.assert(unsafe { words.get_unchecked(0); }.equals_literal("one"), "first word");
      try std.test.assert(unsafe { words.get_unchecked(1); }.equals_literal("two"), "second word");
      try std.test.assert(unsafe { words.get_unchecked(2); }.equals_literal("three"), "third word");

      var solid = String(alloc, "word");
      var solo = solid.split_whitespace(alloc);
      try std.test.assert_eq(solo.size(), 1);
      try std.test.assert(unsafe { solo.get_unchecked(0); }.equals_literal("word"), "single word");

      var spaces = String(alloc, " \t\n ");
      var empty = spaces.split_whitespace(alloc);
      try std.test.assert_eq(empty.size(), 0);
    }

    /** Checks join parts. */
    test_function join_parts() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var csv = String(alloc, "a,b,,c");
      var parts = csv.split(alloc, 44);
      var rejoined = join(alloc, parts, ",");
      try std.test.assert(rejoined.equals(csv), "split then join round trips");
      var dashed = join(alloc, parts, " - ");
      try std.test.assert(dashed.equals_literal("a - b -  - c"), "multi-byte separator");

      var single = Vec<String>(alloc, 2);
      single.push(String(alloc, "solo"));
      var alone = join(alloc, single, ",");
      try std.test.assert(alone.equals_literal("solo"), "single part");
    }

    /** Checks replace literal and string. */
    test_function replace_literal_and_string() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      // Replacement longer than the match: buffer has to grow
      var s = String(alloc, "one fish two fish");
      s.replace("fish", "lizard");
      try std.test.assert(s.equals_literal("one lizard two lizard"), "longer replacement");

      // Replacement shorter than the match
      s.replace("lizard", "ox");
      try std.test.assert(s.equals_literal("one ox two ox"), "shorter replacement");

      // Same length
      s.replace("ox", "oy");
      try std.test.assert(s.equals_literal("one oy two oy"), "same-length replacement");

      // Replacement containing the needle must not loop forever
      var loopy = String(alloc, "aaa");
      loopy.replace("a", "aa");
      try std.test.assert(loopy.equals_literal("aaaaaa"), "replacement contains needle");

      // Deleting matches
      var del = String(alloc, "x-y-z");
      del.replace("-", "");
      try std.test.assert(del.equals_literal("xyz"), "empty replacement deletes");

      // No match leaves the string alone
      var same = String(alloc, "hello");
      same.replace("zz", "yy");
      try std.test.assert(same.equals_literal("hello"), "no match");

      // Empty needle is a no-op
      same.replace("", "yy");
      try std.test.assert(same.equals_literal("hello"), "empty needle");

      // String overloads
      var text = String(alloc, "cat dog cat");
      var from = String(alloc, "cat");
      var to = String(alloc, "bird");
      text.replace(from, to);
      try std.test.assert(text.equals_literal("bird dog bird"), "String overloads");
    }

    /** Checks c str terminates without changing the string. */
    test_function c_str_terminates_without_changing_the_string() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "abc");
      s.append_literal("def");
      var p = s.c_str();
      // A NUL sits just past the last byte, and the bytes are unchanged.
      if (unsafe { _load<u8>(p, 6); } != 0) {
        try std.test.fail("missing NUL");
      }
      if (unsafe { _load<u8>(p, 0); } != 97) {
        try std.test.fail("bytes changed");
      }
      try std.test.assert_eq(s.length(), 6);
      try std.test.assert(s.equals_literal("abcdef"), "content unchanged");
      // Still usable, and re-terminating after a mutation still works.
      s.append_char(33);
      if (unsafe { _load<u8>(s.c_str(), 7); } != 0) {
        try std.test.fail("missing NUL after append");
      }
      try std.test.assert_eq(s.length(), 7);
    }

    /** Checks from c str copies the bytes. */
    test_function from_c_str_copies_the_bytes() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var src = String(alloc, "round trip");
      var copy = from_c_str(alloc, src.c_str());
      try std.test.assert_eq(copy.length(), 10);
      try std.test.assert(copy.equals_literal("round trip"), "copied content");
      // The copy is independent of the source.
      src.clear();
      try std.test.assert_eq(copy.length(), 10);
    }

    /** Checks from c str handles empty and null. */
    test_function from_c_str_handles_empty_and_null() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var empty = String(alloc, "");
      var a = from_c_str(alloc, empty.c_str());
      try std.test.assert(a.is_empty(), "empty C string");
      var b = from_c_str(alloc, null);
      try std.test.assert(b.is_empty(), "null C string");
    }

    /** Checks push encodes UTF-8. */
    test_function push_encodes_utf8() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "");
      s.push('a');
      try std.test.assert_eq(s.length(), 1);
      s.push('é');  // 2 bytes
      try std.test.assert_eq(s.length(), 3);
      s.push('你');  // 3 bytes
      try std.test.assert_eq(s.length(), 6);
      s.push('😀');  // 4 bytes
      try std.test.assert_eq(s.length(), 10);
      // é is C3 A9
      try std.test.assert((try std.test.expect_access(s.at(1))) == b'\xC3' and (try std.test.expect_access(s.at(2))) == b'\xA9', "é bytes");
    }

    /** Checks char count counts scalars not bytes. */
    test_function char_count_counts_scalars_not_bytes() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "héllo😀");
      try std.test.assert_eq(s.length(), 10);  // bytes
      try std.test.assert_eq(s.count_chars(), 6);  // scalar values
    }

    /** Checks chars round trips through push. */
    test_function chars_round_trips_through_push() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "héllo😀");
      var out = String(alloc, "");
      var it = s.iterate_chars();
      for (var c: char in it) {
        out.push(c);
      }
      try std.test.assert(out.equals(s), "round trip");
    }

    /** Checks chars yields the scalar values. */
    test_function chars_yields_the_scalar_values() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "a😀");
      var seen = 0;
      var it = s.iterate_chars();
      for (var c: char in it) {
        if (seen == 0) {
          try std.test.assert_eq(c, 'a');
        }
        if (seen == 1) {
          try std.test.assert_eq(c, '\u{1F600}');
        }
        seen = seen + 1;
      }
      try std.test.assert_eq(seen, 2);
    }

    /**
     * Malformed bytes must not stall or overrun iteration: each bad byte
     * becomes one U+FFFD and the scan moves on.
     */
    test_function chars_replaces_malformed_bytes() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "a");
      s.append_char(b'\xFF');  // not a valid lead byte
      s.append_char(b'b');
      s.append_char(b'\xE2');  // 3-byte lead...
      s.append_char(b'c');  // ...with a bad continuation
      try std.test.assert_eq(s.count_chars(), 5);
      var replacements = 0;
      var it = s.iterate_chars();
      for (var c: char in it) {
        if (c == '\u{FFFD}') {
          replacements = replacements + 1;
        }
      }
      try std.test.assert_eq(replacements, 2);
    }

    /** Checks find returns the byte index of a char. */
    test_function find_returns_the_byte_index_of_a_char() _Result<void, std.string_tests.TestError> {
      var alloc = make_heap_allocator();
      var s = String(alloc, "héllo😀");
      var at_e = match s.find('é') {
        Option.Some(i) => i,
        Option.None => -1
      };
      try std.test.assert_eq(at_e, 1);
      var at_emoji = match s.find('😀') {
        Option.Some(i) => i,
        Option.None => -1
      };
      try std.test.assert_eq(at_emoji, 6);
      var absent = match s.find('z') {
        Option.Some(i) => i,
        Option.None => -1
      };
      try std.test.assert_eq(absent, -1);
      var last_l = match s.rfind('l') {
        Option.Some(i) => i,
        Option.None => -1
      };
      try std.test.assert_eq(last_l, 4);
      try std.test.assert(s.contains('h'), "contains char");
      try std.test.assert(not s.contains('z'), "missing char");
    }

    /** Checks char of rejects non scalar values. */
    test_function char_of_rejects_non_scalar_values() _Result<void, std.string_tests.TestError> {
      var ok = match char_of(65) {
        Option.Some(c) => c == 'A',
        Option.None => false
      };
      try std.test.assert(ok, "char_of(65) is 'A'");
      var surrogate = match char_of(55296) {
        Option.Some(c) => true,
        Option.None => false
      };
      try std.test.assert(not surrogate, "surrogate rejected");
      var too_big = match char_of(1114112) {
        Option.Some(c) => true,
        Option.None => false
      };
      try std.test.assert(not too_big, "beyond U+10FFFF rejected");
      try std.test.assert_eq(code_of('😀'), 128512);
    }

    /** Checks interpolating a char writes UTF-8. */
    test_function interpolating_a_char_writes_utf8() _Result<void, std.string_tests.TestError> {
      var c: char = '😀';
      var s = `[${c}]`;
      try std.test.assert_eq(s.length(), 6);  // '[' + 4 bytes + ']'
      try std.test.assert((try std.test.expect_access(s.at(0))) == b'[' and (try std.test.expect_access(s.at(5))) == b']', "brackets preserved");
    }
    /** Checks that popping moves the final byte and reports an empty string. */
    test_function pop_reports_empty() {
      var text = String("ab");
      try std.test.assert_eq(try std.test.expect_pop(text.pop()), b'b');
      try std.test.assert_eq(try std.test.expect_pop(text.pop()), b'a');
      try std.test.assert_eq(text.length(), 0);
      match text.pop() {
        PopResult.Ok(_) => {
          try std.test.assert(false, "empty string must report Empty");
        },
        PopResult.Empty(_) => {}
      };
    }
  }  // module string_tests
}  // module std
