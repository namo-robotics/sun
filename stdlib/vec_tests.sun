// stdlib/vec_tests.sun - Tests for stdlib/vec.sun.
// Replaces the C++ suite Stdlib_Collections_Vec.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /** Groups tests for the vec library behavior. */
  module vec_tests {
    /** Combines assertions with failures from borrowed element access. */
    enum TestError { Assertion(std.test.AssertionError), Bounds(IndexOutOfBoundsError) }

    /** Checks create empty vec. */
    test_function create_empty_vec() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      try std.test.assert_eq(v.size(), 0);
    }

    /** Checks push and size. */
    test_function push_and_size() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(10);
      v.push(20);
      v.push(30);
      try std.test.assert_eq(v.size(), 3);
    }

    /** Checks push and get. */
    test_function push_and_get() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(10);
      v.push(20);
      v.push(30);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(0))) + (try std.test.expect_access_value(v.get(1))) + (try std.test.expect_access_value(v.get(2))), 60);
    }

    /** Checks set element. */
    test_function set_element() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(10);
      v.push(20);
      try std.test.expect_access_success(v.set(0, 99));
      try std.test.assert_eq((try std.test.expect_access_value(v.get(0))), 99);
    }

    /** Checks pop element. */
    test_function pop_element() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(10);
      v.push(20);
      v.push(30);
      var last = match v.pop() {
        Option.Some(x) => x,
        Option.None => -1
      };
      try std.test.assert_eq(last, 30);
      try std.test.assert_eq(v.size(), 2);
    }

    /** Checks pop empty is none. */
    test_function pop_empty_is_none() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(1);
      v.pop();
      var got = match v.pop() {
        Option.Some(x) => 1,
        Option.None => 42
      };
      try std.test.assert_eq(got, 42);
    }

    /** Checks remove first and iterate. */
    test_function remove_first_and_iterate() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 4);
      v.push(1);
      v.push(2);
      v.push(3);
      v.push(4);
      try std.test.assert_eq((try std.test.expect_access(v.remove(0))), 1);
      try std.test.assert_eq(v.size(), 3);
      try std.test.assert_eq(v.capacity(), 4);
      var order: i64 = 0;
      for (var x: i64 in v) {
        order = order * 10 + x;
      }
      try std.test.assert_eq(order, 234);
      v.push(5);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(3))), 5);
    }

    /** Checks remove middle lsyntax tree and singleton. */
    test_function remove_middle_last_and_singleton() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 4);
      v.push(10);
      v.push(20);
      v.push(30);
      try std.test.assert_eq((try std.test.expect_access(v.remove(1))), 20);
      try std.test.assert_eq(v.size(), 2);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(0))), 10);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(1))), 30);
      try std.test.assert_eq((try std.test.expect_access(v.remove(1))), 30);
      try std.test.assert_eq(v.size(), 1);
      try std.test.assert_eq((try std.test.expect_access(v.remove(0))), 10);
      try std.test.assert(v.is_empty());
      v.push(40);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(0))), 40);
    }

    /** Checks remove invalid indices leave vec unchanged. */
    test_function remove_invalid_indices_leave_vec_unchanged() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 4);
      var caught: i64 = 0;
      match v.remove(0) {
        AccessResult.Ok(_) => {},
        AccessResult.OutOfBounds(e) => {
          caught = caught + 1;
        }
      };
      try std.test.assert(v.is_empty());
      v.push(10);
      for (var index: i64 = -1; index <= 4; index = index + 1) {
        if (index != 0) {
          match v.remove(index) {
            AccessResult.Ok(_) => {},
            AccessResult.OutOfBounds(e) => {
              caught = caught + 1;
            }
          };
          try std.test.assert_eq(v.size(), 1);
          try std.test.assert_eq((try std.test.expect_access_value(v.get(0))), 10);
        }
      }
      try std.test.assert_eq(caught, 6);
    }

    /** Checks swap remove first and iterate. */
    test_function swap_remove_first_and_iterate() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 4);
      v.push(1);
      v.push(2);
      v.push(3);
      v.push(4);
      try std.test.assert_eq((try std.test.expect_access(v.swap_remove(0))), 1);
      try std.test.assert_eq(v.size(), 3);
      try std.test.assert_eq(v.capacity(), 4);
      var order: i64 = 0;
      for (var x: i64 in v) {
        order = order * 10 + x;
      }
      try std.test.assert_eq(order, 423);
      v.push(5);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(3))), 5);
    }

    /** Checks swap remove middle lsyntax tree and singleton. */
    test_function swap_remove_middle_last_and_singleton() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 4);
      v.push(10);
      v.push(20);
      v.push(30);
      try std.test.assert_eq((try std.test.expect_access(v.swap_remove(1))), 20);
      try std.test.assert_eq(v.size(), 2);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(0))), 10);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(1))), 30);
      try std.test.assert_eq((try std.test.expect_access(v.swap_remove(1))), 30);
      try std.test.assert_eq(v.size(), 1);
      try std.test.assert_eq((try std.test.expect_access(v.swap_remove(0))), 10);
      try std.test.assert(v.is_empty());
      v.push(40);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(0))), 40);
    }

    /** Checks swap remove invalid indices leave vec unchanged. */
    test_function swap_remove_invalid_indices_leave_vec_unchanged() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 4);
      var caught: i64 = 0;
      match v.swap_remove(0) {
        AccessResult.Ok(_) => {},
        AccessResult.OutOfBounds(e) => {
          caught = caught + 1;
        }
      };
      try std.test.assert(v.is_empty());
      v.push(10);
      for (var index: i64 = -1; index <= 4; index = index + 1) {
        if (index != 0) {
          match v.swap_remove(index) {
            AccessResult.Ok(_) => {},
            AccessResult.OutOfBounds(e) => {
              caught = caught + 1;
            }
          };
          try std.test.assert_eq(v.size(), 1);
          try std.test.assert_eq((try std.test.expect_access_value(v.get(0))), 10);
        }
      }
      try std.test.assert_eq(caught, 6);
    }

    /** Replacing an optional slot leaves a valid empty value at the same index. */
    test_function replace_leaves_explicit_empty_slot() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<Option<i32>>(allocator, 2);
      v.push(Option.Some(10));
      v.push(Option.Some(20));
      var empty: Option<i32> = Option.None;
      var previous = try std.test.expect_access(v.replace(0, empty));
      try std.test.assert_eq(
        match previous {
          Option.Some(value) => value,
          Option.None => -1
        },
        10
      );
      try std.test.assert_eq(v.size(), 2);
      try std.test.assert(
        match (try v.get(0)) {
          Option.Some(value) => false,
          Option.None => true
        }
      );
      try std.test.assert_eq(
        match (try v.get(1)) {
          Option.Some(value) => value,
          Option.None => -1
        },
        20
      );
    }

    var removal_drops: i64 = 0;

    /** Owns a string and counts destruction of live values. */
    class RemovalTracked {
      public var value: String;
      /** Initializes the fixture fields used by this example or regression test. */
      init(value: String) {
        this.value = value;
      }
      /** Records fixture destruction so tests can verify ownership and cleanup. */
      deinit() {
        removal_drops = removal_drops + 1;
      }
    }

    /** Select a removal operation and transfer its result to the caller. */
    function remove_tracked(v: ref Vec<RemovalTracked>, swap: bool) _Result<RemovalTracked, IndexOutOfBoundsError> {
      if (swap) {
        return _Result.Ok((try v.swap_remove(0)));
      }
      return _Result.Ok((try v.remove(0)));
    }

    /** Check that removing values transfers ownership without dropping them. */
    function exercise_removal_ownership(swap: bool) _Result<void, std.test.AssertionError> {
      var allocator = make_heap_allocator();
      var v = Vec<RemovalTracked>(allocator, 4);
      v.push(RemovalTracked(String("first")));
      v.push(RemovalTracked(String("middle")));
      v.push(RemovalTracked(String("last")));
      var before = removal_drops;
      var removed = try std.test.expect_ok(remove_tracked(v, swap));
      try std.test.assert_eq(removed.value.length(), 5);
      try std.test.assert_eq(removal_drops, before);
      try std.test.assert_eq(v.size(), 2);
      v.clear();
      try std.test.assert_eq(removal_drops, before + 2);
      try std.test.assert_eq(removed.value.length(), 5);
      v.push(RemovalTracked(String("replacement")));
      return _Result.Ok;
    }

    /** Checks removal transfers ownership and drops each value once. */
    test_function removal_transfers_ownership_and_drops_each_value_once() _Result<void, std.vec_tests.TestError> {
      removal_drops = 0;
      try std.test.expect_success(exercise_removal_ownership(false));
      try std.test.assert_eq(removal_drops, 4);
      try std.test.expect_success(exercise_removal_ownership(true));
      try std.test.assert_eq(removal_drops, 8);
    }

    /** Reports whether the collection contains no elements. */
    test_function is_empty() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      try std.test.assert(v.is_empty());
      v.push(1);
      try std.test.assert(v.is_empty() == false);
    }

    /** Checks clear. */
    test_function clear() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(1);
      v.push(2);
      v.push(3);
      v.clear();
      try std.test.assert_eq(v.size(), 0);
    }

    /** Checks capacity. */
    test_function capacity() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      try std.test.assert_eq(v.capacity(), 8);
    }

    /** Checks auto grow. */
    test_function auto_grow() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      for (var i: i64 = 0; i < 20; i = i + 1) {
        v.push(i);
      }
      try std.test.assert_eq(v.size(), 20);
    }

    /** Checks auto grow values preserved. */
    test_function auto_grow_values_preserved() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      for (var i: i64 = 0; i < 20; i = i + 1) {
        v.push(i * 10);
      }
      try std.test.assert_eq((try std.test.expect_access_value(v.get(0))) + (try std.test.expect_access_value(v.get(10))) + (try std.test.expect_access_value(v.get(19))), 290);
    }

    /** Checks first and lsyntax tree. */
    test_function first_and_last() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(10);
      v.push(20);
      v.push(30);
      var f = match v.first() {
        Option.Some(x) => x,
        Option.None => -1
      };
      var l = match v.last() {
        Option.Some(x) => x,
        Option.None => -1
      };
      try std.test.assert_eq(f, 10);
      try std.test.assert_eq(l, 30);
    }

    /** Checks i32 type. */
    test_function i32_type() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i32>(allocator, 8);
      v.push(5);
      v.push(10);
      try std.test.assert_eq((try std.test.expect_access_value(v.get(0))) + (try std.test.expect_access_value(v.get(1))), 15);
    }

    /** Checks iteration. */
    test_function iteration() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(1);
      v.push(2);
      v.push(3);
      v.push(4);
      var sum: i64 = 0;
      for (var x: i64 in v) {
        sum = sum + x;
      }
      try std.test.assert_eq(sum, 10);
    }

    /** Checks index operator. */
    test_function index_operator() _Result<void, std.vec_tests.TestError> {
      var allocator = make_heap_allocator();
      var v = Vec<i64>(allocator, 8);
      v.push(100);
      v.push(200);
      try std.test.assert_eq(v[0] + v[1], 300);
    }
  }  // module vec_tests
}  // module std
