// stdlib/convert_tests.sun - Tests for math.sun (safe_convert).
// Replaces the C++ suite Stdlib_Convert.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /** Groups tests for the convert library behavior. */
  module convert_tests {
    /** Checks narrow i64 to i32 in range. */
    test_function narrow_i64_to_i32_in_range() {
      var ms: i64 = 200;
      try std.test.assert_eq(try std.test.expect_conversion(safe_convert<i32>(ms)), 200);
    }

    /** Checks both type arguments may be written. */
    test_function both_type_arguments_may_be_written() {
      var ms: i64 = 200;
      try std.test.assert_eq(try std.test.expect_conversion(safe_convert<i32, i64>(ms)), 200);
    }

    /** Checks narrow i64 to i32 out of range throws. */
    test_function narrow_i64_to_i32_out_of_range_throws() {
      var big: i64 = 4294967498;  // low 32 bits are 202, so _convert would give 202
      match safe_convert<i32>(big) {
        ConversionResult.Ok(matched_value) => {
          var t: i32 = matched_value;
          try std.test.fail("expected ConversionError");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
    }

    /** Checks negative to unsigned throws. */
    test_function negative_to_unsigned_throws() {
      var neg: i64 = -1;
      match safe_convert<u64>(neg) {
        ConversionResult.Ok(matched_value) => {
          var u: u64 = matched_value;
          try std.test.fail("expected ConversionError");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
    }

    /** Checks unsigned max to signed throws. */
    test_function unsigned_max_to_signed_throws() {
      var umax: u64 = 0;
      umax = umax - 1;  // wraps to the largest u64; round-trips through i64 as -1
      match safe_convert<i64>(umax) {
        ConversionResult.Ok(matched_value) => {
          var s: i64 = matched_value;
          try std.test.fail("expected ConversionError");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
    }

    /** Checks same width sign change in range. */
    test_function same_width_sign_change_in_range() {
      var s: i32 = 77;
      var u: u32 = try std.test.expect_conversion(safe_convert<u32>(s));
      try std.test.assert_eq(_convert<i32>(u), 77);
    }

    /** Checks narrow to i8 edges. */
    test_function narrow_to_i8_edges() {
      var lo: i64 = -128;
      var hi: i64 = 127;
      var over: i64 = 128;
      try std.test.assert_eq(_convert<i32>(try std.test.expect_conversion(safe_convert<i8>(lo))), -128);
      try std.test.assert_eq(_convert<i32>(try std.test.expect_conversion(safe_convert<i8>(hi))), 127);
      match safe_convert<i8>(over) {
        ConversionResult.Ok(matched_value) => {
          var x: i8 = matched_value;
          try std.test.fail("128 does not fit an i8");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
    }

    /** Checks widening always succeeds. */
    test_function widening_always_succeeds() {
      var b: u8 = 250;
      var w: i64 = try std.test.expect_conversion(safe_convert<i64>(b));
      try std.test.assert_eq(w, 250);
    }

    /** Checks float to int truncates toward zero. */
    test_function float_to_int_truncates_toward_zero() {
      var g: f64 = -7.9;
      try std.test.assert_eq(_convert<i32>(try std.test.expect_conversion(safe_convert<i8>(g))), -7);
    }

    /** Checks float to int out of range throws. */
    test_function float_to_int_out_of_range_throws() {
      var f: f64 = 3000000000.0;
      match safe_convert<i32>(f) {
        ConversionResult.Ok(matched_value) => {
          var t: i32 = matched_value;
          try std.test.fail("3e9 does not fit an i32");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
      var small: f64 = -1.0;
      match safe_convert<u8>(small) {
        ConversionResult.Ok(matched_value) => {
          var u: u8 = matched_value;
          try std.test.fail("-1.0 does not fit a u8");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
      var top: f64 = 256.0;
      match safe_convert<u8>(top) {
        ConversionResult.Ok(matched_value) => {
          var u: u8 = matched_value;
          try std.test.fail("256.0 does not fit a u8");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
      var fits: f64 = 255.0;
      try std.test.assert_eq(_convert<i32>(try std.test.expect_conversion(safe_convert<u8>(fits))), 255);
    }

    /** Checks nan to int throws. */
    test_function nan_to_int_throws() {
      var z: f64 = 0.0;
      var nan: f64 = z / z;
      match safe_convert<i64>(nan) {
        ConversionResult.Ok(matched_value) => {
          var t: i64 = matched_value;
          try std.test.fail("NaN does not convert to an integer");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
    }

    /** Checks f64 to f32 overflow throws. */
    test_function f64_to_f32_overflow_throws() {
      var huge: f64 = 1.0e300;
      match safe_convert<f32>(huge) {
        ConversionResult.Ok(matched_value) => {
          var s: f32 = matched_value;
          try std.test.fail("1e300 does not fit an f32");
        },
        ConversionResult.Error(e) => {
          try std.test.assert_eq(e.code(), 9);
        }
      };
      var fine: f64 = 1.5;
      var s: f32 = try std.test.expect_conversion(safe_convert<f32>(fine));
      try std.test.assert_eq(_convert<i32>(s * 2.0), 3);
    }

    /** Checks int to float succeeds. */
    test_function int_to_float_succeeds() {
      var n: i64 = 1234;
      var d: f64 = try std.test.expect_conversion(safe_convert<f64>(n));
      try std.test.assert_eq(_convert<i32>(d), 1234);
    }

    /** Checks error message is readable. */
    test_function error_message_is_readable() {
      var big: i64 = 4294967498;
      match safe_convert<i32>(big) {
        ConversionResult.Ok(matched_value) => {
          var t: i32 = matched_value;
          try std.test.fail("expected ConversionError");
        },
        ConversionResult.Error(e) => {
          var m: String = e.message();
          try std.test.assert(
            m.equals_literal("value out of range for the target type"),
            "unexpected error message"
          );
        }
      };
    }
  }  // module convert_tests
}  // module std
