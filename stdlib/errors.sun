// stdlib/errors.sun - Standard error types implementing IError
//
// All error types implement the IError interface with:
//   - code() -> i32: numeric error code
//   - message() -> String: an owned clone of the error description
//
// message() hands back a clone, so the text stays usable for as long as the
// caller keeps it — independent of the error object and of whatever scope the
// message was composed in.
//
// Error takes its message either as a literal or as a String built at runtime:
//   throw Error(errno(), "failed to open file");
//   throw Error(-1, path);   // path: a String built at runtime
//
// Usage:
//   import "stdlib/errors.sun";
//   using sun;
//
//   method pop_front() T throws IError {
//       if (this.is_empty()) {
//           throw EmptyError();
//       }
//       // ...
//   }

public module sun {
  // ============================================================================
  // Generic Error - base error with custom message
  // ============================================================================

  public class Error implements IError {
    var code_: i32;
    var message_: String;

    // Build an error from a code and a literal message.
    init(code: i32, message: static_ptr<u8>) {
      this.code_ = code;
      this.message_ = String(message);
    }

    // The error keeps its own copy, so the String the caller built can go out
    // of scope (or be thrown past).
    init(code: i32, message: const ref String) {
      var alloc: HeapAllocator = HeapAllocator();
      this.code_ = code;
      this.message_ = message.clone(alloc);
    }

    // The numeric code this error was built with.
    public method code() i32 {
      return this.code_;
    }

    // A fresh copy of the message text, owned by the caller.
    public method message() String {
      var alloc: HeapAllocator = HeapAllocator();
      return this.message_.clone(alloc);
    }
  }

  // ============================================================================
  // EmptyError - for operations on empty containers
  // ============================================================================

  public class EmptyError implements IError {
    // Build the error reporting that a container held nothing.
    init() {}

    // Always 1.
    public method code() i32 {
      return 1;
    }

    // Fixed text: the container is empty.
    public method message() String {
      return String("container is empty");
    }
  }

  // ============================================================================
  // NotFoundError - for failed lookups
  // ============================================================================

  public class NotFoundError implements IError {
    // Build the error reporting that a lookup found nothing.
    init() {}

    // Always 2.
    public method code() i32 {
      return 2;
    }

    // Fixed text: the element was not found.
    public method message() String {
      return String("element not found");
    }
  }

  // ============================================================================
  // IndexOutOfBoundsError - for invalid array/vector indices
  // ============================================================================

  public class IndexOutOfBoundsError implements IError {
    var index_: i64;

    // Build the error, recording the index that was out of range.
    init(index: i64) {
      this.index_ = index;
    }

    // Always 3.
    public method code() i32 {
      return 3;
    }

    // Fixed text: the index was out of bounds.
    public method message() String {
      return String("index out of bounds");
    }

    // The offending index, for a caller that wants to report it.
    public method index() i64 {
      return this.index_;
    }
  }

  // ============================================================================
  // DivisionByZeroError - for division by zero
  // ============================================================================

  public class DivisionByZeroError implements IError {
    // Build the error reporting a divide by zero.
    init() {}

    // Always 4.
    public method code() i32 {
      return 4;
    }

    // Fixed text: division by zero.
    public method message() String {
      return String("division by zero");
    }
  }

  // ============================================================================
  // OverflowError - for arithmetic overflow
  // ============================================================================

  public class OverflowError implements IError {
    // Build the error reporting that arithmetic went out of range.
    init() {}

    // Always 5.
    public method code() i32 {
      return 5;
    }

    // Fixed text: arithmetic overflow.
    public method message() String {
      return String("arithmetic overflow");
    }
  }

  // ============================================================================
  // InvalidArgumentError - for invalid function arguments
  // ============================================================================

  public class InvalidArgumentError implements IError {
    var message_: String;

    // Build the error from a literal explaining what was wrong.
    init(message: static_ptr<u8>) {
      this.message_ = String(message);
    }

    // Build the error from a message put together at runtime. The text is
    // copied, so the caller's String can go out of scope.
    init(message: const ref String) {
      var alloc: HeapAllocator = HeapAllocator();
      this.message_ = message.clone(alloc);
    }

    // Always 6.
    public method code() i32 {
      return 6;
    }

    // A fresh copy of the explanation, owned by the caller.
    public method message() String {
      var alloc: HeapAllocator = HeapAllocator();
      return this.message_.clone(alloc);
    }
  }

  // ============================================================================
  // IOError - for I/O operations
  // ============================================================================

  public class IOError implements IError {
    var errno_: i32;

    // Build the error from the C errno value the failing call left behind.
    init(errno: i32) {
      this.errno_ = errno;
    }

    // The errno value, passed straight through.
    public method code() i32 {
      return this.errno_;
    }

    // Fixed text: an I/O call failed.
    public method message() String {
      return String("I/O error");
    }

    // The errno value, under a name that says where it came from.
    public method errno() i32 {
      return this.errno_;
    }
  }

  // ============================================================================
  // AllocationError - for memory allocation failures
  // ============================================================================

  public class AllocationError implements IError {
    var size_: i64;

    // Build the error, recording how many bytes were asked for.
    init(size: i64) {
      this.size_ = size;
    }

    // Always 7.
    public method code() i32 {
      return 7;
    }

    // Fixed text: the allocator could not satisfy the request.
    public method message() String {
      return String("memory allocation failed");
    }

    // How many bytes the failed request asked for.
    public method requested_size() i64 {
      return this.size_;
    }
  }

  // ============================================================================
  // ConversionError - a value does not fit the type it is converted to
  // ============================================================================

  public class ConversionError implements IError {
    // Build the error reporting that a value did not fit its new type.
    init() {}

    // Always 9.
    public method code() i32 {
      return 9;
    }

    // Fixed text: the value was out of range for the target type.
    public method message() String {
      return String("value out of range for the target type");
    }
  }
}  // module sun
