/** Provides allocator-independent storage and typed construction helpers. */
public module std.mem {

  using std;

  /** Allocates aligned byte storage; owners retain a borrow of this allocator. */
  public interface IAllocator {
    /** Allocate bytes with a positive power-of-two alignment. */
    public const method alloc_raw(size: i64, alignment: i64) raw_ptr<u8> throws;

    /** Release storage using the size and alignment supplied when allocating. */
    public const method dealloc_raw(pointer: raw_ptr<u8>, size: i64, alignment: i64) void;
  }

  /** Reject invalid sizes and alignments before accessing allocator storage. */
  function validate_layout(size: i64, alignment: i64) void throws {
    if (size < 0 or alignment <= 0 or (alignment & (alignment - 1)) != 0) {
      throw InvalidArgumentError("invalid allocation layout");
    }
  }

  /** A stateless system heap allocator whose copies are interchangeable. */
  public class HeapAllocator implements IAllocator {
    /** Construct an allocator without allocating storage. */
    init() {}

    /** Allocate aligned storage; zero bytes still produce a freeable allocation. */
    public const method alloc_raw(size: i64, alignment: i64) raw_ptr<u8> throws {
      validate_layout(size, alignment);
      var physical_size = size;
      if (physical_size == 0) {
        physical_size = 1;
      }
      var pointer = unsafe { _aligned_alloc(physical_size, alignment); };
      if (pointer == null) {
        throw AllocationError(size);
      }
      return pointer;
    }

    /** Release storage obtained from the system heap. */
    public const method dealloc_raw(pointer: raw_ptr<u8>, size: i64, alignment: i64) void {
      unsafe { _free(pointer); };
    }

    /** Copy the stateless allocator without allocating. */
    public const method copy() HeapAllocator {
      return HeapAllocator();
    }
  }

  /** The shared system allocator, passed explicitly to allocating operations. */
  public const global_allocator: HeapAllocator = HeapAllocator();

  /** Allocate storage for count elements without initializing them. */
  public function alloc<T>(allocator: const ref IAllocator, count: i64) raw_ptr<T> throws {
    if (count < 0) {
      throw InvalidArgumentError("negative size");
    }
    var width = _sizeof<T>();
    if (width != 0 and count > std.I64_MAX / width) {
      throw OverflowError();
    }
    return unsafe { _ptr_as_raw<T>(allocator.alloc_raw(count * width, _alignof<T>())); };
  }

  /** Release typed storage after its initialized elements have been destroyed. */
  public function dealloc<T>(
    allocator: const ref IAllocator,
    pointer: raw_ptr<T>,
    count: i64
  ) void {
    allocator.dealloc_raw(
      unsafe { _ptr_as_raw<u8>(pointer); },
      count * _sizeof<T>(),
      _alignof<T>()
    );
  }

  /**
   * Returns storage for one T to its original allocator when the guard leaves scope.
   * The caller is responsible for destroying any live T before the guard frees its storage.
   *
   * For example, create<T> guards the allocation before running the constructor.
   * If construction throws, the guard frees the storage during unwinding. On success,
   * release() returns the pointer and transfers responsibility for cleanup to the caller.
   */
  class AllocationGuard<T> {
    var pointer: raw_ptr<T>;
    var allocator: const ref IAllocator;

    /** Take responsibility for deallocating storage for one element. */
    init(pointer: raw_ptr<T>, allocator: const ref IAllocator) {
      this.pointer = pointer;
      this.allocator = allocator;
    }

    /** Transfer storage to the successfully constructed value's owner. */
    method release() raw_ptr<T> {
      var pointer = this.pointer;
      this.pointer = null;
      return pointer;
    }

    /** Release the storage after its caller has handled any initialized value. */
    deinit() {
      if (this.pointer != null) {
        dealloc<T>(this.allocator, this.pointer, 1);
      }
    }
  }

  /** Allocate and construct a value; release its storage if construction throws. */
  public function create<T>(
    allocator: const ref IAllocator,
    args...: _params_of<T>
  ) raw_ptr<T> throws {
    var pointer = alloc<T>(allocator, 1);
    var guard = AllocationGuard<T>(pointer, allocator);
    unsafe { _init<T>(pointer, args...); };
    return guard.release();
  }

  /** Construct a value owned together with a borrow of its allocator. */
  public function create_unique<T>(
    allocator: const ref IAllocator,
    args...: _params_of<T>
  ) Unique<T, const ref IAllocator> throws {
    return unsafe { Unique<T, const ref IAllocator>(create<T>(allocator, args...), allocator); };
  }

  /** Keeps the allocator and the concrete interface implementation together. */
  class InterfaceBox<T> {
    var allocator: const ref IAllocator;
    var value: T;

    /** Move the implementation into its final dispatch address. */
    init(allocator: const ref IAllocator, value: T) {
      this.allocator = allocator;
      this.value = value;
    }
  }

  /** Destroy the implementation before releasing the original allocation. */
  function drop_interface_box<T>(owner: raw_ptr<InterfaceBox<T>>) void {
    var box = unsafe { _to_ref<InterfaceBox<T>>(owner); };
    var guard = AllocationGuard<InterfaceBox<T>>(owner, box.allocator);
    unsafe { _deinit<InterfaceBox<T>>(owner); };
  }

  /** Move a concrete value into an interface owner that borrows its allocator. */
  public function create_interface<I: interface, T: I>(
    allocator: const ref IAllocator,
    value: T
  ) I throws {
    var owner = create<InterfaceBox<T>>(allocator, allocator, value);
    var box = unsafe { _to_ref<InterfaceBox<T>>(owner); };
    var cleanup: function (raw_ptr<InterfaceBox<T>>) void = drop_interface_box;
    return unsafe { _create_interface<I>(owner, _address_of<T>(box.value), cleanup); };
  }

  /** Stores the synchronized bump cursor separately from the arena handle. */
  class ArenaState {
    var storage: raw_ptr<u8>;
    var capacity: i64;
    var used: i64 = 0;
    var mutex: std.thread.Mutex = std.thread.Mutex();

    /** Allocate the fixed backing buffer. */
    init(capacity: i64) throws {
      this.capacity = capacity;
      this.storage = alloc<u8>(global_allocator, capacity);
    }

    /** Release the backing buffer after all arena owners have been destroyed. */
    deinit() {
      dealloc<u8>(global_allocator, this.storage, this.capacity);
    }

    /** Reserve aligned bytes without moving earlier allocations. */
    method allocate(size: i64, alignment: i64) raw_ptr<u8> throws {
      validate_layout(size, alignment);
      this.mutex.lock();
      var next = unsafe { _ptr_as_raw<u8>(_ptr_offset(this.storage, this.used)); };
      var padding = unsafe { _alignment_padding(next, alignment); };
      var physical_size = size;
      if (physical_size == 0) {
        physical_size = 1;
      }
      var available = this.capacity - this.used;
      if (padding > available or physical_size > available - padding) {
        this.mutex.unlock();
        throw AllocationError(size);
      }
      var result = unsafe { _ptr_as_raw<u8>(_ptr_offset(next, padding)); };
      this.used += padding + physical_size;
      this.mutex.unlock();
      return result;
    }
  }

  /** Owns fixed-capacity storage reclaimed after its borrowers expire. */
  public class ArenaAllocator implements IAllocator {
    var state: Unique<ArenaState, HeapAllocator>;

    /** Allocate a fixed capacity. Negative capacities are invalid. */
    init(capacity: i64) throws {
      if (capacity < 0) {
        throw InvalidArgumentError("negative arena capacity");
      }
      this.state = Unique<ArenaState, HeapAllocator>(ArenaState(capacity), HeapAllocator());
    }

    /** Reserve aligned storage while preserving earlier allocations. */
    public const method alloc_raw(size: i64, alignment: i64) raw_ptr<u8> throws {
      var state = unsafe { _to_ref<ArenaState>(this.state.get_raw()); };
      return state.allocate(size, alignment);
    }

    /** Individual allocations remain reserved until reset or destruction. */
    public const method dealloc_raw(pointer: raw_ptr<u8>, size: i64, alignment: i64) void {}

    /** Reclaim storage after all owners and views borrowing this arena expire. */
    public method reset() void {
      this.state.get().used = 0;
    }
  }

  /** Construct an interchangeable system allocator without allocating. */
  public function make_heap_allocator() HeapAllocator {
    return HeapAllocator();
  }
}
