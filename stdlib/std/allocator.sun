/** Provides checked system heap allocation and the shared default allocator. */
public module std {

  /** Allocates storage explicitly; callers own successful allocations. */
  public interface IAllocator {
    /** Allocate aligned storage for count elements, checking the byte size. */
    public const method alloc<T>(count: i64) raw_ptr<T> throws;

    /** Allocate uninitialized bytes, reporting invalid sizes and allocation failures. */
    public const method alloc_raw(size: i64) raw_ptr<u8> throws;

    /** Release typed storage after its initialized elements have been destroyed. */
    public const method dealloc<T>(p: raw_ptr<T>, count: i64) void;

    /** Release raw storage obtained from this allocator. */
    public const method dealloc_raw(p: raw_ptr<u8>, size: i64) void;

    /** Allocate and initialize a value, propagating supported constructor errors. */
    public const method create<T>(args...: _params_of<T>) raw_ptr<T> throws;

    /** Allocate an initialized value with automatic destruction and deallocation. */
    public const method create_unique<T>(args...: _params_of<T>) Unique<T> throws;
  }

  /** Owns uninitialized storage until construction succeeds or fails. */
  class AllocationStorage {
    var pointer: raw_ptr<u8>;

    /** Take responsibility for freeing raw storage without destroying a value. */
    init(pointer: raw_ptr<u8>) {
      this.pointer = pointer;
    }

    /** Transfer storage to the successfully constructed value's owner. */
    method release() raw_ptr<u8> {
      var pointer = this.pointer;
      this.pointer = null;
      return pointer;
    }

    /** Free storage after failed construction; the constructor drops initialized fields. */
    deinit() {
      unsafe { _free(this.pointer); };
    }
  }

  /** A stateless allocator backed by the system heap; copies are interchangeable. */
  public class HeapAllocator implements IAllocator {
    /** Construct an allocator without allocating storage. */
    init() {}

    /** Allocate aligned storage; zero-sized requests still own a freeable pointer. */
    public const method alloc<T>(count: i64) raw_ptr<T> throws {
      if (count < 0) {
        throw InvalidArgumentError("negative size");
      }
      var width = _sizeof<T>();
      if (width != 0 and count > std.I64_MAX / width) {
        throw OverflowError();
      }
      var size = count * width;
      var physical_size = size;
      if (physical_size == 0) {
        physical_size = 1;
      }
      var pointer = unsafe { _aligned_malloc<T>(physical_size); };
      if (pointer == null) {
        throw AllocationError(size);
      }
      return unsafe { _ptr_as_raw<T>(pointer); };
    }

    /** Allocate bytes; negative requests fail and zero requests own one physical byte. */
    public const method alloc_raw(size: i64) raw_ptr<u8> throws {
      if (size < 0) {
        throw InvalidArgumentError("negative size");
      }
      var physical_size = size;
      if (physical_size == 0) {
        physical_size = 1;
      }
      var pointer: raw_ptr<u8> = unsafe { _ptr_as_raw<u8>(_malloc(physical_size)); };
      if (pointer == null) {
        throw AllocationError(size);
      }
      return pointer;
    }

    /** Release typed storage; the count does not affect system heap deallocation. */
    public const method dealloc<T>(p: raw_ptr<T>, count: i64) void {
      unsafe { _free(p); };
    }

    /** Release raw storage; the size does not affect system heap deallocation. */
    public const method dealloc_raw(p: raw_ptr<u8>, size: i64) void {
      unsafe { _free(p); };
    }

    /** Construct a value only after allocation succeeds. Arguments are consumed normally. */
    public const method create<T>(args...: _params_of<T>) raw_ptr<T> throws {
      var pointer = this.alloc<T>(1);
      var storage = AllocationStorage(unsafe { _ptr_as_raw<u8>(pointer); });
      unsafe { _init<T>(pointer, args...); };
      return unsafe { _ptr_as_raw<T>(storage.release()); };
    }

    /** Return sole ownership of a successfully initialized value. */
    public const method create_unique<T>(args...: _params_of<T>) Unique<T> throws {
      return Unique<T>(this.create<T>(args...));
    }

    /** Explicitly copy the stateless allocator without allocating. */
    public const method copy() HeapAllocator {
      return HeapAllocator();
    }
  }

  /** The immutable system heap allocator, passed explicitly to allocating APIs. */
  public const global_allocator: HeapAllocator = HeapAllocator();

  /** Construct an interchangeable system heap allocator without allocating. */
  public function make_heap_allocator() HeapAllocator {
    return HeapAllocator();
  }
}
