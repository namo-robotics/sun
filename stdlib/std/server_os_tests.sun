using std.net;

using std;

/** Portable server primitive regression tests. */
public module std {

  /** Online CPUs must be a positive host count. */
  test_function online_cpus() {
    std.test.assert(
      (std.thread.online_cpu_count()) > 0,
      "online CPU count is positive"
    );
  }

  /** Notifications coalesce, drain clears readiness, and clones retain ownership. */
  test_function wakeup_lifecycle() {
    var alloc = make_heap_allocator();
    var wake = std.io.Wakeup(alloc);
    var other = wake.clone();
    var loop = std.io.EventLoop(alloc, 4);
    loop.open();
    loop.add(wake.fd(), std.io.POLLIN, 7u64);
    std.test.assert_eq(loop.wait(0), 0);
    for (var i: i64 = 0; i < 100000; i = i + 1) {
      other.notify();
    }
    std.test.assert_eq(loop.wait(0), 1);
    wake.drain();
    std.test.assert_eq(loop.wait(0), 0);
    wake.drain();
    other.notify();
    std.test.assert_eq(loop.wait(0), 1);
    loop.remove(wake.fd());
  }
}

/** Concurrency and socket behavior using private native checks only inside stdlib tests. */
public module std {

  /** Notify repeatedly from a worker while the main thread drains the same source. */
  function send_wakeups(wake: std.io.Wakeup) i32 {
    for (var i: i64 = 0; i < 10000; i = i + 1) {
      try {
        wake.notify();
      } catch (error: Error) {
        return error.code();
      } catch (error: AllocationError) {
        return error.code();
      } catch (error: InvalidArgumentError) {
        return error.code();
      } catch (error: OverflowError) {
        return error.code();
      }
    }
    return 0;
  }

  /** Concurrent notification, clone destruction, and a final notification preserve readiness. */
  test_function concurrent_wakeup() {
    var alloc = make_heap_allocator();
    var wake = std.io.Wakeup(alloc);
    var worker = std.thread.spawn(send_wakeups, wake.clone());
    for (var i: i64 = 0; i < 10000; i = i + 1) {
      wake.drain();
    }
    std.test.assert_eq(worker.join(), 0);
    wake.drain();
    wake.notify();
    var poll = std.io.Poller(alloc);
    poll.add_read(wake.fd());
    std.test.assert_eq(poll.wait(0), 1);
    wake.drain();
    std.test.assert_eq(poll.wait(0), 0);
  }

  /** Wakeup destruction closes endpoints only when the last clone leaves scope. */
  test_function wakeup_descriptor_cleanup() {
    var alloc = make_heap_allocator();
    var fd: i32 = -1;
    if (true) {
      var wake = std.io.Wakeup(alloc);
      fd = wake.fd();
      std.test.assert((unsafe { c_fcntl(fd, 1); } & 1) != 0);
      std.test.assert((unsafe { c_fcntl(fd, 3); } & O_NONBLOCK) != 0);
      if (true) {
        var clone = wake.clone();
        clone.notify();
      }
      wake.drain();
    }
    std.test.assert_eq(unsafe { c_fcntl(fd, 1); }, -1);
  }

  /** Unopened files and invalid socket descriptors return checked failures. */
  test_function closed_resource_errors() {
    var file = std.io.File();
    try {
      file.metadata();

      std.test.fail("closed metadata succeeded");
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 9);
    } catch {
      std.test.fail("closed metadata succeeded");
    }
    std.test.assert(is_system_error(() => void throws { set_fd_close_on_exec(-1, true); }));
    std.test.assert(is_system_error(() => void throws { set_tcp_nodelay(-1, true); }));
    std.test.assert(is_system_error(() => void throws { set_socket_reuse_port(-1, true); }));
  }

  /** Return whether a checked configuration operation failed. */
  function is_system_error(operation: () => void throws) bool {
    try {
      operation();
      return false;
    } catch (error: Error) {
      return true;
    }
  }

  /** Exercise would-block, accepted flags, buffered EOF, half-close, and invalidated batches. */
  test_function nonblocking_tcp() {
    var alloc = make_heap_allocator();
    var listener = TcpListener();
    listener.bind(ipv4_loopback(), 0, true, false);
    listener.listen(8);
    listener.set_nonblocking(true);
    match listener.try_accept() {
      AcceptResult.WouldBlock => {},
      _ => {
        std.test.fail("empty accept must not throw");
      }
    };
    var client = TcpStream();

    client.connect_local(listener.local_port());

    // Client connect can finish before the listener has a pending connection.
    var accept_poll = std.io.Poller(alloc);
    accept_poll.add_read(listener.get_fd());
    std.test.assert_eq(accept_poll.wait(1000), 1);
    var server = match listener.try_accept() {
      AcceptResult.Accepted(stream) => stream,
      _ => {
        std.test.fail("connection was not accepted");
        return;
      }
    };
    var fd = server.get_fd();
    std.test.assert((unsafe { c_fcntl(fd, 1); } & 1) != 0);
    std.test.assert((unsafe { c_fcntl(fd, 3); } & O_NONBLOCK) != 0);
    server.set_nodelay(true);
    var buffer = ContiguousBuffer<u8>(alloc, 32);
    buffer.fill(42);
    var bytes = MutableByteSlice(buffer);
    match server.try_read(bytes) {
      std.io.ReadResult.WouldBlock => {},
      _ => {
        std.test.fail("empty read must report would-block");
      }
    };
    var loop = std.io.EventLoop(alloc, 4);
    loop.open();
    loop.add(fd, std.io.POLLIN, 5u64);
    std.test.assert_eq(client.send_str("pending"), 7);
    // Keep the client's read half open to specifically test peer write shutdown.
    std.test.assert_eq(unsafe { __shutdown(client.get_fd(), 1); }, 0);
    std.test.assert((loop.wait(1000)) > 0);
    var event = loop.event_at(0);
    std.test.assert(event.is_readable());
    match server.try_read(bytes) {
      std.io.ReadResult.Data(n) => {
        std.test.assert_eq(n, 7);
      },
      _ => {
        std.test.fail("EOF discarded buffered data");
      }
    };
    std.test.assert((loop.wait(1000)) > 0);
    var eof_event = loop.event_at(0);
    std.test.assert(eof_event.is_hup(), "read half-close is reported");
    match server.try_read(bytes) {
      std.io.ReadResult.Eof => {},
      _ => {
        std.test.fail("drained stream should report EOF");
      }
    };
    loop.modify(fd, std.io.POLLOUT, 6u64);
    try {
      loop.event_at(0);

      std.test.fail("modified registration left a stale batch");
    } catch (error: IndexOutOfBoundsError) {} catch {
      std.test.fail("modified registration left a stale batch");
    }
    std.test.assert((loop.wait(1000)) > 0);
    loop.remove(fd);
    try {
      loop.event_at(0);

      std.test.fail("removed registration left a stale batch");
    } catch (error: IndexOutOfBoundsError) {} catch {
      std.test.fail("removed registration left a stale batch");
    }
    var send_buffer = ContiguousBuffer<u8>(alloc, 32);
    send_buffer.fill(42);
    var output = ByteSlice(send_buffer);
    match server.try_write(output) {
      std.io.WriteResult.Complete(n) => {
        std.test.assert_eq(n, 32);
      },
      _ => {
        std.test.fail("write on open half should complete");
      }
    };
  }
}

/** Additional socket backpressure and registration reuse regressions. */
public module std {

  /** A bounded native send buffer forces a partial nonblocking write with a resumable prefix. */
  test_function tcp_partial_write() {
    var alloc = make_heap_allocator();
    var listener = TcpListener();
    listener.bind(ipv4_loopback(), 0, true, false);
    listener.listen(8);
    listener.set_nonblocking(true);
    var client = TcpStream();

    client.connect_local(listener.local_port());

    // Client connect can finish before the listener has a pending connection.
    var accept_poll = std.io.Poller(alloc);
    accept_poll.add_read(listener.get_fd());
    std.test.assert_eq(accept_poll.wait(1000), 1);
    var server = match listener.try_accept() {
      AcceptResult.Accepted(stream) => stream,
      _ => {
        std.test.fail("connection was not accepted");
        return;
      }
    };
    var size: i32 = 4096;
    var option: i32 = _target_is("macos") ? 4097 : 7;
    std.test.assert_eq(
      unsafe { __setsockopt(server.get_fd(), SOL_SOCKET, option, _address_of<i32>(size), 4); },
      0
    );
    var buffer = ContiguousBuffer<u8>(alloc, 1048576);
    buffer.fill(42);
    var bytes = ByteSlice(buffer);
    match server.try_write(bytes) {
      std.io.WriteResult.WouldBlock(n) => {
        std.test.assert(n > 0 and n < bytes.size(), "partial prefix precedes would-block");
      },
      _ => {
        std.test.fail("bounded socket should apply backpressure");
      }
    };
  }

  /** Reusing the same descriptor and token must not revive a removed cached event. */
  test_function stale_registration_reuse() {
    var alloc = make_heap_allocator();
    var wake = std.io.Wakeup(alloc);
    var loop = std.io.EventLoop(alloc, 4);
    loop.open();
    loop.add(wake.fd(), std.io.POLLIN, 1u64);
    wake.notify();
    std.test.assert_eq(loop.wait(1000), 1);
    loop.remove(wake.fd());
    loop.add(wake.fd(), std.io.POLLIN, 1u64);
    try {
      loop.event_at(0);

      std.test.fail("reused registration revived a stale event");
    } catch (error: IndexOutOfBoundsError) {} catch {
      std.test.fail("reused registration revived a stale event");
    }
    std.test.assert_eq(loop.wait(1000), 1);
    var current = loop.event_at(0);
    std.test.assert(current.token() == 1u64);
    loop.remove(wake.fd());
  }
}

/** Metadata and ownership with the first available descriptor. */
public module std {

  /** Open a real file at descriptor zero and verify metadata and cleanup after moving. */
  function metadata_at_zero() void throws {
    unsafe { c_close(0); };
    if (true) {
      var file = std.io.File();
      file.open("README.md", std.io.FileMode.Read);
      std.test.assert_eq(file.get_fd(), 0);
      std.test.assert(file.is_open());
      var info = file.metadata();
      std.test.assert(info.kind == std.io.FileKind.File);
      std.test.assert(info.size > 0);
      var moved = file;
      var after = moved.metadata();
      std.test.assert_eq(after.size, info.size);
    }
    std.test.assert_eq(unsafe { c_fcntl(0, 1); }, -1);
    return;
  }

  /** Isolate descriptor-zero ownership checks from the runner's input stream. */
  test_function file_metadata_descriptor_zero() {
    var pid = std.process.fork();
    if (pid == 0) {
      try {
        metadata_at_zero();

        std.process.exit_now(0);
      } catch {
        std.process.exit_now(1);
      }
    }
    var status = std.process.wait_pid(pid, 0);
    std.test.assert(std.process.exited(status));
    std.test.assert_eq(std.process.exit_status(status), 0);
  }
}
