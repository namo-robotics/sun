/** Terminal line-discipline layout and request codes for macOS. */
public module std.terminal {
  // c_lflag bit the kernel sets on a return to canonical mode; declared
  // ahead of Termios.equals, which masks it.
  const PENDIN: u64 = 0x20000000;

  /**
   * struct termios on macOS: four u64 flag words (tcflag_t is unsigned long),
   * 20 control characters, natural padding, then u64 input and output speeds.
   * 72 bytes, aligned to 8, on both arm64 and x86-64. Fields are filled by
   * tcgetattr and read back by tcsetattr; user code never touches them.
   */
  public class Termios {
    var iflag: u64 = 0;
    var oflag: u64 = 0;
    var cflag: u64 = 0;
    var lflag: u64 = 0;
    var cc: array<u8, 20>;
    var ispeed: u64 = 0;
    var ospeed: u64 = 0;

    /** Start from all-zero settings, ready for tcgetattr to fill in. */
    init() {
      var zeros: array<u8, 20> = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
      this.cc = zeros;
    }

    /**
     * Report whether every setting, including each control character,
     * matches. PENDIN is not a setting: the kernel sets it when a tcsetattr
     * returns the terminal to canonical mode, to mark typed-ahead input it
     * must reprocess, and clears it on the next read. It is masked out.
     */
    public const method equals(other: const ref Termios) bool {
      if (this.iflag != other.iflag or this.oflag != other.oflag) {
        return false;
      }
      if (this.cflag != other.cflag) {
        return false;
      }
      if ((this.lflag & ~PENDIN) != (other.lflag & ~PENDIN)) {
        return false;
      }
      if (this.ispeed != other.ispeed or this.ospeed != other.ospeed) {
        return false;
      }
      for (var i: i64 = 0; i < 20; i = i + 1) {
        if (this.cc[i] != other.cc[i]) {
          return false;
        }
      }
      return true;
    }
  }

  // c_lflag bits (sys/termios.h).
  const ISIG: u64 = 0x80;
  const ICANON: u64 = 0x100;
  const ECHO: u64 = 0x8;
  const IEXTEN: u64 = 0x400;
  // c_iflag and c_oflag bits.
  const ICRNL: u64 = 0x100;
  const IXON: u64 = 0x200;
  const OPOST: u64 = 0x1;
  // Indexes into c_cc.
  const VMIN: i64 = 16;
  const VTIME: i64 = 17;

  // ioctl request codes (sys/ttycom.h, with the _IOR/_IOW direction bits).
  /** Read the window size into a struct winsize. */
  public const TIOCGWINSZ: u64 = 0x40087468;
  /** Set the window size from a struct winsize. */
  public const TIOCSWINSZ: u64 = 0x80087467;
  /** Make the terminal the calling session's controlling terminal. */
  public const TIOCSCTTY: u64 = 0x20007461;
}
