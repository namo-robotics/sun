/** macOS timebase and native argument-record regressions. */
public module std.process {

  /** Exercise the macOS inspection record decoders. */

  /** Native libproc writes match the generated record's named fields. */
  test_function generated_process_record_fields() {
    var alloc = make_heap_allocator();
    var target = pid();
    var info = ContiguousBuffer<darwin_process_abi.proc_bsdinfo>(alloc, 1);
    var info_size = _convert<i32>(_sizeof<darwin_process_abi.proc_bsdinfo>());
    var got = unsafe { c_proc_pidinfo(target, 3, 0, info.raw_data(), info_size); };
    std.test.assert_eq(got, info_size);
    std.test.assert_eq(info[0].pbi_pid, _convert<u32>(target));
    var identity = process_identity(alloc, target);
    std.test.assert_eq(
      identity.start_marker,
      info[0].pbi_start_tvsec * 1000000 + info[0].pbi_start_tvusec
    );

    var task = ContiguousBuffer<darwin_process_abi.proc_taskinfo>(alloc, 1);
    var task_size = _convert<i32>(_sizeof<darwin_process_abi.proc_taskinfo>());
    got = unsafe { c_proc_pidinfo(target, 4, 0, task.raw_data(), task_size); };
    std.test.assert_eq(got, task_size);
    std.test.assert(task[0].pti_resident_size > 0, "resident memory is reported");
    std.test.assert(task[0].pti_threadnum > 0, "the current process has a thread");
  }

  /** Fractional timebases and large tick values convert without intermediate overflow. */
  test_function mach_time_units() {
    var nanos = process_mach_time_ns(24, 125, 3);
    std.test.assert_eq(nanos, _convert<u64>(1000));
    var large = process_mach_time_ns(U64_MAX, 1, 1);
    std.test.assert_eq(large, U64_MAX);
    var caught_failure_1 = false;
    try {
      process_mach_time_ns(U64_MAX, 125, 3);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_1 = true;
    }
    std.test.assert(caught_failure_1, "expected operation to fail");
    var caught_failure_2 = false;
    try {
      process_mach_time_ns(10, 1, 0);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_2 = true;
    }
    std.test.assert(caught_failure_2, "expected operation to fail");
  }

  /** KERN_PROCARGS2 padding is skipped and argc excludes environment entries. */
  test_function darwin_argument_record() {
    var alloc = make_heap_allocator();
    var text = String(alloc, "/bin/program\0\0program\0\0two words\0KEY=value\0");
    var data = ContiguousBuffer<u8>(alloc, text.length() + 4);
    unsafe { _store<i32>(data.raw_data(), 0, 3); };
    for (var i: i64 = 0; i < text.length(); i = i + 1) {
      data[i + 4] = process_byte(text, i);
    }
    var args = darwin_process_arguments(alloc, data, data.size());
    std.test.assert_eq(args.size(), 3);
    std.test.assert(
      args[0].equals_literal("program"),
      "argv excludes the executable prefix"
    );
    std.test.assert(args[1].is_empty(), "empty argument preserved");
    std.test.assert(args[2].equals_literal("two words"), "argument spaces preserved");
    var caught_failure_3 = false;
    try {
      darwin_process_arguments(alloc, data, 3);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_3 = true;
    }
    std.test.assert(caught_failure_3, "expected operation to fail");
    var caught_failure_4 = false;
    try {
      darwin_process_arguments(alloc, data, 4);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_4 = true;
    }
    std.test.assert(caught_failure_4, "expected operation to fail");
  }
}
