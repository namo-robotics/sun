/** Linux procfs inspection and pidfd process ownership. */
public module std.process {

  /** Build a procfs path with an explicitly supplied allocator. */
  function process_path(
    alloc: const ref HeapAllocator,
    target: i32,
    leaf: static_ptr<u8>
  ) String throws {
    var path = String(alloc, "/proc/");
    path.append_i64(_convert<i64>(target));
    path.append(leaf);
    return path;
  }

  /** Parse the selected unsigned stat field after the final parenthesis. */
  function process_stat_field(text: const ref String, field: i32) u64 throws {
    var end: i64 = text.length() - 1;
    while (end >= 0 and process_byte(text, end) != b')') {
      end = end - 1;
    }
    if (end < 0 or field < 4) {
      throw Error(22, "malformed process stat record");
    }
    var at = end + 2;
    var current: i32 = 3;
    while (current < field and at < text.length()) {
      while (at < text.length() and process_byte(text, at) != b' ') {
        at = at + 1;
      }
      while (at < text.length() and process_byte(text, at) == b' ') {
        at = at + 1;
      }
      current = current + 1;
    }
    var value: u64 = 0;
    var digits: i64 = 0;
    while (at < text.length() and process_byte(text, at) >= b'0' and
      process_byte(text, at) <= b'9') {
      var digit = _convert<u64>(process_byte(text, at) - b'0');
      if (value > (U64_MAX - digit) / 10) {
        throw Error(22, "process stat value overflows");
      }
      value = value * 10 + digit;
      digits = digits + 1;
      at = at + 1;
    }
    if (digits == 0 or
      (at < text.length() and process_byte(text, at) != b' ' and process_byte(text, at) != b'\n')) {
      throw Error(22, "missing process stat value");
    }
    return value;
  }

  /** Read the process's opaque start tick count from procfs. */
  function native_process_identity(
    alloc: const ref HeapAllocator,
    target: i32
  ) ProcessIdentity throws {
    var path = process_path(alloc, target, "/stat");
    var text = std.io.read_to_string(alloc, path);
    return ProcessIdentity(target, (process_stat_field(text, 22)));
  }

  /** Enumerate numeric procfs entries; no per-process privileges are requested. */
  function native_process_ids(alloc: const ref HeapAllocator) Vec<i32> throws {
    var entries = std.io.read_dir(alloc, "/proc");
    var ids = Vec<i32>(alloc, entries.size());
    for (var i: i64 = 0; i < entries.size(); i = i + 1) {
      match entries[i].name().parse_i64() {
        Option.Some(value) => {
          if (value > 0 and value <= 2147483647) {
            ids.push(_convert<i32>(value));
          }
        },
        Option.None => {}
      };
    }
    return ids;
  }

  /** Convert cumulative user and system ticks to nanoseconds without early overflow. */
  function process_cpu_ns(text: const ref String) u64 throws {
    var hz = unsafe { c_sysconf(2); };
    if (hz <= 0) {
      throw Error(22, "CPU clock tick rate unavailable");
    }
    var user = process_stat_field(text, 14);
    var system = process_stat_field(text, 15);
    var rate = _convert<u64>(hz);
    if (user > U64_MAX - system) {
      throw Error(22, "CPU time overflows");
    }
    var ticks = user + system;
    var seconds = ticks / rate;
    if (seconds > (U64_MAX / 1000000000) or rate > (U64_MAX / 1000000000)) {
      throw Error(22, "CPU time overflows");
    }
    var fraction = (ticks % rate) * 1000000000 / rate;
    var whole = seconds * 1000000000;
    if (whole > U64_MAX - fraction) {
      throw Error(22, "CPU time overflows");
    }
    return whole + fraction;
  }

  /** Convert resident page counts to bytes, rejecting invalid kernel data. */
  function process_rss_bytes(text: const ref String) u64 throws {
    var pages = process_stat_field(text, 24);
    var size = page_size_bytes();
    if (pages > U64_MAX / size) {
      throw Error(22, "resident size overflows");
    }
    return pages * size;
  }

  /** Grow readlink storage until the complete path fits, without silent truncation. */
  function process_executable(alloc: const ref HeapAllocator, target: i32) String throws {
    var path = process_path(alloc, target, "/exe");
    var capacity: i64 = 256;
    while (capacity <= 1048576) {
      var data = ContiguousBuffer<u8>(alloc, capacity);
      var size = unsafe { c_readlink(path.c_str(), data.raw_data(), capacity); };
      if (size < 0) {
        throw Error(errno(), "process executable unavailable");
      }
      if (size < capacity) {
        return process_text(alloc, data, 0, size);
      }
      capacity = capacity * 2;
    }
    throw Error(36, "process executable path is too long");
  }

  /** Read argv bytes independently so access failures remain field-specific. */
  function native_process_arguments(
    alloc: const ref HeapAllocator,
    target: i32
  ) Vec<String> throws {
    var path = process_path(alloc, target, "/cmdline");
    var text = std.io.read_to_string(alloc, path);
    return process_arguments(alloc, text);
  }

  /** Read resource fields from one stat record and collect optional text separately. */
  function native_process_snapshot(
    alloc: const ref HeapAllocator,
    target: i32
  ) ProcessSnapshot throws {
    var path = process_path(alloc, target, "/stat");
    var text = std.io.read_to_string(alloc, path);
    var identity = ProcessIdentity(target, (process_stat_field(text, 22)));
    return ProcessSnapshot(
      identity,
      process_cpu_ns(text),
      process_rss_bytes(text),
      process_executable(alloc, target),
      native_process_arguments(alloc, target)
    );
  }

  /** Query physical pages and convert to bytes with overflow checking. */
  function native_physical_memory_bytes() u64 throws {
    var pages = unsafe { c_sysconf(85); };
    if (pages <= 0) {
      throw Error(22, "physical memory unavailable");
    }
    var size = page_size_bytes();
    var count = _convert<u64>(pages);
    if (count > U64_MAX / size) {
      throw Error(22, "physical memory size overflows");
    }
    return count * size;
  }

  /** Report the kernel-backed guarantee, with no POSIX kill fallback. */
  function native_process_protection() ProcessProtection {
    return ProcessProtection.Atomic;
  }

  /** Open a pidfd, then verify its still-live process matches the requested identity. */
  function native_process_open(
    alloc: const ref HeapAllocator,
    identity: const ref ProcessIdentity
  ) i64 throws {
    // pidfd syscall numbers agree on the supported Linux x86_64 and aarch64 ABIs.
    var fd = unsafe { c_syscall(434, _convert<i64>(identity.pid), _convert<i64>(0)); };
    if (fd < 0) {
      throw Error(errno(), "pidfd_open failed; no fallback is used");
    }
    var token = fd + 1;
    try {
      var observed = process_identity(alloc, identity.pid);
      if (not identity.equals(observed)) {
        throw Error(3, "process identity changed");
      }
      // A dead pidfd must not validate a newly reused PID read from procfs.
      native_process_signal(alloc, identity, token, 0);
    } catch {
      native_process_close(token);
      throw;
    }
    return token;
  }

  /** Signal only through the owned pidfd; errno includes EPERM, ESRCH and ENOSYS. */
  function native_process_signal(
    alloc: const ref HeapAllocator,
    identity: const ref ProcessIdentity,
    token: i64,
    signal: i32
  ) void throws {
    if (unsafe {
      c_syscall(424, token - 1, _convert<i64>(signal), _convert<i64>(0), _convert<i64>(0));
    } < 0) {
      throw Error(errno(), "pidfd_send_signal failed");
    }
    return;
  }

  /** Close once; retrying close could accidentally close a reused descriptor. */
  function native_process_close(token: i64) void {
    unsafe { c_close(_convert<i32>(token - 1)); };
  }
}
