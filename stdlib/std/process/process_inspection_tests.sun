using std;
using std.process;

/** Native regression tests for portable process inspection and ownership. */
public module std.process {

  /** Require a failure and return its preserved native error code. */

  /** Current-process snapshots expose identity, text, and explicit resource units. */
  test_function snapshot_and_system_units() {
    var alloc = make_heap_allocator();
    var snapshot = inspect_process(alloc, pid());
    var identity = process_identity(alloc, pid());
    std.test.assert(
      snapshot.identity.equals(identity),
      "snapshot keeps the observed identity"
    );
    var rss = snapshot.rss_bytes;
    var cpu = snapshot.cpu_time_ns;
    var page = page_size_bytes();
    var memory = physical_memory_bytes();
    std.test.assert(page >= 1024 and page <= 1048576, "page size is in bytes");
    std.test.assert(rss >= page and rss <= memory, "resident memory is in bytes");
    std.test.assert(rss % page == 0, "resident memory counts whole pages");
    var executable = snapshot.executable;
    var args = snapshot.arguments;
    std.test.assert(not executable.is_empty(), "executable available for self");
    std.test.assert(args.size() > 0, "argv is available for self");
    var later = inspect_process(alloc, pid());
    var later_cpu = later.cpu_time_ns;
    std.test.assert(later_cpu >= cpu, "CPU time is cumulative");
    var ids = process_ids(alloc);
    var found = false;
    for (var i: i64 = 0; i < ids.size(); i = i + 1) {
      found = found or ids[i] == pid();
    }
    std.test.assert(found, "enumeration includes the caller");
  }

  /** Read an independent POSIX process CPU clock in nanoseconds. */
  function cpu_clock_ns() u64 throws {
    var ts = Timespec(0, 0);
    var clock_id: i32 = _target_is("linux") ? 2 : 12;
    var code = unsafe { c_clock_gettime(clock_id, ts); };
    std.test.assert_eq(code, 0);
    return _convert<u64>(ts.sec * 1000000000 + ts.nsec);
  }

  /** Snapshot CPU units agree with the OS process clock, allowing Linux tick rounding. */
  test_function cpu_time_is_nanoseconds() {
    var alloc = make_heap_allocator();
    var start = cpu_clock_ns();
    while ((cpu_clock_ns()) - start < 100000000) {}
    var before = cpu_clock_ns();
    var snapshot = inspect_process(alloc, pid());
    var after = cpu_clock_ns();
    var cpu = snapshot.cpu_time_ns;
    std.test.assert(cpu + 20000000 >= before, "CPU time is not ticks or microseconds");
    std.test.assert(cpu <= after + 20000000, "CPU time has nanosecond scale");
  }

  /** Invalid PIDs and stale start markers never target a process group or reused PID. */
  test_function invalid_and_reused_identity() {
    var alloc = make_heap_allocator();
    var caught_failure_1 = false;
    try {
      process_identity(alloc, 0);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_1 = true;
    }
    std.test.assert(caught_failure_1, "expected operation to fail");
    var caught_failure_2 = false;
    try {
      inspect_process(alloc, -1);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_2 = true;
    }
    std.test.assert(caught_failure_2, "expected operation to fail");
    var identity = process_identity(alloc, pid());
    var stale = ProcessIdentity(identity.pid, identity.start_marker + 1);
    var handle = ProcessHandle(alloc);
    var caught_failure_3 = false;
    try {
      handle.open(stale);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 3);
      caught_failure_3 = true;
    }
    std.test.assert(caught_failure_3, "expected operation to fail");
    var caught_failure_4 = false;
    try {
      handle.terminate();
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 9);
      caught_failure_4 = true;
    }
    std.test.assert(caught_failure_4, "expected operation to fail");
  }

  /** Closing twice and moving a handle do not signal or lose the owned reference. */
  test_function handle_move_and_close() {
    var alloc = make_heap_allocator();
    var identity = process_identity(alloc, pid());
    var original = ProcessHandle(alloc);
    original.open(identity);
    var moved = original;
    moved.close();
    moved.close();
    var caught_failure_5 = false;
    try {
      moved.kill();
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 9);
      caught_failure_5 = true;
    }
    std.test.assert(caught_failure_5, "expected operation to fail");
    var caught_failure_6 = false;
    try {
      moved.terminate();
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 9);
      caught_failure_6 = true;
    }
    std.test.assert(caught_failure_6, "expected operation to fail");
    moved.open(identity);
    var expected = _target_is("linux") ? ProcessProtection.Atomic : ProcessProtection.Checked;
    std.test.assert(moved.protection() == expected, "platform guarantee is explicit");
  }

  /** A bound handle kills its child, then rejects signaling after the child is reaped. */
  test_function handle_exit_and_kill() {
    var alloc = make_heap_allocator();
    var cmd = Command(alloc, "/bin/sleep");
    cmd.add_arg("30");
    var child = cmd.start();
    var identity = process_identity(alloc, child.id());
    var handle = ProcessHandle(alloc);
    handle.open(identity);
    handle.kill();
    std.test.assert_eq(child.wait(), 128 + SIGKILL);
    var code: i32 = 0;
    var caught_failure_7 = false;
    try {
      handle.kill();
    } catch (error: Error) {
      code = error.code();
      caught_failure_7 = true;
    }
    std.test.assert(caught_failure_7, "expected operation to fail");
    std.test.assert(code == 3 or code == 2, "exited process is unavailable");
    var caught_failure_8 = false;
    try {
      handle.open(identity);
    } catch (error: Error) {
      caught_failure_8 = true;
    }
    std.test.assert(caught_failure_8, "expected operation to fail");
    var caught_failure_9 = false;
    try {
      handle.kill();
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 9);
      caught_failure_9 = true;
    }
    std.test.assert(caught_failure_9, "expected operation to fail");
  }

  /** SIGTERM is delivered through an identity-bound handle. */
  test_function handle_terminate() {
    var alloc = make_heap_allocator();
    var cmd = Command(alloc, "/bin/sleep");
    cmd.add_arg("30");
    var child = cmd.start();
    var identity = process_identity(alloc, child.id());
    var handle = ProcessHandle(alloc);
    handle.open(identity);
    handle.terminate();
    std.test.assert_eq(child.wait(), 128 + SIGTERM);
  }

  /** NUL-delimited argv keeps spaces and empty arguments without a trailing fake argument. */
  test_function argument_boundaries() {
    var alloc = make_heap_allocator();
    var bytes = String(alloc, "program\0two words\0\0last\0");
    var args = std.process.process_arguments(alloc, bytes);
    std.test.assert_eq(args.size(), 4);
    std.test.assert(args[1].equals_literal("two words"), "spaces remain in one argument");
    std.test.assert(args[2].is_empty(), "empty argument preserved");
    var empty = String(alloc, "");
    var none = std.process.process_arguments(alloc, empty);
    std.test.assert_eq(none.size(), 0);
    var truncated = String(alloc, "missing terminator");
    var caught_failure_10 = false;
    try {
      std.process.process_arguments(alloc, truncated);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_10 = true;
    }
    std.test.assert(caught_failure_10, "expected operation to fail");
  }
}
