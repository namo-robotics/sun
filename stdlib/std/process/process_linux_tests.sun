/** Linux-specific native and procfs parser regressions. */
public module std.process {

  /** Tests for Linux process data and descriptor ownership. */

  /** Construct a stat fixture with a command name containing spaces and parentheses. */
  function stat_fixture(alloc: ref HeapAllocator) String throws {
    var text = String(alloc, "42 (name ) with (parens)) S");
    for (var field: i32 = 4; field <= 24; field = field + 1) {
      text.append_char(b' ');
      if (field == 14) {
        text.append("150");
      } else if (field == 15) {
        text.append("50");
      } else if (field == 22) {
        text.append("123456");
      } else if (field == 24) {
        text.append("7");
      } else {
        text.append("0");
      }
    }
    text.append_char(b'\n');
    return text;
  }

  /** Parsing does not confuse command-name delimiters with stat field boundaries. */
  test_function stat_units_and_names() {
    var alloc = make_heap_allocator();
    var text = stat_fixture(alloc);
    var start = process_stat_field(text, 22);
    std.test.assert_eq(start, _convert<u64>(123456));
    var ticks = unsafe { c_sysconf(2); };
    var cpu = process_cpu_ns(text);
    std.test.assert_eq(cpu, _convert<u64>(200000000000 / ticks));
    var rss = process_rss_bytes(text);
    var page = page_size_bytes();
    std.test.assert_eq(rss, page * 7);
    var malformed = String(alloc, "42 (bad) S 1");
    var caught_failure_1 = false;
    try {
      process_stat_field(malformed, 22);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_1 = true;
    }
    std.test.assert(caught_failure_1, "expected operation to fail");
    var negative = String(alloc, "42 (bad) S -1");
    var caught_failure_2 = false;
    try {
      process_stat_field(negative, 4);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_2 = true;
    }
    std.test.assert(caught_failure_2, "expected operation to fail");
    var overflow = String(alloc, "42 (bad) S 18446744073709551616");
    var caught_failure_3 = false;
    try {
      process_stat_field(overflow, 4);
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 22);
      caught_failure_3 = true;
    }
    std.test.assert(caught_failure_3, "expected operation to fail");
  }

  /** Repeated successful, failed, and moved handles release every pidfd. */
  test_function descriptors_are_closed() {
    var alloc = make_heap_allocator();
    var before = std.io.read_dir(alloc, "/proc/self/fd");
    var identity = process_identity(alloc, pid());
    var stale = ProcessIdentity(identity.pid, identity.start_marker + 1);
    for (var i: i32 = 0; i < 20; i = i + 1) {
      var handle = ProcessHandle(alloc);
      handle.open(identity);
      handle.open(identity);
      var caught_failure_4 = false;
      try {
        handle.open(stale);
      } catch (error: Error) {
        std.test.assert_eq(error.code(), 3);
        caught_failure_4 = true;
      }
      std.test.assert(caught_failure_4, "expected operation to fail");
      handle.open(identity);
      var moved = handle;
    }
    var after = std.io.read_dir(alloc, "/proc/self/fd");
    std.test.assert_eq(before.size(), after.size());
  }
}
