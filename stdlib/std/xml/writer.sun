/** Checked XML serialization with automatic namespace declarations. */
public module std.xml {

  /** Appends escaped character data to an existing buffer. */
  function xml_escape(out: ref String, text: const ref String, attribute: bool) void throws {
    for (var i: i64 = 0; i < text.length(); i += 1) {
      var c = xml_byte(text, i);
      if (c == 38) {
        out.append("&amp;");
      } else if (c == 60) {
        out.append("&lt;");
      } else if (c == 62) {
        out.append("&gt;");
      } else if (c == 13) {
        out.append("&#13;");
      } else if (attribute and c == 34) {
        out.append("&quot;");
      } else if (attribute and c == 9) {
        out.append("&#9;");
      } else if (attribute and c == 10) {
        out.append("&#10;");
      } else {
        out.append_char(_convert<u8>(c));
      }
    }

    return;
  }

  /** Tracks one open writer element and its delayed start tag. */
  class XmlWriteFrame {
    var qname: String;
    var head: String;
    var namespaces: Vec<XmlNamespace>;
    var attributes: Vec<XmlName>;

    /** Starts an empty frame with explicitly allocated storage. */
    init(alloc: const ref HeapAllocator) throws {
      this.qname = String(alloc, "");
      this.head = String(alloc, "");
      this.namespaces = Vec<XmlNamespace>(alloc, 4);
      this.attributes = Vec<XmlName>(alloc, 4);
    }
  }

  /** Appends checked XML to borrowed output; any failure permanently stops this writer. */
  public class XmlWriter {
    var alloc: HeapAllocator;
    var output: ref String;
    var stack: Vec<XmlWriteFrame>;
    var failed: bool = false;
    var finished: bool = false;
    var pending: bool = false;
    var started: bool = false;
    var roots: i64 = 0;
    var serial: i64 = 0;

    /** Borrows output and allocates only through the supplied allocator. */
    init(alloc: const ref HeapAllocator, output: ref String) throws {
      this.alloc = alloc.copy();
      this.output = output;
      this.stack = Vec<XmlWriteFrame>(alloc, 4);
    }

    /** Marks an operation failed until it explicitly completes successfully. */
    method begin() void throws {
      if (this.failed or this.finished) {
        throw xml_error("XML writer is failed or finished");
      }
      this.failed = true;
      return;
    }

    /** Commits an already validated delayed start tag. */
    method flush() void throws {
      if (this.pending) {
        this.output.append(this.stack[this.stack.size() - 1].head);
        this.output.append(">");
        this.pending = false;
      }

      return;
    }

    /** Finds an effective prefix binding, checking the prospective frame first. */
    method binding(
      frame: const ref XmlWriteFrame,
      prefix: const ref String
    ) Option<const ref String> {
      for (var i = frame.namespaces.size() - 1; i >= 0; i -= 1) {
        if (frame.namespaces[i].prefix.equals(prefix)) {
          return Option.Some(frame.namespaces[i].uri);
        }
      }
      for (var n = this.stack.size() - 1; n >= 0; n -= 1) {
        for (var i = this.stack[n].namespaces.size() - 1; i >= 0; i -= 1) {
          if (this.stack[n].namespaces[i].prefix.equals(prefix)) {
            return Option.Some(this.stack[n].namespaces[i].uri);
          }
        }
      }
      return Option.None;
    }

    /** Adds a declaration only when it changes the effective binding. */
    method bind(frame: ref XmlWriteFrame, prefix: String, uri: String) void throws {
      var same = match this.binding(frame, prefix) {
        Option.Some(value) => value.equals(uri),
        Option.None => prefix.is_empty() and uri.is_empty()
      };
      if (not same) {
        frame.head.append(" xmlns");
        if (not prefix.is_empty()) {
          frame.head.append(":");
          frame.head.append(prefix);
        }
        frame.head.append("=\"");
        xml_escape(frame.head, uri, true);
        frame.head.append("\"");
        frame.namespaces.push(XmlNamespace(prefix, uri));
      }

      return;
    }

    /** Selects a deterministic prefix without reinterpreting expanded name identity. */
    method qualify(
      frame: ref XmlWriteFrame,
      name: const ref XmlName,
      attribute: bool
    ) String throws {
      if (name.uri_.is_empty()) {
        if (not attribute) {
          this.bind(frame, String(this.alloc, ""), String(this.alloc, ""));
        }
        return name.local_.clone(this.alloc);
      }
      if (name.uri_.equals_literal("http://www.w3.org/XML/1998/namespace")) {
        var result = String(this.alloc, "xml:");
        result.append(name.local_);
        return result;
      }
      var prefix = name.prefix_.clone(this.alloc);
      var usable = not attribute or not prefix.is_empty();
      if (usable) {
        usable = match this.binding(frame, prefix) {
          Option.Some(uri) => uri.equals(name.uri_),
          Option.None => true
        };
      }
      if (not usable) {
        while (true) {
          this.serial += 1;
          prefix = String(this.alloc, "ns");
          xml_append_number(prefix, this.serial);
          var available = match this.binding(frame, prefix) {
            Option.Some(_) => false,
            Option.None => true
          };
          if (available) {
            break;
          }
        }
      }
      this.bind(frame, prefix.clone(this.alloc), name.uri_.clone(this.alloc));
      var result = String(this.alloc, "");
      if (not prefix.is_empty()) {
        result.append(prefix);
        result.append(":");
      }
      result.append(name.local_);
      return result;
    }

    /** Writes an optional declaration before any document content. */
    public method declaration() void throws {
      this.begin();
      if (this.started) {
        throw xml_error("XML declaration must be first");
      }
      this.output.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
      this.started = true;
      this.failed = false;
      return;
    }

    /** Opens an element, automatically declaring namespaces as needed. */
    public method start_element(name: const ref XmlName) void throws {
      var declarations = Vec<XmlNamespace>(this.alloc, 4);
      this.start_with_namespaces(name, declarations);
      return;
    }

    /** Opens a parsed element while preserving compatible explicit declarations. */
    method start_with_namespaces(
      name: const ref XmlName,
      declarations: const ref Vec<XmlNamespace>
    ) void throws {
      this.begin();
      name.validate();
      if (this.stack.size() >= 256) {
        throw xml_error("XML nesting too deep");
      }
      if (this.stack.is_empty() and this.roots != 0) {
        throw xml_error("multiple root elements");
      }
      var frame = XmlWriteFrame(this.alloc);
      // Namespace declarations are assembled before the lexical element name.
      for (var i: i64 = 0; i < declarations.size(); i += 1) {
        if (name.uri_.is_empty() and declarations[i].prefix.is_empty()) {
          continue;
        }
        this.bind(
          frame,
          declarations[i].prefix.clone(this.alloc),
          declarations[i].uri.clone(this.alloc)
        );
      }
      var qname = this.qualify(frame, name, false);
      var head = String(this.alloc, "<");
      head.append(qname);
      head.append(frame.head);
      frame.head = head;
      frame.qname = qname;
      this.flush();
      if (this.stack.is_empty()) {
        this.roots += 1;
      }
      this.stack.push(frame);
      this.pending = true;
      this.started = true;
      this.failed = false;
      return;
    }

    /** Adds an attribute while the current start tag remains open. */
    public method attribute(name: const ref XmlName, value: const ref String) void throws {
      this.begin();
      if (not this.pending) {
        throw xml_error("attribute requires an open start tag");
      }
      name.validate();
      xml_validate_text(value);
      if (name.uri_.is_empty() and name.local_.equals_literal("xmlns")) {
        throw xml_error("namespace declarations are managed automatically");
      }
      var n = this.stack.size() - 1;
      for (var i: i64 = 0; i < this.stack[n].attributes.size(); i += 1) {
        if (this.stack[n].attributes[i].equals(name)) {
          throw xml_error("duplicate expanded attribute");
        }
      }
      // Temporarily remove the current frame to avoid borrowing it through this.
      var frame = match this.stack.pop() {
        Option.Some(f) => f,
        Option.None => {
          throw xml_error("missing writer frame");
        }
      };
      var qname = this.qualify(frame, name, true);
      frame.head.append(" ");
      frame.head.append(qname);
      frame.head.append("=\"");
      xml_escape(frame.head, value, true);
      frame.head.append("\"");
      frame.attributes.push(name.clone(this.alloc));
      this.stack.push(frame);
      this.failed = false;
      return;
    }

    /** Writes character data, permitting only whitespace outside the root. */
    public method text(value: const ref String) void throws {
      this.begin();
      xml_validate_text(value);
      if (this.stack.is_empty()) {
        for (var i: i64 = 0; i < value.length(); i += 1) {
          if (not xml_space(xml_byte(value, i))) {
            throw xml_error("text outside root");
          }
        }
      }
      this.flush();
      if (this.stack.is_empty()) {
        this.output.append(value);
      } else {
        xml_escape(this.output, value, false);
      }
      this.started = true;
      this.failed = false;
      return;
    }

    /** Writes a validated comment. */
    public method comment(value: const ref String) void throws {
      this.begin();
      xml_validate_comment(value);
      this.flush();
      this.output.append("<!--");
      this.output.append(value);
      this.output.append("-->");
      this.started = true;
      this.failed = false;
      return;
    }

    /** Writes an uninterpreted, validated processing instruction. */
    public method instruction(target: const ref String, data: const ref String) void throws {
      this.begin();
      xml_validate_instruction(target, data);
      this.flush();
      this.output.append("<?");
      this.output.append(target);
      if (not data.is_empty()) {
        this.output.append(" ");
        this.output.append(data);
      }
      this.output.append("?>");
      this.started = true;
      this.failed = false;
      return;
    }

    /** Closes the innermost element, using empty-element syntax when possible. */
    public method end_element() void throws {
      this.begin();
      var frame = match this.stack.pop() {
        Option.Some(f) => f,
        Option.None => {
          throw xml_error("no open element");
        }
      };
      if (this.pending) {
        this.output.append(frame.head);
        this.output.append("/>");
        this.pending = false;
      } else {
        this.output.append("</");
        this.output.append(frame.qname);
        this.output.append(">");
      }
      this.failed = false;
      return;
    }

    /** Verifies completion and prevents further writes. */
    public method finish() void throws {
      this.begin();
      if (this.roots != 1 or not this.stack.is_empty()) {
        throw xml_error("incomplete XML document");
      }
      this.finished = true;
      this.failed = false;
      return;
    }
  }

  /** Appends positive decimal digits without allocating temporary strings. */
  function xml_append_number(out: ref String, value: i64) void throws {
    if (value >= 10) {
      xml_append_number(out, value / 10);
    }
    out.append_char(_convert<u8>(48 + value % 10));

    return;
  }

  /** Serializes ordered content through the checked writer. */
  function xml_write_node(writer: ref XmlWriter, node: ref XmlNode) void throws {
    return match node.value {
      XmlNodeValue.Element(e) => xml_write_element(writer, e),
      XmlNodeValue.Text(t) => writer.text(t),
      XmlNodeValue.Comment(t) => writer.comment(t),
      XmlNodeValue.Instruction(p) => writer.instruction(p.target, p.data)
    };
  }

  /** Serializes one element while preserving semantic names and content order. */
  function xml_write_element(writer: ref XmlWriter, element: ref XmlElement) void throws {
    writer.start_with_namespaces(element.name_, element.namespaces);
    for (var i: i64 = 0; i < element.attributes.size(); i += 1) {
      writer.attribute(element.attributes[i].name, element.attributes[i].value);
    }
    for (var i: i64 = 0; i < element.children.size(); i += 1) {
      xml_write_node(writer, element.children[i]);
    }
    return writer.end_element();
  }
}
