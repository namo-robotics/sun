/** Event-based parsing of complete UTF-8 XML input. */
public module std.xml {

  /** Owns a reader event; empty elements emit both Start and End. */
  public enum XmlEvent { Start(XmlElement), End(XmlName), Text(String), Comment(String), Instruction(XmlInstruction) }

  /** Keeps lexical names and namespace declarations for an open element. */
  class XmlFrame {
    var raw: String;
    var name: XmlName;
    var namespaces: Vec<XmlNamespace>;

    /** Moves one open element's state into the stack. */
    init(raw: String, name: XmlName, namespaces: Vec<XmlNamespace>) {
      this.raw = raw;
      this.name = name;
      this.namespaces = namespaces;
    }
  }

  /** Temporarily owns an unresolved attribute. */
  class XmlRawAttribute {
    var name: String;
    var value: String;
    var source_span: XmlSourceSpan;

    /** Moves lexical attribute data into temporary storage. */
    init(name: String, value: String, source_span: XmlSourceSpan) {
      this.name = name;
      this.value = value;
      this.source_span = source_span;
    }
  }

  /** Borrows input and owns only parser state and returned event payloads. */
  public class XmlReader {
    var alloc: HeapAllocator;
    var input: const ref String;
    var filename: Option<String> = Option.None;
    var pos: i64 = 0;
    var event_start: i64 = 0;
    var event_end: i64 = 0;
    var stack: Vec<XmlFrame>;
    var initialized: bool = false;
    var roots: i64 = 0;
    var pending_end: bool = false;
    var failure: Option<XmlError> = Option.None;

    /** Borrows complete input until the reader is destroyed. */
    init(alloc: const ref HeapAllocator, input: const ref String) throws {
      this.alloc = alloc.copy();
      this.input = input;
      this.stack = Vec<XmlFrame>(alloc, 4);
    }

    /** Borrows input and takes ownership of a diagnostic filename; performs no file I/O. */
    init(alloc: const ref HeapAllocator, input: const ref String, filename: String) throws {
      this.alloc = alloc.copy();
      this.input = input;
      this.stack = Vec<XmlFrame>(alloc, 4);
      this.filename = Option.Some(filename);
    }

    /** Copies the optional filename into an independently owned returned diagnostic. */
    method named_error(error: XmlError) XmlError throws {
      match this.filename {
        Option.Some(value) => {
          error.set_filename(value);
        },
        Option.None => {}
      };
      return error;
    }

    /** Reports a position in the original, unmodified input. */
    method error(message: static_ptr<u8>) XmlError {
      var line: i64 = 1;
      var column: i64 = 1;
      var i: i64 = 0;
      while (i < this.pos) {
        var c = xml_byte(this.input, i);
        if (c == 13) {
          line += 1;
          column = 1;
          if (xml_byte(this.input, i + 1) == 10 and i + 1 < this.pos) {
            i += 1;
          }
        } else if (c == 10) {
          line += 1;
          column = 1;
        } else if (c < 128 or c >= 192) {
          column += 1;
        }
        i += 1;
      }
      return XmlError(message, this.pos, line, column);
    }

    /** Tests a literal at the current byte position. */
    method starts(literal: static_ptr<u8>) bool {
      if (literal.length() > this.input.length() - this.pos) {
        return false;
      }
      var end = this.pos + literal.length();
      var view = this.input[this.pos:end];
      return view.equals_literal(literal);
    }

    /** Consumes XML whitespace. */
    method space() void {
      while (xml_space(xml_byte(this.input, this.pos))) {
        this.pos += 1;
      }
    }

    /** Consumes a required delimiter. */
    method expect(c: i64) void throws {
      if (xml_byte(this.input, this.pos) != c) {
        throw this.error("unexpected XML delimiter");
      }
      this.pos += 1;
      return;
    }

    /** Reads a lexical XML Name; QName restrictions are checked during resolution. */
    method raw_name() String throws {
      var start = this.pos;
      while (this.pos < this.input.length()) {
        var scalar = xml_scalar(this.input, this.pos);
        if (scalar.value != 58 and not xml_name_char(scalar.value)) {
          break;
        }
        if (this.pos == start and scalar.value != 58 and not xml_name_start(scalar.value)) {
          break;
        }
        this.pos += scalar.width;
      }
      if (this.pos == start) {
        throw this.error("expected XML name");
      }
      return xml_slice(this.alloc, this.input, start, this.pos);
    }

    /** Decodes a character reference directly into an output buffer. */
    method entity(out: ref String) void throws {
      this.expect(38);
      var start = this.pos;
      while (this.pos < this.input.length() and xml_byte(this.input, this.pos) != 59) {
        this.pos += 1;
      }
      if (this.pos == this.input.length()) {
        throw this.error("unterminated character reference");
      }
      var name = xml_slice(this.alloc, this.input, start, this.pos);
      this.pos += 1;
      if (name.equals_literal("amp")) {
        out.append("&");
      } else if (name.equals_literal("lt")) {
        out.append("<");
      } else if (name.equals_literal("gt")) {
        out.append(">");
      } else if (name.equals_literal("quot")) {
        out.append("\"");
      } else if (name.equals_literal("apos")) {
        out.append("'");
      } else {
        if (xml_byte(name, 0) != 35) {
          throw this.error("unknown entity; custom entities are unsupported");
        }
        var base: i64 = 10;
        var i: i64 = 1;
        var code: i64 = 0;
        if (xml_byte(name, i) == 120) {
          base = 16;
          i += 1;
        }
        if (i == name.length()) {
          throw this.error("empty character reference");
        }
        while (i < name.length()) {
          var c = xml_byte(name, i);
          var digit: i64 = -1;
          if (c >= 48 and c <= 57) {
            digit = c - 48;
          } else if (c >= 65 and c <= 70) {
            digit = c - 55;
          } else if (c >= 97 and c <= 102) {
            digit = c - 87;
          }
          if (digit < 0 or digit >= base or code > (1114111 - digit) / base) {
            throw this.error("invalid character reference");
          }
          code = code * base + digit;
          i += 1;
        }
        if (not xml_character(code)) {
          throw this.error("invalid referenced XML character");
        }
        for (var j: i64 = 0; j < compute_utf8_len(code); j += 1) {
          out.append_char(encode_utf8_byte(code, j));
        }
      }
      return;
    }

    /** Appends a source character with XML line-ending normalization. */
    method character(out: ref String, attribute: bool) void throws {
      var c = xml_byte(this.input, this.pos);
      this.pos += 1;
      if (c == 13) {
        if (xml_byte(this.input, this.pos) == 10) {
          this.pos += 1;
        }
        c = 10;
      }
      if (attribute and xml_space(c)) {
        c = 32;
      }
      out.append_char(_convert<u8>(c));

      return;
    }

    /** Reads a quoted attribute value and decodes references. */
    method quoted() String throws {
      var quote = xml_byte(this.input, this.pos);
      if (quote != 34 and quote != 39) {
        throw this.error("attribute must be quoted");
      }
      this.pos += 1;
      var out = String(this.alloc, "");
      while (xml_byte(this.input, this.pos) != quote) {
        var c = xml_byte(this.input, this.pos);
        if (c < 0 or c == 60) {
          throw this.error("invalid or unterminated attribute");
        }
        if (c == 38) {
          this.entity(out);
        } else {
          this.character(out, true);
        }
      }
      this.pos += 1;
      return out;
    }

    /** Reads normalized content through a literal terminator. */
    method until(end: static_ptr<u8>) String throws {
      var out = String(this.alloc, "");
      while (not this.starts(end)) {
        if (this.pos >= this.input.length()) {
          throw this.error("unterminated XML construct");
        }
        this.character(out, false);
      }
      this.pos += end.length();
      return out;
    }

    /** Validates the optional XML declaration and supported encoding. */
    method declaration() void throws {
      this.pos += 5;
      var index: i64 = 0;
      var encoding = false;
      var standalone = false;
      while (true) {
        var before = this.pos;
        this.space();
        if (this.starts("?>")) {
          this.pos += 2;
          break;
        }
        if (before == this.pos) {
          throw this.error("declaration fields require whitespace");
        }
        var name = this.raw_name();
        this.space();
        this.expect(61);
        this.space();
        // Declaration values cannot contain references or normalized whitespace.
        var quote = xml_byte(this.input, this.pos);
        if (quote != 34 and quote != 39) {
          throw this.error("declaration value must be quoted");
        }
        this.pos += 1;
        var start = this.pos;
        while (xml_byte(this.input, this.pos) != quote) {
          if (xml_byte(this.input, this.pos) < 0) {
            throw this.error("unterminated declaration");
          }
          this.pos += 1;
        }
        var value = xml_slice(this.alloc, this.input, start, this.pos);
        this.pos += 1;
        if (index == 0) {
          if (not name.equals_literal("version")) {
            throw this.error("XML declaration requires version first");
          }
          if (not value.equals_literal("1.0")) {
            throw this.error("only XML 1.0 is supported");
          }
        } else if (name.equals_literal("encoding") and not encoding and not standalone) {
          value.to_lower();
          if (not value.equals_literal("utf-8")) {
            throw this.error("only UTF-8 XML is supported");
          }
          encoding = true;
        } else if (name.equals_literal("standalone") and not standalone) {
          if (not value.equals_literal("yes") and not value.equals_literal("no")) {
            throw this.error("invalid standalone declaration");
          }
          standalone = true;
        } else {
          throw this.error("invalid XML declaration field");
        }
        index += 1;
      }
      if (index == 0) {
        throw this.error("XML declaration requires version");
      }
      return;
    }

    /** Resolves a prefix in the open element stack. */
    method namespace_uri(prefix: const ref String) String throws {
      if (prefix.equals_literal("xml")) {
        return String(this.alloc, "http://www.w3.org/XML/1998/namespace");
      }
      for (var n = this.stack.size() - 1; n >= 0; n -= 1) {
        for (var i: i64 = 0; i < this.stack[n].namespaces.size(); i += 1) {
          if (this.stack[n].namespaces[i].prefix.equals(prefix)) {
            return this.stack[n].namespaces[i].uri.clone(this.alloc);
          }
        }
      }
      if (prefix.is_empty()) {
        return String(this.alloc, "");
      }
      throw this.error("unbound namespace prefix");
    }

    /** Expands a QName; default namespaces do not apply to attributes. */
    method resolve(raw: const ref String, attribute: bool) XmlName throws {
      var colon: i64 = -1;
      for (var i: i64 = 0; i < raw.length(); i += 1) {
        if (xml_byte(raw, i) == 58) {
          if (colon >= 0) {
            throw this.error("multiple QName colons");
          }
          colon = i;
        }
      }
      var prefix = xml_slice(this.alloc, raw, 0, colon < 0 ? 0 : colon);
      var local = xml_slice(this.alloc, raw, colon + 1, raw.length());
      if (colon >= 0) {
        xml_validate_ncname(prefix);
      }
      xml_validate_ncname(local);
      var uri = String(this.alloc, "");
      if (colon >= 0 or not attribute) {
        uri = this.namespace_uri(prefix);
      }
      var name = XmlName(uri, local, prefix);
      name.validate();
      return name;
    }

    /** Parses a start tag and establishes its namespace scope. */
    method start_element() XmlEvent throws {
      this.pos += 1;
      var raw = this.raw_name();
      if (this.stack.size() >= 256) {
        throw this.error("XML nesting too deep");
      }
      if (this.stack.is_empty()) {
        this.roots += 1;
        if (this.roots > 1) {
          throw this.error("multiple root elements");
        }
      }
      var attributes = Vec<XmlRawAttribute>(this.alloc, 4);
      var namespaces = Vec<XmlNamespace>(this.alloc, 4);
      while (true) {
        var before = this.pos;
        this.space();
        var c = xml_byte(this.input, this.pos);
        if (c == 47 or c == 62) {
          break;
        }
        if (this.pos == before) {
          throw this.error("attributes require whitespace");
        }
        var attribute_start = this.pos;
        var key = this.raw_name();
        this.space();
        this.expect(61);
        this.space();
        var value = this.quoted();
        for (var i: i64 = 0; i < attributes.size(); i += 1) {
          if (attributes[i].name.equals(key)) {
            throw this.error("duplicate attribute");
          }
        }
        if (key.equals_literal("xmlns") or key.starts_with("xmlns:")) {
          var prefix = xml_slice(
            this.alloc,
            key,
            key.equals_literal("xmlns") ? key.length() : 6,
            key.length()
          );
          if (not prefix.is_empty()) {
            xml_validate_ncname(prefix);
          } else if (not key.equals_literal("xmlns")) {
            throw this.error("empty namespace prefix");
          }
          if (prefix.equals_literal("xmlns") or
            value.equals_literal("http://www.w3.org/2000/xmlns/") or
            (prefix.equals_literal("xml") !=
              value.equals_literal("http://www.w3.org/XML/1998/namespace")) or
            (not prefix.is_empty() and value.is_empty())) {
            throw this.error("invalid reserved namespace binding");
          }
          namespaces.push(XmlNamespace(prefix, value.clone(this.alloc)));
        }
        attributes.push(XmlRawAttribute(key, value, XmlSourceSpan(attribute_start, this.pos)));
      }
      var empty = xml_byte(this.input, this.pos) == 47;
      if (empty) {
        this.pos += 1;
      }
      this.expect(62);
      this.stack.push(
        XmlFrame(
          raw.clone(this.alloc),
          XmlName(
            String(this.alloc, ""),
            String(this.alloc, ""),
            String(this.alloc, "")
          ),
          namespaces
        )
      );
      var name = this.resolve(raw, false);
      this.stack[this.stack.size() - 1].name = name.clone(this.alloc);
      var element = XmlElement(this.alloc, name);
      for (var i: i64 = 0; i < this.stack[this.stack.size() - 1].namespaces.size(); i += 1) {
        element.namespaces.push(
          this.stack[this.stack.size() - 1].namespaces[i].clone(this.alloc)
        );
      }
      for (var i: i64 = 0; i < attributes.size(); i += 1) {
        if (attributes[i].name.equals_literal("xmlns") or attributes[i].name.starts_with("xmlns:")) {
          continue;
        }
        var key = this.resolve(attributes[i].name, true);
        for (var j: i64 = 0; j < element.attributes.size(); j += 1) {
          if (element.attributes[j].name.equals(key)) {
            throw this.error("duplicate expanded attribute");
          }
        }
        var attribute = XmlAttribute(key, attributes[i].value.clone(this.alloc));
        attribute.source_span = Option.Some(attributes[i].source_span.copy());
        element.attributes.push(attribute);
      }
      this.pending_end = empty;
      return XmlEvent.Start(element);
    }

    /** Returns the last successful event range; empty-element End events are zero-width. */
    public const method source_span() XmlSourceSpan {
      return XmlSourceSpan(this.event_start, this.event_end);
    }

    /** Advances the parser, retaining the first failure on subsequent calls. */
    public method next() Option<XmlEvent> throws {
      match this.failure {
        Option.Some(error) => {
          throw error.copy();
        },
        Option.None => {}
      };
      try {
        var event = this.next_impl();

        this.event_end = this.pos;
        return event;
      } catch (error: XmlError) {
        var located = this.error("");
        error.offset_ = located.offset_;
        error.line_ = located.line_;
        error.column_ = located.column_;
        match this.filename {
          Option.Some(value) => {
            error.set_filename(value);
          },
          Option.None => {}
        };
        this.failure = Option.Some(error.copy());
        throw;
      }
      return Option.None;
    }

    /** Implements event decoding after the sticky-error check. */
    method next_impl() Option<XmlEvent> throws {
      if (not this.initialized) {
        this.initialized = true;
        while (this.pos < this.input.length()) {
          var scalar = xml_scalar(this.input, this.pos);
          this.pos += scalar.width;
        }
        this.pos = 0;
        if (this.starts("\xef\xbb\xbf")) {
          this.pos = 3;
        }
        if (this.starts("<?xml") and xml_space(xml_byte(this.input, this.pos + 5))) {
          this.declaration();
        }
      }
      this.event_start = this.pos;
      if (this.pending_end) {
        this.pending_end = false;
        var frame = match this.stack.pop() {
          Option.Some(f) => f,
          Option.None => {
            throw this.error("unexpected closing tag");
          }
        };
        return Option.Some(XmlEvent.End(frame.name));
      }
      if (this.pos == this.input.length()) {
        if (not this.stack.is_empty() or this.roots != 1) {
          throw this.error("incomplete XML document");
        }
        return Option.None;
      }
      if (this.starts("<!--")) {
        this.pos += 4;
        var text = this.until("-->");
        xml_validate_comment(text);
        return Option.Some(XmlEvent.Comment(text));
      }
      if (this.starts("<?")) {
        this.pos += 2;
        var target = this.raw_name();
        var data = String(this.alloc, "");
        if (not this.starts("?>")) {
          if (not xml_space(xml_byte(this.input, this.pos))) {
            throw this.error("processing instruction requires whitespace");
          }
          this.space();
          data = this.until("?>");
        } else {
          this.pos += 2;
        }
        xml_validate_instruction(target, data);
        return Option.Some(XmlEvent.Instruction(XmlInstruction(target, data)));
      }
      if (this.starts("<![CDATA[")) {
        if (this.stack.is_empty()) {
          throw this.error("CDATA outside root");
        }
        this.pos += 9;
        return Option.Some(XmlEvent.Text(this.until("]]>")));
      }
      if (this.starts("<!")) {
        throw this.error("DTD and declarations are unsupported");
      }
      if (this.starts("</")) {
        this.pos += 2;
        var raw = this.raw_name();
        this.space();
        this.expect(62);
        var frame = match this.stack.pop() {
          Option.Some(f) => f,
          Option.None => {
            throw this.error("unexpected closing tag");
          }
        };
        if (not frame.raw.equals(raw)) {
          throw this.error("mismatched closing tag");
        }
        return Option.Some(XmlEvent.End(frame.name));
      }
      if (this.starts("<")) {
        return Option.Some(this.start_element());
      }
      var text = String(this.alloc, "");
      while (this.pos < this.input.length() and xml_byte(this.input, this.pos) != 60) {
        if (this.stack.is_empty() and not xml_space(xml_byte(this.input, this.pos))) {
          throw this.error("text outside root");
        }
        if (this.starts("]]>")) {
          throw this.error("CDATA terminator in text");
        }
        if (xml_byte(this.input, this.pos) == 38) {
          this.entity(text);
        } else {
          this.character(text, false);
        }
      }
      return Option.Some(XmlEvent.Text(text));
    }
  }

  /** Builds one owned subtree exclusively from validated reader events. */
  function xml_read_element(reader: ref XmlReader, element: XmlElement) XmlElement throws {
    var result = element;
    while (true) {
      var event = match (reader.next()) {
        Option.Some(e) => e,
        Option.None => {
          throw xml_error("incomplete XML element");
        }
      };
      match event {
        XmlEvent.Start(e) => {
          result.children.push(XmlNode(XmlNodeValue.Element(xml_read_element(reader, e))));
        },
        XmlEvent.End(_) => {
          return result;
        },
        XmlEvent.Text(t) => {
          result.children.push(XmlNode(XmlNodeValue.Text(t)));
        },
        XmlEvent.Comment(t) => {
          result.children.push(XmlNode(XmlNodeValue.Comment(t)));
        },
        XmlEvent.Instruction(p) => {
          result.children.push(XmlNode(XmlNodeValue.Instruction(p)));
        }
      };
    }
    throw xml_error("incomplete XML element");
  }

  /** Parses complete input into an independent editable document. */
  public function parse_xml(
    alloc: const ref HeapAllocator,
    input: const ref String
  ) XmlDocument throws {
    var reader = XmlReader(alloc, input);
    var before = Vec<XmlNode>(alloc, 4);
    while (true) {
      var event = match (reader.next()) {
        Option.Some(e) => e,
        Option.None => {
          throw xml_error("missing XML root");
        }
      };
      match event {
        XmlEvent.Start(e) => {
          var document = XmlDocument(alloc, xml_read_element(reader, e));
          document.before = std.replace(before, Vec<XmlNode>(alloc, 4));
          while (true) {
            var tail = match (reader.next()) {
              Option.Some(t) => t,
              Option.None => {
                return document;
              }
            };
            match tail {
              XmlEvent.Text(t) => {
                document.after.push(XmlNode(XmlNodeValue.Text(t)));
              },
              XmlEvent.Comment(t) => {
                document.after.push(XmlNode(XmlNodeValue.Comment(t)));
              },
              XmlEvent.Instruction(p) => {
                document.after.push(XmlNode(XmlNodeValue.Instruction(p)));
              },
              _ => {
                throw xml_error("unexpected XML root");
              }
            };
          }
        },
        XmlEvent.Text(t) => {
          before.push(XmlNode(XmlNodeValue.Text(t)));
        },
        XmlEvent.Comment(t) => {
          before.push(XmlNode(XmlNodeValue.Comment(t)));
        },
        XmlEvent.Instruction(p) => {
          before.push(XmlNode(XmlNodeValue.Instruction(p)));
        },
        _ => {
          throw xml_error("unexpected closing tag");
        }
      };
    }
    throw xml_error("missing XML root");
  }

  /** Parses literal input, releasing the temporary input after the tree is built. */
  public function parse_xml(
    alloc: const ref HeapAllocator,
    input: static_ptr<u8>
  ) XmlDocument throws {
    var text = String(alloc, input);
    return parse_xml(alloc, text);
  }

  /** Parse input and attach the owned filename only to XML diagnostics. */
  public function parse_xml(
    alloc: const ref HeapAllocator,
    input: const ref String,
    filename: String
  ) XmlDocument throws {
    try {
      return parse_xml(alloc, input);
    } catch (error: XmlError) {
      error.set_filename(filename);
      throw;
    }
  }

  /** Parses literal input with an owned diagnostic filename; performs no file I/O. */
  public function parse_xml(
    alloc: const ref HeapAllocator,
    input: static_ptr<u8>,
    filename: String
  ) XmlDocument throws {
    var text = String(alloc, input);
    return parse_xml(alloc, text, filename);
  }
}
