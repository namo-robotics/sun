public module std.xml {

  /** Combines assertion and XML failures without terminating the process. */
  enum XmlFixtureChecks { Ok, Assertion(std.test.AssertionError), Xml(XmlError), Bounds(IndexOutOfBoundsError), Allocation(AllocationError), InvalidArgument(InvalidArgumentError), Overflow(OverflowError), System(Error), NotFound(NotFoundError), Empty(EmptyError), Io(IOError), Conversion(ConversionError), DivisionByZero(DivisionByZeroError), Arithmetic(ArithmeticError), Json(std.json.JsonError), Decode(ProtoDecodeError) }

  /** Parses and round-trips xml-valid.xml (upstream blob bc997e6d6ef5a3d5860acb40bc01a63f3ab4400f). */
  test_function valid_xml() XmlFixtureChecks {
    var alloc = make_heap_allocator();
    var input = try String(
      alloc,
      "<?xml version=\"1.0\"?>\n<root xmlns:c=\"urn:test\" a=\"&lt;&amp;&quot;&apos;&gt;\" c:unicode=\"&#x1f600;\">\n  <!-- comment --> <child>héllo &#65;<![CDATA[<raw>]]></child>\n</root>\n"
    );
    var document = try parse_xml(alloc, input, try String(alloc, "xml-valid.xml"));
    var attribute = XmlName(
      try String(alloc, "urn:test"),
      try String(alloc, "unicode"),
      try String(alloc, "different")
    );
    try std.test.assert(
      match document.root().attribute(attribute) {
        Option.Some(value) => value.equals_literal("😀"),
        Option.None => false
      },
      "numeric entity and namespace URI are preserved"
    );
    var plain = XmlName(try String(alloc, ""), try String(alloc, "a"), try String(alloc, ""));
    try std.test.assert(
      match document.root().attribute(plain) {
        Option.Some(value) => value.equals_literal("<&\"'>"),
        Option.None => false
      },
      "predefined entities are decoded"
    );
    try std.test.assert(
      (try (try (try (try document.root().child(3)).element()).child(0)).text()).equals_literal(
        "héllo A"
      ),
      "Unicode text and decimal entity are decoded"
    );
    try std.test.assert(
      (try (try (try (try document.root().child(3)).element()).child(1)).text()).equals_literal(
        "<raw>"
      ),
      "CDATA is decoded"
    );
    var output = try String(alloc, "");
    try document.write(alloc, output);
    var again = try parse_xml(alloc, output);
    try std.test.assert(
      document.root().name().equals(again.root().name()),
      "root identity survives"
    );
    try std.test.assert_eq(document.root().attribute_count(), again.root().attribute_count());
    try std.test.assert_eq(document.root().child_count(), again.root().child_count());
    return XmlFixtureChecks.Ok;
  }

  /** Parses and round-trips Tiny-1.0.gir (upstream blob d8c358f7bd4af9a7ddb5635d1e0206f73317a41e). */
  test_function gir_class_and_function() XmlFixtureChecks {
    var alloc = make_heap_allocator();
    var input = try String(
      alloc,
      "<repository xmlns=\"http://www.gtk.org/introspection/core/1.0\" xmlns:c=\"http://www.gtk.org/introspection/c/1.0\" version=\"1.2\">\n  <namespace name=\"Tiny\" version=\"1.0\">\n    <class name=\"Object\" c:type=\"TinyObject\" parent=\"GObject.Object\">\n      <property name=\"enabled\" writable=\"1\" transfer-ownership=\"none\"><type name=\"gboolean\" c:type=\"gboolean\"/></property>\n    </class>\n    <function name=\"increment\" c:identifier=\"tiny_increment\">\n      <return-value transfer-ownership=\"none\"><type name=\"gint\" c:type=\"gint\"/></return-value>\n      <parameters><parameter name=\"value\" transfer-ownership=\"none\"><type name=\"gint\" c:type=\"gint\"/></parameter></parameters>\n    </function>\n    <function name=\"unsupported\" c:identifier=\"tiny_unsupported\">\n      <return-value><type name=\"Mystery\" c:type=\"Mystery\"/></return-value>\n    </function>\n  </namespace>\n</repository>\n"
    );
    var document = try parse_xml(alloc, input, try String(alloc, "Tiny-1.0.gir"));
    try input.replace("xmlns:c=", "xmlns:native=");
    try input.replace("c:", "native:");
    var renamed = try parse_xml(alloc, input);
    var ns = try (try renamed.root().child(1)).element();
    var cls = try (try ns.child(1)).element();
    try std.test.assert(
      cls.name().uri().equals_literal("http://www.gtk.org/introspection/core/1.0"),
      "GIR element namespace survives prefix changes"
    );
    var key = XmlName(
      try String(alloc, "http://www.gtk.org/introspection/c/1.0"),
      try String(alloc, "type"),
      try String(alloc, "c")
    );
    try std.test.assert(
      match cls.attribute(key) {
        Option.Some(value) => value.equals_literal("TinyObject"),
        Option.None => false
      },
      "GIR C type lookup uses URI identity"
    );
    var output = try String(alloc, "");
    try document.write(alloc, output);
    var again = try parse_xml(alloc, output);
    try std.test.assert(
      document.root().name().equals(again.root().name()),
      "root identity survives"
    );
    try std.test.assert_eq(document.root().attribute_count(), again.root().attribute_count());
    try std.test.assert_eq(document.root().child_count(), again.root().child_count());
    return XmlFixtureChecks.Ok;
  }

  /** Parses and round-trips TinyDep-1.0.gir (upstream blob 767363e29e330a9b89c0412939a19ba15e4b9dfb). */
  test_function gir_dependency() XmlFixtureChecks {
    var alloc = make_heap_allocator();
    var input = try String(
      alloc,
      "<repository xmlns=\"http://www.gtk.org/introspection/core/1.0\" xmlns:c=\"http://www.gtk.org/introspection/c/1.0\">\n  <namespace name=\"TinyDep\" version=\"1.0\">\n    <bitfield name=\"Flags\" c:type=\"TinyFlags\"><member name=\"one\" value=\"1\" c:identifier=\"TINY_ONE\"/></bitfield>\n  </namespace>\n</repository>\n"
    );
    var document = try parse_xml(alloc, input, try String(alloc, "TinyDep-1.0.gir"));
    var output = try String(alloc, "");
    try document.write(alloc, output);
    var again = try parse_xml(alloc, output);
    try std.test.assert(
      document.root().name().equals(again.root().name()),
      "root identity survives"
    );
    try std.test.assert_eq(document.root().attribute_count(), again.root().attribute_count());
    try std.test.assert_eq(document.root().child_count(), again.root().child_count());
    return XmlFixtureChecks.Ok;
  }

  /** Parses and round-trips selection.xml (upstream blob a2fa979486dcb7f017cd784475240d5346675aff). */
  test_function generator_selection() XmlFixtureChecks {
    var alloc = make_heap_allocator();
    var input = try String(
      alloc,
      "<selection><namespace name=\"Tiny\" version=\"1.0\" module=\"tiny\"><function symbol=\"tiny_increment\"/></namespace></selection>\n"
    );
    var document = try parse_xml(alloc, input, try String(alloc, "selection.xml"));
    var output = try String(alloc, "");
    try document.write(alloc, output);
    var again = try parse_xml(alloc, output);
    try std.test.assert(
      document.root().name().equals(again.root().name()),
      "root identity survives"
    );
    try std.test.assert_eq(document.root().attribute_count(), again.root().attribute_count());
    try std.test.assert_eq(document.root().child_count(), again.root().child_count());
    return XmlFixtureChecks.Ok;
  }

  /** Rejects the generator's malformed XML fixtures with recoverable source diagnostics. */
  test_function malformed_fixtures() XmlFixtureChecks {
    var a = make_heap_allocator();
    var cases = try Vec<String>(a, 16);
    try cases.push(try String("<r>"));
    try cases.push(try String("<r></wrong>"));
    try cases.push(try String("<r/><s/>"));
    try cases.push(try String("<r a=\"1\"a=\"2\"/>"));
    try cases.push(try String("<r a=\"1\" a=\"2\"/>"));
    try cases.push(try String("<r>&unknown;</r>"));
    try cases.push(try String("<r>&#0;</r>"));
    try cases.push(try String("<r>&#xD800;</r>"));
    try cases.push(try String("<r>&#99999999;</r>"));
    try cases.push(try String("<!DOCTYPE r SYSTEM \"file:///etc/passwd\"><r/>"));
    try cases.push(try String("<r><!-- bad -- comment --></r>"));
    try cases.push(try String("<r>]]></r>"));
    try cases.push(try String("<r a=\"<\"/>"));
    var overlong = try String("<r>");
    try overlong.append_char(192);
    try overlong.append_char(128);
    try overlong.append("</r>");
    try cases.push(overlong);
    var truncated = try String("<r>");
    try truncated.append_char(240);
    try truncated.append_char(144);
    try truncated.append("</r>");
    try cases.push(truncated);
    var nul = try String("<r>");
    try nul.append_char(0);
    try nul.append("</r>");
    try cases.push(nul);

    try cases.push(try String("<r><missing:child/></r>"));
    try cases.push(try String("<r xmlns:a=\"urn:x\" xmlns:b=\"urn:x\" a:x=\"1\" b:x=\"2\"/>"));
    for (var content: ref String in cases) {
      match parse_xml(a, content, try String(a, "input.xml")) {
        Result.Xml(error) => {
          try std.test.assert(
            error.line() > 0 and error.column() > 0,
            "source coordinates are present"
          );
          try std.test.assert(
            match error.filename() {
              Option.Some(value) => value.equals_literal("input.xml"),
              Option.None => false
            },
            "source filename is present"
          );
        },
        Result.Ok(_) => {
          try std.test.assert(false, "malformed fixture accepted");
        },
        _ => false
      };
    }
    return XmlFixtureChecks.Ok;
  }
}
