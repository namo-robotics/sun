using std.json;
using std.io;

// stdlib/std/test/test.sun - Unit testing: assertions, test results, and the runner.
//
// Test functions are declared with `test_function` and compiled only into
// the test binary. For that binary the compiler synthesizes a main that runs
// every test through its result runner — each on its own thread by default — and
// reports with report/finish. Passing --test-sequential to the test binary
// runs the tests one after another in declaration order instead.
//
// A failed assertion returns AssertionError. Propagation runs the same drop
// glue as normal scope exit, so a fixture class's deinit (the teardown)
// still runs when a test fails.
//
// Usage:
//   test_function growsWhenFull() {
//       var v = try Vec<i32>(global_allocator);
//       try v.push(1);
//       try std.test.assert_eq(v.size(), 1);
//   }

/** Assertions and helpers for running tests. */
public module std.test {

  /**
   * Raised by a failed assertion; carries the explanation text.
   */
  public class AssertionError implements IError {
    var message_: Error;

    /**
     * Build the error from a literal explanation.
     */
    init(message: static_ptr<u8>) {
      this.message_ = Error(10, message);
    }

    /**
     * Build the error from text composed at runtime; the text is copied.
     */
    init(message: const ref String) AllocationResult<void> {
      this.message_ = try Error(10, message);
    }

    /**
     * Error code 10: assertion failure.
     */
    public const method code() i32 {
      return 10;
    }

    /**
     * A fresh copy of the explanation, owned by the caller.
     */
    public const method message() AllocationResult<String> {
      return this.message_.message();
    }
  }

  /** Carries a successful assertion value or an owned assertion failure. */
  public enum AssertionResult<T> {
    Ok(T),
    Allocation(AllocationError),
    InvalidArgument(InvalidArgumentError),
    Overflow(OverflowError),
    Error(AssertionError),
    System(Error),
    OutOfBounds(IndexOutOfBoundsError),
    NotFound(NotFoundError),
    Empty(EmptyError),
    Io(IOError),
    Conversion(ConversionError),
    DivisionByZero(DivisionByZeroError),
    Arithmetic(ArithmeticError),
    Json(std.json.JsonError),
    Xml(std.xml.XmlError),
    Decode(ProtoDecodeError)
  }

  /**
   * Returns AssertionError when the condition is false.
   */
  public function assert(condition: bool) std.test.AssertionResult<void> {
    if (condition) {
      return std.test.AssertionResult.Ok;
    }
    return std.test.AssertionResult.Error(AssertionError("assertion failed"));
  }

  /**
   * Same, with an explanation shown in the failure output.
   */
  public function assert(condition: bool, message: static_ptr<u8>) std.test.AssertionResult<void> {
    if (condition) {
      return std.test.AssertionResult.Ok;
    }
    return std.test.AssertionResult.Error(AssertionError(message));
  }

  /** Returns AssertionError when primitive values differ, showing both in the failure text. */
  public function assert_eq<T: _Primitive>(expected: T, actual: T) std.test.AssertionResult<void> {
    if (expected == actual) {
      return std.test.AssertionResult.Ok;
    }
    return std.test.AssertionResult.Error(
      try AssertionError(try `assertion failed: expected ${expected}, got ${actual}`)
    );
  }

  /**
   * Compare two strings by content.
   */
  public function assert_eq(
    expected: const ref String,
    actual: const ref String
  ) std.test.AssertionResult<void> {
    if (expected.equals(actual)) {
      return std.test.AssertionResult.Ok;
    }
    return std.test.AssertionResult.Error(
      try AssertionError(try `assertion failed: expected ${expected}, got ${actual}`)
    );
  }

  /** Returns AssertionError when primitive values are equal, showing the value in the failure text. */
  public function assert_ne<T: _Primitive>(a: T, b: T) std.test.AssertionResult<void> {
    if (a == b) {
      return std.test.AssertionResult.Error(
        try AssertionError(try `assertion failed: both values are ${a}`)
      );
    }
    return std.test.AssertionResult.Ok;
  }

  /**
   * Unconditionally fail with the given message.
   */
  public function fail(message: static_ptr<u8>) std.test.AssertionResult<void> {
    return std.test.AssertionResult.Error(AssertionError(message));
  }

  /** Returns the success value or reports the unexpected error as an assertion failure. */
  public function expect_ok<T, E>(result: _Result<T, E>) std.test.AssertionResult<T> {
    return match result {
      _Result.Ok(value) => std.test.AssertionResult.Ok(value),
      _Result.Err(error) => match error {
        (e: const ref IError) => std.test.AssertionResult.Error(
          try AssertionError(try e.message())
        )
      }
    };
  }

  /** Reads a primitive success through a borrow, or reports its error as an assertion failure. */
  public function expect_value<T: _Primitive, E>(
    result: _Result<ref T, E>
  ) std.test.AssertionResult<T> {
    return match result {
      _Result.Ok(value) => std.test.AssertionResult.Ok(value),
      _Result.Err(error) => match error {
        (e: const ref IError) => std.test.AssertionResult.Error(
          try AssertionError(try e.message())
        )
      }
    };
  }

  /** Checks that an operation returning no value succeeded. */
  public function expect_success<E>(result: _Result<void, E>) std.test.AssertionResult<void> {
    return match result {
      _Result.Ok => std.test.AssertionResult.Ok,
      _Result.Err(error) => match error {
        (e: const ref IError) => std.test.AssertionResult.Error(
          try AssertionError(try e.message())
        )
      }
    };
  }

  /** Returns a checked access value or reports its bounds error as a test failure. */
  public function expect_access<T>(result: AccessResult<T>) std.test.AssertionResult<T> {
    return match result {
      AccessResult.Ok(value) => std.test.AssertionResult.Ok(value),
      AccessResult.OutOfBounds(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Reads a checked scalar borrow before returning its value to the test. */
  public function expect_access_value<T: _Primitive>(
    result: AccessResult<ref T>
  ) std.test.AssertionResult<T> {
    return match result {
      AccessResult.Ok(value) => std.test.AssertionResult.Ok(value),
      AccessResult.OutOfBounds(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Reports an unexpected bounds failure from a checked access update. */
  public function expect_access_success(result: AccessResult<void>) std.test.AssertionResult<void> {
    return match result {
      AccessResult.Ok => std.test.AssertionResult.Ok,
      AccessResult.OutOfBounds(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Returns a found value or reports its lookup error as a test failure. */
  public function expect_lookup<T>(result: LookupResult<T>) std.test.AssertionResult<T> {
    return match result {
      LookupResult.Ok(value) => std.test.AssertionResult.Ok(value),
      LookupResult.NotFound(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Reads a found scalar borrow or reports its lookup error as a test failure. */
  public function expect_lookup_value<T: _Primitive>(
    result: LookupResult<ref T>
  ) std.test.AssertionResult<T> {
    return match result {
      LookupResult.Ok(value) => std.test.AssertionResult.Ok(value),
      LookupResult.NotFound(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Checks that a lookup-based update succeeded. */
  public function expect_lookup_success(result: LookupResult<void>) std.test.AssertionResult<void> {
    return match result {
      LookupResult.Ok => std.test.AssertionResult.Ok,
      LookupResult.NotFound(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Returns a removed value or reports an empty collection as a test failure. */
  public function expect_pop<T>(result: PopResult<T>) std.test.AssertionResult<T> {
    return match result {
      PopResult.Ok(value) => std.test.AssertionResult.Ok(value),
      PopResult.Empty(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Returns a JSON value or reports its error as a test failure. */
  public function expect_json<T>(result: JsonResult<T>) std.test.AssertionResult<T> {
    return match result {
      JsonResult.Ok(value) => std.test.AssertionResult.Ok(value),
      JsonResult.Error(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Checks that a JSON container update succeeded. */
  public function expect_json_success(result: JsonResult<void>) std.test.AssertionResult<void> {
    return match result {
      JsonResult.Ok => std.test.AssertionResult.Ok,
      JsonResult.Error(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Returns a converted value or reports a conversion test failure. */
  public function expect_conversion<T>(result: ConversionResult<T>) std.test.AssertionResult<T> {
    return match result {
      ConversionResult.Ok(value) => std.test.AssertionResult.Ok(value),
      ConversionResult.Error(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Checks that an arithmetic update succeeded. */
  public function expect_arithmetic_success(
    result: ArithmeticResult<void>
  ) std.test.AssertionResult<void> {
    return match result {
      ArithmeticResult.Ok => std.test.AssertionResult.Ok,
      (error: const ref IError) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Returns an arithmetic value or reports its error as a test failure. */
  public function expect_arithmetic<T>(result: ArithmeticResult<T>) std.test.AssertionResult<T> {
    return match result {
      ArithmeticResult.Ok(value) => std.test.AssertionResult.Ok(value),
      (error: const ref IError) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Returns a system-call value or reports its error as a test failure. */
  public function expect_system<T>(result: SystemResult<T>) std.test.AssertionResult<T> {
    return match result {
      SystemResult.Ok(value) => std.test.AssertionResult.Ok(value),
      SystemResult.Error(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      ),
      SystemResult.Allocation(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      ),
      SystemResult.InvalidArgument(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      ),
      SystemResult.Overflow(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /** Checks that a system operation succeeded. */
  public function expect_system_success(result: SystemResult<void>) std.test.AssertionResult<void> {
    return match result {
      SystemResult.Ok => std.test.AssertionResult.Ok,
      SystemResult.Error(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      ),
      SystemResult.Allocation(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      ),
      SystemResult.InvalidArgument(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      ),
      SystemResult.Overflow(error) => std.test.AssertionResult.Error(
        try AssertionError(try error.message())
      )
    };
  }

  /**
   * The outcome of one test, produced on the test's thread and moved back
   * to the main thread through join. The message is empty on a pass.
   */
  public class TestResult {
    public var name: static_ptr<u8>;
    public var passed: bool;
    public var message: AllocationResult<String>;

    /** Own a diagnostic result without allocating while recording a test outcome. */
    init(name: static_ptr<u8>, passed: bool, message: AllocationResult<String>) {
      this.name = name;
      this.passed = passed;
      this.message = message;
    }
  }

  /** Run a test and retain diagnostic allocation failures for reporting. */
  public function run_one<E>(name: static_ptr<u8>, fn: function () _Result<void, E>) TestResult {
    return match fn() {
      _Result.Ok => TestResult(name, true, String("")),
      _Result.Err(error) => match error {
        (e: const ref IError) => TestResult(name, false, e.message())
      }
    };
  }

  /** Run a structural result test without allocating to wrap its outcome. */
  public function run_result<R>(name: static_ptr<u8>, fn: function () R) TestResult {
    return match fn() {
      (error: const ref IError) => TestResult(name, false, error.message()),
      _ => TestResult(name, true, String(""))
    };
  }

  /** Print an outcome without allocating, using fixed text when diagnostic creation failed. */
  public function report(result: const ref TestResult) bool {
    if (result.passed) {
      print("PASS ");
      println(result.name);
      return true;
    }
    print("FAIL ");
    print(result.name);
    print(": ");
    match result.message {
      AllocationResult.Ok(text) => {
        println(text);
      },
      _ => {
        println("unable to allocate error message");
      }
    };
    return false;
  }

  /** Print totals without allocating and return the process exit status. */
  public function finish(total: i64, failed: i64) i32 {
    print(total - failed);
    print(" passed, ");
    print(failed);
    println(" failed");
    return failed > 0 ? 1 : 0;
  }

  /**
   * True when the test binary's arguments ask for sequential execution
   * ("--test-sequential" anywhere in argv).
   */
  public function wants_sequential(argc: i32, argv: raw_ptr<raw_ptr<i8>>) AllocationResult<bool> {
    var env = try std.env.Env(global_allocator);
    var cli = try env.args(argc, argv);
    var i: i64 = 0;
    while (i < cli.size()) {
      if (unsafe { cli.get_unchecked(i); }.equals_literal("--test-sequential")) {
        return AllocationResult.Ok(true);
      }
      i = i + 1;
    }
    return AllocationResult.Ok(false);
  }

  /**
   * True when the dotted test name matches one filter pattern: the exact
   * name, a trailing-star prefix ("geometry.*"), or a module prefix
   * ("geometry" selects everything under it).
   */
  function matches(name: const ref String, pattern: const ref String) bool {
    if (name.equals(pattern)) {
      return true;
    }
    var plen: i64 = pattern.length();
    if (plen > 0 and unsafe { pattern.unsafe_at(plen - 1); } == b'*') {
      if (name.length() < plen - 1) {
        return false;
      }
      for (var i: i64 = 0; i < plen - 1; i = i + 1) {
        if (unsafe { name.unsafe_at(i); } != unsafe { pattern.unsafe_at(i); }) {
          return false;
        }
      }
      return true;
    }
    return name.length() > plen and name.starts_with(pattern) and
      unsafe { name.unsafe_at(plen); } == b'.';
  }

  /**
   * True when the test named `name` should run, given the test binary's
   * arguments. Every "--test-filter <pattern>" in argv contributes one
   * pattern; a test runs when it matches any of them, and no patterns at
   * all runs every test.
   */
  public function is_selected(
    name: static_ptr<u8>,
    argc: i32,
    argv: raw_ptr<raw_ptr<i8>>
  ) AllocationResult<bool> {
    var env = try std.env.Env(global_allocator);
    var cli = try env.args(argc, argv);
    var name_text = try String(name);
    var saw_filter = false;
    var i: i64 = 0;
    while (i + 1 < cli.size()) {
      if (unsafe { cli.get_unchecked(i); }.equals_literal("--test-filter")) {
        saw_filter = true;
        if (matches(name_text, unsafe { cli.get_unchecked(i + 1); })) {
          return AllocationResult.Ok(true);
        }
        i = i + 2;
        continue;
      }
      i = i + 1;
    }
    return AllocationResult.Ok(saw_filter == false);
  }
}
