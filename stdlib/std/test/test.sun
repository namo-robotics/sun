using std.json;
using std.io;

// stdlib/std/test/test.sun - Unit testing: assertions, test results, and the runner.
//
// Test functions are declared with `test_function` and compiled only into
// the test binary. For that binary the compiler synthesizes a main that runs
// every test through its result runner — each on its own thread by default — and
// reports with report/finish. Passing --test-sequential to the test binary
// runs the tests one after another in declaration order instead.
//
// A failed assertion returns AssertionError. Propagation runs the same drop
// glue as normal scope exit, so a fixture class's deinit (the teardown)
// still runs when a test fails.
//
// Usage:
//   test_function growsWhenFull() {
//       var v = Vec<i32>(global_allocator);
//       v.push(1);
//       std.test.assert_eq(v.size(), 1);
//   }

/** Assertions and helpers for running tests. */
public module std.test {

  /**
   * Raised by a failed assertion; carries the explanation text.
   */
  public exception AssertionError implements IError {
    var text_: array<u8, 96> = [
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8
    ];
    var text_length_: i32 = 0;

    /** Copies and truncates the supplied diagnostic without allocating. */
    init(message: static_ptr<u8>) {
      this.text_length_ = 0;
      for (var i: i64 = 0; i < message.length() and i < 96; i += 1) {
        this.text_[i] = unsafe { _load<u8>(message.raw(), i); };
        this.text_length_ += 1;
      }
    }

    /** Copies and truncates the supplied diagnostic without allocating. */
    init(message: const ref String) {
      this.text_length_ = 0;
      for (var i: i64 = 0; i < message.length() and i < 96; i += 1) {
        this.text_[i] = unsafe { message.unsafe_at(i); };
        this.text_length_ += 1;
      }
    }

    /** Returns the numeric failure code. */
    public const method code() i32 {
      return 10;
    }

    /** Copies the bounded diagnostic into an explicitly requested owned string. */
    public const method message() String throws {
      var text = String("");
      for (var i: i64 = 0; i < _convert<i64>(this.text_length_); i += 1) {
        text.append_char(this.text_[i]);
      }
      return text;
    }
  }

  /** Carries a successful assertion value or an owned assertion failure. */

  /**
   * Returns AssertionError when the condition is false.
   */
  public function assert(condition: bool) void throws {
    if (condition) {
      return;
    }
    throw AssertionError("assertion failed");
  }

  /**
   * Same, with an explanation shown in the failure output.
   */
  public function assert(condition: bool, message: static_ptr<u8>) void throws {
    if (condition) {
      return;
    }
    throw AssertionError(message);
  }

  /** Returns AssertionError when primitive values differ, showing both in the failure text. */
  public function assert_eq<T: _Primitive>(expected: T, actual: T) void throws {
    if (expected == actual) {
      return;
    }
    throw AssertionError(`assertion failed: expected ${expected}, got ${actual}`);
  }

  /**
   * Compare two strings by content.
   */
  public function assert_eq(expected: const ref String, actual: const ref String) void throws {
    if (expected.equals(actual)) {
      return;
    }
    throw AssertionError(`assertion failed: expected ${expected}, got ${actual}`);
  }

  /** Returns AssertionError when primitive values are equal, showing the value in the failure text. */
  public function assert_ne<T: _Primitive>(a: T, b: T) void throws {
    if (a == b) {
      throw AssertionError(`assertion failed: both values are ${a}`);
    }
    return;
  }

  /**
   * Unconditionally fail with the given message.
   */
  public function fail(message: static_ptr<u8>) void throws {
    throw AssertionError(message);
  }

  /**
   * The outcome of one test, produced on the test's thread and moved back
   * to the main thread through join. The message is empty on a pass.
   */
  public class TestResult {
    public var name: static_ptr<u8>;
    public var passed: bool;
    public var message: Option<String>;

    /** Stores a completed test outcome; None denotes unavailable diagnostic text. */
    init(name: static_ptr<u8>, passed: bool, message: Option<String>) {
      this.name = name;
      this.passed = passed;
      this.message = message;
    }
  }

  /** Runs one test and catches failures before returning to its thread entrypoint. */
  public function run_one(name: static_ptr<u8>, fn: function () void throws) TestResult {
    try {
      fn();
      return TestResult(name, true, Option.None);
    } catch (error: AssertionError) {
      try {
        return TestResult(name, false, Option.Some(error.message()));
      } catch {
        return TestResult(name, false, Option.None);
      }
    } catch {
      return TestResult(name, false, Option.None);
    }
  }

  /** Reports a completed test without allocating additional text. */
  public function report(result: const ref TestResult) bool {
    if (result.passed) {
      print("PASS ");
      println(result.name);
      return true;
    }
    print("FAIL ");
    print(result.name);
    print(": ");
    match result.message {
      Option.Some(text) => {
        println(text);
      },
      Option.None => {
        println("test threw an exception; diagnostic unavailable");
      }
    };
    return false;
  }

  /** Print totals without allocating and return the process exit status. */
  public function finish(total: i64, failed: i64) i32 {
    print(total - failed);
    print(" passed, ");
    print(failed);
    println(" failed");
    return failed > 0 ? 1 : 0;
  }

  /**
   * True when the test binary's arguments ask for sequential execution
   * ("--test-sequential" anywhere in argv).
   */
  public function wants_sequential(argc: i32, argv: raw_ptr<raw_ptr<i8>>) bool throws {
    var env = std.env.Env(global_allocator);
    var cli = env.args(argc, argv);
    var i: i64 = 0;
    while (i < cli.size()) {
      if (unsafe { cli.get_unchecked(i); }.equals_literal("--test-sequential")) {
        return true;
      }
      i = i + 1;
    }
    return false;
  }

  /**
   * True when the dotted test name matches one filter pattern: the exact
   * name, a trailing-star prefix ("geometry.*"), or a module prefix
   * ("geometry" selects everything under it).
   */
  function matches(name: const ref String, pattern: const ref String) bool {
    if (name.equals(pattern)) {
      return true;
    }
    var plen: i64 = pattern.length();
    if (plen > 0 and unsafe { pattern.unsafe_at(plen - 1); } == b'*') {
      if (name.length() < plen - 1) {
        return false;
      }
      for (var i: i64 = 0; i < plen - 1; i = i + 1) {
        if (unsafe { name.unsafe_at(i); } != unsafe { pattern.unsafe_at(i); }) {
          return false;
        }
      }
      return true;
    }
    return name.length() > plen and name.starts_with(pattern) and
      unsafe { name.unsafe_at(plen); } == b'.';
  }

  /**
   * True when the test named `name` should run, given the test binary's
   * arguments. Every "--test-filter <pattern>" in argv contributes one
   * pattern; a test runs when it matches any of them, and no patterns at
   * all runs every test.
   */
  public function is_selected(
    name: static_ptr<u8>,
    argc: i32,
    argv: raw_ptr<raw_ptr<i8>>
  ) bool throws {
    var env = std.env.Env(global_allocator);
    var cli = env.args(argc, argv);
    var name_text = String(name);
    var saw_filter = false;
    var i: i64 = 0;
    while (i + 1 < cli.size()) {
      if (unsafe { cli.get_unchecked(i); }.equals_literal("--test-filter")) {
        saw_filter = true;
        if (matches(name_text, unsafe { cli.get_unchecked(i + 1); })) {
          return true;
        }
        i = i + 2;
        continue;
      }
      i = i + 1;
    }
    return saw_filter == false;
  }
}
