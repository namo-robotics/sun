/** Regression tests for bounded byte storage and native-endian decoding. */
public module std {

  /** Checks boundaries, unaligned decoding, signed values, and overflow-sized offsets. */
  test_function native_decoding_checks_slice_bounds() {
    var alloc = make_heap_allocator();
    var buffer = ContiguousBuffer<u8>(alloc, 12);
    buffer.fill(255);
    var bytes = ByteSlice(buffer, 1, 8);
    std.test.assert_eq(bytes.size(), 8);
    std.test.assert_eq(
      std.byte_order.read_native_i16(bytes, 1),
      -1
    );
    std.test.assert_eq(
      std.byte_order.read_native_i32(bytes, 1),
      -1
    );
    std.test.assert_eq(
      std.byte_order.read_native_i64(bytes, 0),
      -1
    );
    std.test.assert_eq(
      std.byte_order.read_native_u16(bytes, 6),
      65535
    );
    std.test.assert_eq(
      std.byte_order.read_native_u32(bytes, 4),
      4294967295
    );
    std.test.assert_eq(
      std.byte_order.read_native_u64(bytes, 0),
      18446744073709551615
    );
    var offsets: array<i64, 4> = [-1, 1, 8, std.I64_MAX];
    for (var i: i64 = 0; i < 4; i = i + 1) {
      var offset = offsets[i];
      try {
        std.byte_order.read_native_i64(bytes, offset);

        std.test.fail("invalid native load succeeded");
      } catch (ignored_error: IndexOutOfBoundsError) {}
    }
  }

  /** Rejects invalid slice ranges without adding potentially overflowing bounds. */
  test_function byte_slices_reject_invalid_ranges() {
    var alloc = make_heap_allocator();
    var buffer = ContiguousBuffer<u8>(alloc, 8);
    var starts: array<i64, 3> = [-1, 9, std.I64_MAX];
    for (var i: i64 = 0; i < 3; i = i + 1) {
      var start = starts[i];
      try {
        ByteSlice(buffer, start, 0);

        std.test.fail("invalid start accepted");
      } catch (ignored_error: IndexOutOfBoundsError) {}
      try {
        MutableByteSlice(buffer, start, 0);

        std.test.fail("invalid mutable start accepted");
      } catch (ignored_error: IndexOutOfBoundsError) {}
    }
    var counts: array<i64, 3> = [-1, 8, std.I64_MAX];
    for (var i: i64 = 0; i < 3; i = i + 1) {
      var count = counts[i];
      try {
        ByteSlice(buffer, 1, count);

        std.test.fail("invalid length accepted");
      } catch (ignored_error: IndexOutOfBoundsError) {}
      try {
        MutableByteSlice(buffer, 1, count);

        std.test.fail("invalid mutable length accepted");
      } catch (ignored_error: IndexOutOfBoundsError) {}
    }
  }

  /** Copies the host representation at an unaligned offset and decodes exactly that value. */
  test_function native_decoding_preserves_host_order() {
    var alloc = make_heap_allocator();
    var buffer = ContiguousBuffer<u8>(alloc, 10);
    buffer.fill(0);
    var expected: i64 = -72623859790382856;
    unsafe {
      _memcpy(
        _ptr_offset(buffer.raw_data(), 1),
        _ptr_as_raw<u8>(_address_of<i64>(expected)),
        _sizeof<i64>()
      );
    };
    var bytes = ByteSlice(buffer, 1, 8);
    std.test.assert_eq(
      std.byte_order.read_native_i64(bytes, 0),
      expected
    );
    try {
      bytes.get(8);

      std.test.fail("slice get must not read outside its range");
    } catch (ignored_error: IndexOutOfBoundsError) {} catch {
      std.test.fail("slice get must not read outside its range");
    }
  }
}
