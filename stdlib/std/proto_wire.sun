// stdlib/std/proto_wire.sun - Protobuf wire-format primitives
//
// Encoding/decoding helpers used by the classes the compiler synthesizes for
// `manifest { protos: [...] }` schemas. All integer arithmetic is done in u64;
// per-proto-type wrappers do the sign/width conversions.
//
// Wire types: 0 = varint, 1 = 64-bit, 2 = length-delimited, 5 = 32-bit.

/** Provides the standard-library declarations implemented in this source file. */
public module std {

  // ==========================================================================
  // Errors
  // ==========================================================================

  /** Reports malformed or unsupported protobuf wire data. */
  public exception ProtoDecodeError implements IError {
    var text_: array<u8, 96> = [
      0u8,
      0u8,
