/** Queries of host CPU availability. */
public module std.thread {
  /**
   * Return online logical CPUs, not affinity, container quota, or recommended worker count.
   * Query on each call. Failure is an error with no silent fallback; callers may choose one.
   */
  public function online_cpu_count() SystemResult<i64> {
    unsafe { _store<i32>(errno_ptr(), 0, 0); };
    var count = unsafe { c_sysconf(ONLINE_CPUS); };
    if (count <= 0) {
      return SystemResult.Error(Error(errno(), "online CPU count unavailable"));
    }
    return SystemResult.Ok(count);
  }
}
