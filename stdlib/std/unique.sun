/** Provides sole ownership with allocator-specific destruction. */
public module std.mem {

  using std;

  /** Owns a value and its allocator binding. A may be an owned allocator or a reference. */
  public class Unique<T, A: IAllocator> {
    var data: raw_ptr<T>;
    var allocator: A;

    /** Allocate storage and move an initialized value into it. */
    init(value: T, allocator: A) throws {
      this.allocator = allocator;
      this.data = alloc<T>(this.allocator, 1);
      unsafe { _store<T>(this.data, 0, value); };
    }

    /** Adopt initialized storage from the supplied allocator, or null.
     * The caller must transfer exclusive ownership of a compatible allocation.
     */
    unsafe init(pointer: raw_ptr<T>, allocator: A) {
      this.data = pointer;
      this.allocator = allocator;
    }

    /** Borrow the initialized value. A null owner cannot be dereferenced. */
    public const method get() ref T {
      if (this.data == null) {
        panic("cannot dereference an empty Unique");
      }
      return unsafe { _to_ref<T>(this.data); };
    }

    /** Expose the address without transferring ownership. */
    public const method get_raw() raw_ptr<T> {
      return this.data;
    }

    /** Report whether this owner contains no allocation. */
    public const method is_null() bool {
      return this.data == null;
    }

    /** Destroy the value and return its storage through the original allocator. */
    deinit() {
      if (this.data != null) {
        unsafe { _deinit<T>(this.data); };
        dealloc<T>(this.allocator, this.data, 1);
        this.data = null;
      }
    }
  }

  /** Precompile an owner using the stateless system allocator. */
  public declare Unique_i8 = Unique<i8, HeapAllocator>;
}
