/** Exercise process-wide signal state sequentially within one test. */
public module std.signal {

  /** Deliver a signal synchronously to the calling thread. */
  extern "C" function test_raise(sig: i32) i32 as "raise";

  /** Own a subscription across a propagated error to exercise destructor cleanup. */
  function subscription_error() void throws {
    var subscription = SignalSubscription();
    throw Error(1, "expected test error");
  }

  /** Deliver from another thread after the event loop has had time to block. */
  function delayed_signal() i32 {
    std.time.sleep(std.time.create_duration_millis(20));
    return unsafe { test_raise(std.process.SIGTERM); };
  }

  /** Coalescing, full-pipe safety, pollers, moves, restoration, and exclusive ownership. */
  test_function signal_subscription_lifecycle() {
    var alloc = make_heap_allocator();
    var subscription = SignalSubscription();
    var fd = subscription.fd();
    std.test.assert(fd >= 0);
    std.test.assert((unsafe { c_fcntl(fd, 1); } & 1) != 0);
    std.test.assert((unsafe { c_fcntl(fd, 3); } & O_NONBLOCK) != 0);
    try {
      var other = SignalSubscription();

      std.test.assert(false, "overlapping subscription accepted");
    } catch (error: Error) {
      std.test.assert_eq(error.code(), 16);
    } catch (error: AllocationError) {
      std.test.assert_eq(error.code(), 16);
    } catch (error: InvalidArgumentError) {
      std.test.assert_eq(error.code(), 16);
    } catch (error: OverflowError) {
      std.test.assert_eq(error.code(), 16);
    }
    var poller = std.io.Poller(alloc);
    poller.add_read(fd);
    var loop = std.io.EventLoop(alloc, 4);
    loop.open();
    loop.add(fd, std.io.POLLIN, 7u64);
    var sender = std.thread.spawn(delayed_signal);
    std.test.assert((loop.wait(1000)) > 0);
    std.test.assert_eq(sender.join(), 0);
    var wakeup = subscription.take_pending();
    std.test.assert(wakeup.terminated());
    var poll_sender = std.thread.spawn(delayed_signal);
    std.test.assert_eq(poller.wait(1000), 1);
    std.test.assert_eq(poll_sender.join(), 0);
    var poll_wakeup = subscription.take_pending();
    std.test.assert(poll_wakeup.terminated());
    for (var i: i32 = 0; i < 100; i = i + 1) {
      std.test.assert_eq(unsafe { test_raise(std.process.SIGINT); }, 0);
      std.test.assert_eq(unsafe { test_raise(std.process.SIGTERM); }, 0);
      std.test.assert_eq(poller.wait(1000), 1);
      std.test.assert((loop.wait(1000)) > 0);
      var events = subscription.take_pending();
      std.test.assert(events.interrupted() and events.terminated());
      var empty = subscription.take_pending();
      std.test.assert(not empty.any());
      std.test.assert_eq(poller.wait(0), 0);
    }

    // Fill the pipe deliberately: the handler must not block or lose either bit.
    var byte: u8 = 1;
    var shared = state();
    while (unsafe { c_write(shared.writer, _address_of<u8>(byte), 1); } == 1) {}
    std.test.assert_eq(errno(), WOULD_BLOCK_ERRNO);
    unsafe { _store<i32>(errno_ptr(), 0, 123); };
    unsafe {
      test_raise(std.process.SIGINT);
      test_raise(std.process.SIGTERM);
    };
    std.test.assert_eq(errno(), 123);
    var full = subscription.take_pending();
    std.test.assert(full.interrupted() and full.terminated());

    loop.remove(fd);
    poller.remove(fd);
    var moved = subscription;
    std.test.assert_eq(moved.fd(), fd);
    moved.restore();
    moved.restore();
    std.test.assert_eq(moved.fd(), -1);
    std.test.assert_eq(unsafe { c_fcntl(fd, 1); }, -1);
    try {
      subscription_error();
    } catch {}
    var again = SignalSubscription();
    unsafe { test_raise(std.process.SIGTERM); };
    var final_events = again.take_pending();
    std.test.assert(final_events.terminated());
  }
}
