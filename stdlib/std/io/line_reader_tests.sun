/** Exercises bounded file lines and deterministic stream interruptions. */
public module std.io {

  /** Verifies a line's status and exact bytes. */
  function expect_line(
    reader: ref std.io.LineReader,
    expected: static_ptr<u8>,
    incomplete: bool
  ) void throws {
    match reader.next() {
      std.io.LineReadResult.Complete => {
        std.test.assert(not incomplete, "complete line");
      },
      std.io.LineReadResult.Incomplete => {
        std.test.assert(incomplete, "incomplete final line");
      },
      _ => {
        std.test.fail("expected a line");
      }
    };
    std.test.assert(reader.line().equals_literal(expected), "exact line bytes");
    return;
  }

  /** Verifies stable EOF and an empty exposed line. */
  function expect_eof(reader: ref std.io.LineReader) void throws {
    for (var i: i64 = 0; i < 2; i = i + 1) {
      match reader.next() {
        std.io.LineReadResult.Eof => {},
        _ => {
          std.test.fail("expected EOF");
        }
      };
      std.test.assert_eq(reader.line().length(), 0);
    }
    return;
  }

  /** Checks empty files, empty lines, CR preservation, and LF at every buffer position. */
  test_function line_reader_boundaries() {
    var alloc = make_heap_allocator();
    var td = std.tests.TempDir(alloc, "line_boundaries");
    var path = td.file("lines");
    var empty = String("");
    std.io.write_string(path, empty);
    if (true) {
      var file = std.io.File();
      file.open(path, std.io.FileMode.Read);
      var reader = std.io.LineReader(alloc, file, 8, 3);
      expect_eof(reader);
    }
    var body = String("\nabc\ndefg\nh\r\nlast");
    std.io.write_string(path, body);
    for (var size: i64 = 1; size < 10; size = size + 1) {
      var file = std.io.File();
      file.open(path, std.io.FileMode.Read);
      var reader = std.io.LineReader(alloc, file, 4, size);
      expect_line(reader, "", false);
      expect_line(reader, "abc", false);
      expect_line(reader, "defg", false);
      expect_line(reader, "h\r", false);
      expect_line(reader, "last", true);
      expect_eof(reader);
    }
  }

  /** Checks exact limits, overlong draining and recovery, and overlong final data. */
  test_function line_reader_limits() {
    var alloc = make_heap_allocator();
    var td = std.tests.TempDir(alloc, "line_limits");
    var path = td.file("lines");
    var body = String("abcd\nabcdefghij\nok\nabcde");
    std.io.write_string(path, body);
    var file = std.io.File();
    file.open(path, std.io.FileMode.Read);
    var reader = std.io.LineReader(alloc, file, 4, 3);
    expect_line(reader, "abcd", false);
    match reader.next() {
      std.io.LineReadResult.TooLong => {},
      _ => {
        std.test.fail("expected overlong line");
      }
    };
    std.test.assert(reader.line().equals_literal("abcd"), "bounded prefix");
    expect_line(reader, "ok", false);
    match reader.next() {
      std.io.LineReadResult.TooLong => {},
      _ => {
        std.test.fail("expected overlong final line");
      }
    };
    std.test.assert_eq(reader.line().length(), 4);
    expect_eof(reader);
  }

  /** Streams a file much larger than the buffers and recognizes newline-terminated EOF. */
  test_function line_reader_large_file() {
    var alloc = make_heap_allocator();
    var td = std.tests.TempDir(alloc, "line_large");
    var path = td.file("lines");
    if (true) {
      var file = std.io.File();
      file.open(path, std.io.FileMode.Write);
      for (var i: i64 = 0; i < 20000; i = i + 1) {
        file.write("record\n");
      }
    }
    var file = std.io.File();
    file.open(path, std.io.FileMode.Read);
    var reader = std.io.LineReader(alloc, file, 6, 31);
    for (var i: i64 = 0; i < 20000; i = i + 1) {
      expect_line(reader, "record", false);
    }
    expect_eof(reader);
  }

  /** Rejects invalid sizes and permits zero-length limits without confusing data with EOF. */
  test_function line_reader_invalid_and_zero_limits() {
    var alloc = make_heap_allocator();
    var file = std.io.File();
    try {
      std.io.LineReader(alloc, file, -1, 3);

      std.test.fail("negative limit accepted");
    } catch (ignored_error: Error) {} catch {
      std.test.fail("negative limit accepted");
    }
    try {
      std.io.LineReader(alloc, file, 4, 0);

      std.test.fail("empty read buffer accepted");
    } catch (ignored_error: Error) {} catch {
      std.test.fail("empty read buffer accepted");
    }
    var td = std.tests.TempDir(alloc, "line_zero");
    var path = td.file("lines");
    var body = String("\nx\n");
    std.io.write_string(path, body);
    file.open(path, std.io.FileMode.Read);
    var reader = std.io.LineReader(alloc, file, 0, 2);
    expect_line(reader, "", false);
    match reader.next() {
      std.io.LineReadResult.TooLong => {},
      _ => {
        std.test.fail("zero limit accepts only empty lines");
      }
    };
    expect_eof(reader);
  }

  /** Injects short reads, EINTR, would-block, and errors while delivering a final partial record. */
  class FragmentedReader implements std.io.ByteReader {
    var calls: i64 = 0;

    /** Returns one byte at a time, with retryable interruptions between bytes. */
    public unsafe method read(fd: i32, data: raw_ptr<u8>, count: i64) i64 {
      this.calls = this.calls + 1;
      if (this.calls == 1 or this.calls == 4) {
        unsafe { _store<i32>(errno_ptr(), 0, INTERRUPTED_ERRNO); };
        return -1;
      }
      if (this.calls == 3) {
        unsafe { _store<i32>(errno_ptr(), 0, WOULD_BLOCK_ERRNO); };
        return -1;
      }
      if (this.calls == 7) {
        unsafe { _store<i32>(errno_ptr(), 0, 5); };
        return -1;
      }
      if (this.calls > 8) {
        return 0;
      }
      var ch: u8 = b'a';
      if (this.calls == 5) {
        ch = b'\n';
      }
      unsafe { _store<u8>(data, 0, ch); };
      return 1;
    }
  }

  /** Keeps partial lines across retryable results and distinguishes a truncated final record. */
  test_function line_reader_partial_reads_and_interruptions() {
    var alloc = make_heap_allocator();
    var file = std.io.File();
    var reader = std.io.LineReader(alloc, file, 4, 8);
    var operation = FragmentedReader();
    match std.io.next_line_using(reader, operation) {
      std.io.LineReadResult.WouldBlock => {},
      _ => {
        std.test.fail("expected would-block");
      }
    };
    std.test.assert(reader.line().equals_literal("a"), "partial data retained");
    match std.io.next_line_using(reader, operation) {
      std.io.LineReadResult.Complete => {},
      _ => {
        std.test.fail("expected complete short line");
      }
    };
    std.test.assert(reader.line().equals_literal("a"), "interruption loses no bytes");
    try {
      match std.io.next_line_using(reader, operation) {
        _ => {
          std.test.fail("expected I/O error");
        }
      };
    } catch (e: Error) {
      std.test.assert_eq(e.code(), 5);
    }
    std.test.assert(reader.line().equals_literal("a"), "I/O error retains partial data");
    match std.io.next_line_using(reader, operation) {
      std.io.LineReadResult.Incomplete => {},
      _ => {
        std.test.fail("expected interrupted final record");
      }
    };
    std.test.assert(reader.line().equals_literal("aa"), "short reads accumulate");
    expect_eof(reader);
  }

  /** Retains overlong-line draining state across would-block and native errors. */
  test_function line_reader_interrupted_overlong_drain() {
    var alloc = make_heap_allocator();
    var file = std.io.File();
    var reader = std.io.LineReader(alloc, file, 0, 8);
    var operation = FragmentedReader();
    match std.io.next_line_using(reader, operation) {
      std.io.LineReadResult.WouldBlock => {},
      _ => {
        std.test.fail("expected would-block during drain");
      }
    };
    match std.io.next_line_using(reader, operation) {
      std.io.LineReadResult.TooLong => {},
      _ => {
        std.test.fail("overlong state survives would-block");
      }
    };
    try {
      match std.io.next_line_using(reader, operation) {
        _ => {
          std.test.fail("expected error during drain");
        }
      };
    } catch (ignored_error: Error) {}
    match std.io.next_line_using(reader, operation) {
      std.io.LineReadResult.TooLong => {},
      _ => {
        std.test.fail("overlong state survives error until EOF");
      }
    };
    std.test.assert_eq(reader.line().length(), 0);
    expect_eof(reader);
  }
}
