/** Kernel-backed, level-triggered descriptor readiness with application tokens. */
public module std.io {

  /** A readiness snapshot; its token belongs to the registration at wait time. */
  public class ReadyEvent {
    var event_: Event;
    var token_: u64;
    var generation: u64 = 0;

    /** Capture a native event and its application's token. */
    init(event: Event, token: u64) {
      this.event_ = event;
      this.token_ = token;
    }

    /** Return the registered descriptor. */
    public const method fd() i32 {
      return this.event_.fd();
    }

    /** Return the application's token without narrowing it. */
    public const method token() u64 {
      return this.token_;
    }

    /** Return the portable POLL* readiness bits. */
    public const method events() i16 {
      return this.event_.events();
    }

    /** Report available input. */
    public const method is_readable() bool {
      return this.event_.is_readable();
    }

    /** Report available output space. */
    public const method is_writable() bool {
      return this.event_.is_writable();
    }

    /** Report a peer shutdown; buffered input may still be readable. */
    public const method is_hup() bool {
      return this.event_.is_hup();
    }

    /** Report a descriptor error. */
    public const method is_error() bool {
      return this.event_.is_error();
    }
  }

  /** Registration metadata kept separately from platform-specific event layouts. */
  public class EventRegistration {
    var events: i16;
    var token: u64;
    var generation: u64 = 0;

    /** Store the requested interest and application token. */
    init(events: i16, token: u64) {
      this.events = events;
      this.token = token;
    }
  }

  /**
   * Own an epoll or kqueue descriptor, but borrow all watched descriptors.
   * Call open before use. Remove descriptors before closing or reusing them.
   * The allocator supplies registration storage and reusable wait buffers.
   * Wait returns at most capacity events; readiness remains level-triggered.
   * Use from one thread at a time. macOS can return separate read/write events.
   */
  public class EventLoop {
    // Store fd + 1 so zeroed moved-from objects own no descriptor, including fd 0.
    var handle: i64 = 0;
    var capacity: i32;
    var next_generation: u64 = 1;
    var registrations: Map<i64, EventRegistration>;
    var native_events: ContiguousBuffer<u32>;
    var ready: Vec<ReadyEvent>;

    /** Reserve wait buffers; open rejects nonpositive capacities. */
    init(alloc: const ref HeapAllocator, capacity: i32) throws {
      this.capacity = capacity;
      this.registrations = Map<i64, EventRegistration>(alloc, 16);
      var slots: i64 = capacity > 0 ? _convert<i64>(capacity) : 1;
      this.native_events = ContiguousBuffer<u32>(alloc, slots * 8);
      this.ready = Vec<ReadyEvent>(alloc, slots);
    }

    /** Open the native queue once. Failure leaves this object unopened. */
    public method open() void throws {
      if (this.handle != 0 or this.capacity <= 0) {
        throw Error(22, "invalid event loop state or capacity");
      }
      var fd: i32 = native_loop_open();
      if (fd < 0) {
        throw Error(errno(), "cannot open event loop");
      }
      this.handle = _convert<i64>(fd) + 1;
      return;
    }

    /** Close the queue and forget registrations without closing watched descriptors. */
    public method close() void {
      if (this.handle != 0) {
        unsafe { c_close(_convert<i32>(this.handle - 1)); };
        this.handle = 0;
      }
      this.registrations.clear();
      this.ready.clear();
    }

    /** Release the queue, including when this value moves out of a scope. */
    deinit() {
      this.close();
    }

    /** Return the number of registrations. */
    public const method count() i64 {
      return this.registrations.size();
    }

    /**
     * Register a descriptor once with POLLIN, POLLOUT, or both, and a token.
     * Zero interest suspends normal readiness; error/hangup reporting varies by OS.
     * Registration changes may allocate through the supplied allocator.
     */
    public method add(fd: i32, events: i16, token: u64) void throws {
      this.check_interest(fd, events);
      if (this.registrations.contains(fd)) {
        throw Error(17, "descriptor is already registered");
      }
      var generation = this.allocate_generation();
      this.change(fd, 0, events, 1);
      var entry = EventRegistration(events, token);
      entry.generation = generation;
      this.registrations.insert(fd, entry);
      return;
    }

    /** Replace a registration's interest and token for subsequent waits. */
    public method modify(fd: i32, events: i16, token: u64) void throws {
      this.check_interest(fd, events);
      var old: i16 = 0;
      try {
        var entry = this.registrations.get(fd);

        old = entry.events;
      } catch (e: NotFoundError) {
        throw Error(2, "descriptor is not registered");
      }
      var generation = this.allocate_generation();
      this.change(fd, old, events, 3);
      var entry = EventRegistration(events, token);
      entry.generation = generation;
      this.registrations.insert(fd, entry);
      return;
    }

    /** Stop watching a registered descriptor. Remove it before closing it. */
    public method remove(fd: i32) void throws {
      this.check_interest(fd, 0);
      var old: i16 = 0;
      try {
        var entry = this.registrations.get(fd);

        old = entry.events;
      } catch (e: NotFoundError) {
        throw Error(2, "descriptor is not registered");
      }
      this.change(fd, old, 0, 2);
      try {
        this.registrations.remove(fd);
      } catch {}
      return;
    }

    /** Allocate a registration identity without ever reusing a generation. */
    method allocate_generation() u64 throws {
      if (this.next_generation == 0) {
        throw Error(22, "event loop registration identities exhausted");
      }
      var generation = this.next_generation;
      this.next_generation = generation == 18446744073709551615u64 ? 0u64 : generation + 1u64;
      return generation;
    }

    /** Validate portable interest flags and require an open queue. */
    method check_interest(fd: i32, events: i16) void throws {
      if (this.handle == 0 or fd < 0) {
        throw Error(9, "event loop or descriptor is closed");
      }
      if ((events & ~(POLLIN | POLLOUT)) != 0) {
        throw Error(22, "unsupported event loop interest");
      }
      return;
    }

    /** Apply a native change; close the queue if a partial change cannot be undone. */
    method change(fd: i32, old: i16, events: i16, operation: i32) void throws {
      var error: i32 = native_loop_change(
        _convert<i32>(this.handle - 1),
        fd,
        old,
        events,
        operation
      );
      if (error < 0) {
        this.close();
        throw Error(0 - error, "event loop rollback failed; queue closed");
      }
      if (error != 0) {
        throw Error(error, "event loop registration failed");
      }
      return;
    }

    /**
     * Replace the ready batch without allocating. Zero polls, -1 waits forever.
     * Other negative timeouts are rejected. Signals return an interrupted error.
     * On failure the ready batch is empty; successful events last until wait/close.
     * Modifying or removing a registration invalidates only its cached events.
     * event_at rejects them even if the descriptor and token have been reused.
     */
    public method wait(timeout_ms: i32) i32 throws {
      this.ready.clear();
      this.check_interest(0, 0);
      if (timeout_ms < -1) {
        throw Error(22, "invalid event loop timeout");
      }
      var count: i32 = native_loop_wait(
        _convert<i32>(this.handle - 1),
        this.native_events.raw_data(),
        this.capacity,
        timeout_ms
      );
      if (count < 0) {
        throw Error(errno(), "event loop wait failed");
      }
      for (var i: i64 = 0; i < count; i = i + 1) {
        var event = native_loop_event(this.native_events.raw_data(), i);
        try {
          var entry = this.registrations.get(event.fd());

          var ready = ReadyEvent(event, entry.token);
          ready.generation = entry.generation;
          this.ready.push(ready);
        } catch (e: NotFoundError) {}
      }
      return _convert<i32>(this.ready.size());
    }

    /** Wait for a finite duration, rounding fractional milliseconds upward. */
    public method wait(timeout: const ref std.time.Duration) i32 throws {
      return this.wait(poll_timeout_millis(timeout));
    }

    /**
     * Return an independent snapshot without allocation. OutOfBounds also means
     * the registration changed since wait; skip that slot and continue dispatch.
     * Snapshots already returned remain historical values after later changes.
     */
    public const method event_at(index: i64) ReadyEvent throws {
      var event = this.ready.get(index);
      try {
        var entry = this.registrations.get(event.fd());
        if (entry.generation == event.generation) {
          return ReadyEvent(Event(event.fd(), event.events()), event.token());
        }
      } catch (error: NotFoundError) {}
      throw IndexOutOfBoundsError(index);
    }
  }
}
