using std;

/** Linux local descriptor exchange and fixed-size shared byte mappings. */
public module std.ipc {

  // Linux flags used together at the native boundary.
  const LOCAL_SOCKET_FLAGS: i32 = 2048 | 524288;  // SOCK_NONBLOCK | SOCK_CLOEXEC
  const FIXED_SIZE_SEALS: i32 = 1 | 2 | 4;  // F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW
  const PACKET_TRUNCATION: i32 = 8 | 32;  // MSG_CTRUNC | MSG_TRUNC
  const LOCAL_PACKET_LIMIT: i64 = 256;

  /** Own one descriptor; moved-from values and failed acquisitions are harmless. */
  public class Descriptor {
    var handle: i64 = 0;

    /** Construct an empty owner. */
    init() {}

    /** Borrow the descriptor until this owner is closed or destroyed. */
    public const method fd() i32 {
      return _convert<i32>(this.handle - 1);
    }

    /** Release ownership exactly once. */
    public method close() void {
      if (this.handle != 0) {
        unsafe { c_close(this.fd()); };
        this.handle = 0;
      }
    }

    /** Close any owned descriptor. */
    deinit() {
      this.close();
    }
  }

  /** Generate a nonzero connection nonce; failure never substitutes predictable data. */
  public function random_nonce() u64 throws {
    var value: u64 = 0;
    while (value == 0) {
      var done: i64 = 0;
      while (done < 8) {
        var count = unsafe {
          c_getrandom(
            _ptr_offset(_bitcast<raw_ptr<u8>>(_address_of<u64>(value)), done),
            _convert<u64>(8 - done),
            0
          );
        };
        if (count < 0 and errno() == 4) {
          continue;
        }
        if (count <= 0) {
          throw Error(errno(), "cannot obtain local connection nonce");
        }
        done += count;
      }
    }
    return value;
  }

  /** Return page-rounded mapping storage without overflow or assuming a fixed page size. */
  public function mapping_footprint(size: i64) i64 throws {
    if (size < 8 or size > 1073741824) {
      throw Error(22, "invalid shared mapping size");
    }
    var page = unsafe { c_sysconf(30); };
    if (page < 1 or page > 1073741824) {
      throw Error(22, "invalid native page size");
    }
    return (size + page - 1) / page * page;
  }

  /**
   * Own fixed-size shared bytes. Reads return values, never references into foreign
   * storage. Protocols must prevent concurrent mutation of published byte ranges.
   */
  public class SharedMemory {
    var file: Descriptor = Descriptor();
    var address: raw_ptr<u8> = null;
    var length: i64 = 0;
    var writable: bool = false;
    var footprint: i64 = 0;

    /** Construct an unopened mapping. */
    init() {}

    /** Release this process's view; foreign mappings remain valid. */
    deinit() {
      if (this.address != null) {
        unsafe { c_munmap(this.address, _convert<u64>(this.length)); };
      }
    }

    /** Return page-rounded mapped storage, excluding descriptor and allocator metadata. */
    public const method mapped_bytes() i64 {
      return this.footprint;
    }

    /** Borrow the backing descriptor for explicit descriptor transfer. */
    public const method fd() i32 {
      return this.file.fd();
    }

    /** Return the immutable byte length. */
    public const method size() i64 {
      return this.length;
    }

    /** Read one bounded byte without exposing a foreign reference. */
    public const method get(index: i64) u8 throws {
      if (index < 0 or index >= this.length) {
        throw IndexOutOfBoundsError(index);
      }
      return unsafe { _load<u8>(this.address, index); };
    }

    /** Write a bounded byte only through an owner mapped writable. */
    public method set(index: i64, value: u8) void throws {
      if (not this.writable or index < 0 or index >= this.length) {
        throw IndexOutOfBoundsError(index);
      }
      unsafe { _store<u8>(this.address, index, value); };
    }

    /** Copy initialized ordinary bytes into a checked writable range. */
    public method copy_from(index: i64, bytes: const ref ContiguousBuffer<u8>) void throws {
      if (not this.writable or index < 0 or index > this.length or
        bytes.size() > this.length - index) {
        throw IndexOutOfBoundsError(index);
      }
      unsafe { _memcpy(_ptr_offset(this.address, index), bytes.raw_data(), bytes.size()); };
    }

    /** Copy a checked range into caller-owned ordinary storage. */
    public const method copy_to(index: i64, bytes: ref ContiguousBuffer<u8>) void throws {
      if (index < 0 or index > this.length or bytes.size() > this.length - index) {
        throw IndexOutOfBoundsError(index);
      }
      unsafe { _memcpy(bytes.raw_data(), _ptr_offset(this.address, index), bytes.size()); };
    }

    /** Initialize a bounded writable range without exposing a raw address. */
    public method fill(index: i64, count: i64, value: u8) void throws {
      if (not this.writable or index < 0 or count < 0 or index > this.length or
        count > this.length - index) {
        throw IndexOutOfBoundsError(index);
      }
      unsafe { _memset(_ptr_offset(this.address, index), _convert<i32>(value), count); };
    }

    /** Release-publish a protocol marker at a checked, naturally aligned position. */
    public method publish(index: i64, value: i32) void throws {
      if (not this.writable or index < 0 or index > this.length - 4 or index % 4 != 0) {
        throw IndexOutOfBoundsError(index);
      }
      unsafe {
        _atomic_store_i32(_bitcast<raw_ptr<i32>>(_ptr_offset(this.address, index)), value);
      };
    }

    /** Acquire a publication marker before reading its associated immutable bytes. */
    public const method acquire(index: i64) i32 throws {
      if (index < 0 or index > this.length - 4 or index % 4 != 0) {
        throw IndexOutOfBoundsError(index);
      }
      return unsafe {
        _atomic_load_i32(_bitcast<raw_ptr<i32>>(_ptr_offset(this.address, index)));
      };
    }
  }

  /** Native packet scatter/gather record; its pointees live through the syscall. */
  class LocalIovec {
    var data: raw_ptr<u8>;
    var length: u64;

    /** Borrow packet storage for a single syscall. */
    init(data: raw_ptr<u8>, length: u64) {
      this.data = data;
      this.length = length;
    }
  }

  /** Linux 64-bit msghdr layout; never exposed as a public API. */
  class LocalMessage {
    var name: raw_ptr<u8> = null;
    var name_length: u32 = 0;
    var padding: u32 = 0;
    var vectors: raw_ptr<LocalIovec>;
    var vector_count: u64 = 1;
    var control: raw_ptr<u8>;
    var control_length: u64;
    var flags: i32 = 0;

    /** Borrow one vector and aligned ancillary storage. */
    init(vectors: raw_ptr<LocalIovec>, control: raw_ptr<u8>, length: u64) {
      this.vectors = vectors;
      this.control = control;
      this.control_length = length;
    }
  }

  /** One bounded packet with optional descriptor ownership. */
  public class LocalPacket {
    public var bytes: ContiguousBuffer<u8>;
    public var size: i64;
    public var file: Descriptor;

    /** Transfer packet storage and its received descriptor. */
    init(bytes: ContiguousBuffer<u8>, size: i64, file: Descriptor) {
      this.bytes = bytes;
      this.size = size;
      this.file = file;
    }
  }

  /** Nonblocking, close-on-exec Linux abstract Unix sequenced-packet socket. */
  public class LocalSocket {
    var file: Descriptor = Descriptor();

    /** Construct a closed socket. */
    init() {}

    /** Borrow the native descriptor for readiness registration. */
    public const method fd() i32 {
      return this.file.fd();
    }

    /** Close the socket; abstract listener names disappear automatically. */
    public method close() void {
      this.file.close();
    }

    /** Bind or connect to an opaque abstract address without filesystem entries. */
    method open(first: u64, second: u64, listen: bool) void throws {
      if (this.fd() >= 0) {
        throw Error(22, "local socket already open");
      }
      var fd = unsafe { __socket(1, 5 | LOCAL_SOCKET_FLAGS, 0); };
      if (fd < 0) {
        throw Error(errno(), "cannot create local socket");
      }
      var file = adopt_descriptor(fd);
      var address: array<u8, 19> = [
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8
      ];
      address[0] = 1;
      for (var i: i64 = 0; i < 8; i += 1) {
        address[3 + i] = _convert<u8>(first >> (i * 8));
        address[11 + i] = _convert<u8>(second >> (i * 8));
      }
      var result = listen ? unsafe { c_bind(fd, _address_of<u8>(address[0]), 19); } : unsafe {
        c_connect(fd, _address_of<u8>(address[0]), 19);
      };
      if (result < 0) {
        throw Error(errno(), "cannot establish local socket");
      }
      if (listen and unsafe { __listen(fd, 4); } < 0) {
        throw Error(errno(), "cannot listen locally");
      }
      this.file = file;
    }

    /** Listen at an unpredictable abstract address. */
    public method listen(first: u64, second: u64) void throws {
      this.open(first, second, true);
    }

    /** Attempt a local connection; unavailable or full endpoints fail without blocking. */
    public method connect(first: u64, second: u64) void throws {
      this.open(first, second, false);
    }

    /** Accept at most one connection without blocking. */
    public method accept() Option<LocalSocket> throws {
      var fd = unsafe { c_accept4(this.fd(), null, null, LOCAL_SOCKET_FLAGS); };
      if (fd < 0) {
        if (errno() == 11 or errno() == 4) {
          return Option.None;
        }
        throw Error(errno(), "cannot accept local connection");
      }
      var out = LocalSocket();
      out.file = adopt_descriptor(fd);
      return Option.Some(out);
    }

    /** Verify the kernel-reported peer user matches this process's effective user. */
    public const method same_user() bool throws {
      var credentials: array<i32, 3> = [0, 0, 0];
      var length: u32 = 12;
      if (unsafe {
        c_getsockopt(this.fd(), 1, 17, _address_of<i32>(credentials[0]), _address_of<u32>(length));
      } < 0 or length != 12) {
        throw Error(errno(), "cannot read local peer credentials");
      }
      return _convert<u32>(credentials[1]) == unsafe { c_geteuid(); };
    }

    /** Send one bounded packet and optional borrowed descriptor; false means would-block. */
    public method send(bytes: const ref ContiguousBuffer<u8>, fd: i32) bool throws {
      if (bytes.size() < 1 or bytes.size() > LOCAL_PACKET_LIMIT) {
        throw Error(22, "invalid local packet size");
      }
      var control: array<u64, 3> = [20u64, 4294967297u64, _convert<u64>(fd)];
      var vector = LocalIovec(unsafe { bytes.raw_data(); }, _convert<u64>(bytes.size()));
      var message = LocalMessage(
        unsafe { _address_of<LocalIovec>(vector); },
        unsafe { _bitcast<raw_ptr<u8>>(_address_of<u64>(control[0])); },
        fd >= 0 ? 24 : 0
      );
      var count = unsafe {
        c_sendmsg(this.fd(), _bitcast<raw_ptr<u8>>(_address_of<LocalMessage>(message)), 16384);
      };
      if (count < 0 and (errno() == 11 or errno() == 4)) {
        return false;
      }
      if (count != bytes.size()) {
        throw Error(errno(), "cannot send local packet");
      }
      return true;
    }

    /** Receive at most one descriptor; reject truncation and close every excess descriptor. */
    public method receive(alloc: const ref std.mem.HeapAllocator) Option<LocalPacket> throws {
      var probe: u8 = 0;
      var available = unsafe { __recv(this.fd(), _address_of<u8>(probe), 1, 66); };
      if (available < 0 and (errno() == 11 or errno() == 4)) {
        return Option.None;
      }
      if (available <= 0) {
        throw Error(errno(), "local connection closed");
      }
      var bytes = ContiguousBuffer<u8>(alloc, LOCAL_PACKET_LIMIT);
      // CMSG_SPACE(sizeof(int)) also fits two descriptors in its alignment padding.
      // Parse and close both before rejecting; the kernel closes any truncated ones.
      var control: array<u64, 3> = [0u64, 0u64, 0u64];
      var vector = LocalIovec(unsafe { bytes.raw_data(); }, _convert<u64>(LOCAL_PACKET_LIMIT));
      var message = LocalMessage(
        unsafe { _address_of<LocalIovec>(vector); },
        unsafe { _bitcast<raw_ptr<u8>>(_address_of<u64>(control[0])); },
        24
      );
      var count = unsafe {
        c_recvmsg(
          this.fd(),
          _bitcast<raw_ptr<u8>>(_address_of<LocalMessage>(message)),
          1073741824
        );
      };
      if (count < 0 and (errno() == 11 or errno() == 4)) {
        return Option.None;
      }
      if (count <= 0) {
        throw Error(errno(), "local connection closed");
      }
      var file = Descriptor();
      var descriptors: i64 = 0;
      var position: u64 = 0;
      while (position + 16 <= message.control_length) {
        var base = unsafe {
          _ptr_offset(
            _bitcast<raw_ptr<u8>>(_address_of<u64>(control[0])),
            _convert<i64>(position)
          );
        };
        var length = unsafe { _load<u64>(base, 0); };
        if (length < 16 or length > message.control_length - position) {
          break;
        }
        if (unsafe { _load<i32>(base, 2); } == 1 and unsafe { _load<i32>(base, 3); } == 1) {
          for (var at: u64 = 16; at + 4 <= length; at += 4) {
            var fd = unsafe { _load<i32>(base, _convert<i64>(at / 4)); };
            var owned = adopt_descriptor(fd);
            descriptors += 1;
            if (descriptors == 1) {
              file = owned;
            }
          }
        }
        position += (length + 7) & ~7u64;
      }
      if ((message.flags & PACKET_TRUNCATION) != 0 or descriptors > 1) {
        throw Error(22, "truncated or excessive local descriptors");
      }
      return Option.Some(LocalPacket(bytes, count, file));
    }
  }

  /** Adopt exclusive ownership; callers must not retain another owning handle. */
  function adopt_descriptor(fd: i32) Descriptor {
    var out = Descriptor();
    out.handle = _convert<i64>(fd) + 1;
    return out;
  }

  /** Allocate zero-filled anonymous storage and prohibit all subsequent resizing. */
  public function create_shared_memory(size: i64) SharedMemory throws {
    if (size < 8 or size > 1073741824) {
      throw Error(22, "invalid shared mapping size");
    }
    var name: array<u8, 4> = [115u8, 117u8, 110u8, 0u8];
    var fd = unsafe { c_memfd_create(_address_of<u8>(name[0]), 3); };
    if (fd < 0) {
      throw Error(errno(), "cannot create shared memory");
    }
    var owned = adopt_descriptor(fd);
    if (unsafe { c_ftruncate(fd, size); } < 0 or
      unsafe { c_fcntl(fd, 1033, FIXED_SIZE_SEALS); } < 0) {
      throw Error(errno(), "cannot size and seal shared memory");
    }
    return map_shared_memory(owned, size, true);
  }

  /** Validate immutable size before adopting and mapping received storage. */
  public function map_shared_memory(
    file: Descriptor,
    size: i64,
    writable: bool
  ) SharedMemory throws {
    var fd = file.fd();
    var seals = unsafe { c_fcntl(fd, 1034); };
    if (size < 8 or size > 1073741824 or unsafe { c_lseek(fd, 0, 2); } != size or seals < 0 or
      (seals & FIXED_SIZE_SEALS) != FIXED_SIZE_SEALS) {
      throw Error(22, "unsealed or incorrectly sized shared memory");
    }
    var footprint = mapping_footprint(size);
    var address = unsafe { c_mmap(null, _convert<u64>(size), writable ? 3 : 1, 1, fd, 0); };
    if (unsafe { _load<i64>(_bitcast<raw_ptr<u8>>(_address_of<raw_ptr<u8>>(address)), 0); } == -1) {
      throw Error(errno(), "cannot map shared memory");
    }
    var out = SharedMemory();
    out.file = file;
    out.address = address;
    out.length = size;
    out.footprint = footprint;
    out.writable = writable;
    return out;
  }
}
