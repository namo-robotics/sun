// stdlib/std/bigint_tests.sun - Tests for bigint.sun (BigUint).
// The bare intrinsics BigUint builds on (_mul_hi_u64/_ctlz_u64/_cttz_u64)
// are tested in tests/builtins/test_intrinsics.cpp.

using std;

/** Tests bigint behavior in the library module. */
public module std {

  /**
     * Build a BigUint from decimal text.
     */
  function make_bigint(alloc: ref HeapAllocator, text: static_ptr<u8>) AllocationResult<BigUint> {
    var s = try String(alloc, text);
    var n = try BigUint(alloc);
    try n.set_decimal(s);
    return AllocationResult.Ok(n);
  }

  /**
     * True when the number renders to exactly this decimal text.
     */
  function renders_as(
    alloc: ref HeapAllocator,
    n: ref BigUint,
    text: static_ptr<u8>
  ) AllocationResult<bool> {
    var s = try String(alloc, "");
    try n.append_decimal(s);
    return AllocationResult.Ok(s.equals_literal(text));
  }

  /** Checks factorial and decimal round trip. */
  test_function factorial_and_decimal_round_trip() {
    var alloc = make_heap_allocator();
    var n = try BigUint(alloc, 1);
    for (var i: u64 = 2; i <= 30; i = i + 1) {
      try n.mul_small(i);
    }
    var text = try String(alloc, "");
    try n.append_decimal(text);
    try std.test.assert(
      text.equals_literal("265252859812191058636308480000000"),
      "30! renders wrong"
    );
    try std.test.assert_eq(n.bit_length(), 108);
    try std.test.assert_eq(n.limb_count(), 2);
    var back = try BigUint(alloc);
    try std.test.assert(try back.set_decimal(text), "30! text should parse");
    try std.test.assert(back.equals(n), "parsed 30! differs from the original");
    var square = try n.clone();
    try square.mul(n);
    var sq_text = try String(alloc, "");
    try square.append_decimal(sq_text);
    try std.test.assert(
      sq_text.equals_literal(
        "70359079638545882374689246780656119576032161719910400000000000000"
      ),
      "(30!)^2 renders wrong"
    );
    var bad = try String(alloc, "12x");
    try std.test.assert(try back.set_decimal(bad) == false, "bad digits should not parse");
    try std.test.assert(back.is_zero(), "a failed parse leaves zero");
    var zero = try BigUint(alloc);
    var zt = try String(alloc, "");
    try zero.append_decimal(zt);
    try std.test.assert(zt.equals_literal("0"), "zero renders as 0");
  }

  /** Checks multi limb arithmetic. */
  test_function multi_limb_arithmetic() {
    var alloc = make_heap_allocator();
    // a = 2^200 + 12345, b = 3^150 + 7
    var a = try make_bigint(
      alloc,
      "1606938044258990275541962092341162602522202993782792835313721"
    );
    var b = try make_bigint(
      alloc,
      "369988485035126972924700782451696644186473100389722973815184405301748256"
    );
    var sum = try a.clone();
    try sum.add(b);
    try std.test.assert(
      try renders_as(
        alloc,
        sum,
        "369988485036733910968959772727238606278814262992245176808967198137061977"
      ),
      "a + b wrong"
    );
    var diff = try b.clone();
    try std.test.expect_arithmetic_success(diff.sub(a));
    try std.test.assert(
      try renders_as(
        alloc,
        diff,
        "369988485033520034880441792176154682094131937787200770821401612466434535"
      ),
      "b - a wrong"
    );
    var prod = try a.clone();
    try prod.mul(b);
    try std.test.assert(
      try renders_as(
        alloc,
        prod,
        "594548572540693628849860287507659082019984411858745114670193959411490296520390392243035028084963886526203367157948222586215524620576"
      ),
      "a * b wrong"
    );
    try prod.shr(77);
    try std.test.assert(
      try renders_as(
        alloc,
        prod,
        "3934392419413913323894585204914305526281585972813365664542781201694709080391154784167284198954246014261865110"
      ),
      "(a * b) >> 77 wrong"
    );
    var scaled = try a.clone();
    try scaled.mul_pow10(40);
    try std.test.assert(
      try renders_as(
        alloc,
        scaled,
        "16069380442589902755419620923411626025222029937827928353137210000000000000000000000000000000000000000"
      ),
      "a * 10^40 wrong"
    );
    try std.test.assert_eq(a.compare(b), -1);
    try std.test.assert_eq(b.compare(a), 1);
    try std.test.assert_eq(a.compare(a), 0);
    // Subtracting a larger number reports overflow
    var small = try a.clone();
    var overflowed: bool = false;
    match small.sub(b) {
      ArithmeticResult.Overflow(e) => {
        overflowed = true;
      },
      _ => {}
    };
    try std.test.assert(overflowed, "subtracting a larger number should report overflow");
    // 2^100 via shift, back down via shift
    var p = try BigUint(alloc, 1);
    try p.shl(100);
    try std.test.assert(
      try renders_as(alloc, p, "1267650600228229401496703205376"),
      "2^100 wrong"
    );
    try std.test.assert_eq(p.bit_length(), 101);
    try p.shr(99);
    try std.test.assert_eq(p.compare_u64(2), 0);
    try p.shr(5);
    try std.test.assert(p.is_zero(), "2 >> 5 should be zero");
    // divmod peels digits from the bottom
    var d = try make_bigint(alloc, "123456789012345678901234567890");
    var rem: u32 = try std.test.expect_arithmetic(d.divmod_small(1000));
    try std.test.assert_eq(rem, 890);
    try std.test.assert(
      try renders_as(alloc, d, "123456789012345678901234567"),
      "divmod quotient wrong"
    );
    try d.mul_small(1000);
    try d.add_small(890);
    try std.test.assert(
      try renders_as(alloc, d, "123456789012345678901234567890"),
      "divmod round trip wrong"
    );
    // Carries across a limb boundary
    var c = try BigUint(alloc, 0 - _convert<u64>(1));
    try c.add_small(1);
    try std.test.assert_eq(c.limb_count(), 2);
    try std.test.assert_eq(c.limb(0), 0);
    try std.test.assert_eq(c.limb(1), 1);
    var fits: bool = match c.to_u64() {
      Option.Some(v) => true,
      Option.None => false
    };
    try std.test.assert(fits == false, "2^64 does not fit a u64");
    try c.set_u64(7);
    var v: u64 = match c.to_u64() {
      Option.Some(x) => x,
      Option.None => 0
    };
    try std.test.assert_eq(v, 7);
  }

  /** Failed arithmetic reports its precise error without changing the value. */
  test_function failed_arithmetic_preserves_value() {
    var alloc = make_heap_allocator();
    var value = try BigUint(alloc, 7);
    var larger = try BigUint(alloc, 8);
    match value.sub(larger) {
      ArithmeticResult.Overflow(_) => {},
      _ => {
        try std.test.fail("expected overflow");
      }
    };
    try std.test.assert_eq(value.compare_u64(7), 0);
    match value.divmod_small(0) {
      ArithmeticResult.DivisionByZero(_) => {},
      _ => {
        try std.test.fail("expected zero-divisor error");
      }
    };
    try std.test.assert_eq(value.compare_u64(7), 0);
  }
}
