/**
 * Standard exceptions carry numeric codes and bounded inline diagnostics.
 * Constructing or throwing an exception does not allocate. Text exceeding
 * the exception's inline capacity is truncated. Calling message() explicitly
 * creates an owned String and may itself throw on allocation failure.
 */
/** Provides the standard-library declarations implemented in this source file. */
public module std {

  /** Provides borrowed access to exception codes and explicit diagnostic copies. */
  public interface IError {
    /** Identifies the error within its originating subsystem. */
    public const method code() i32;

    /** Returns diagnostic text owned by the caller. */
    public const method message() String throws;
  }

  /** Reports checked integer division or remainder without allocating storage. */
  public exception ArithmeticError implements IError {
    var code_: i32;

    /** Retains the failure code returned by checked arithmetic. */
    init(code: i32) {
      this.code_ = code;
    }

    /** Identifies division by zero or signed division overflow. */
    public const method code() i32 {
      return this.code_;
    }

    /** Creates diagnostic text owned by the caller. */
    public const method message() String throws {
      if (this.code_ == 4) {
        return String("integer division by zero");
      }
      return String("integer division overflow");
    }
  }

  /** Prints a literal diagnostic and aborts the process without running destructors. */
  public function panic(message: static_ptr<u8>) void {
    _panic(message);
  }

  // ============================================================================
  // Generic Error - base error with custom message
  // ============================================================================

  /** An exception carrying a caller-supplied code and bounded inline message. */
  public exception Error implements IError {
    var code_: i32;
    var text_: array<u8, 96> = [
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
