      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8
    ];
    var text_length_: i32 = 0;

    /** Copies and truncates the supplied diagnostic without allocating. */
    init(code: i32, message: static_ptr<u8>) {
      this.code_ = code;
      this.text_length_ = 0;
      for (var i: i64 = 0; i < message.length() and i < 96; i += 1) {
        this.text_[i] = unsafe { _load<u8>(message.raw(), i); };
        this.text_length_ += 1;
      }
    }

    /** Copies and truncates the supplied diagnostic without allocating. */
    init(code: i32, message: const ref String) {
      this.code_ = code;
      this.text_length_ = 0;
      for (var i: i64 = 0; i < message.length() and i < 96; i += 1) {
        this.text_[i] = unsafe { message.unsafe_at(i); };
        this.text_length_ += 1;
      }
    }

    /** Returns the numeric failure code. */
    public const method code() i32 {
      return this.code_;
    }

    /** Copies the bounded diagnostic into an explicitly requested owned string. */
    public const method message() String throws {
      var text = String("");
      for (var i: i64 = 0; i < _convert<i64>(this.text_length_); i += 1) {
        text.append_char(this.text_[i]);
      }
      return text;
    }
  }

  // ============================================================================
  // EmptyError - for operations on empty containers
  // ============================================================================

  /** Reports an operation that requires an element from an empty container. */
  public exception EmptyError implements IError {
    /**
     * Build the error reporting that a container held nothing.
     */
    init() {}

    /**
     * Returns the code identifying this error category.
     */
    public const method code() i32 {
      return 1;
    }

    /**
     * Fixed text: the container is empty.
     */
    public const method message() String throws {
      return String("container is empty");
    }
  }

  // ============================================================================
  // NotFoundError - for failed lookups
  // ============================================================================

  /** Reports that a lookup could not find the requested item. */
  public exception NotFoundError implements IError {
    /**
     * Build the error reporting that a lookup found nothing.
     */
    init() {}

    /**
     * Returns the code identifying this error category.
     */
    public const method code() i32 {
      return 2;
    }

    /**
     * Fixed text: the element was not found.
     */
    public const method message() String throws {
      return String("element not found");
    }
  }

  // ============================================================================
  // IndexOutOfBoundsError - for invalid array/vector indices
  // ============================================================================

  /** Reports an invalid index and retains the index supplied by the caller. */
  public exception IndexOutOfBoundsError implements IError {
    var index_: i64;

    /**
     * Build the error, recording the index that was out of range.
     */
    init(index: i64) {
      this.index_ = index;
    }

    /**
     * Returns the code identifying this error category.
     */
    public const method code() i32 {
      return 3;
    }

    /**
     * Fixed text: the index was out of bounds.
     */
    public const method message() String throws {
      return String("index out of bounds");
    }

    /**
     * The offending index, for a caller that wants to report it.
     */
    public method index() i64 {
      return this.index_;
    }
  }

  // ============================================================================
  // DivisionByZeroError - for division by zero
  // ============================================================================

  /** Reports arithmetic division with a zero divisor. */
  public exception DivisionByZeroError implements IError {
    /**
     * Build the error reporting a divide by zero.
     */
    init() {}

    /**
     * Returns the code identifying this error category.
     */
    public const method code() i32 {
      return 4;
    }

    /**
     * Fixed text: division by zero.
     */
    public const method message() String throws {
      return String("division by zero");
    }
  }

  // ============================================================================
  // OverflowError - for arithmetic overflow
  // ============================================================================

  /** Reports arithmetic whose result cannot fit in the destination type. */
  public exception OverflowError implements IError {
    /**
     * Build the error reporting that arithmetic went out of range.
     */
    init() {}

    /**
     * Returns the code identifying this error category.
     */
    public const method code() i32 {
      return 5;
    }

    /**
     * Fixed text: arithmetic overflow.
     */
    public const method message() String throws {
      return String("arithmetic overflow");
    }
  }

