// stdlib/std/option.sun - Optional values
//
// Option<T> represents a value that may be absent. Inspect its payload with match:
//
//   var found = m.find(key);
//   var v = match found {
//       Option.Some(x) => x,
//       Option.None => fallback
//   };
//
// Type arguments are inferred from payload arguments (Option.Some(42)) or
// from the expected type (return position, annotations, field assignment).

/** Provides the standard-library declarations implemented in this source file. */
public module std {

  /** Contains an owned value when present, or records that no value is available. */
  public enum Option<T> {
    Some(T),
    None
  }
}
