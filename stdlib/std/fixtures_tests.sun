// stdlib/std/fixtures_tests.sun - Shared fixtures for the stdlib's own tests.
//
// The stdlib test suite runs as one process with every test on its own
// thread by default, so anything touching shared machine state (files,
// environment variables) must use names unique to the test. These helpers
// derive uniqueness from a per-test tag plus the process id, which also
// isolates concurrent CI runs from each other.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {

  /** Groups declarations used by this compiler regression test. */
  module tests {

    /**
     * A scratch directory under /tmp, created on init and removed with its
     * files on deinit. Propagating a failed assertion exits the scope and
     * runs deinit, so cleanup happens even when the test fails.
     * Pass the test's own name as the tag so parallel tests never collide.
     */
    public class TempDir {
      public var path: String;
      var alloc: HeapAllocator;

      /** Creates the scratch directory or returns its filesystem error. */
      init(allocator: ref HeapAllocator, tag: static_ptr<u8>) SystemResult<void> {
        this.alloc = allocator.copy();
        var p = try String("/tmp/sun_stdlib_");
        try p.append_literal(tag);
        try p.append_char(b'_');
        try p.append(std.process.pid());
        this.path = p;
        try std.io.make_dir(this.path, 493);
      }

      /**
       * A path for `name` inside the directory, owned by the caller.
       */
      public method file(name: static_ptr<u8>) AllocationResult<String> {
        var p = try this.path.clone(this.alloc);
        try p.append_char(b'/');
        try p.append_literal(name);
        return AllocationResult.Ok(p);
      }

      /** Records fixture destruction so tests can verify ownership and cleanup. */
      deinit() {
        ignore_error(this.cleanup());
      }

      /** Remove temporary files while allowing the destructor to discard cleanup errors. */
      method cleanup() SystemResult<void> {
        // Best-effort cleanup: remove the entries we can, then the
        // directory itself. deinit must not throw.
        match std.io.read_dir(this.alloc, this.path) {
          SystemResult.Ok(entries) => {
            for (var i: i64 = 0; i < entries.size(); i = i + 1) {
              var entry_path = try this.path.clone(this.alloc);
              try entry_path.append_char(b'/');
              try entry_path.append(unsafe { entries.get_unchecked(i); }.name());
              if (unsafe { entries.get_unchecked(i); }.is_dir()) {
                ignore_error(std.io.remove_dir(entry_path));
              } else {
                ignore_error(std.io.remove_file(entry_path));
              }
            }
          },
          _ => {}
        };
        ignore_error(std.io.remove_dir(this.path));
        return SystemResult.Ok;
      }
    }

    /**
     * A /tmp file path unique to the calling test, owned by the caller.
     * Nothing is created; the test makes and removes the file itself.
     */
    public function unique_path(tag: static_ptr<u8>) AllocationResult<String> {
      var p = try String("/tmp/sun_stdlib_");
      try p.append_literal(tag);
      try p.append_char(b'_');
      try p.append(std.process.pid());
      return AllocationResult.Ok(p);
    }
  }  // module tests
}  // module std
