// stdlib/target_darwin.sun - Everything OS-specific, with macOS's values
//
// The macOS counterpart of target_linux.sun: the same names, this OS's
// values. The manifest's `target:` block includes exactly one of the two per
// build, chosen by the compilation's --target.

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /**
   * Darwin returns the address of its environment-vector slot.
   */
  extern "C" function c_ns_get_environ() raw_ptr<raw_ptr<raw_ptr<u8>>> as "_NSGetEnviron";

  /**
   * Return this platform's current environment vector.
   */
  function environment_ptr() raw_ptr<raw_ptr<u8>> {
    var slot: raw_ptr<raw_ptr<raw_ptr<u8>>> = unsafe { c_ns_get_environ(); };
    return unsafe { _load<raw_ptr<raw_ptr<u8>>>(slot, 0); };
  }

  /**
   * macOS spells the per-thread errno accessor __error.
   */
  extern "C" function c_errno_location() raw_ptr<i32> as "__error";

  /**
   * Where this OS keeps the per-thread errno value.
   */
  function errno_ptr() raw_ptr<i32> {
    return unsafe { c_errno_location(); };
  }

  // Descriptor flags and the errno used for non-blocking operations.
  var O_NONBLOCK: i32 = 4;
  var WOULD_BLOCK_ERRNO: i32 = 35;
  /** Native error code for an address that is already bound. */
  var ADDRESS_IN_USE_ERRNO: i32 = 48;

  // setsockopt family. macOS has no MSG_NOSIGNAL — it folds to no flag at
  // all here — and marks the socket SO_NOSIGPIPE instead (below).
  public var MSG_NOSIGNAL: i32 = 0;
  public var SOL_SOCKET: i32 = 65535;  // 0xffff
  public var SO_REUSEADDR: i32 = 4;
  public var SO_RCVTIMEO: i32 = 4102;  // 0x1006
  var SO_NOSIGPIPE: i32 = 4130;  // 0x1022

  // IPPROTO_IP-level options for IPv4 multicast.
  public var IP_MULTICAST_TTL: i32 = 10;
  public var IP_MULTICAST_LOOP: i32 = 11;
  public var IP_ADD_MEMBERSHIP: i32 = 12;
  public var IP_DROP_MEMBERSHIP: i32 = 13;

  /**
   * Mark the socket so a send on a broken connection fails with EPIPE
   * instead of raising SIGPIPE.
   */
  function suppress_sigpipe(fd: i32) void {
    var optval: i32 = 1;
    unsafe { __setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, _address_of<i32>(optval), 4); };
  }

  // struct addrinfo: macOS puts ai_canonname before ai_addr, so ai_addr is
  // the 5th pointer-sized slot (byte 32). The full layout is documented at
  // the getaddrinfo declaration in sys.sun.
  var ADDRINFO_ADDR_INDEX: i64 = 4;
}

/** File and directory constants for macOS. */
public module std.io {
  // open(2) composables: O_CREAT=0x200, O_TRUNC=0x400, O_APPEND=0x8, over
  // O_WRONLY=1.
  var O_WRONLY_CREAT_TRUNC: i32 = 1537;  // 0x601
  var O_WRONLY_CREAT_APPEND: i32 = 521;  // 0x209

  // struct dirent's fixed head: u64 d_ino, u64 d_seekoff, u16 d_reclen,
  // u16 d_namlen, u8 d_type at byte 20, then the d_name characters.
  var DIRENT_TYPE_OFFSET: i64 = 20;
  var DIRENT_NAME_OFFSET: i64 = 21;
}

/** Clock constants for macOS. */
public module std.time {
  // clockid_t: macOS numbers CLOCK_MONOTONIC 6.
  var CLOCK_MONOTONIC: i32 = 6;
}

/** Process signal constants for macOS. */
public module std.process {
  // The job-control signals above 15, where Linux and macOS disagree.
  public var SIGCHLD: i32 = 20;
  public var SIGCONT: i32 = 19;
  public var SIGSTOP: i32 = 17;
}

/** Terminal line-discipline layout and request codes for macOS. */
public module std.terminal {
  /**
   * struct termios on macOS: four u64 flag words (tcflag_t is unsigned long),
   * 20 control characters, natural padding, then u64 input and output speeds.
   * 72 bytes, aligned to 8, on both arm64 and x86-64. Fields are filled by
   * tcgetattr and read back by tcsetattr; user code never touches them.
   */
  public class Termios {
    var iflag: u64 = 0;
    var oflag: u64 = 0;
    var cflag: u64 = 0;
    var lflag: u64 = 0;
    var cc: array<u8, 20>;
    var ispeed: u64 = 0;
    var ospeed: u64 = 0;

    /** Start from all-zero settings, ready for tcgetattr to fill in. */
    init() {
      var zeros: array<u8, 20> = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
      this.cc = zeros;
    }

    /** Report whether every field, including each control character, matches. */
    public const method equals(other: const ref Termios) bool {
      if (this.iflag != other.iflag or this.oflag != other.oflag) {
        return false;
      }
      if (this.cflag != other.cflag or this.lflag != other.lflag) {
        return false;
      }
      if (this.ispeed != other.ispeed or this.ospeed != other.ospeed) {
        return false;
      }
      for (var i: i64 = 0; i < 20; i = i + 1) {
        if (this.cc[i] != other.cc[i]) {
          return false;
        }
      }
      return true;
    }
  }

  // c_lflag bits (sys/termios.h).
  var ISIG: u64 = 128;  // 0x80
  var ICANON: u64 = 256;  // 0x100
  var ECHO: u64 = 8;
  var IEXTEN: u64 = 1024;  // 0x400
  // c_iflag and c_oflag bits.
  var ICRNL: u64 = 256;  // 0x100
  var IXON: u64 = 512;  // 0x200
  var OPOST: u64 = 1;
  // Indexes into c_cc.
  var VMIN: i64 = 16;
  var VTIME: i64 = 17;

  // ioctl request codes (sys/ttycom.h, with the _IOR/_IOW direction bits).
  /** Read the window size into a struct winsize. */
  public var TIOCGWINSZ: u64 = 1074295912;  // 0x40087468
  /** Set the window size from a struct winsize. */
  public var TIOCSWINSZ: u64 = 2148037735;  // 0x80087467
  /** Make the terminal the calling session's controlling terminal. */
  public var TIOCSCTTY: u64 = 536900705;  // 0x20007461
}
