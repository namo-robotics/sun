// stdlib/target_linux.sun - Everything OS-specific, with Linux's values
//
// One file per operating system defines the same names (see
// target_darwin.sun for the macOS set); the manifest's `target:` block
// includes exactly one of them per build, chosen by the compilation's
// --target. Shared stdlib code references these names without caring which
// OS supplied them.

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /*
   * Native null-terminated environment vector.
   */
  extern "C" var c_environ: raw_ptr<raw_ptr<u8>> as "environ";

  /**
   * Return this platform's current environment vector.
   */
  function environment_ptr() raw_ptr<raw_ptr<u8>> {
    return unsafe { c_environ; };
  }

  /**
   * Both glibc and musl export __errno_location for the per-thread errno.
   */
  extern "C" function c_errno_location() raw_ptr<i32> as "__errno_location";

  /**
   * Where this OS keeps the per-thread errno value.
   */
  function errno_ptr() raw_ptr<i32> {
    return unsafe { c_errno_location(); };
  }

  // Descriptor flags and the errno used for non-blocking operations.
  const O_NONBLOCK: i32 = 2048;  // 0x800
  const WOULD_BLOCK_ERRNO: i32 = 11;
  /** Native error code for an address that is already bound. */
  const ADDRESS_IN_USE_ERRNO: i32 = 98;

  /**
   * MSG_NOSIGNAL on every send already keeps a broken-pipe write from
   * raising SIGPIPE, so per-socket setup has nothing to do.
   */
  function suppress_sigpipe(fd: i32) void {}

  // setsockopt family (asm-generic values).
  public const MSG_NOSIGNAL: i32 = 16384;
  public const SOL_SOCKET: i32 = 1;
  public const SO_REUSEADDR: i32 = 2;
  public const SO_RCVTIMEO: i32 = 20;

  // IPPROTO_IP-level options for IPv4 multicast.
  public const IP_MULTICAST_TTL: i32 = 33;
  public const IP_MULTICAST_LOOP: i32 = 34;
  public const IP_ADD_MEMBERSHIP: i32 = 35;
  public const IP_DROP_MEMBERSHIP: i32 = 36;

  // struct addrinfo: ai_addr is the 4th pointer-sized slot (byte 24). The
  // full layout is documented at the getaddrinfo declaration in sys.sun.
  const ADDRINFO_ADDR_INDEX: i64 = 3;
}

/** File and directory constants for Linux. */
public module std.io {
  // open(2) composables from the asm-generic set: O_CREAT=0x40,
  // O_TRUNC=0x200, O_APPEND=0x400, over O_WRONLY=1.
  const O_WRONLY_CREAT_TRUNC: i32 = 577;  // 0x241
  const O_WRONLY_CREAT_APPEND: i32 = 1089;  // 0x441

  // struct dirent's fixed head: u64 d_ino, i64 d_off, u16 d_reclen,
  // u8 d_type at byte 18, then the d_name characters.
  const DIRENT_TYPE_OFFSET: i64 = 18;
  const DIRENT_NAME_OFFSET: i64 = 19;
}

/** Clock constants for Linux. */
public module std.time {
  // clockid_t from asm-generic, the same on every Linux target.
  const CLOCK_MONOTONIC: i32 = 1;
}

/** Process signal constants for Linux. */
public module std.process {
  // The job-control signals above 15, where Linux and macOS disagree.
  public const SIGCHLD: i32 = 17;
  public const SIGCONT: i32 = 18;
  public const SIGSTOP: i32 = 19;
}

/** Terminal line-discipline layout and request codes for Linux. */
public module std.terminal {
  /**
   * struct termios on Linux: four u32 flag words, a u8 line discipline, 32
   * control characters, then u32 input and output speeds. 60 bytes, aligned
   * to 4; identical on glibc and musl, x86-64 and aarch64. Fields are filled
   * by tcgetattr and read back by tcsetattr; user code never touches them.
   */
  public class Termios {
    var iflag: u32 = 0;
    var oflag: u32 = 0;
    var cflag: u32 = 0;
    var lflag: u32 = 0;
    var line: u8 = 0;
    var cc: array<u8, 32>;
    var ispeed: u32 = 0;
    var ospeed: u32 = 0;

    /** Start from all-zero settings, ready for tcgetattr to fill in. */
    init() {
      var zeros: array<u8, 32> = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
      this.cc = zeros;
    }

    /** Report whether every field, including each control character, matches. */
    public const method equals(other: const ref Termios) bool {
      if (this.iflag != other.iflag or this.oflag != other.oflag) {
        return false;
      }
      if (this.cflag != other.cflag or this.lflag != other.lflag) {
        return false;
      }
      if (this.line != other.line or this.ispeed != other.ispeed or this.ospeed != other.ospeed) {
        return false;
      }
      for (var i: i64 = 0; i < 32; i = i + 1) {
        if (this.cc[i] != other.cc[i]) {
          return false;
        }
      }
      return true;
    }
  }

  // c_lflag bits (asm-generic termbits).
  const ISIG: u32 = 0x1;
  const ICANON: u32 = 0x2;
  const ECHO: u32 = 0x8;
  const IEXTEN: u32 = 0x8000;
  // c_iflag and c_oflag bits.
  const ICRNL: u32 = 0x100;
  const IXON: u32 = 0x400;
  const OPOST: u32 = 0x1;
  // Indexes into c_cc.
  const VTIME: i64 = 5;
  const VMIN: i64 = 6;

  // ioctl request codes (asm-generic ioctls).
  /** Read the window size into a struct winsize. */
  public const TIOCGWINSZ: u64 = 0x5413;
  /** Set the window size from a struct winsize. */
  public const TIOCSWINSZ: u64 = 0x5414;
  /** Make the terminal the calling session's controlling terminal. */
  public const TIOCSCTTY: u64 = 0x540E;
}
