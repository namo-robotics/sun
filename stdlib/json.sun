// stdlib/json.sun - JSON parsing and serialization
//
// A parsed document is a tree of Json values. Objects keep their members in
// insertion order (lookup is a linear scan), numbers are Int(i64) when the
// text is an integer that fits, Float(f64) otherwise.
//
// Usage:
//   using sun;
//
//   var alloc = make_heap_allocator();
//   var doc = parse_json(alloc, "{\"name\": \"sun\", \"tags\": [1, 2.5]}");
//   var name: ref String = doc.get("name").as_string();
//   var second: f64 = doc.get("tags").at(1).as_f64();
//
//   var obj = create_json_object(alloc);
//   obj.set(String(alloc, "ok"), Json(true));
//   var text = obj.to_string(alloc);          // {"ok":true}
//   var pretty = obj.to_pretty_string(alloc, 2);
//
// Ownership: the tree owns everything in it. Json(s) and set(key, value)
// move their String/Json arguments in, so the caller cannot use them after
// the call. To keep a String, store a copy with create_json_string(alloc, ref s).

public module sun {
  // ==========================================================================
  // Errors
  // ==========================================================================

  // Raised by parse_json (with the byte offset of the problem) and by the
  // Json readers when the value has another kind (offset -1).
  public class JsonError implements IError {
    var message_: static_ptr<u8>;
    var offset_: i64;

    // Build a parse error with an explanation and the byte offset it happened at.
    // An offset of -1 means the error was not tied to a position.
    init(message: static_ptr<u8>, offset: i64) {
      this.message_ = message;
      this.offset_ = offset;
    }

    // Always 10, the code for a JSON error.
    public method code() i32 {
      return 60;
    }

    // A fresh copy of the explanation, owned by the caller.
    public method message() String {
      return String(this.message_);
    }

    // Byte offset into the parsed text, or -1 for non-parse errors
    public method offset() i64 {
      return this.offset_;
    }
  }

  // ==========================================================================
  // Value tree
  // ==========================================================================

  public enum JsonValue {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    String(String),
    Array(Vec<Json>),
    Object(Vec<JsonMember>)
  }

  // One "key": value pair of an object
  public class JsonMember {
    var key: String;
    var value: Json;

    // Build a member. Both the key and the value move in.
    init(key: String, value: Json) {
      this.key = key;
      this.value = value;
    }
  }

  public class Json {
    // The tree node itself; match on it directly when the methods below are
    // not enough (see JsonValue)
    public var value: JsonValue;

    // null
    init() {
      this.value = JsonValue.Null;
    }

    // Build a node around an already-built value.
    init(v: JsonValue) {
      this.value = v;
    }

    // Build a JSON true or false.
    init(b: bool) {
      this.value = JsonValue.Bool(b);
    }

    // Build a JSON integer.
    init(n: i64) {
      this.value = JsonValue.Int(n);
    }

    // Build a JSON floating-point number.
    init(x: f64) {
      this.value = JsonValue.Float(x);
    }

    // Takes ownership of the string: s is moved into the node and cannot be
    // used afterwards. To keep the original, pass a borrow to
    // create_json_string(alloc, ref s), which stores a copy.
    init(s: String) {
      this.value = JsonValue.String(s);
    }

    // ------------------------------------------------------------------------
    // Kind checks
    // ------------------------------------------------------------------------

    public method is_null() bool {
      return match this.value {
        JsonValue.Null => true,
        _ => false
      };
    }

    // Report whether this node is true or false.
    public method is_bool() bool {
      return match this.value {
        JsonValue.Bool(b) => true,
        _ => false
      };
    }

    // Report whether this node is an integer. A number written with a decimal
    // point or exponent is a float, not an int.
    public method is_int() bool {
      return match this.value {
        JsonValue.Int(n) => true,
        _ => false
      };
    }

    // Report whether this node is a floating-point number.
    public method is_float() bool {
      return match this.value {
        JsonValue.Float(x) => true,
        _ => false
      };
    }

    // Int or Float
    public method is_number() bool {
      return match this.value {
        JsonValue.Int(n) => true,
        JsonValue.Float(x) => true,
        _ => false
      };
    }

    // Report whether this node is a string.
    public method is_string() bool {
      return match this.value {
        JsonValue.String(s) => true,
        _ => false
      };
    }

    // Report whether this node is an array.
    public method is_array() bool {
      return match this.value {
        JsonValue.Array(items) => true,
        _ => false
      };
    }

    // Report whether this node is an object.
    public method is_object() bool {
      return match this.value {
        JsonValue.Object(members) => true,
        _ => false
      };
    }

    // ------------------------------------------------------------------------
    // Readers
    // ------------------------------------------------------------------------

    public method as_bool() bool throws IError {
      match this.value {
        JsonValue.Bool(b) => {
          return b;
        },
        _ => {
          throw JsonError("JSON value is not a bool", -1);
        }
      };
    }

    // Int, or a Float with an integral value
    public method as_i64() i64 throws IError {
      match this.value {
        JsonValue.Int(n) => {
          return n;
        },
        JsonValue.Float(x) => {
          var min_f: f64 = _convert<f64>(I64_MIN);
          if (x >= min_f and x < 0.0 - min_f) {
            var n: i64 = _convert<i64>(x);
            if (_convert<f64>(n) == x) {
              return n;
            }
          }
          throw JsonError("JSON number is not an integer", -1);
        },
        _ => {
          throw JsonError("JSON value is not a number", -1);
        }
      };
    }

    // Int or Float, as f64
    public method as_f64() f64 throws IError {
      match this.value {
        JsonValue.Int(n) => {
          return _convert<f64>(n);
        },
        JsonValue.Float(x) => {
          return x;
        },
        _ => {
          throw JsonError("JSON value is not a number", -1);
        }
      };
    }

    // Borrow the string this node holds. Throws if it is not a string; the node
    // keeps ownership of the text.
    public method as_string() ref String throws IError {
      match this.value {
        JsonValue.String(s) => {
          return s;
        },
        _ => {
          throw JsonError("JSON value is not a string", -1);
        }
      };
    }

    // Number of array items or object members; 0 for other kinds
    public method len() i64 {
      return match this.value {
        JsonValue.Array(items) => items.size(),
        JsonValue.Object(members) => members.size(),
        _ => 0
      };
    }

    // Array item by index
    public method at(i: i64) ref Json throws IError {
      match this.value {
        JsonValue.Array(items) => {
          if (i < 0 or i >= items.size()) {
            throw JsonError("JSON array index out of range", -1);
          }
          return items.get(i);
        },
        _ => {
          throw JsonError("JSON value is not an array", -1);
        }
      };
    }

    // Object member value by key
    public method get(key: static_ptr<u8>) ref Json throws IError {
      match this.value {
        JsonValue.Object(members) => {
          for (var i: i64 = 0; i < members.size(); i = i + 1) {
            if (members.get(i).key.equals_literal(key)) {
              return members.get(i).value;
            }
          }
          throw JsonError("JSON object has no such key", -1);
        },
        _ => {
          throw JsonError("JSON value is not an object", -1);
        }
      };
    }

    // Borrow the value stored under a key built at runtime. Throws if this is not
    // an object or the key is absent.
    public method get(key: const ref String) ref Json throws IError {
      match this.value {
        JsonValue.Object(members) => {
          for (var i: i64 = 0; i < members.size(); i = i + 1) {
            if (members.get(i).key.equals(key)) {
              return members.get(i).value;
            }
          }
          throw JsonError("JSON object has no such key", -1);
        },
        _ => {
          throw JsonError("JSON value is not an object", -1);
        }
      };
    }

    // True if this is an object with the key
    public method has(key: static_ptr<u8>) bool {
      return match this.value {
        JsonValue.Object(members) => this.find_member_index(members, key) >= 0,
        _ => false
      };
    }

    // The position of a key in an object's members, or -1 when it is absent.
    method find_member_index(members: const ref Vec<JsonMember>, key: static_ptr<u8>) i64 {
      for (var i: i64 = 0; i < members.size(); i = i + 1) {
        if (members.get(i).key.equals_literal(key)) {
          return i;
        }
      }
      return -1;
    }

    // Object member key by position (insertion order)
    public method key_at(i: i64) ref String throws IError {
      match this.value {
        JsonValue.Object(members) => {
          if (i < 0 or i >= members.size()) {
            throw JsonError("JSON member index out of range", -1);
          }
          return members.get(i).key;
        },
        _ => {
          throw JsonError("JSON value is not an object", -1);
        }
      };
    }

    // Object member value by position (insertion order)
    public method value_at(i: i64) ref Json throws IError {
      match this.value {
        JsonValue.Object(members) => {
          if (i < 0 or i >= members.size()) {
            throw JsonError("JSON member index out of range", -1);
          }
          return members.get(i).value;
        },
        _ => {
          throw JsonError("JSON value is not an object", -1);
        }
      };
    }

    // ------------------------------------------------------------------------
    // Building
    // ------------------------------------------------------------------------

    // Append an item to an array
    public method push(item: Json) void throws IError {
      match this.value {
        JsonValue.Array(items) => {
          items.push(item);
        },
        _ => {
          throw JsonError("JSON value is not an array", -1);
        }
      };
    }

    // Set an object member: replaces the value of an existing key (the old
    // value is dropped) or appends a new member.
    public method set(key: String, value: Json) void throws IError {
      match this.value {
        JsonValue.Object(members) => {
          var index: i64 = -1;
          for (var i: i64 = 0; i < members.size(); i = i + 1) {
            if (members.get(i).key.equals(key)) {
              index = i;
            }
          }
          if (index >= 0) {
            members.set(index, JsonMember(key, value));
          } else {
            members.push(JsonMember(key, value));
          }
        },
        _ => {
          throw JsonError("JSON value is not an object", -1);
        }
      };
    }

    // ------------------------------------------------------------------------
    // Serialization
    // ------------------------------------------------------------------------

    // Append compact JSON text (no whitespace)
    public method write(out: ref String) void {
      write_json_value(this, out, -1, 0);
    }

    // Append JSON text with newlines and `indent` spaces per level
    public method write_pretty(out: ref String, indent: i64) void {
      write_json_value(this, out, indent, 0);
    }

    // Render this node as compact JSON text in a new String.
    public method to_string(alloc: ref HeapAllocator) String {
      var out = String(alloc, "");
      this.write(out);
      return out;
    }

    // Render this node as JSON text with newlines and `indent` spaces per level.
    public method to_pretty_string(alloc: ref HeapAllocator, indent: i64) String {
      var out = String(alloc, "");
      this.write_pretty(out, indent);
      return out;
    }
  }

  // Empty array
  public function create_json_array(alloc: ref HeapAllocator) Json {
    return Json(JsonValue.Array(Vec<Json>(alloc, 4)));
  }

  // Empty object
  public function create_json_object(alloc: ref HeapAllocator) Json {
    return Json(JsonValue.Object(Vec<JsonMember>(alloc, 4)));
  }

  // String value from a literal
  public function create_json_string(alloc: ref HeapAllocator, text: static_ptr<u8>) Json {
    return Json(String(alloc, text));
  }

  // String value copied from a borrowed String; the caller keeps its own.
  // Use Json(s) instead to hand the String over without a copy.
  public function create_json_string(alloc: ref HeapAllocator, text: const ref String) Json {
    return Json(text.clone(alloc));
  }

  // ==========================================================================
  // Writer
  // ==========================================================================

  function write_json_indent(out: ref String, indent: i64, level: i64) void {
    if (indent < 0) {
      return;
    }
    out.append_char(b'\n');
    for (var i: i64 = 0; i < indent * level; i = i + 1) {
      out.append_char(b' ');
    }
  }

  // Append a code point as exactly four hex digits, for a \u escape.
  function write_json_hex4(out: ref String, code: i64) void {
    var shift: i64 = 12;
    while (shift >= 0) {
      var nibble: i64 = (code >> shift) & 15;
      if (nibble < 10) {
        out.append_char(_convert<u8>(b'0' + nibble));
      } else {
        out.append_char(_convert<u8>(b'a' + nibble - 10));
      }
      shift = shift - 4;
    }
  }

  // Quoted string with JSON escapes; bytes >= 0x20 other than '"' and '\'
  // pass through unchanged (UTF-8 stays UTF-8)
  function write_json_string(s: const ref String, out: ref String) void {
    out.append_char(b'"');
    var n: i64 = s.length();
    for (var i: i64 = 0; i < n; i = i + 1) {
      var ch: u8 = s.at(i);
      if (ch == b'"') {
        out.append_literal("\\\"");
      } else if (ch == b'\\') {
        out.append_literal("\\\\");
      } else if (ch == b'\n') {
        out.append_literal("\\n");
      } else if (ch == b'\r') {
        out.append_literal("\\r");
      } else if (ch == b'\t') {
        out.append_literal("\\t");
      } else if (ch == b'\x08') {
        out.append_literal("\\b");
      } else if (ch == b'\x0C') {
        out.append_literal("\\f");
      } else if (ch < b' ') {
        out.append_literal("\\u");
        write_json_hex4(out, _convert<i64>(ch));
      } else {
        out.append_char(ch);
      }
    }
    out.append_char(b'"');
  }

  // Floats keep a '.'/exponent so they read back as Float; non-finite
  // values have no JSON spelling and are written as null
  function write_json_float(x: f64, out: ref String) void {
    if (x != x or x > F64_MAX or x < 0.0 - F64_MAX) {
      // nan / inf
      out.append_literal("null");
      return;
    }
    var start: i64 = out.length();
    out.append_f64(x);
    for (var i: i64 = start; i < out.length(); i = i + 1) {
      var ch: u8 = out.at(i);
      if (ch == b'.' or ch == b'e') {
        // '.' 'e'
        return;
      }
    }
    out.append_literal(".0");
  }

  // Append one node's JSON text. An indent below zero writes compact output;
  // otherwise each level is indented by that many spaces.
  function write_json_value(j: const ref Json, out: ref String, indent: i64, level: i64) void {
    match j.value {
      JsonValue.Null => {
        out.append_literal("null");
      },
      JsonValue.Bool(b) => {
        out.append_bool(b);
      },
      JsonValue.Int(n) => {
        out.append_i64(n);
      },
      JsonValue.Float(x) => {
        write_json_float(x, out);
      },
      JsonValue.String(s) => {
        write_json_string(s, out);
      },
      JsonValue.Array(items) => {
        out.append_char(b'[');
        var n: i64 = items.size();
        for (var i: i64 = 0; i < n; i = i + 1) {
          if (i > 0) {
            out.append_char(b',');
          }
          write_json_indent(out, indent, level + 1);
          write_json_value(items.get_unchecked(i), out, indent, level + 1);
        }
        if (n > 0) {
          write_json_indent(out, indent, level);
        }
        out.append_char(b']');
      },
      JsonValue.Object(members) => {
        out.append_char(b'{');
        var n: i64 = members.size();
        for (var i: i64 = 0; i < n; i = i + 1) {
          if (i > 0) {
            out.append_char(b',');
          }
          write_json_indent(out, indent, level + 1);
          write_json_string(members.get_unchecked(i).key, out);
          out.append_char(b':');
          if (indent >= 0) {
            out.append_char(b' ');
          }
          write_json_value(members.get_unchecked(i).value, out, indent, level + 1);
        }
        if (n > 0) {
          write_json_indent(out, indent, level);
        }
        out.append_char(b'}');
      }
    };
  }

  // ==========================================================================
  // Parser
  // ==========================================================================

  // Deepest allowed array/object nesting
  var JSON_MAX_DEPTH: i64 = 256;

  class JsonParser {
    var pos: i64;
    var depth: i64;
    var alloc: HeapAllocator;

    // Build a parser positioned at the start of the text.
    init(alloc: ref HeapAllocator) {
      this.pos = 0;
      this.depth = 0;
      this.alloc = alloc.copy();
    }

    // The byte at the current position, or -1 at the end of the text.
    method peek(text: const ref String) i64 {
      if (this.pos >= text.length()) {
        return -1;
      }
      return _convert<i64>(text.at(this.pos));
    }

    // Step past spaces, tabs, newlines and carriage returns.
    method skip_whitespace(text: const ref String) void {
      while (this.pos < text.length()) {
        var ch: u8 = text.at(this.pos);
        if (ch == b' ' or ch == b'\t' or ch == b'\n' or ch == b'\r') {
          this.pos = this.pos + 1;
        } else {
          return;
        }
      }
    }

    // Consume `literal` at pos or fail
    method expect_literal(text: const ref String, literal: static_ptr<u8>, what: static_ptr<u8>) void throws IError {
      var data: raw_ptr<u8> = literal.raw();
      var n: i64 = literal.length();
      var start: i64 = this.pos;
      for (var i: i64 = 0; i < n; i = i + 1) {
        var expected: u8 = unsafe { _load<u8>(data, i); };
        if (this.pos >= text.length() or text.at(this.pos) != expected) {
          throw JsonError(what, start);
        }
        this.pos = this.pos + 1;
      }
    }

    // Parse whatever JSON value starts at the current position.
    method parse_value(text: const ref String) Json throws IError {
      var ch: i64 = this.peek(text);
      if (ch == b'{') {
        return this.parse_object(text);
      }
      if (ch == b'[') {
        return this.parse_array(text);
      }
      if (ch == b'"') {
        return Json(this.parse_string(text));
      }
      if (ch == b't') {
        this.expect_literal(text, "true", "invalid JSON literal");
        return Json(true);
      }
      if (ch == b'f') {
        this.expect_literal(text, "false", "invalid JSON literal");
        return Json(false);
      }
      if (ch == b'n') {
        this.expect_literal(text, "null", "invalid JSON literal");
        return Json();
      }
      if (ch == b'-' or (ch >= b'0' and ch <= b'9')) {
        return this.parse_number(text);
      }
      if (ch < 0) {
        throw JsonError("unexpected end of JSON text", this.pos);
      }
      throw JsonError("unexpected character in JSON text", this.pos);
    }

    // Count one level deeper into an array or object, throwing once the nesting
    // limit is passed. This is what stops a deeply nested document from running
    // the stack out.
    method enter(text: const ref String) void throws IError {
      this.depth = this.depth + 1;
      if (this.depth > JSON_MAX_DEPTH) {
        throw JsonError("JSON nesting too deep", this.pos);
      }
    }

    // Parse an array, from its '[' through its ']'.
    method parse_array(text: const ref String) Json throws IError {
      this.enter(text);
      this.pos = this.pos + 1;  // '['
      var items = Vec<Json>(this.alloc, 4);
      this.skip_whitespace(text);
      if (this.peek(text) == b']') {
        this.pos = this.pos + 1;
        this.depth = this.depth - 1;
        return Json(JsonValue.Array(items));
      }
      while (true) {
        this.skip_whitespace(text);
        items.push(this.parse_value(text));
        this.skip_whitespace(text);
        var ch: i64 = this.peek(text);
        if (ch == b',') {
          this.pos = this.pos + 1;
        } else if (ch == b']') {
          this.pos = this.pos + 1;
          this.depth = this.depth - 1;
          return Json(JsonValue.Array(items));
        } else if (ch < 0) {
          throw JsonError("unterminated JSON array", this.pos);
        } else {
          throw JsonError("expected ',' or ']' in JSON array", this.pos);
        }
      }
      return Json();
    }

    // Parse an object, from its '{' through its '}'.
    method parse_object(text: const ref String) Json throws IError {
      this.enter(text);
      this.pos = this.pos + 1;  // '{'
      var members = Vec<JsonMember>(this.alloc, 4);
      this.skip_whitespace(text);
      if (this.peek(text) == b'}') {
        this.pos = this.pos + 1;
        this.depth = this.depth - 1;
        return Json(JsonValue.Object(members));
      }
      while (true) {
        this.skip_whitespace(text);
        if (this.peek(text) != b'"') {
          throw JsonError("expected string key in JSON object", this.pos);
        }
        var key: String = this.parse_string(text);
        this.skip_whitespace(text);
        if (this.peek(text) != b':') {
          throw JsonError("expected ':' after JSON object key", this.pos);
        }
        this.pos = this.pos + 1;
        this.skip_whitespace(text);
        var value: Json = this.parse_value(text);
        members.push(JsonMember(key, value));
        this.skip_whitespace(text);
        var ch: i64 = this.peek(text);
        if (ch == b',') {
          this.pos = this.pos + 1;
        } else if (ch == b'}') {
          this.pos = this.pos + 1;
          this.depth = this.depth - 1;
          return Json(JsonValue.Object(members));
        } else if (ch < 0) {
          throw JsonError("unterminated JSON object", this.pos);
        } else {
          throw JsonError("expected ',' or '}' in JSON object", this.pos);
        }
      }
      return Json();
    }

    // Read one hex digit and step past it. Throws on anything else.
    method parse_hex_digit(text: const ref String) i64 throws IError {
      var ch: i64 = this.peek(text);
      this.pos = this.pos + 1;
      if (ch >= b'0' and ch <= b'9') {
        return ch - b'0';
      }
      if (ch >= b'a' and ch <= b'f') {
        return ch - b'a' + 10;
      }
      if (ch >= b'A' and ch <= b'F') {
        return ch - b'A' + 10;
      }
      throw JsonError("invalid \\u escape in JSON string", this.pos - 1);
    }

    // Read the four hex digits of a \u escape as a code point.
    method parse_hex4(text: const ref String) i64 throws IError {
      var code: i64 = 0;
      for (var i: i64 = 0; i < 4; i = i + 1) {
        code = code * 16 + this.parse_hex_digit(text);
      }
      return code;
    }

    // The UTF-8 encoder lives in string.sun; privacy is module-scoped and
    // both files are `module sun`, so push_code is reachable here.
    method append_utf8(out: ref String, code: i64) void {
      out.push_code(code);
    }

    // Parse a quoted string starting at pos, decoding escapes into UTF-8
    method parse_string(text: const ref String) String throws IError {
      var start: i64 = this.pos;
      this.pos = this.pos + 1;  // opening '"'
      var out = String(this.alloc, "");
      while (true) {
        var ch: i64 = this.peek(text);
        if (ch < 0) {
          throw JsonError("unterminated JSON string", start);
        }
        if (ch == b'"') {
          // closing '"'
          this.pos = this.pos + 1;
          return out;
        }
        if (ch < b' ') {
          throw JsonError("control character in JSON string", this.pos);
        }
        if (ch != b'\\') {
          // not '\'
          out.append_char(_convert<u8>(ch));
          this.pos = this.pos + 1;
          continue;
        }
        // Escape sequence
        var esc_at: i64 = this.pos;
        this.pos = this.pos + 1;
        var esc: i64 = this.peek(text);
        this.pos = this.pos + 1;
        if (esc == b'"' or esc == b'\\' or esc == b'/') {
          // '"' '\' '/'
          out.append_char(_convert<u8>(esc));
        } else if (esc == b'n') {
          out.append_char(b'\n');
        } else if (esc == b't') {
          out.append_char(b'\t');
        } else if (esc == b'r') {
          out.append_char(b'\r');
        } else if (esc == b'b') {
          out.append_char(b'\x08');
        } else if (esc == b'f') {
          out.append_char(b'\x0C');
        } else if (esc == b'u') {
          var code: i64 = this.parse_hex4(text);
          if (code >= 55296 and code <= 56319) {
            // high surrogate
            var low: i64 = -1;
            if (this.peek(text) == b'\\' and this.pos + 1 < text.length() and text.at(this.pos + 1) == b'u') {
              var save: i64 = this.pos;
              this.pos = this.pos + 2;
              low = this.parse_hex4(text);
              if (low < 56320 or low > 57343) {
                this.pos = save;  // not a low surrogate: leave it for the next round
                low = -1;
              }
            }
            if (low >= 0) {
              code = 65536 + ((code - 55296) << 10) + (low - 56320);
            } else {
              code = 65533;  // U+FFFD replacement character
            }
          } else if (code >= 56320 and code <= 57343) {
            // lone low surrogate
            code = 65533;
          }
          this.append_utf8(out, code);
        } else {
          throw JsonError("invalid escape in JSON string", esc_at);
        }
      }
      return out;
    }

    // Step past a run of decimal digits and return how many there were.
    method parse_digits(text: const ref String) i64 {
      var count: i64 = 0;
      while (this.pos < text.length() and text.at(this.pos) >= b'0' and text.at(this.pos) <= b'9') {
        this.pos = this.pos + 1;
        count = count + 1;
      }
      return count;
    }

    // number = [-] int [frac] [exp]; int = 0 | [1-9][0-9]*
    method parse_number(text: const ref String) Json throws IError {
      var start: i64 = this.pos;
      if (this.peek(text) == b'-') {
        this.pos = this.pos + 1;
      }
      var first: i64 = this.peek(text);
      if (first == b'0') {
        // '0' must stand alone
        this.pos = this.pos + 1;
        if (this.peek(text) >= b'0' and this.peek(text) <= b'9') {
          throw JsonError("leading zeros are not allowed in JSON numbers", start);
        }
      } else if (first >= b'1' and first <= b'9') {
        this.parse_digits(text);
      } else {
        throw JsonError("invalid JSON number", start);
      }
      var is_float: bool = false;
      if (this.peek(text) == b'.') {
        is_float = true;
        this.pos = this.pos + 1;
        if (this.parse_digits(text) == 0) {
          throw JsonError("digits expected after '.' in JSON number", this.pos);
        }
      }
      if (this.peek(text) == b'e' or this.peek(text) == b'E') {
        // 'e' 'E'
        is_float = true;
        this.pos = this.pos + 1;
        if (this.peek(text) == b'+' or this.peek(text) == b'-') {
          this.pos = this.pos + 1;
        }
        if (this.parse_digits(text) == 0) {
          throw JsonError("digits expected in JSON number exponent", this.pos);
        }
      }
      var token = String(this.alloc, "");
      for (var i: i64 = start; i < this.pos; i = i + 1) {
        token.append_char(text.at(i));
      }
      if (not is_float) {
        match token.parse_i64() {
          Option.Some(n) => {
            return Json(n);
          },
          Option.None => {}
        };
      }
      match token.parse_f64() {
        Option.Some(x) => {
          return Json(x);
        },
        Option.None => {
          throw JsonError("invalid JSON number", start);
        }
      };
    }
  }

  // Parse a complete JSON text. Trailing whitespace is allowed, anything else
  // after the value is an error.
  public function parse_json(alloc: ref HeapAllocator, text: const ref String) Json throws IError {
    var parser = JsonParser(alloc);
    parser.skip_whitespace(text);
    var value: Json = parser.parse_value(text);
    parser.skip_whitespace(text);
    if (parser.pos < text.length()) {
      throw JsonError("unexpected text after JSON value", parser.pos);
    }
    return value;
  }

  // Parse a JSON literal into a tree. Throws JsonError on malformed text.
  public function parse_json(alloc: ref HeapAllocator, text: static_ptr<u8>) Json throws IError {
    var owned = String(alloc, text);
    return parse_json(alloc, owned);
  }

  // ============================================================================
  // Precompiled Specializations
  // ============================================================================

  public declare Vec_Json = Vec<Json>;
  public declare Vec_JsonMember = Vec<JsonMember>;
}  // module sun
