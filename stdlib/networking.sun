// stdlib/networking.sun - Network socket wrapper over __socket* intrinsics
//
// Provides TCP client and server abstractions using high-level IPv4 intrinsics.
//
// Usage:
//   using sun;
//
//   // TCP Server (for HTTP, prefer HttpServer from http.sun)
//   var listener = TcpListener();
//   listener.bind_port(8080);
//   listener.listen(128);
//   while (true) {
//       var client = listener.accept();
//       client.send_str("Hello!");
//       client.close();
//   }
//
//   // TCP Client
//   var stream = TcpStream();
//   stream.connect_local(8080);
//   stream.send_str("ping");
//   stream.close();

public module sun {
  // -------------------------------------------------------------------
  // Socket constants (Linux x86_64)
  // -------------------------------------------------------------------

  public var AF_INET: i32 = 2;
  public var SOCK_STREAM: i32 = 1;
  public var SHUT_RDWR: i32 = 2;
  public var MSG_NOSIGNAL: i32 = 16384;
  public var INADDR_ANY: i32 = 0;
  public var INADDR_LOOPBACK: i32 = 16777343;  // 127.0.0.1 in network byte order
  public var SOL_SOCKET: i32 = 1;
  public var SO_REUSEADDR: i32 = 2;

  // -------------------------------------------------------------------
  // DNS resolution
  // -------------------------------------------------------------------

  // Resolve a hostname to its first IPv4 address, returned in network byte
  // order (the shape connect_ip takes). Throws when the name does not resolve
  // or has no IPv4 address. Field offsets are documented at the getaddrinfo
  // declaration in sys.sun.
  public function resolve_host_ipv4(host: ref String) i32, IError {
    var list: raw_ptr<u8> = null;
    var rc: i32 = unsafe { c_getaddrinfo(host.c_str(), null, null, _address_of<raw_ptr<u8>>(list)); };
    if (rc != 0) {
      var alloc: HeapAllocator = HeapAllocator();
      var msg: String = from_c_str(alloc, unsafe { c_gai_strerror(rc); });
      throw Error(rc, msg);
    }
    var entry: raw_ptr<u8> = list;
    while (entry != null) {
      var family: i32 = unsafe { _load<i32>(entry, 1); };  // ai_family @4
      var socktype: i32 = unsafe { _load<i32>(entry, 2); };  // ai_socktype @8
      if (family == AF_INET and socktype == SOCK_STREAM) {
        var sa: raw_ptr<u8> = unsafe { _load<raw_ptr<u8>>(entry, 3); };  // ai_addr @24
        var ip: i32 = unsafe { _load<i32>(sa, 1); };  // sin_addr @4, network order
        unsafe { c_freeaddrinfo(list); };
        return ip;
      }
      entry = unsafe { _load<raw_ptr<u8>>(entry, 5); };  // ai_next @40
    }
    unsafe { c_freeaddrinfo(list); };
    throw Error(-1, "host has no IPv4 address");
  }

  // -------------------------------------------------------------------
  // TcpStream - TCP connection (client or accepted)
  // -------------------------------------------------------------------

  public class TcpStream {
    var fd: i32;

    public function init() {
      this.fd = -1;
    }

    function deinit() void {
      this.close();
    }

    // Connect to loopback (127.0.0.1) on port
    public function connect_local(port: i32) void, IError {
      var sock_fd: i32 = unsafe { __socket(AF_INET, SOCK_STREAM, 0); };
      if (sock_fd < 0) {
        throw Error(sock_fd, "failed to create socket");
      }
      this.fd = sock_fd;

      var result: i32 = unsafe { __connect_ipv4(this.fd, INADDR_LOOPBACK, port); };
      if (result < 0) {
        throw Error(result, "failed to connect");
      }
    }

    // Connect to specific IP (in network byte order) and port
    public function connect_ip(ip: i32, port: i32) void, IError {
      var sock_fd: i32 = unsafe { __socket(AF_INET, SOCK_STREAM, 0); };
      if (sock_fd < 0) {
        throw Error(sock_fd, "failed to create socket");
      }
      this.fd = sock_fd;

      var result: i32 = unsafe { __connect_ipv4(this.fd, ip, port); };
      if (result < 0) {
        throw Error(result, "failed to connect");
      }
    }

    // Resolve a hostname and connect to its first IPv4 address
    public function connect_host(host: ref String, port: i32) void, IError {
      var ip: i32 = resolve_host_ipv4(host);
      this.connect_ip(ip, port);
    }

    // Send string data
    public function send_str(data: static_ptr<u8>) i64, IError {
      var str_ptr: raw_ptr<u8> = data.raw();
      var len: i64 = data.length();
      var result: i64 = unsafe { __send(this.fd, str_ptr, len, MSG_NOSIGNAL); };
      if (result < 0) {
        var err_code: i32 = -1;
        throw Error(err_code, "send failed");
      }
      return result;
    }

    // Send raw bytes
    public function send_bytes(data: raw_ptr<u8>, len: i64) i64, IError {
      var result: i64 = unsafe { __send(this.fd, data, len, MSG_NOSIGNAL); };
      if (result < 0) {
        var err_code: i32 = -1;
        throw Error(err_code, "send failed");
      }
      return result;
    }

    // Send a String's contents
    public function send_string(data: const ref String) i64, IError {
      return this.send_bytes(data.data.rawData(), data.length());
    }

    // Receive into ContiguousBuffer, returns bytes read
    public function recv(buf: ref ContiguousBuffer<u8>) i64, IError {
      var result: i64 = unsafe { __recv(this.fd, buf.rawData(), buf.size(), 0); };
      if (result < 0) {
        var err_code: i32 = -1;
        throw Error(err_code, "recv failed");
      }
      return result;
    }

    // Close the connection
    public function close() void {
      if (this.fd >= 0) {
        unsafe { __shutdown(this.fd, SHUT_RDWR); };
        unsafe { c_close(this.fd); };
        this.fd = -1;
      }
    }

    public function is_open() bool {
      return this.fd >= 0;
    }

    public function get_fd() i32 {
      return this.fd;
    }
  }

  // -------------------------------------------------------------------
  // TcpListener - TCP server socket
  // -------------------------------------------------------------------

  public class TcpListener {
    var fd: i32;

    public function init() {
      this.fd = -1;
    }

    function deinit() void {
      this.close();
    }

    // Allow rebinding the port immediately after a restart
    public function enable_reuse_addr() void {
      var optval: i32 = 1;
      unsafe { __setsockopt(this.fd, SOL_SOCKET, SO_REUSEADDR, _address_of<i32>(optval), 4); };
    }

    // Create and bind to port on all interfaces (0.0.0.0)
    public function bind_port(port: i32) void, IError {
      var sock_fd: i32 = unsafe { __socket(AF_INET, SOCK_STREAM, 0); };
      if (sock_fd < 0) {
        throw Error(sock_fd, "failed to create socket");
      }
      this.fd = sock_fd;
      this.enable_reuse_addr();

      var result: i32 = unsafe { __bind_ipv4(this.fd, INADDR_ANY, port); };
      if (result < 0) {
        throw Error(result, "failed to bind socket");
      }
    }

    // Create and bind to loopback (127.0.0.1) on port
    public function bind_loopback(port: i32) void, IError {
      var sock_fd: i32 = unsafe { __socket(AF_INET, SOCK_STREAM, 0); };
      if (sock_fd < 0) {
        throw Error(sock_fd, "failed to create socket");
      }
      this.fd = sock_fd;
      this.enable_reuse_addr();

      var result: i32 = unsafe { __bind_ipv4(this.fd, INADDR_LOOPBACK, port); };
      if (result < 0) {
        throw Error(result, "failed to bind socket");
      }
    }

    // Start listening for connections
    public function listen(backlog: i32) void, IError {
      var result: i32 = unsafe { __listen(this.fd, backlog); };
      if (result < 0) {
        throw Error(result, "failed to listen");
      }
    }

    // Accept a new connection, returns TcpStream
    public function accept() TcpStream, IError {
      var client_fd: i32 = unsafe { __accept_fd(this.fd); };
      if (client_fd < 0) {
        throw Error(client_fd, "failed to accept connection");
      }
      var stream = TcpStream();
      stream.fd = client_fd;
      return stream;
    }

    // Close the listener
    public function close() void {
      if (this.fd >= 0) {
        unsafe { __shutdown(this.fd, SHUT_RDWR); };
        unsafe { c_close(this.fd); };
        this.fd = -1;
      }
    }

    public function is_open() bool {
      return this.fd >= 0;
    }

    public function get_fd() i32 {
      return this.fd;
    }
  }
}  // module sun
