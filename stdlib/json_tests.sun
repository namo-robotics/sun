// stdlib/json_tests.sun - Tests for json.sun: parsing, access, building,
// writing. Replaces the C++ suite Stdlib_Json; the compile-time
// use-after-move test json_constructor_takes_ownership_of_string stays in
// tests/stdlib/test_json.cpp.

using std;

public module std {
  module json_tests {
    test_function parse_scalars() {
      var alloc = make_heap_allocator();
      std.test.assert(parse_json(alloc, "null").is_null(), "null parses");
      std.test.assert(parse_json(alloc, "true").as_bool(), "true parses");
      std.test.assert(parse_json(alloc, "false").as_bool() == false, "false parses");
      std.test.assert_eq(parse_json(alloc, "42").as_i64(), 42);
      std.test.assert_eq(parse_json(alloc, "-7").as_i64(), -7);
      std.test.assert_eq(parse_json(alloc, "2.5").as_f64(), 2.5);
      std.test.assert_eq(parse_json(alloc, "-1e2").as_f64(), -100.0);
      std.test.assert_eq(parse_json(alloc, "1E-2").as_f64(), 0.01);
      std.test.assert_eq(parse_json(alloc, "0").as_i64(), 0);
      std.test.assert_eq(parse_json(alloc, "  \n\t 5 \r\n").as_i64(), 5);
      var n = parse_json(alloc, "42");
      std.test.assert(
        n.is_int() and n.is_float() == false and n.is_number(),
        "42 is an integer number"
      );
      var f = parse_json(alloc, "4.0");
      std.test.assert(f.is_float() and f.is_int() == false, "4.0 is a float");
      std.test.assert_eq(f.as_i64(), 4);
      std.test.assert_eq(parse_json(alloc, "9223372036854775807").as_i64(), 9223372036854775807);
      var huge = parse_json(alloc, "9223372036854775808");
      std.test.assert(huge.is_float(), "past i64 max becomes a float");
      var s = parse_json(alloc, "\"hi\"");
      std.test.assert(s.is_string(), "a quoted value is a string");
      std.test.assert(s.as_string().equals_literal("hi"), "string content");
    }

    test_function parse_string_escapes() {
      var alloc = make_heap_allocator();
      var s = parse_json(alloc, "\"a\\\"b\\\\c\\/d\\n\\t\\r\\b\\f\"");
      var text: ref String = s.as_string();
      std.test.assert_eq(text.length(), 12);
      std.test.assert_eq(_convert<i32>(text.at(1)), 34);
      std.test.assert_eq(_convert<i32>(text.at(3)), 92);
      std.test.assert_eq(_convert<i32>(text.at(5)), 47);
      std.test.assert_eq(_convert<i32>(text.at(7)), 10);
      std.test.assert_eq(_convert<i32>(text.at(8)), 9);
      std.test.assert_eq(_convert<i32>(text.at(9)), 13);
      std.test.assert_eq(_convert<i32>(text.at(10)), 8);
      std.test.assert_eq(_convert<i32>(text.at(11)), 12);
      // \u escapes decode to UTF-8: é (2 bytes), € (3 bytes), 😀 as a
      // surrogate pair (4 bytes)
      var u = parse_json(alloc, "\"\\u00e9\\u20AC\\ud83d\\ude00\"");
      var ut: ref String = u.as_string();
      std.test.assert_eq(ut.length(), 9);
      std.test.assert(ut.at(0) == 195 and ut.at(1) == 169, "e-acute bytes");
      std.test.assert(ut.at(2) == 226 and ut.at(3) == 130 and ut.at(4) == 172, "euro bytes");
      std.test.assert(
        ut.at(5) == 240 and ut.at(6) == 159 and ut.at(7) == 152 and ut.at(8) == 128,
        "emoji bytes"
      );
      // A lone surrogate becomes U+FFFD (3 bytes)
      var lone = parse_json(alloc, "\"\\ud83d\"");
      std.test.assert_eq(lone.as_string().length(), 3);
      // Raw UTF-8 passes through
      var raw = parse_json(alloc, "\"héllo\"");
      std.test.assert_eq(raw.as_string().length(), 6);
    }

    test_function parse_nested_and_access() {
      var alloc = make_heap_allocator();
      var doc = parse_json(alloc, "{\"name\": \"sun\", \"tags\": [1, 2.5, true, null, {\"deep\": [[]]}], \"empty\": {}}");
      std.test.assert(doc.is_object(), "top level is an object");
      std.test.assert_eq(doc.len(), 3);
      std.test.assert(doc.get("name").as_string().equals_literal("sun"), "name member");
      var tags: ref Json = doc.get("tags");
      std.test.assert(tags.is_array(), "tags is an array");
      std.test.assert_eq(tags.len(), 5);
      std.test.assert_eq(tags.at(0).as_i64(), 1);
      std.test.assert_eq(tags.at(1).as_f64(), 2.5);
      std.test.assert(tags.at(2).as_bool(), "third tag is true");
      std.test.assert(tags.at(3).is_null(), "fourth tag is null");
      std.test.assert_eq(tags.at(4).get("deep").at(0).len(), 0);
      std.test.assert_eq(doc.get("empty").len(), 0);
      std.test.assert(doc.has("name") and doc.has("nope") == false, "has() finds members");
      std.test.assert(doc.key_at(0).equals_literal("name"), "first key");
      std.test.assert(doc.key_at(2).equals_literal("empty"), "third key");
      std.test.assert_eq(doc.value_at(1).len(), 5);
      var key = String(alloc, "tags");
      std.test.assert_eq(doc.get(key).len(), 5);
      // Scalars have length 0
      std.test.assert_eq(doc.get("name").len(), 0);
    }

    test_function reader_kind_mismatch_throws() {
      var alloc = make_heap_allocator();
      var codes: i32 = 0;
      var doc = parse_json(alloc, "{\"a\": [1], \"s\": \"x\", \"f\": 1.5}");
      try {
        doc.get("s").as_i64();
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("f").as_i64();
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("a").as_bool();
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("a").as_string();
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("missing");
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("a").at(5);
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("a").at(-1);
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("s").at(0);
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("a").get("k");
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.key_at(9);
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("s").push(Json());
      } catch (e: IError) {
        codes = codes + 1;
      }
      try {
        doc.get("a").set(String(alloc, "k"), Json());
      } catch (e: IError) {
        codes = codes + 1;
      }
      // A JsonError from a reader carries no text offset
      try {
        doc.get("s").as_f64();
      } catch (e: IError) {
        std.test.assert_eq(e.code(), 60);
        codes = codes + 1;
      }
      std.test.assert_eq(codes, 13);
    }

    // Returns the offset outcome for a parse: -1 if the text parsed, -2 for a
    // JsonError with a readable message, other values flag a wrong error.
    function classify_parse(alloc: ref HeapAllocator, text: static_ptr<u8>) i64 {
      try {
        var doc = parse_json(alloc, text);
        return -1;
      } catch (e: IError) {
        if (e.code() != 60) {
          return -100;
        }
        var msg: String = e.message();
        if (msg.is_empty()) {
          return -101;
        }
        return -2;
      }
    }

    test_function parse_errors_report_offsets() {
      var alloc = make_heap_allocator();
      std.test.assert_eq(classify_parse(alloc, ""), -2);
      std.test.assert_eq(classify_parse(alloc, "[1, 2,]"), -2);
      std.test.assert_eq(classify_parse(alloc, "[1 2]"), -2);
      std.test.assert_eq(classify_parse(alloc, "{\"a\" 1}"), -2);
      std.test.assert_eq(classify_parse(alloc, "{a: 1}"), -2);
      std.test.assert_eq(classify_parse(alloc, "{\"a\": 1,}"), -2);
      std.test.assert_eq(classify_parse(alloc, "[1, 2"), -2);
      std.test.assert_eq(classify_parse(alloc, "\"abc"), -2);
      std.test.assert_eq(classify_parse(alloc, "\"a\\qb\""), -2);
      std.test.assert_eq(classify_parse(alloc, "\"a\\u12\""), -2);
      std.test.assert_eq(classify_parse(alloc, "\"a\nb\""), -2);
      std.test.assert_eq(classify_parse(alloc, "tru"), -2);
      std.test.assert_eq(classify_parse(alloc, "nul"), -2);
      std.test.assert_eq(classify_parse(alloc, "01"), -2);
      std.test.assert_eq(classify_parse(alloc, "1."), -2);
      std.test.assert_eq(classify_parse(alloc, ".5"), -2);
      std.test.assert_eq(classify_parse(alloc, "+1"), -2);
      std.test.assert_eq(classify_parse(alloc, "1e"), -2);
      std.test.assert_eq(classify_parse(alloc, "-"), -2);
      std.test.assert_eq(classify_parse(alloc, "1 2"), -2);
      std.test.assert_eq(classify_parse(alloc, "[] x"), -2);
      std.test.assert_eq(classify_parse(alloc, "[1]"), -1);
      std.test.assert_eq(classify_parse(alloc, " {} "), -1);
    }

    test_function json_error_carries_offset() {
      var e = JsonError("bad", 7);
      std.test.assert_eq(e.code(), 60);
      std.test.assert_eq(e.offset(), 7);
    }

    test_function deep_nesting_is_rejected() {
      var alloc = make_heap_allocator();
      var text = String(alloc, "");
      for (var i: i64 = 0; i < 300; i = i + 1) {
        text.append_char(91);
      }
      for (var i: i64 = 0; i < 300; i = i + 1) {
        text.append_char(93);
      }
      try {
        var doc = parse_json(alloc, text);
        std.test.fail("300 nested arrays should be rejected");
      } catch (e: IError) {
        std.test.assert_eq(e.code(), 60);
      }
    }

    test_function deep_but_allowed_nesting() {
      var alloc = make_heap_allocator();
      var text = String(alloc, "");
      for (var i: i64 = 0; i < 200; i = i + 1) {
        text.append_char(91);
      }
      text.append_literal("7");
      for (var i: i64 = 0; i < 200; i = i + 1) {
        text.append_char(93);
      }
      var doc = parse_json(alloc, text);
      var out = doc.to_string(alloc);
      std.test.assert(out.equals(text), "200 nested arrays round trip");
    }

    test_function build_and_write_compact() {
      var alloc = make_heap_allocator();
      var obj = create_json_object(alloc);
      obj.set(String(alloc, "ok"), Json(true));
      obj.set(String(alloc, "n"), Json(42));
      obj.set(String(alloc, "x"), Json(0.1));
      obj.set(String(alloc, "none"), Json());
      var arr = create_json_array(alloc);
      arr.push(Json(1));
      arr.push(create_json_string(alloc, "two"));
      arr.push(Json(-3.5));
      arr.push(create_json_array(alloc));
      arr.push(create_json_object(alloc));
      obj.set(String(alloc, "list"), arr);
      obj.set(String(alloc, "s"), Json(String(alloc, "q\"\\\n")));
      // Overwrite keeps the member position and drops the old value
      obj.set(String(alloc, "n"), Json(43));
      var out = obj.to_string(alloc);
      std.test.assert(
        out.equals_literal("{\"ok\":true,\"n\":43,\"x\":0.1,\"none\":null,\"list\":[1,\"two\",-3.5,[],{}],\"s\":\"q\\\"\\\\\\n\"}"),
        "compact output wrong"
      );
      std.test.assert_eq(obj.len(), 6);
    }

    // A value type whose text field feeds the borrowed-string constructor.
    class Config {
      var model: String;
      init(model: String) {
        this.model = model;
      }
    }

    // Issue #94: Json(s) moves the String in; create_json_string(alloc, ref s)
    // stores a copy so the caller can keep using the original.
    test_function json_string_copies_a_borrowed_string() {
      var alloc = make_heap_allocator();
      var cfg = Config(String(alloc, "sun-1"));
      var req = create_json_object(alloc);
      req.set(String(alloc, "model"), create_json_string(alloc, cfg.model));
      req.set(String(alloc, "again"), create_json_string(alloc, cfg.model));
      // The original is intact after both calls
      std.test.assert(cfg.model.equals_literal("sun-1"), "original survives both copies");
      var out = req.to_string(alloc);
      std.test.assert(
        out.equals_literal("{\"model\":\"sun-1\",\"again\":\"sun-1\"}"),
        "document content wrong"
      );
      // The copies are independent of the original: changing it later does
      // not change the document.
      cfg.model.append("-pro");
      std.test.assert(
        req.get("model").as_string().equals_literal("sun-1"),
        "stored copy is independent"
      );
    }

    test_function write_pretty() {
      var alloc = make_heap_allocator();
      var doc = parse_json(alloc, "{\"a\":[1,{\"b\":null}],\"c\":{},\"d\":[]}");
      var out = doc.to_pretty_string(alloc, 2);
      var expected = String(alloc, "{\n  \"a\": [\n    1,\n    {\n      \"b\": null\n    }\n  ],\n  \"c\": {},\n  \"d\": []\n}");
      std.test.assert(out.equals(expected), "pretty output wrong");
      var scalar = parse_json(alloc, "5");
      std.test.assert(
        scalar.to_pretty_string(alloc, 4).equals_literal("5"),
        "a scalar pretty-prints as itself"
      );
    }

    // True when the value writes as exactly this text.
    function writes_as(alloc: ref HeapAllocator, j: Json, expected: static_ptr<u8>) bool {
      var out = j.to_string(alloc);
      return out.equals_literal(expected);
    }

    test_function number_formatting() {
      var alloc = make_heap_allocator();
      std.test.assert(writes_as(alloc, Json(0.1), "0.1"), "0.1");
      std.test.assert(writes_as(alloc, Json(5.0), "5.0"), "5.0");
      std.test.assert(writes_as(alloc, Json(1e21), "1e+21"), "1e+21");
      std.test.assert(writes_as(alloc, Json(-0.0), "-0.0"), "-0.0");
      std.test.assert(writes_as(alloc, Json(9223372036854775807), "9223372036854775807"), "i64 max");
      var min: i64 = -9223372036854775807 - 1;
      std.test.assert(writes_as(alloc, Json(min), "-9223372036854775808"), "i64 min");
      var inf: f64 = 1.0 / 0.0;
      std.test.assert(writes_as(alloc, Json(inf), "null"), "infinity writes null");
      std.test.assert(writes_as(alloc, Json(0.0 - inf), "null"), "-infinity writes null");
      std.test.assert(writes_as(alloc, Json(inf - inf), "null"), "NaN writes null");
      // Round trip keeps kinds
      var back = parse_json(alloc, Json(5.0).to_string(alloc));
      std.test.assert(back.is_float(), "5.0 stays a float");
      var big = parse_json(alloc, "12345678901234567890");
      std.test.assert(big.is_float(), "past i64 max becomes a float");
      std.test.assert(writes_as(alloc, big, "1.2345678901234567e+19"), "big float text");
    }

    test_function round_trip() {
      var alloc = make_heap_allocator();
      var text = String(alloc, "{\"name\":\"s\\u00fcn\",\"list\":[1,2.5,-3,true,false,null,\"\\\"\"],\"nested\":{\"a\":{\"b\":[[],{}]}},\"e\":\"\"}");
      var doc = parse_json(alloc, text);
      var once = doc.to_string(alloc);
      var again = parse_json(alloc, once).to_string(alloc);
      std.test.assert(once.equals(again), "second round trip is stable");
      // \u00fc is written as raw UTF-8, everything else is stable
      std.test.assert(
        once.equals_literal("{\"name\":\"sün\",\"list\":[1,2.5,-3,true,false,null,\"\\\"\"],\"nested\":{\"a\":{\"b\":[[],{}]}},\"e\":\"\"}"),
        "written text wrong"
      );
    }

    test_function control_characters_are_escaped_on_write() {
      var alloc = make_heap_allocator();
      var s = String(alloc, "a");
      s.append_char(1);
      s.append_char(31);
      s.append_char(8);
      s.append_char(12);
      var out = Json(s).to_string(alloc);
      std.test.assert(out.equals_literal("\"a\\u0001\\u001f\\b\\f\""), "escaped text wrong");
      var back = parse_json(alloc, out);
      std.test.assert_eq(back.as_string().length(), 5);
    }

    test_function iterate_object_members_and_array_items() {
      var alloc = make_heap_allocator();
      var doc = parse_json(alloc, "{\"a\": 1, \"b\": 2, \"c\": [10, 20, 30]}");
      var total: i64 = 0;
      for (var i: i64 = 0; i < doc.len(); i = i + 1) {
        var v: ref Json = doc.value_at(i);
        if (v.is_int()) {
          total = total + v.as_i64();
        } else {
          for (var k: i64 = 0; k < v.len(); k = k + 1) {
            total = total + v.at(k).as_i64();
          }
        }
      }
      var keys = String(alloc, "");
      for (var i: i64 = 0; i < doc.len(); i = i + 1) {
        keys.append(doc.key_at(i));
      }
      std.test.assert(keys.equals_literal("abc"), "keys iterate in order");
      std.test.assert_eq(total, 63);
    }

    // Owning payloads are dropped exactly once: building, overwriting and
    // dropping a large document must not double free or crash.
    test_function large_document_builds_and_drops() {
      var alloc = make_heap_allocator();
      var total: i64 = 0;
      for (var round: i64 = 0; round < 3; round = round + 1) {
        var root = create_json_object(alloc);
        for (var i: i64 = 0; i < 200; i = i + 1) {
          var item = create_json_object(alloc);
          item.set(String(alloc, "id"), Json(i));
          item.set(String(alloc, "name"), create_json_string(alloc, "item"));
          var nums = create_json_array(alloc);
          for (var k: i64 = 0; k < 5; k = k + 1) {
            nums.push(Json(_convert<f64>(k) * 0.5));
          }
          item.set(String(alloc, "nums"), nums);
          var key = String(alloc, "k");
          key.append_i64(i);
          root.set(key, item);
        }
        // Overwrite half the members (drops the old subtrees)
        for (var i: i64 = 0; i < 100; i = i + 1) {
          var key = String(alloc, "k");
          key.append_i64(i);
          root.set(key, Json(i));
        }
        var text = root.to_string(alloc);
        var back = parse_json(alloc, text);
        total = total + back.len();
      }
      std.test.assert_eq(total, 600);
    }

    // Sorts a Json into a small code by its payload kind.
    function describe(j: ref Json) i32 {
      return match j.value {
        JsonValue.Null => 1,
        JsonValue.Bool(b) => 2,
        JsonValue.Int(n) => 3,
        JsonValue.Float(x) => 4,
        JsonValue.String(s) => 5,
        JsonValue.Array(items) => 6,
        JsonValue.Object(members) => 7
      };
    }

    test_function json_value_enum_is_matchable() {
      var alloc = make_heap_allocator();
      var doc = parse_json(alloc, "[null, true, 1, 1.5, \"s\", [], {}]");
      var sum: i32 = 0;
      for (var i: i64 = 0; i < doc.len(); i = i + 1) {
        sum = sum * 10 + describe(doc.at(i));
      }
      std.test.assert_eq(sum, 1234567);
    }
  }  // module json_tests
}  // module std
