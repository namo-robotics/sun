// stdlib/test.sun - Unit testing: assertions, test results, and the runner.
//
// Test functions are declared with `test_function` and compiled only into
// the test binary. For that binary the compiler synthesizes a main that runs
// every test through run_one — each on its own thread by default — and
// reports with report/finish. Passing --test-sequential to the test binary
// runs the tests one after another in declaration order instead.
//
// A failed assertion returns AssertionError. Propagation runs the same drop
// glue as normal scope exit, so a fixture class's deinit (the teardown)
// still runs when a test fails.
//
// Usage:
//   test_function growsWhenFull() {
//       var v = Vec<i32>(make_heap_allocator());
//       v.push(1);
//       try std.test.assert_eq(v.size(), 1);
//   }

/** Assertions and helpers for running tests. */
public module std.test {
  /**
   * Raised by a failed assertion; carries the explanation text.
   */
  public class AssertionError implements IError {
    var message_: String;

    /**
     * Build the error from a literal explanation.
     */
    init(message: static_ptr<u8>) {
      this.message_ = String(message);
    }

    /**
     * Build the error from text composed at runtime; the text is copied.
     */
    init(message: const ref String) {
      var alloc: HeapAllocator = HeapAllocator();
      this.message_ = message.clone(alloc);
    }

    /**
     * Error code 10: assertion failure.
     */
    public const method code() i32 {
      return 10;
    }

    /**
     * A fresh copy of the explanation, owned by the caller.
     */
    public const method message() String {
      var alloc: HeapAllocator = HeapAllocator();
      return this.message_.clone(alloc);
    }
  }

  /**
   * Returns AssertionError when the condition is false.
   */
  public function assert(condition: bool) _Result<void, std.test.AssertionError> {
    if (condition) {
      return _Result.Ok;
    }
    return _Result.Err(AssertionError("assertion failed"));
  }

  /**
   * Same, with an explanation shown in the failure output.
   */
  public function assert(condition: bool, message: static_ptr<u8>) _Result<void, std.test.AssertionError> {
    if (condition) {
      return _Result.Ok;
    }
    return _Result.Err(AssertionError(message));
  }

  /** Returns AssertionError when primitive values differ, showing both in the failure text. */
  public function assert_eq<T: _Primitive>(expected: T, actual: T) _Result<void, std.test.AssertionError> {
    if (expected == actual) {
      return _Result.Ok;
    }
    return _Result.Err(AssertionError(`assertion failed: expected ${expected}, got ${actual}`));
  }
  /**
   * Compare two strings by content.
   */
  public function assert_eq(expected: const ref String, actual: const ref String) _Result<void, std.test.AssertionError> {
    if (expected.equals(actual)) {
      return _Result.Ok;
    }
    return _Result.Err(AssertionError(`assertion failed: expected ${expected}, got ${actual}`));
  }

  /** Returns AssertionError when primitive values are equal, showing the value in the failure text. */
  public function assert_ne<T: _Primitive>(a: T, b: T) _Result<void, std.test.AssertionError> {
    if (a == b) {
      return _Result.Err(AssertionError(`assertion failed: both values are ${a}`));
    }
    return _Result.Ok;
  }

  /**
   * Unconditionally fail with the given message.
   */
  public function fail(message: static_ptr<u8>) _Result<void, std.test.AssertionError> {
    return _Result.Err(AssertionError(message));
  }

  /** Returns the success value or reports the unexpected error as an assertion failure. */
  public function expect_ok<T, E>(result: _Result<T, E>) _Result<T, std.test.AssertionError> {
    return match result {
      _Result.Ok(value) => _Result.Ok(value),
      _Result.Err(error) => match error {
        (e: const ref IError) => _Result.Err(AssertionError(e.message()))
      }
    };
  }

  /** Reads a primitive success through a borrow, or reports its error as an assertion failure. */
  public function expect_value<T: _Primitive, E>(result: _Result<ref T, E>) _Result<T, std.test.AssertionError> {
    return match result {
      _Result.Ok(value) => _Result.Ok(value),
      _Result.Err(error) => match error {
        (e: const ref IError) => _Result.Err(AssertionError(e.message()))
      }
    };
  }

  /** Checks that an operation returning no value succeeded. */
  public function expect_success<E>(result: _Result<void, E>) _Result<void, std.test.AssertionError> {
    return match result {
      _Result.Ok => _Result.Ok,
      _Result.Err(error) => match error {
        (e: const ref IError) => _Result.Err(AssertionError(e.message()))
      }
    };
  }

  /** Returns a checked access value or reports its bounds error as a test failure. */
  public function expect_access<T>(result: AccessResult<T>) _Result<T, std.test.AssertionError> {
    return match result {
      AccessResult.Ok(value) => _Result.Ok(value),
      AccessResult.OutOfBounds(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Reads a checked scalar borrow before returning its value to the test. */
  public function expect_access_value<T: _Primitive>(result: AccessResult<ref T>) _Result<T, std.test.AssertionError> {
    return match result {
      AccessResult.Ok(value) => _Result.Ok(value),
      AccessResult.OutOfBounds(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Reports an unexpected bounds failure from a checked access update. */
  public function expect_access_success(result: AccessResult<void>) _Result<void, std.test.AssertionError> {
    return match result {
      AccessResult.Ok => _Result.Ok,
      AccessResult.OutOfBounds(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Returns a found value or reports its lookup error as a test failure. */
  public function expect_lookup<T>(result: LookupResult<T>) _Result<T, std.test.AssertionError> {
    return match result {
      LookupResult.Ok(value) => _Result.Ok(value),
      LookupResult.NotFound(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Reads a found scalar borrow or reports its lookup error as a test failure. */
  public function expect_lookup_value<T: _Primitive>(result: LookupResult<ref T>) _Result<T, std.test.AssertionError> {
    return match result {
      LookupResult.Ok(value) => _Result.Ok(value),
      LookupResult.NotFound(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Checks that a lookup-based update succeeded. */
  public function expect_lookup_success(result: LookupResult<void>) _Result<void, std.test.AssertionError> {
    return match result {
      LookupResult.Ok => _Result.Ok,
      LookupResult.NotFound(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Returns a removed value or reports an empty collection as a test failure. */
  public function expect_pop<T>(result: PopResult<T>) _Result<T, std.test.AssertionError> {
    return match result {
      PopResult.Ok(value) => _Result.Ok(value),
      PopResult.Empty(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Returns a JSON value or reports its error as a test failure. */
  public function expect_json<T>(result: JsonResult<T>) _Result<T, std.test.AssertionError> {
    return match result {
      JsonResult.Ok(value) => _Result.Ok(value),
      JsonResult.Error(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Checks that a JSON container update succeeded. */
  public function expect_json_success(result: JsonResult<void>) _Result<void, std.test.AssertionError> {
    return match result {
      JsonResult.Ok => _Result.Ok,
      JsonResult.Error(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Returns a converted value or reports a conversion test failure. */
  public function expect_conversion<T>(result: ConversionResult<T>) _Result<T, std.test.AssertionError> {
    return match result {
      ConversionResult.Ok(value) => _Result.Ok(value),
      ConversionResult.Error(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Checks that an arithmetic update succeeded. */
  public function expect_arithmetic_success(result: ArithmeticResult<void>) _Result<void, std.test.AssertionError> {
    return match result {
      ArithmeticResult.Ok => _Result.Ok,
      (error: const ref IError) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Returns an arithmetic value or reports its error as a test failure. */
  public function expect_arithmetic<T>(result: ArithmeticResult<T>) _Result<T, std.test.AssertionError> {
    return match result {
      ArithmeticResult.Ok(value) => _Result.Ok(value),
      (error: const ref IError) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Returns a system-call value or reports its error as a test failure. */
  public function expect_system<T>(result: SystemResult<T>) _Result<T, std.test.AssertionError> {
    return match result {
      SystemResult.Ok(value) => _Result.Ok(value),
      SystemResult.Error(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /** Checks that a system operation succeeded. */
  public function expect_system_success(result: SystemResult<void>) _Result<void, std.test.AssertionError> {
    return match result {
      SystemResult.Ok => _Result.Ok,
      SystemResult.Error(error) => _Result.Err(AssertionError(error.message()))
    };
  }

  /**
   * The outcome of one test, produced on the test's thread and moved back
   * to the main thread through join. The message is empty on a pass.
   */
  public class TestResult {
    public var name: static_ptr<u8>;
    public var passed: bool;
    public var message: String;

    /** Initializes the fixture fields used by this example or regression test. */
    init(name: static_ptr<u8>, passed: bool, message: String) {
      this.name = name;
      this.passed = passed;
      this.message = message;
    }
  }

  /** Runs a result-returning test and owns its failure text for reporting. */
  public function run_one<E>(name: static_ptr<u8>, fn: function () _Result<void, E>) TestResult {
    return match fn() {
      _Result.Ok => TestResult(name, true, String("")),
      _Result.Err(error) => match error {
        (e: const ref IError) => TestResult(name, false, e.message())
      }
    };
  }

  /**
   * Print one result line: "PASS name" or "FAIL name: message". Returns
   * whether the test passed. Only the main thread reports, so lines from
   * parallel runs never interleave.
   */
  public function report(result: const ref TestResult) bool {
    if (result.passed) {
      println(`PASS ${result.name}`);
      return true;
    }
    println(`FAIL ${result.name}: ${result.message}`);
    return false;
  }

  /**
   * Print the summary line and hand back the process exit code: 0 when
   * every test passed, 1 otherwise.
   */
  public function finish(total: i64, failed: i64) i32 {
    var passed: i64 = total - failed;
    println(`${passed} passed, ${failed} failed`);
    if (failed > 0) {
      return 1;
    }
    return 0;
  }

  /**
   * True when the test binary's arguments ask for sequential execution
   * ("--test-sequential" anywhere in argv).
   */
  public function wants_sequential(argc: i32, argv: raw_ptr<raw_ptr<i8>>) bool {
    var alloc: HeapAllocator = HeapAllocator();
    var env = std.env.Env(alloc);
    var cli = env.args(argc, argv);
    var i: i64 = 0;
    while (i < cli.size()) {
      if (unsafe { cli.get_unchecked(i); }.equals_literal("--test-sequential")) {
        return true;
      }
      i = i + 1;
    }
    return false;
  }

  /**
   * True when the dotted test name matches one filter pattern: the exact
   * name, a trailing-star prefix ("geometry.*"), or a module prefix
   * ("geometry" selects everything under it).
   */
  function matches(name: const ref String, pattern: const ref String) bool {
    if (name.equals(pattern)) {
      return true;
    }
    var plen: i64 = pattern.length();
    if (plen > 0 and unsafe { pattern.unsafe_at(plen - 1); } == b'*') {
      if (name.length() < plen - 1) {
        return false;
      }
      for (var i: i64 = 0; i < plen - 1; i = i + 1) {
        if (unsafe { name.unsafe_at(i); } != unsafe { pattern.unsafe_at(i); }) {
          return false;
        }
      }
      return true;
    }
    return name.length() > plen and name.starts_with(pattern) and unsafe { name.unsafe_at(plen); } == b'.';
  }

  /**
   * True when the test named `name` should run, given the test binary's
   * arguments. Every "--test-filter <pattern>" in argv contributes one
   * pattern; a test runs when it matches any of them, and no patterns at
   * all runs every test.
   */
  public function is_selected(name: static_ptr<u8>, argc: i32, argv: raw_ptr<raw_ptr<i8>>) bool {
    var alloc: HeapAllocator = HeapAllocator();
    var env = std.env.Env(alloc);
    var cli = env.args(argc, argv);
    var name_text = String(name);
    var saw_filter = false;
    var i: i64 = 0;
    while (i + 1 < cli.size()) {
      if (unsafe { cli.get_unchecked(i); }.equals_literal("--test-filter")) {
        saw_filter = true;
        if (matches(name_text, unsafe { cli.get_unchecked(i + 1); })) {
          return true;
        }
        i = i + 2;
        continue;
      }
      i = i + 1;
    }
    return saw_filter == false;
  }
}
