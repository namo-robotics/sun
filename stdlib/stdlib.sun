// stdlib.sun - Standard library entrypoint for building stdlib.moon
//
// This file serves as the manifest for the standard library bundle.
// All stdlib modules are listed here.

manifest {
  library_id: "sun/stdlib"
  source_files: [
    "std/allocator.sun",
    "std/unique.sun",
    "std/sys.sun",
    "std/option.sun",
    "std/memory.sun",
    "std/math.sun",
    "std/byte_order/byte_order.sun",
    "std/bytes.sun",
    "std/iterator.sun",
    "std/slice.sun",
    "std/contiguous_buffer.sun",
    "std/vec.sun",
    "std/matrix.sun",
    "std/simd.sun",
    "std/linalg.sun",
    "std/string.sun",
    "std/errors.sun",
    "std/result.sun",
    "std/print.sun",
    "std/map.sun",
    "std/linked_list.sun",
    "std/queue.sun",
    "std/thread/thread.sun",
    "std/signal/signal.sun",
    "std/test/test.sun",
    "std/shared.sun",
    "std/io/io.sun",
    "std/io/event_loop.sun",
    "std/socket_config.sun",
    "std/thread/cpu.sun",
    "std/io/metadata.sun",
    "std/io/wakeup.sun",
    "std/env/env.sun",
    "std/time/time.sun",
    "std/process/process.sun",
    "std/process/process_inspection.sun",
    "std/terminal/terminal.sun",
    "std/networking.sun",
    "std/http.sun",
    "std/proto_wire.sun",
    "std/json.sun",
    "std/xml/common.sun",
    "std/xml/tree.sun",
    "std/xml/reader.sun",
    "std/xml/writer.sun",
    "std/bigint.sun"
  ],
  test_files: [
    "std/fixtures_tests.sun",
    "std/bigint_tests.sun",
    "std/byte_order/byte_order_tests.sun",
    "std/bytes_tests.sun",
    "std/contiguous_buffer_tests.sun",
    "std/convert_tests.sun",
    "std/env/env_tests.sun",
    "std/http_tests.sun",
    "std/interpolation_tests.sun",
    "std/io/io_tests.sun",
    "std/io/stream_tests.sun",
    "std/io/line_reader_tests.sun",
    "std/io/event_loop_tests.sun",
    "std/server_os_tests.sun",
    "std/json_tests.sun",
    "std/xml/xml_tests.sun",
    "std/xml/xml_fixture_tests.sun",
    "std/linked_list_tests.sun",
    "std/map_tests.sun",
    "std/math_tests.sun",
    "std/matrix_tests.sun",
    "std/simd_tests.sun",
    "std/linalg_tests.sun",
    "std/memory_tests.sun",
    "std/thread/mutex_tests.sun",
    "std/networking_tests.sun",
    "std/option_tests.sun",
    "std/process/process_tests.sun",
    "std/process/process_inspection_tests.sun",
    "std/queue_tests.sun",
    "std/shared_tests.sun",
    "std/string_tests.sun",
    "std/terminal/terminal_tests.sun",
    "std/test/test_tests.sun",
    "std/thread/thread_tests.sun",
    "std/signal/signal_tests.sun",
    "std/thread/atomic_bool_tests.sun",
    "std/time/time_tests.sun",
    "std/udp_tests.sun",
    "std/vec_tests.sun"
  ],
  target: {
    linux: {
      source_files: [
        "std/target_linux.sun",
        "std/io/target_linux.sun",
        "std/time/target_linux.sun",
        "std/process/target_linux.sun",
        "std/terminal/target_linux.sun",
        "std/signal/target_linux.sun",
        "std/io/event_loop_linux.sun",
        "std/process/process_linux.sun"
      ],
      test_files: [
        "std/process/process_linux_tests.sun"
      ]
    },
    macos: {
      source_files: [
        "$SUN_DARWIN_PROCESS_BINDINGS",
        "std/target_darwin.sun",
        "std/io/target_darwin.sun",
        "std/time/target_darwin.sun",
        "std/process/target_darwin.sun",
        "std/terminal/target_darwin.sun",
        "std/signal/target_darwin.sun",
        "std/io/event_loop_darwin.sun",
        "std/process/process_darwin.sun"
      ],
      test_files: [
        "std/process/process_darwin_tests.sun"
      ]
    }
  }
}
