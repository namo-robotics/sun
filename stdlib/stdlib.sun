// stdlib.sun - Standard library entrypoint for building stdlib.moon
//
// This file serves as the manifest for the standard library bundle.
// All stdlib modules are listed here.

manifest {
    source_files: [
        "allocator.sun",
        "unique.sun",
        "sys.sun",
        "option.sun",
        "math.sun",
        "iterator.sun",
        "slice.sun",
        "contiguous_buffer.sun",
        "vec.sun",
        "matrix.sun",
        "string.sun",
        "errors.sun",
        "print.sun",
        "map.sun",
        "linked_list.sun",
        "queue.sun",
        "thread.sun",
        "shared.sun",
        "io.sun",
        "env.sun",
        "time.sun",
        "process.sun",
        "networking.sun",
        "http.sun",
        "proto_wire.sun",
        "json.sun",
        "bigint.sun"
    ],
    target: {
        linux: {
            source_files: [ "target_linux.sun" ]
        },
        macos: {
            source_files: [ "target_darwin.sun" ]
        }
    }
}
