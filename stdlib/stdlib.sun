// stdlib.sun - Standard library entrypoint for building stdlib.moon
//
// This file serves as the manifest for the standard library bundle.
// All stdlib modules are listed here.

manifest {
    source_files: [
        "allocator.sun",
        "unique.sun",
        "sys.sun",
        "option.sun",
        "math.sun",
        "byte_order.sun",
        "iterator.sun",
        "slice.sun",
        "contiguous_buffer.sun",
        "vec.sun",
        "matrix.sun",
        "string.sun",
        "errors.sun",
        "print.sun",
        "map.sun",
        "linked_list.sun",
        "queue.sun",
        "thread.sun",
        "test.sun",
        "shared.sun",
        "io.sun",
        "env.sun",
        "time.sun",
        "process.sun",
        "networking.sun",
        "http.sun",
        "proto_wire.sun",
        "json.sun",
        "bigint.sun"
    ],
    test_files: [
        "fixtures_tests.sun",
        "bigint_tests.sun",
        "byte_order_tests.sun",
        "contiguous_buffer_tests.sun",
        "convert_tests.sun",
        "env_tests.sun",
        "http_tests.sun",
        "interpolation_tests.sun",
        "io_tests.sun",
        "json_tests.sun",
        "linked_list_tests.sun",
        "map_tests.sun",
        "math_tests.sun",
        "matrix_tests.sun",
        "mutex_tests.sun",
        "networking_tests.sun",
        "option_tests.sun",
        "process_tests.sun",
        "queue_tests.sun",
        "shared_tests.sun",
        "string_tests.sun",
        "thread_tests.sun",
        "time_tests.sun",
        "udp_tests.sun",
        "vec_tests.sun"
    ],
    target: {
        linux: {
            source_files: [ "target_linux.sun" ]
        },
        macos: {
            source_files: [ "target_darwin.sun" ]
        }
    }
}
