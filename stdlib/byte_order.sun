// stdlib/byte_order.sun - Reading and writing integers in a chosen byte order
//
// A binary wire format fixes the order the bytes of a number appear in, and
// that order is often not the one the machine uses. These helpers convert
// between the two. `swap_bytes_*` reverses the bytes unconditionally; the
// `to_*`/`from_*` pairs name the wire's order and do nothing when it already
// matches the machine's.
//
// Every processor Sun targets is little-endian, so the big-endian
// conversions reverse and the little-endian ones are free. Should a
// big-endian target ever be added, these twelve functions are the only place
// that has to learn about it.

/** Read and write integers in a chosen byte order. */
public module std.byte_order {
  // ========================================================================
  // Unconditional byte reversal
  // ========================================================================

  /**
   * Return the value with its two bytes in the opposite order.
   */
  public function swap_bytes_u16(value: u16) u16 {
    return _bswap_u16(value);
  }

  /**
   * Return the value with its four bytes in the opposite order.
   */
  public function swap_bytes_u32(value: u32) u32 {
    return _bswap_u32(value);
  }

  /**
   * Return the value with its eight bytes in the opposite order.
   */
  public function swap_bytes_u64(value: u64) u64 {
    return _bswap_u64(value);
  }

  // ========================================================================
  // Big-endian wire order, which network protocols call network byte order
  // ========================================================================

  /**
   * Convert a number the machine holds into its big-endian form.
   */
  public function to_big_endian_u16(value: u16) u16 {
    return _bswap_u16(value);
  }

  /**
   * Convert a number the machine holds into its big-endian form.
   */
  public function to_big_endian_u32(value: u32) u32 {
    return _bswap_u32(value);
  }

  /**
   * Convert a number the machine holds into its big-endian form.
   */
  public function to_big_endian_u64(value: u64) u64 {
    return _bswap_u64(value);
  }

  /**
   * Read a big-endian number back into the machine's own order.
   */
  public function from_big_endian_u16(value: u16) u16 {
    return _bswap_u16(value);
  }

  /**
   * Read a big-endian number back into the machine's own order.
   */
  public function from_big_endian_u32(value: u32) u32 {
    return _bswap_u32(value);
  }

  /**
   * Read a big-endian number back into the machine's own order.
   */
  public function from_big_endian_u64(value: u64) u64 {
    return _bswap_u64(value);
  }

  // ========================================================================
  // Little-endian wire order, which the machine already uses
  // ========================================================================

  /**
   * Convert a number the machine holds into its little-endian form.
   */
  public function to_little_endian_u16(value: u16) u16 {
    return value;
  }

  /**
   * Convert a number the machine holds into its little-endian form.
   */
  public function to_little_endian_u32(value: u32) u32 {
    return value;
  }

  /**
   * Convert a number the machine holds into its little-endian form.
   */
  public function to_little_endian_u64(value: u64) u64 {
    return value;
  }

  /**
   * Read a little-endian number back into the machine's own order.
   */
  public function from_little_endian_u16(value: u16) u16 {
    return value;
  }

  /**
   * Read a little-endian number back into the machine's own order.
   */
  public function from_little_endian_u32(value: u32) u32 {
    return value;
  }

  /**
   * Read a little-endian number back into the machine's own order.
   */
  public function from_little_endian_u64(value: u64) u64 {
    return value;
  }

  /** Decodes an unaligned native-endian u16, rejecting ranges outside the slice. */
  public function read_native_u16(bytes: const ref ByteSlice, offset: i64) AccessResult<u16> {
    if (not valid_byte_range(bytes.size(), offset, _sizeof<u16>())) {
      return AccessResult.OutOfBounds(IndexOutOfBoundsError(offset));
    }
    var value: u16 = 0;
    unsafe { _memcpy(_ptr_as_raw<u8>(_address_of<u16>(value)), _ptr_offset(bytes.raw_data(), offset), _sizeof<u16>()); };
    return AccessResult.Ok(value);
  }

  /** Decodes an unaligned native-endian u32, rejecting ranges outside the slice. */
  public function read_native_u32(bytes: const ref ByteSlice, offset: i64) AccessResult<u32> {
    if (not valid_byte_range(bytes.size(), offset, _sizeof<u32>())) {
      return AccessResult.OutOfBounds(IndexOutOfBoundsError(offset));
    }
    var value: u32 = 0;
    unsafe { _memcpy(_ptr_as_raw<u8>(_address_of<u32>(value)), _ptr_offset(bytes.raw_data(), offset), _sizeof<u32>()); };
    return AccessResult.Ok(value);
  }

  /** Decodes an unaligned native-endian u64, rejecting ranges outside the slice. */
  public function read_native_u64(bytes: const ref ByteSlice, offset: i64) AccessResult<u64> {
    if (not valid_byte_range(bytes.size(), offset, _sizeof<u64>())) {
      return AccessResult.OutOfBounds(IndexOutOfBoundsError(offset));
    }
    var value: u64 = 0;
    unsafe { _memcpy(_ptr_as_raw<u8>(_address_of<u64>(value)), _ptr_offset(bytes.raw_data(), offset), _sizeof<u64>()); };
    return AccessResult.Ok(value);
  }

  /** Decodes an unaligned native-endian i16, rejecting ranges outside the slice. */
  public function read_native_i16(bytes: const ref ByteSlice, offset: i64) AccessResult<i16> {
    if (not valid_byte_range(bytes.size(), offset, _sizeof<i16>())) {
      return AccessResult.OutOfBounds(IndexOutOfBoundsError(offset));
    }
    var value: i16 = 0;
    unsafe { _memcpy(_ptr_as_raw<u8>(_address_of<i16>(value)), _ptr_offset(bytes.raw_data(), offset), _sizeof<i16>()); };
    return AccessResult.Ok(value);
  }

  /** Decodes an unaligned native-endian i32, rejecting ranges outside the slice. */
  public function read_native_i32(bytes: const ref ByteSlice, offset: i64) AccessResult<i32> {
    if (not valid_byte_range(bytes.size(), offset, _sizeof<i32>())) {
      return AccessResult.OutOfBounds(IndexOutOfBoundsError(offset));
    }
    var value: i32 = 0;
    unsafe { _memcpy(_ptr_as_raw<u8>(_address_of<i32>(value)), _ptr_offset(bytes.raw_data(), offset), _sizeof<i32>()); };
    return AccessResult.Ok(value);
  }

  /** Decodes an unaligned native-endian i64, rejecting ranges outside the slice. */
  public function read_native_i64(bytes: const ref ByteSlice, offset: i64) AccessResult<i64> {
    if (not valid_byte_range(bytes.size(), offset, _sizeof<i64>())) {
      return AccessResult.OutOfBounds(IndexOutOfBoundsError(offset));
    }
    var value: i64 = 0;
    unsafe { _memcpy(_ptr_as_raw<u8>(_address_of<i64>(value)), _ptr_offset(bytes.raw_data(), offset), _sizeof<i64>()); };
    return AccessResult.Ok(value);
  }
}
