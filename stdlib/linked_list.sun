// stdlib/linked_list.sun - Doubly-linked list
//
// LinkedList<T> is a generic doubly-linked list backed by heap-allocated nodes.
// Supports O(1) push/pop at both ends, O(n) indexed access.
// Uses HeapAllocator for memory management.
//
// Usage:
//   import "stdlib/linked_list.sun";
//   using std;
//
//   var allocator = make_heap_allocator();
//   var list = LinkedList<i32>(allocator);
//   list.push_back(10);
//   list.push_back(20);
//   list.push_front(5);
//   var val = list.first();     // Option.Some borrowing 5
//   var last = list.last();     // Option.Some borrowing 20
//   var popped = list.pop_front(); // 5
//   var len = list.size();      // 2

// ============================================================================
// LinkedListNode<T> - Doubly-linked node
// ============================================================================

public module std {
  public class LinkedListNode<T> {
    var value: T;
    var next: raw_ptr<LinkedListNode<T>> = null;
    var prev: raw_ptr<LinkedListNode<T>> = null;

    // Build a detached node that owns the given value.
    init(v: T) {
      this.value = v;
    }

    // Borrow the stored value; the node keeps ownership
    public const method get_value() ref T {
      return unsafe { _to_ref<T>(_address_of<T>(this.value)); };
    }

    // Move the stored value out. The move zeroes the slot, so the node's own
    // drop is a no-op. Only for callers that are freeing or reusing the node.
    public method take_value() T {
      var value: T = this.value;
      return value;
    }

    // Overwrite the stored value without dropping the old one. Only safe on a
    // slot that was already moved out of.
    public method set_value(v: T) void {
      this.value = v;
    }

    // Replace the stored value, dropping the old one first (no-op for
    // non-owning types)
    public method replace_value(v: T) void {
      unsafe { _deinit<T>(_address_of<T>(this.value)); };
      this.value = v;
    }

    // Drop the stored value in place (used when freeing nodes that still own
    // their payload)
    method drop_value() void {
      unsafe { _deinit<T>(_address_of<T>(this.value)); };
    }

    // The node after this one, or null at the tail.
    public const method get_next() raw_ptr<LinkedListNode<T>> {
      return this.next;
    }

    // The node before this one, or null at the head.
    public const method get_prev() raw_ptr<LinkedListNode<T>> {
      return this.prev;
    }

    // Point this node at its successor. Does not touch the other node's links.
    public method set_next(n: raw_ptr<LinkedListNode<T>>) void {
      this.next = n;
    }

    // Point this node at its predecessor. Does not touch the other node's links.
    public method set_prev(p: raw_ptr<LinkedListNode<T>>) void {
      this.prev = p;
    }
  }

  // ============================================================================
  // LinkedList<T> - Doubly-Linked List
  // ============================================================================

  public class LinkedList<T> implements IIterable<ref T, LinkedList<T>> {
    var head: raw_ptr<LinkedListNode<T>> = null;
    var tail: raw_ptr<LinkedListNode<T>> = null;
    var alloc: HeapAllocator;
    var size_: i64 = 0;

    // Constructor with allocator
    init(allocator: const ref HeapAllocator) {
      this.alloc = allocator.copy();
    }

    // Destructor - free all nodes
    deinit() {
      this.clear();
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    // Append element to the back
    public method push_back(value: T) void {
      var node: raw_ptr<LinkedListNode<T>> = this.alloc.create<LinkedListNode<T>>(value);
      if (this.tail != null) {
        unsafe { this.tail.set_next(node); };
        unsafe { node.set_prev(this.tail); };
        this.tail = node;
      } else {
        this.head = node;
        this.tail = node;
      }
      this.size_ = this.size_ + 1;
    }

    // Prepend element to the front
    public method push_front(value: T) void {
      var node: raw_ptr<LinkedListNode<T>> = this.alloc.create<LinkedListNode<T>>(value);
      if (this.head != null) {
        unsafe { this.head.set_prev(node); };
        unsafe { node.set_next(this.head); };
        this.head = node;
      } else {
        this.head = node;
        this.tail = node;
      }
      this.size_ = this.size_ + 1;
    }

    // Remove and return the last element
    public method pop_back() T throws IError {
      if (this.tail == null) {
        throw EmptyError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.tail;
      var value: T = unsafe { node.take_value(); };
      this.tail = unsafe { node.get_prev(); };
      if (this.tail != null) {
        unsafe { this.tail.set_next(null); };
      } else {
        this.head = null;
      }
      unsafe { _free(node); };
      this.size_ = this.size_ - 1;
      return value;
    }

    // Remove and return the first element
    public method pop_front() T throws IError {
      if (this.head == null) {
        throw EmptyError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.head;
      var value: T = unsafe { node.take_value(); };
      this.head = unsafe { node.get_next(); };
      if (this.head != null) {
        unsafe { this.head.set_prev(null); };
      } else {
        this.tail = null;
      }
      unsafe { _free(node); };
      this.size_ = this.size_ - 1;
      return value;
    }

    // Borrow the element at index (traverses from nearest end). The list keeps
    // ownership, so this hands back a reference; use remove()/pop_*() to move
    // an element out.
    public const method get(index: i64) ref T throws IError {
      if (index < 0) {
        throw NotFoundError();
      }
      if (index >= this.size_) {
        throw NotFoundError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.find_node_at(index);
      return unsafe { node.get_value(); };
    }

    // Set element at index
    public method set(index: i64, value: T) void throws IError {
      if (index < 0) {
        throw NotFoundError();
      }
      if (index >= this.size_) {
        throw NotFoundError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.find_node_at(index);
      unsafe { node.replace_value(value); };
    }

    // Remove element at index and return its value
    public method remove(index: i64) T throws IError {
      if (index < 0) {
        throw NotFoundError();
      }
      if (index >= this.size_) {
        throw NotFoundError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.find_node_at(index);
      var value: T = unsafe { node.take_value(); };
      this.unlink_node(node);
      unsafe { _free(node); };
      this.size_ = this.size_ - 1;
      return value;
    }

    // Borrow the first element; None when empty
    public const method first() Option<ref T> {
      if (this.head == null) {
        return Option.None;
      }
      return Option.Some(unsafe { this.head.get_value(); });
    }

    // Borrow the last element; None when empty
    public const method last() Option<ref T> {
      if (this.tail == null) {
        return Option.None;
      }
      return Option.Some(unsafe { this.tail.get_value(); });
    }

    // Get current size
    public const method size() i64 {
      return this.size_;
    }

    // Check if empty
    public const method is_empty() bool {
      return this.size_ == 0;
    }

    // Remove all elements and free nodes. Node payloads still owned by the
    // list are dropped.
    public method clear() void {
      var curr: raw_ptr<LinkedListNode<T>> = this.head;
      while (curr != null) {
        var next: raw_ptr<LinkedListNode<T>> = unsafe { curr.get_next(); };
        unsafe { curr.drop_value(); };
        unsafe { _free(curr); };
        curr = next;
      }
      this.head = null;
      this.tail = null;
      this.size_ = 0;
    }

    // ========================================================================
    // Internal Methods
    // ========================================================================

    // Get node at index, traversing from nearest end
    const method find_node_at(index: i64) raw_ptr<LinkedListNode<T>> {
      if (index < this.size_ / 2) {
        // Traverse from head
        var node: raw_ptr<LinkedListNode<T>> = this.head;
        for (var i: i64 = 0; i < index; i = i + 1) {
          node = unsafe { node.get_next(); };
        }
        return node;
      }
      // Traverse from tail
      var node: raw_ptr<LinkedListNode<T>> = this.tail;
      for (var i: i64 = this.size_ - 1; i > index; i = i - 1) {
        node = unsafe { node.get_prev(); };
      }
      return node;
    }

    // Unlink a node from the list (does not free or adjust size)
    method unlink_node(node: raw_ptr<LinkedListNode<T>>) void {
      var prev: raw_ptr<LinkedListNode<T>> = unsafe { node.get_prev(); };
      var next: raw_ptr<LinkedListNode<T>> = unsafe { node.get_next(); };
      if (prev != null) {
        unsafe { prev.set_next(next); };
      } else {
        this.head = next;
      }
      if (next != null) {
        unsafe { next.set_prev(prev); };
      } else {
        this.tail = prev;
      }
    }

    // ========================================================================
    // Iteration Support
    // ========================================================================

    // Return iterator over elements
    public const method iter() LinkedListIterator<T> {
      return LinkedListIterator<T>();
    }
  }

  // ============================================================================
  // LinkedListIterator<T> - Iterator over LinkedList elements
  // ============================================================================

  /** Iterates over borrowed list elements from the first node. */
  public class LinkedListIterator<T> implements IIterator<ref T, LinkedList<T>> {
    var current: raw_ptr<LinkedListNode<T>> = null;
    var started: bool = false;

    // Next element, or None once the list is exhausted. Elements are
    // borrowed: the list still owns them.
    public method next(list: ref LinkedList<T>) Option<ref T> {
      if (this.started == false) {
        this.current = list.head;
        this.started = true;
      } else if (this.current != null) {
        this.current = unsafe { this.current.get_next(); };
      }
      if (this.current == null) {
        return Option.None;
      }
      return Option.Some(unsafe { this.current.get_value(); });
    }
  }

  // ============================================================================
  // Precompiled Specializations
  // ============================================================================

  public declare LinkedListNode_i32 = LinkedListNode<i32>;
  public declare LinkedListNode_i64 = LinkedListNode<i64>;

  public declare LinkedList_i32 = LinkedList<i32>;
  public declare LinkedList_i64 = LinkedList<i64>;

  public declare LinkedListIterator_i32 = LinkedListIterator<i32>;
  public declare LinkedListIterator_i64 = LinkedListIterator<i64>;
}  // module std
