// stdlib/linked_list.sun - Doubly-linked list
//
// LinkedList<T> is a generic doubly-linked list backed by heap-allocated nodes.
// Supports O(1) push/pop at both ends, O(n) indexed access.
// Uses HeapAllocator for memory management.
//
// Usage:
//   import "stdlib/linked_list.sun";
//   using sun;
//
//   var allocator = make_heap_allocator();
//   var list = LinkedList<i32>(allocator);
//   list.push_back(10);
//   list.push_back(20);
//   list.push_front(5);
//   var val = list.first();     // Option.Some borrowing 5
//   var last = list.last();     // Option.Some borrowing 20
//   var popped = list.pop_front(); // 5
//   var len = list.size();      // 2

// ============================================================================
// LinkedListNode<T> - Doubly-linked node
// ============================================================================

public module sun {
  public class LinkedListNode<T> {
    var value: T;
    var next: raw_ptr<LinkedListNode<T>>;
    var prev: raw_ptr<LinkedListNode<T>>;

    public function init(v: T) {
      this.value = v;
      this.next = null;
      this.prev = null;
    }

    // Borrow the stored value; the node keeps ownership
    public function getValue() ref T {
      return unsafe { _to_ref<T>(_address_of<T>(this.value)); };
    }

    // Move the stored value out. The move zeroes the slot, so the node's own
    // drop is a no-op. Only for callers that are freeing or reusing the node.
    public function takeValue() T {
      var value: T = this.value;
      return value;
    }

    public function setValue(v: T) void {
      this.value = v;
    }

    // Replace the stored value, dropping the old one first (no-op for
    // non-owning types)
    public function replaceValue(v: T) void {
      unsafe { _deinit<T>(_address_of<T>(this.value)); };
      this.value = v;
    }

    // Drop the stored value in place (used when freeing nodes that still own
    // their payload)
    function dropValue() void {
      unsafe { _deinit<T>(_address_of<T>(this.value)); };
    }

    public function getNext() raw_ptr<LinkedListNode<T>> {
      return this.next;
    }

    public function getPrev() raw_ptr<LinkedListNode<T>> {
      return this.prev;
    }

    public function setNext(n: raw_ptr<LinkedListNode<T>>) void {
      this.next = n;
    }

    public function setPrev(p: raw_ptr<LinkedListNode<T>>) void {
      this.prev = p;
    }
  }

  // ============================================================================
  // LinkedList<T> - Doubly-Linked List
  // ============================================================================

  public class LinkedList<T> implements IIterable<ref T, LinkedList<T>> {
    var head: raw_ptr<LinkedListNode<T>>;
    var tail: raw_ptr<LinkedListNode<T>>;
    var alloc: HeapAllocator;
    var size_: i64;

    // Constructor with allocator
    public function init(allocator: ref HeapAllocator) {
      this.alloc = allocator.copy();
      this.head = null;
      this.tail = null;
      this.size_ = 0;
    }

    // Destructor - free all nodes
    function deinit() void {
      this.clear();
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    // Append element to the back
    public function push_back(value: T) void {
      var node: raw_ptr<LinkedListNode<T>> = this.alloc.create<LinkedListNode<T>>(value);
      if (this.tail != null) {
        unsafe { this.tail.setNext(node); };
        unsafe { node.setPrev(this.tail); };
        this.tail = node;
      } else {
        this.head = node;
        this.tail = node;
      }
      this.size_ = this.size_ + 1;
    }

    // Prepend element to the front
    public function push_front(value: T) void {
      var node: raw_ptr<LinkedListNode<T>> = this.alloc.create<LinkedListNode<T>>(value);
      if (this.head != null) {
        unsafe { this.head.setPrev(node); };
        unsafe { node.setNext(this.head); };
        this.head = node;
      } else {
        this.head = node;
        this.tail = node;
      }
      this.size_ = this.size_ + 1;
    }

    // Remove and return the last element
    public function pop_back() T, IError {
      if (this.tail == null) {
        throw EmptyError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.tail;
      var value: T = unsafe { node.takeValue(); };
      this.tail = unsafe { node.getPrev(); };
      if (this.tail != null) {
        unsafe { this.tail.setNext(null); };
      } else {
        this.head = null;
      }
      unsafe { _free(node); };
      this.size_ = this.size_ - 1;
      return value;
    }

    // Remove and return the first element
    public function pop_front() T, IError {
      if (this.head == null) {
        throw EmptyError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.head;
      var value: T = unsafe { node.takeValue(); };
      this.head = unsafe { node.getNext(); };
      if (this.head != null) {
        unsafe { this.head.setPrev(null); };
      } else {
        this.tail = null;
      }
      unsafe { _free(node); };
      this.size_ = this.size_ - 1;
      return value;
    }

    // Borrow the element at index (traverses from nearest end). The list keeps
    // ownership, so this hands back a reference; use remove()/pop_*() to move
    // an element out.
    public function get(index: i64) ref T, IError {
      if (index < 0) {
        throw NotFoundError();
      }
      if (index >= this.size_) {
        throw NotFoundError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.nodeAt(index);
      return unsafe { node.getValue(); };
    }

    // Set element at index
    public function set(index: i64, value: T) void, IError {
      if (index < 0) {
        throw NotFoundError();
      }
      if (index >= this.size_) {
        throw NotFoundError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.nodeAt(index);
      unsafe { node.replaceValue(value); };
    }

    // Remove element at index and return its value
    public function remove(index: i64) T, IError {
      if (index < 0) {
        throw NotFoundError();
      }
      if (index >= this.size_) {
        throw NotFoundError();
      }
      var node: raw_ptr<LinkedListNode<T>> = this.nodeAt(index);
      var value: T = unsafe { node.takeValue(); };
      this.unlinkNode(node);
      unsafe { _free(node); };
      this.size_ = this.size_ - 1;
      return value;
    }

    // Borrow the first element; None when empty
    public function first() Option<ref T> {
      if (this.head == null) {
        return Option.None;
      }
      return Option.Some(unsafe { this.head.getValue(); });
    }

    // Borrow the last element; None when empty
    public function last() Option<ref T> {
      if (this.tail == null) {
        return Option.None;
      }
      return Option.Some(unsafe { this.tail.getValue(); });
    }

    // Get current size
    public function size() i64 {
      return this.size_;
    }

    // Check if empty
    public function isEmpty() bool {
      return this.size_ == 0;
    }

    // Remove all elements and free nodes. Node payloads still owned by the
    // list are dropped.
    public function clear() void {
      var curr: raw_ptr<LinkedListNode<T>> = this.head;
      while (curr != null) {
        var next: raw_ptr<LinkedListNode<T>> = unsafe { curr.getNext(); };
        unsafe { curr.dropValue(); };
        unsafe { _free(curr); };
        curr = next;
      }
      this.head = null;
      this.tail = null;
      this.size_ = 0;
    }

    // ========================================================================
    // Internal Methods
    // ========================================================================

    // Get node at index, traversing from nearest end
    function nodeAt(index: i64) raw_ptr<LinkedListNode<T>> {
      if (index < this.size_ / 2) {
        // Traverse from head
        var node: raw_ptr<LinkedListNode<T>> = this.head;
        for (var i: i64 = 0; i < index; i = i + 1) {
          node = unsafe { node.getNext(); };
        }
        return node;
      }
      // Traverse from tail
      var node: raw_ptr<LinkedListNode<T>> = this.tail;
      for (var i: i64 = this.size_ - 1; i > index; i = i - 1) {
        node = unsafe { node.getPrev(); };
      }
      return node;
    }

    // Unlink a node from the list (does not free or adjust size)
    function unlinkNode(node: raw_ptr<LinkedListNode<T>>) void {
      var prev: raw_ptr<LinkedListNode<T>> = unsafe { node.getPrev(); };
      var next: raw_ptr<LinkedListNode<T>> = unsafe { node.getNext(); };
      if (prev != null) {
        unsafe { prev.setNext(next); };
      } else {
        this.head = next;
      }
      if (next != null) {
        unsafe { next.setPrev(prev); };
      } else {
        this.tail = prev;
      }
    }

    // ========================================================================
    // Iteration Support
    // ========================================================================

    // Return iterator over elements
    public function iter() LinkedListIterator<T> {
      return LinkedListIterator<T>();
    }
  }

  // ============================================================================
  // LinkedListIterator<T> - Iterator over LinkedList elements
  // ============================================================================

  public class LinkedListIterator<T> implements IIterator<ref T, LinkedList<T>> {
    var current: raw_ptr<LinkedListNode<T>>;
    var started: bool;

    public function init() {
      this.current = null;
      this.started = false;
    }

    // Next element, or None once the list is exhausted. Elements are
    // borrowed: the list still owns them.
    public function next(list: ref LinkedList<T>) Option<ref T> {
      if (this.started == false) {
        this.current = list.head;
        this.started = true;
      } else if (this.current != null) {
        this.current = unsafe { this.current.getNext(); };
      }
      if (this.current == null) {
        return Option.None;
      }
      return Option.Some(unsafe { this.current.getValue(); });
    }
  }

  // ============================================================================
  // Precompiled Specializations
  // ============================================================================

  public declare LinkedListNode_i32 = LinkedListNode<i32>;
  public declare LinkedListNode_i64 = LinkedListNode<i64>;

  public declare LinkedList_i32 = LinkedList<i32>;
  public declare LinkedList_i64 = LinkedList<i64>;

  public declare LinkedListIterator_i32 = LinkedListIterator<i32>;
  public declare LinkedListIterator_i64 = LinkedListIterator<i64>;
}  // module sun
