// stdlib/allocator.sun - Memory allocator interface and implementations
// Following Zig-style allocator pattern: allocator.create<Type>(args...)
//
// Use raw_ptr<T> for manual memory management.
// Use Unique<T> for automatic cleanup via deinit().

// Memory allocation intrinsics:
// _malloc(size: i64) raw_ptr<u8> - allocate size bytes
// _free(ptr: raw_ptr<u8>) void - free previously allocated memory
// _sizeof<T>() i64 - size of type T in bytes
// _init<T>(ptr, args...) - call T's constructor at ptr

public module sun {
  // Interface for memory allocators
  // All allocators must implement this interface
  public interface IAllocator {
    // Allocate an array of count elements of type T
    // Returns raw_ptr<T> - caller is responsible for freeing
    public function alloc<T>(count: i64) raw_ptr<T>;

    // Low-level raw allocation - returns raw_ptr<u8>
    public function alloc_raw(size: i64) raw_ptr<u8>;

    // Free previously allocated memory (typed version)
    public function dealloc<T>(p: raw_ptr<T>, count: i64) void;

    // Free previously allocated memory (raw bytes)
    public function dealloc_raw(p: raw_ptr<u8>, size: i64) void;

    // Create a single instance of T, calling its constructor
    // Returns raw_ptr<T> - caller manages lifetime
    public function create<T>(args...: _init_args<T>) raw_ptr<T>;

    // Create a single instance of T owned by a Unique<T> (freed on scope exit)
    public function create_unique<T>(args...: _init_args<T>) Unique<T>;
  }

  // Default heap allocator using malloc/free
  // This is the standard allocator for most use cases
  public class HeapAllocator implements IAllocator {
    public function init() {
      // No initialization needed for system malloc
    }

    // Allocate array of count elements, returns typed raw pointer
    public function alloc<T>(count: i64) raw_ptr<T> {
      var size: i64 = count * _sizeof<T>();
      return unsafe { _malloc(size); };
    }

    // Low-level raw byte allocation
    public function alloc_raw(size: i64) raw_ptr<u8> {
      return unsafe { _malloc(size); };
    }

    // Free typed memory allocated with alloc<T>
    public function dealloc<T>(p: raw_ptr<T>, count: i64) void {
      unsafe { _free(p); };
    }

    // Free raw bytes allocated with alloc_raw
    public function dealloc_raw(p: raw_ptr<u8>, size: i64) void {
      unsafe { _free(p); };
    }

    // Create a single instance of T
    // Allocates memory, calls T's constructor, returns raw_ptr<T>
    public function create<T>(args...: _init_args<T>) raw_ptr<T> {
      var size: i64 = _sizeof<T>();
      var memory: raw_ptr<u8> = this.alloc_raw(size);
      _init<T>(memory, args...);
      return memory;
    }

    // Create a single instance of T wrapped in Unique<T>
    // Preferred over create<T> when the object has a single owner
    public function create_unique<T>(args...: _init_args<T>) Unique<T> {
      return Unique<T>(this.create<T>(args...));
    }

    // Create a copy of this allocator
    // Since HeapAllocator has no state, this just returns a new instance
    public const function copy() HeapAllocator {
      return HeapAllocator();
    }
  }

  // Factory function to create a heap allocator
  // Usage: import "stdlib/allocator.sun"; 
  //        using sun;
  //        var allocator = make_heap_allocator();
  //        var p = allocator.create_unique<Point>(3, 4);
  //        // p.deinit() called automatically at scope exit
  public function make_heap_allocator() HeapAllocator {
    return HeapAllocator();
  }
}  // module sun
