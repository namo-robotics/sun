// stdlib/proto_wire.sun - Protobuf wire-format primitives
//
// Encoding/decoding helpers used by the classes the compiler synthesizes for
// `manifest { protos: [...] }` schemas. All integer arithmetic is done in u64;
// per-proto-type wrappers do the sign/width conversions.
//
// Wire types: 0 = varint, 1 = 64-bit, 2 = length-delimited, 5 = 32-bit.

public module std {
  // ==========================================================================
  // Errors
  // ==========================================================================

  public class ProtoDecodeError implements IError {
    var message_: static_ptr<u8>;

    // Build a decode error carrying a literal explanation.
    init(message: static_ptr<u8>) {
      this.message_ = message;
    }

    // Always 100, the code for a protobuf decode failure.
    public method code() i32 {
      return 40;
    }

    // A fresh copy of the explanation, owned by the caller.
    public method message() String {
      return String(this.message_);
    }
  }

  // ==========================================================================
  // Writers (append to a Vec<u8>)
  // ==========================================================================

  public function proto_write_varint(buf: ref Vec<u8>, value: u64) void {
    var v: u64 = value;
    while (v >= 128) {
      buf.push(_convert<u8>((v & 127) | 128));
      v = v >> 7;
    }
    buf.push(_convert<u8>(v));
  }

  // Append a field tag: the field number and wire type packed into one varint.
  public function proto_write_tag(buf: ref Vec<u8>, field: i64, wire_type: i64) void {
    var key: u64 = _convert<u64>(field * 8 + wire_type);
    proto_write_varint(buf, key);
  }

  // Append an int32 field value. Negative values sign-extend to ten bytes, as
  // the protobuf spec requires.
  public function proto_write_int32(buf: ref Vec<u8>, value: i32) void {
    // Negative int32 sign-extends to a 10-byte varint (protobuf spec)
    proto_write_varint(buf, _convert<u64>(value));
  }

  // Append an int64 field value as a varint.
  public function proto_write_int64(buf: ref Vec<u8>, value: i64) void {
    proto_write_varint(buf, _convert<u64>(value));
  }

  // Append a uint32 field value as a varint.
  public function proto_write_uint32(buf: ref Vec<u8>, value: u32) void {
    proto_write_varint(buf, _convert<u64>(value));
  }

  // Append a uint64 field value as a varint.
  public function proto_write_uint64(buf: ref Vec<u8>, value: u64) void {
    proto_write_varint(buf, value);
  }

  // Append a bool field value as a single 0 or 1 byte.
  public function proto_write_bool(buf: ref Vec<u8>, value: bool) void {
    if (value) {
      buf.push(1);
    } else {
      buf.push(0);
    }
  }

  // Fold a signed value into an unsigned one so small negatives stay short:
  // 0, -1, 1, -2 become 0, 1, 2, 3.
  public function proto_encode_zigzag64(value: i64) u64 {
    return (_convert<u64>(value) << 1) ^ _convert<u64>(value >> 63);
  }

  // Undo the zigzag folding, recovering the signed value.
  public function proto_decode_zigzag64(value: u64) i64 {
    var half: i64 = _convert<i64>(value >> 1);
    var neg: i64 = 0 - _convert<i64>(value & 1);
    return half ^ neg;
  }

  // Append a sint32 field value, zigzag encoded.
  public function proto_write_sint32(buf: ref Vec<u8>, value: i32) void {
    proto_write_varint(buf, proto_encode_zigzag64(_convert<i64>(value)));
  }

  // Append a sint64 field value, zigzag encoded.
  public function proto_write_sint64(buf: ref Vec<u8>, value: i64) void {
    proto_write_varint(buf, proto_encode_zigzag64(value));
  }

  // Append a fixed32 field value: four bytes, least significant first.
  public function proto_write_fixed32(buf: ref Vec<u8>, value: u32) void {
    var v: u32 = value;
    buf.push(_convert<u8>(v & 255));
    buf.push(_convert<u8>((v >> 8) & 255));
    buf.push(_convert<u8>((v >> 16) & 255));
    buf.push(_convert<u8>((v >> 24) & 255));
  }

  // Append a fixed64 field value: eight bytes, least significant first.
  public function proto_write_fixed64(buf: ref Vec<u8>, value: u64) void {
    var v: u64 = value;
    for (var i: i32 = 0; i < 8; i = i + 1) {
      buf.push(_convert<u8>(v & 255));
      v = v >> 8;
    }
  }

  // Append an sfixed32 field value: four bytes of the two's complement form.
  public function proto_write_sfixed32(buf: ref Vec<u8>, value: i32) void {
    proto_write_fixed32(buf, _convert<u32>(value));
  }

  // Append an sfixed64 field value: eight bytes of the two's complement form.
  public function proto_write_sfixed64(buf: ref Vec<u8>, value: i64) void {
    proto_write_fixed64(buf, _convert<u64>(value));
  }

  // Append a float field value as its four raw IEEE-754 bytes.
  public function proto_write_float(buf: ref Vec<u8>, value: f32) void {
    proto_write_fixed32(buf, _bitcast<u32>(value));
  }

  // Append a double field value as its eight raw IEEE-754 bytes.
  public function proto_write_double(buf: ref Vec<u8>, value: f64) void {
    proto_write_fixed64(buf, _bitcast<u64>(value));
  }

  // Length-prefixed raw bytes
  public function proto_write_bytes(buf: ref Vec<u8>, data: const ref Vec<u8>) void {
    var n: i64 = data.size();
    proto_write_varint(buf, _convert<u64>(n));
    for (var i: i64 = 0; i < n; i = i + 1) {
      buf.push(data.get_unchecked(i));
    }
  }

  // Length-prefixed string bytes
  public function proto_write_string(buf: ref Vec<u8>, s: const ref String) void {
    var n: i64 = s.length();
    proto_write_varint(buf, _convert<u64>(n));
    for (var i: i64 = 0; i < n; i = i + 1) {
      buf.push(s.at(i));
    }
  }

  // Append raw bytes without a length prefix (unknown-field passthrough,
  // packed bodies)
  public function proto_append_raw(buf: ref Vec<u8>, data: const ref Vec<u8>) void {
    var n: i64 = data.size();
    for (var i: i64 = 0; i < n; i = i + 1) {
      buf.push(data.get_unchecked(i));
    }
  }

  // ==========================================================================
  // ProtoReader - cursor over a byte buffer with a nesting limit stack
  // ==========================================================================
  //
  // Holds a raw pointer into the Vec<u8> it was created from; the generated
  // decode functions keep that Vec borrowed (`ref`) for the reader's whole
  // lifetime, so the pointer cannot dangle.

  public class ProtoReader {
    var data: raw_ptr<u8>;
    var len: i64;  // current limit (end of the message being decoded)
    var pos: i64;

    // Build a reader over a buffer. The buffer stays borrowed for the reader's
    // whole life, so its bytes cannot move underneath it.
    init(buf: ref Vec<u8>) {
      this.data = buf.raw_data();
      this.len = buf.size();
      this.pos = 0;
    }

    // Report whether the reader has consumed everything up to the current limit.
    public method at_end() bool {
      return this.pos >= this.len;
    }

    // The current byte offset into the buffer.
    public method position() i64 {
      return this.pos;
    }

    // Read one byte and step past it. Throws at the end of the buffer.
    public method read_byte() u8 throws IError {
      if (this.pos >= this.len) {
        throw ProtoDecodeError("unexpected end of buffer");
      }
      var b: u8 = unsafe { _load<u8>(this.data, this.pos); };
      this.pos = this.pos + 1;
      return b;
    }

    // Read a base-128 varint. Throws on a truncated or over-long encoding.
    public method read_varint() u64 throws IError {
      var result: u64 = 0;
      var shift: u64 = 0;
      for (var i: i32 = 0; i < 10; i = i + 1) {
        var b: u8 = this.read_byte();
        var low: u64 = _convert<u64>(b & 127);
        result = result | (low << shift);
        if ((b & 128) == 0) {
          return result;
        }
        shift = shift + 7;
      }
      throw ProtoDecodeError("varint too long");
    }

    // Returns the tag key (field << 3 | wire type)
    public method read_tag() u64 throws IError {
      return this.read_varint();
    }

    // Read an int32 field value.
    public method read_int32() i32 throws IError {
      return _convert<i32>(this.read_varint());
    }

    // Read an int64 field value.
    public method read_int64() i64 throws IError {
      return _convert<i64>(this.read_varint());
    }

    // Read a uint32 field value.
    public method read_uint32() u32 throws IError {
      return _convert<u32>(this.read_varint());
    }

    // Read a uint64 field value.
    public method read_uint64() u64 throws IError {
      return this.read_varint();
    }

    // Read a bool field value. Any non-zero varint counts as true.
    public method read_bool() bool throws IError {
      return this.read_varint() != 0;
    }

    // Read a zigzag-encoded sint32 field value.
    public method read_sint32() i32 throws IError {
      return _convert<i32>(proto_decode_zigzag64(this.read_varint()));
    }

    // Read a zigzag-encoded sint64 field value.
    public method read_sint64() i64 throws IError {
      return proto_decode_zigzag64(this.read_varint());
    }

    // Read four bytes as a fixed32 field value, least significant first.
    public method read_fixed32() u32 throws IError {
      var b0: u32 = _convert<u32>(this.read_byte());
      var b1: u32 = _convert<u32>(this.read_byte());
      var b2: u32 = _convert<u32>(this.read_byte());
      var b3: u32 = _convert<u32>(this.read_byte());
      return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    // Read eight bytes as a fixed64 field value, least significant first.
    public method read_fixed64() u64 throws IError {
      var result: u64 = 0;
      var shift: u64 = 0;
      for (var i: i32 = 0; i < 8; i = i + 1) {
        var b: u64 = _convert<u64>(this.read_byte());
        result = result | (b << shift);
        shift = shift + 8;
      }
      return result;
    }

    // Read four bytes as a signed sfixed32 field value.
    public method read_sfixed32() i32 throws IError {
      return _convert<i32>(this.read_fixed32());
    }

    // Read eight bytes as a signed sfixed64 field value.
    public method read_sfixed64() i64 throws IError {
      return _convert<i64>(this.read_fixed64());
    }

    // Read four bytes as an IEEE-754 float.
    public method read_float() f32 throws IError {
      return _bitcast<f32>(this.read_fixed32());
    }

    // Read eight bytes as an IEEE-754 double.
    public method read_double() f64 throws IError {
      return _bitcast<f64>(this.read_fixed64());
    }

    // Read a length prefix and return the absolute end position of the
    // delimited region; the caller narrows with push_limit / restores with
    // pop_limit around nested decoding.
    public method read_length() i64 throws IError {
      var n: i64 = _convert<i64>(this.read_varint());
      if (n < 0) {
        throw ProtoDecodeError("negative length");
      }
      if (this.pos + n > this.len) {
        throw ProtoDecodeError("length exceeds buffer");
      }
      return this.pos + n;
    }

    // Narrow the readable region to [pos, new_end); returns the previous end
    public method push_limit(new_end: i64) i64 {
      var old: i64 = this.len;
      this.len = new_end;
      return old;
    }

    // Restore the limit that push_limit returned, after a nested message ends.
    public method pop_limit(old_end: i64) void {
      this.len = old_end;
    }

    // Read `n` bytes into a fresh Vec<u8>
    public method read_bytes(alloc: ref HeapAllocator, n: i64) Vec<u8> throws IError {
      if (this.pos + n > this.len) {
        throw ProtoDecodeError("length exceeds buffer");
      }
      var out = Vec<u8>(alloc, n + 1);
      for (var i: i64 = 0; i < n; i = i + 1) {
        out.push(unsafe { _load<u8>(this.data, this.pos + i); });
      }
      this.pos = this.pos + n;
      return out;
    }

    // Read a length-prefixed byte field
    public method read_bytes_field(alloc: ref HeapAllocator) Vec<u8> throws IError {
      var n: i64 = _convert<i64>(this.read_varint());
      return this.read_bytes(alloc, n);
    }

    // Read a length-prefixed string field
    public method read_string_field(alloc: ref HeapAllocator) String throws IError {
      var n: i64 = _convert<i64>(this.read_varint());
      if (n < 0) {
        throw ProtoDecodeError("negative length");
      }
      if (this.pos + n > this.len) {
        throw ProtoDecodeError("length exceeds buffer");
      }
      var tmp = ContiguousBuffer<u8>(alloc, n + 1);
      for (var i: i64 = 0; i < n; i = i + 1) {
        tmp.set_unchecked(i, unsafe { _load<u8>(this.data, this.pos + i); });
      }
      this.pos = this.pos + n;
      return String(alloc, tmp, n);
    }

    // Skip a field of the given wire type, appending its raw tag+payload
    // bytes to `unknown` so an unrecognized field survives re-encoding.
    public method skip_field(wire_type: i64, tag: u64, unknown: ref Vec<u8>) void throws IError {
      proto_write_varint(unknown, tag);
      if (wire_type == 0) {
        var v: u64 = this.read_varint();
        proto_write_varint(unknown, v);
        return;
      }
      if (wire_type == 1) {
        var v64: u64 = this.read_fixed64();
        proto_write_fixed64(unknown, v64);
        return;
      }
      if (wire_type == 5) {
        var v32: u32 = this.read_fixed32();
        proto_write_fixed32(unknown, v32);
        return;
      }
      if (wire_type == 2) {
        var n: i64 = _convert<i64>(this.read_varint());
        if (n < 0) {
          throw ProtoDecodeError("negative length");
        }
        if (this.pos + n > this.len) {
          throw ProtoDecodeError("length exceeds buffer");
        }
        proto_write_varint(unknown, _convert<u64>(n));
        for (var i: i64 = 0; i < n; i = i + 1) {
          unknown.push(unsafe { _load<u8>(this.data, this.pos + i); });
        }
        this.pos = this.pos + n;
        return;
      }
      throw ProtoDecodeError("unsupported wire type");
    }
  }

  // Tag helpers
  public function proto_read_tag_field(tag: u64) i64 {
    return _convert<i64>(tag >> 3);
  }

  // The wire type packed into a tag: its low three bits.
  public function proto_read_tag_wire_type(tag: u64) i64 {
    return _convert<i64>(tag & 7);
  }
}  // module std
