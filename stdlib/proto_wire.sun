// stdlib/proto_wire.sun - Protobuf wire-format primitives
//
// Encoding/decoding helpers used by the classes the compiler synthesizes for
// `manifest { protos: [...] }` schemas. All integer arithmetic is done in u64;
// per-proto-type wrappers do the sign/width conversions.
//
// Wire types: 0 = varint, 1 = 64-bit, 2 = length-delimited, 5 = 32-bit.

public module sun {
  // ==========================================================================
  // Errors
  // ==========================================================================

  public class ProtoDecodeError implements IError {
    var message_: static_ptr<u8>;

    public function init(message: static_ptr<u8>) {
      this.message_ = message;
    }

    public function code() i32 {
      return 40;
    }

    public function message() static_ptr<u8> {
      return this.message_;
    }
  }

  // ==========================================================================
  // Writers (append to a Vec<u8>)
  // ==========================================================================

  public function proto_write_varint(buf: ref Vec<u8>, value: u64) void {
    var v: u64 = value;
    while (v >= 128) {
      buf.push(_convert<u8>((v & 127) | 128));
      v = v >> 7;
    }
    buf.push(_convert<u8>(v));
  }

  public function proto_write_tag(buf: ref Vec<u8>, field: i64, wire_type: i64) void {
    var key: u64 = _convert<u64>(field * 8 + wire_type);
    proto_write_varint(buf, key);
  }

  public function proto_write_int32(buf: ref Vec<u8>, value: i32) void {
    // Negative int32 sign-extends to a 10-byte varint (protobuf spec)
    proto_write_varint(buf, _convert<u64>(value));
  }

  public function proto_write_int64(buf: ref Vec<u8>, value: i64) void {
    proto_write_varint(buf, _convert<u64>(value));
  }

  public function proto_write_uint32(buf: ref Vec<u8>, value: u32) void {
    proto_write_varint(buf, _convert<u64>(value));
  }

  public function proto_write_uint64(buf: ref Vec<u8>, value: u64) void {
    proto_write_varint(buf, value);
  }

  public function proto_write_bool(buf: ref Vec<u8>, value: bool) void {
    if (value) {
      buf.push(1);
    } else {
      buf.push(0);
    }
  }

  public function proto_zigzag64(value: i64) u64 {
    return (_convert<u64>(value) << 1) ^ _convert<u64>(value >> 63);
  }

  public function proto_unzigzag64(value: u64) i64 {
    var half: i64 = _convert<i64>(value >> 1);
    var neg: i64 = 0 - _convert<i64>(value & 1);
    return half ^ neg;
  }

  public function proto_write_sint32(buf: ref Vec<u8>, value: i32) void {
    proto_write_varint(buf, proto_zigzag64(_convert<i64>(value)));
  }

  public function proto_write_sint64(buf: ref Vec<u8>, value: i64) void {
    proto_write_varint(buf, proto_zigzag64(value));
  }

  public function proto_write_fixed32(buf: ref Vec<u8>, value: u32) void {
    var v: u32 = value;
    buf.push(_convert<u8>(v & 255));
    buf.push(_convert<u8>((v >> 8) & 255));
    buf.push(_convert<u8>((v >> 16) & 255));
    buf.push(_convert<u8>((v >> 24) & 255));
  }

  public function proto_write_fixed64(buf: ref Vec<u8>, value: u64) void {
    var v: u64 = value;
    for (var i: i32 = 0; i < 8; i = i + 1) {
      buf.push(_convert<u8>(v & 255));
      v = v >> 8;
    }
  }

  public function proto_write_sfixed32(buf: ref Vec<u8>, value: i32) void {
    proto_write_fixed32(buf, _convert<u32>(value));
  }

  public function proto_write_sfixed64(buf: ref Vec<u8>, value: i64) void {
    proto_write_fixed64(buf, _convert<u64>(value));
  }

  public function proto_write_float(buf: ref Vec<u8>, value: f32) void {
    proto_write_fixed32(buf, _bitcast<u32>(value));
  }

  public function proto_write_double(buf: ref Vec<u8>, value: f64) void {
    proto_write_fixed64(buf, _bitcast<u64>(value));
  }

  // Length-prefixed raw bytes
  public function proto_write_bytes(buf: ref Vec<u8>, data: ref Vec<u8>) void {
    var n: i64 = data.size();
    proto_write_varint(buf, _convert<u64>(n));
    for (var i: i64 = 0; i < n; i = i + 1) {
      buf.push(data.get_unchecked(i));
    }
  }

  // Length-prefixed string bytes
  public function proto_write_string(buf: ref Vec<u8>, s: ref String) void {
    var n: i64 = s.length();
    proto_write_varint(buf, _convert<u64>(n));
    for (var i: i64 = 0; i < n; i = i + 1) {
      buf.push(s.at(i));
    }
  }

  // Append raw bytes without a length prefix (unknown-field passthrough,
  // packed bodies)
  public function proto_append_raw(buf: ref Vec<u8>, data: ref Vec<u8>) void {
    var n: i64 = data.size();
    for (var i: i64 = 0; i < n; i = i + 1) {
      buf.push(data.get_unchecked(i));
    }
  }

  // ==========================================================================
  // ProtoReader - cursor over a byte buffer with a nesting limit stack
  // ==========================================================================
  //
  // Holds a raw pointer into the Vec<u8> it was created from; the generated
  // decode functions keep that Vec borrowed (`ref`) for the reader's whole
  // lifetime, so the pointer cannot dangle.

  public class ProtoReader {
    var data: raw_ptr<u8>;
    var len: i64;    // current limit (end of the message being decoded)
    var pos: i64;

    public function init(buf: ref Vec<u8>) {
      this.data = buf.rawData();
      this.len = buf.size();
      this.pos = 0;
    }

    public function at_end() bool {
      return this.pos >= this.len;
    }

    public function position() i64 {
      return this.pos;
    }

    public function read_byte() u8, IError {
      if (this.pos >= this.len) {
        throw ProtoDecodeError("unexpected end of buffer");
      }
      var b: u8 = unsafe { _load<u8>(this.data, this.pos); };
      this.pos = this.pos + 1;
      return b;
    }

    public function read_varint() u64, IError {
      var result: u64 = 0;
      var shift: u64 = 0;
      for (var i: i32 = 0; i < 10; i = i + 1) {
        var b: u8 = this.read_byte();
        var low: u64 = _convert<u64>(b & 127);
        result = result | (low << shift);
        if ((b & 128) == 0) {
          return result;
        }
        shift = shift + 7;
      }
      throw ProtoDecodeError("varint too long");
    }

    // Returns the tag key (field << 3 | wire type)
    public function read_tag() u64, IError {
      return this.read_varint();
    }

    public function read_int32() i32, IError {
      return _convert<i32>(this.read_varint());
    }

    public function read_int64() i64, IError {
      return _convert<i64>(this.read_varint());
    }

    public function read_uint32() u32, IError {
      return _convert<u32>(this.read_varint());
    }

    public function read_uint64() u64, IError {
      return this.read_varint();
    }

    public function read_bool() bool, IError {
      return this.read_varint() != 0;
    }

    public function read_sint32() i32, IError {
      return _convert<i32>(proto_unzigzag64(this.read_varint()));
    }

    public function read_sint64() i64, IError {
      return proto_unzigzag64(this.read_varint());
    }

    public function read_fixed32() u32, IError {
      var b0: u32 = _convert<u32>(this.read_byte());
      var b1: u32 = _convert<u32>(this.read_byte());
      var b2: u32 = _convert<u32>(this.read_byte());
      var b3: u32 = _convert<u32>(this.read_byte());
      return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    public function read_fixed64() u64, IError {
      var result: u64 = 0;
      var shift: u64 = 0;
      for (var i: i32 = 0; i < 8; i = i + 1) {
        var b: u64 = _convert<u64>(this.read_byte());
        result = result | (b << shift);
        shift = shift + 8;
      }
      return result;
    }

    public function read_sfixed32() i32, IError {
      return _convert<i32>(this.read_fixed32());
    }

    public function read_sfixed64() i64, IError {
      return _convert<i64>(this.read_fixed64());
    }

    public function read_float() f32, IError {
      return _bitcast<f32>(this.read_fixed32());
    }

    public function read_double() f64, IError {
      return _bitcast<f64>(this.read_fixed64());
    }

    // Read a length prefix and return the absolute end position of the
    // delimited region; the caller narrows with push_limit / restores with
    // pop_limit around nested decoding.
    public function read_length() i64, IError {
      var n: i64 = _convert<i64>(this.read_varint());
      if (n < 0) {
        throw ProtoDecodeError("negative length");
      }
      if (this.pos + n > this.len) {
        throw ProtoDecodeError("length exceeds buffer");
      }
      return this.pos + n;
    }

    // Narrow the readable region to [pos, new_end); returns the previous end
    public function push_limit(new_end: i64) i64 {
      var old: i64 = this.len;
      this.len = new_end;
      return old;
    }

    public function pop_limit(old_end: i64) void {
      this.len = old_end;
    }

    // Read `n` bytes into a fresh Vec<u8>
    public function read_bytes(alloc: ref HeapAllocator, n: i64) Vec<u8>, IError {
      if (this.pos + n > this.len) {
        throw ProtoDecodeError("length exceeds buffer");
      }
      var out = Vec<u8>(alloc, n + 1);
      for (var i: i64 = 0; i < n; i = i + 1) {
        out.push(unsafe { _load<u8>(this.data, this.pos + i); });
      }
      this.pos = this.pos + n;
      return out;
    }

    // Read a length-prefixed byte field
    public function read_bytes_field(alloc: ref HeapAllocator) Vec<u8>, IError {
      var n: i64 = _convert<i64>(this.read_varint());
      return this.read_bytes(alloc, n);
    }

    // Read a length-prefixed string field
    public function read_string_field(alloc: ref HeapAllocator) String, IError {
      var n: i64 = _convert<i64>(this.read_varint());
      if (n < 0) {
        throw ProtoDecodeError("negative length");
      }
      if (this.pos + n > this.len) {
        throw ProtoDecodeError("length exceeds buffer");
      }
      var tmp = ContiguousBuffer<u8>(alloc, n + 1);
      for (var i: i64 = 0; i < n; i = i + 1) {
        tmp.set_unchecked(i, unsafe { _load<u8>(this.data, this.pos + i); });
      }
      this.pos = this.pos + n;
      return String(alloc, tmp, n);
    }

    // Skip a field of the given wire type, appending its raw tag+payload
    // bytes to `unknown` so an unrecognized field survives re-encoding.
    public function skip_field(wire_type: i64, tag: u64, unknown: ref Vec<u8>) void, IError {
      proto_write_varint(unknown, tag);
      if (wire_type == 0) {
        var v: u64 = this.read_varint();
        proto_write_varint(unknown, v);
        return;
      }
      if (wire_type == 1) {
        var v64: u64 = this.read_fixed64();
        proto_write_fixed64(unknown, v64);
        return;
      }
      if (wire_type == 5) {
        var v32: u32 = this.read_fixed32();
        proto_write_fixed32(unknown, v32);
        return;
      }
      if (wire_type == 2) {
        var n: i64 = _convert<i64>(this.read_varint());
        if (n < 0) {
          throw ProtoDecodeError("negative length");
        }
        if (this.pos + n > this.len) {
          throw ProtoDecodeError("length exceeds buffer");
        }
        proto_write_varint(unknown, _convert<u64>(n));
        for (var i: i64 = 0; i < n; i = i + 1) {
          unknown.push(unsafe { _load<u8>(this.data, this.pos + i); });
        }
        this.pos = this.pos + n;
        return;
      }
      throw ProtoDecodeError("unsupported wire type");
    }
  }

  // Tag helpers
  public function proto_tag_field(tag: u64) i64 {
    return _convert<i64>(tag >> 3);
  }

  public function proto_tag_wire_type(tag: u64) i64 {
    return _convert<i64>(tag & 7);
  }


}  // module sun
