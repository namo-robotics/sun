// stdlib/networking_tests.sun - Tests for networking.sun (TcpListener,
// TcpStream, name resolution). UdpSocket and Ipv4Addr are in udp_tests.sun.
// Every listener binds port 0 and reads the OS's pick back with
// local_port(), so parallel test runs never collide.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /** Groups tests for the networking library behavior. */
  module networking_tests {
    /** Check socket ownership with stdin closed in an isolated process. */
    test_function sockets_can_own_descriptor_zero() {
      var pid: i32 = std.process.fork();
      if (pid == 0) {
        try {
          check_descriptor_zero();
        } catch (e: ref IError) {
          std.process.exit_now(1);
        }
        std.process.exit_now(0);
      }
      var status: i32 = std.process.wait_pid(pid, 0);
      std.test.assert(std.process.exited(status), "the socket child exited normally");
      std.test.assert_eq(std.process.exit_status(status), 0);
    }

    /** Exercise every socket acquisition path with descriptor zero available. */
    function check_descriptor_zero() void throws IError {
      unsafe { c_close(0); };
      for (var mode: i32 = 0; mode < 3; mode = mode + 1) {
        var listener = TcpListener();
        if (mode == 0) {
          listener.bind_port(0);
        } else if (mode == 1) {
          listener.bind_loopback(0);
        } else {
          listener.bind_addr(ipv4_loopback(), 0);
        }
        std.test.assert_eq(listener.get_fd(), 0);
        std.test.assert(listener.is_open(), "a listener can own descriptor zero");
        listener.listen(1);
        listener.close();
        listener.close();
        std.test.assert(not listener.is_open(), "the listener is closed");
        std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);
      }

      // Occupy zero while opening the server, then release it for each client.
      var reserve = UdpSocket();
      reserve.bind(ipv4_loopback(), 0);
      var listener = TcpListener();
      listener.bind_loopback(0);
      listener.listen(1);
      reserve.close();
      for (var mode: i32 = 0; mode < 2; mode = mode + 1) {
        var stream = TcpStream();
        if (mode == 0) {
          stream.connect_local(listener.local_port());
        } else {
          stream.connect_ip(INADDR_LOOPBACK, listener.local_port());
        }
        std.test.assert_eq(stream.get_fd(), 0);
        std.test.assert(stream.is_open(), "a connected stream can own descriptor zero");
        var peer = listener.accept();
        std.test.assert_eq(stream.send_str("ping"), 4);
        stream.close();
        stream.close();
        std.test.assert(not stream.is_open(), "the stream is closed");
        std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);
      }

      reserve.bind(ipv4_loopback(), 0);
      var client = TcpStream();
      client.connect_local(listener.local_port());
      reserve.close();
      if (true) {
        var accepted = listener.accept();
        std.test.assert_eq(accepted.get_fd(), 0);
        std.test.assert(accepted.is_open(), "an accepted stream can own descriptor zero");
        std.test.assert_eq(accepted.send_str("ping"), 4);
      }
      std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);

      if (true) {
        var socket = UdpSocket();
        socket.bind(ipv4_loopback(), 0);
        std.test.assert_eq(socket.get_fd(), 0);
        std.test.assert(socket.is_open(), "a UDP socket can own descriptor zero");
        std.test.assert(socket.local_port() > 0, "the UDP socket is bound");
        socket.close();
        socket.close();
        std.test.assert(not socket.is_open(), "the UDP socket is closed");
        std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);
        socket.bind(ipv4_loopback(), 0);
        std.test.assert_eq(socket.get_fd(), 0);
      }
      std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);
    }

    /** Check that removing and dropping a TcpStream preserves stdin. */
    test_function removed_stream_preserves_stdin() {
      var alloc = make_heap_allocator();
      var stdin_flags: i32 = unsafe { c_fcntl(0, F_GETFL); };
      std.test.assert(stdin_flags >= 0, "stdin is open before the test");
      if (true) {
        var sockets = Vec<TcpStream>(alloc, 1);
        var listener = TcpListener();
        listener.bind_loopback(0);
        listener.listen(1);
        var socket = TcpStream();
        socket.connect_local(listener.local_port());
        var peer = listener.accept();
        sockets.push(socket);
        var taken = sockets.remove(0);
        std.test.assert_eq(sockets.size(), 0);
        sockets.clear();
        std.test.assert(taken.is_open(), "the taken stream is open");
        std.test.assert_eq(taken.send_str("ping"), 4);
        var buf = ContiguousBuffer<u8>(alloc, 4);
        std.test.assert(peer.recv(buf) > 0, "the taken stream can send data");
        taken.close();
        taken.close();
        std.test.assert(not taken.is_open(), "the socket is closed");
      }
      std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, stdin_flags);
    }

    /** Check that removing and dropping a TcpListener preserves stdin. */
    test_function removed_listener_preserves_stdin() {
      var alloc = make_heap_allocator();
      var stdin_flags: i32 = unsafe { c_fcntl(0, F_GETFL); };
      std.test.assert(stdin_flags >= 0, "stdin is open before the test");
      if (true) {
        var sockets = Vec<TcpListener>(alloc, 1);
        var socket = TcpListener();
        socket.bind_loopback(0);
        sockets.push(socket);
        var taken = sockets.remove(0);
        std.test.assert_eq(sockets.size(), 0);
        sockets.clear();
        std.test.assert(taken.is_open(), "the taken socket is open");
        std.test.assert(taken.local_port() > 0, "the taken socket remains bound");
        taken.close();
        taken.close();
        std.test.assert(not taken.is_open(), "the socket is closed");
      }
      std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, stdin_flags);
    }

    /** Check that removing and dropping a UdpSocket preserves stdin. */
    test_function removed_udp_socket_preserves_stdin() {
      var alloc = make_heap_allocator();
      var stdin_flags: i32 = unsafe { c_fcntl(0, F_GETFL); };
      std.test.assert(stdin_flags >= 0, "stdin is open before the test");
      if (true) {
        var sockets = Vec<UdpSocket>(alloc, 1);
        var socket = UdpSocket();
        socket.bind(ipv4_loopback(), 0);
        sockets.push(socket);
        var taken = sockets.remove(0);
        std.test.assert_eq(sockets.size(), 0);
        sockets.clear();
        std.test.assert(taken.is_open(), "the taken socket is open");
        std.test.assert(taken.local_port() > 0, "the taken socket remains bound");
        taken.close();
        taken.close();
        std.test.assert(not taken.is_open(), "the socket is closed");
      }
      std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, stdin_flags);
    }

    /**
     * A non-blocking read on a connected stream with nothing to read fails
     * with a would-block code instead of waiting.
     */
    test_function nonblocking_recv_reports_would_block() {
      var alloc = make_heap_allocator();
      var listener = TcpListener();
      listener.bind_loopback(0);
      listener.listen(1);
      var stream = TcpStream();
      stream.connect_local(listener.local_port());
      stream.set_nonblocking(true);
      var buf = ContiguousBuffer<u8>(alloc, 16);
      var would_block: bool = false;
      try {
        stream.recv(buf);
      } catch (e: ref IError) {
        would_block = is_would_block(e.code());
      }
      std.test.assert(would_block, "recv on an idle non-blocking stream reports would-block");
      stream.set_nonblocking(false);
      stream.close();
      listener.close();
    }

    /**
     * A socket that was never opened has no descriptor, so the OS answers
     * EBADF (9 on every supported target), which is not a would-block code.
     * The error carries the real errno, whatever the operation.
     */
    test_function unopened_sockets_report_ebadf() {
      var alloc = make_heap_allocator();
      var stream = TcpStream();
      var buf = ContiguousBuffer<u8>(alloc, 1);
      var recv_code: i32 = 0;
      try {
        stream.recv(buf);
      } catch (e: ref IError) {
        recv_code = e.code();
      }
      std.test.assert_eq(recv_code, 9);
      std.test.assert(not is_would_block(recv_code), "EBADF is not a would-block code");

      var listener = TcpListener();
      var listener_code: i32 = 0;
      try {
        listener.set_nonblocking(true);
      } catch (e: ref IError) {
        listener_code = e.code();
      }
      std.test.assert_eq(listener_code, 9);
    }

    /** Checks resolves localhost to loopback. */
    test_function resolves_localhost_to_loopback() {
      var alloc = make_heap_allocator();
      var host = String(alloc, "localhost");
      std.test.assert_eq(resolve_host_ipv4(host), INADDR_LOOPBACK);
    }

    /** Checks unresolvable host throws. */
    test_function unresolvable_host_throws() {
      var alloc = make_heap_allocator();
      var host = String(alloc, "no-such-host.invalid");
      var threw: bool = false;
      try {
        resolve_host_ipv4(host);
      } catch (e: ref IError) {
        threw = true;
      }
      std.test.assert(threw, "a name under .invalid never resolves");
    }
  }  // module networking_tests
}  // module std
