// stdlib/networking_tests.sun - Tests for networking.sun (TcpListener,
// TcpStream, name resolution). UdpSocket and Ipv4Addr are in udp_tests.sun.
// Every listener binds port 0 and reads the OS's pick back with
// local_port(), so parallel test runs never collide.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /** Groups tests for the networking library behavior. */
  module networking_tests {
    /** Check socket ownership with stdin closed in an isolated process. */
    test_function sockets_can_own_descriptor_zero() {
      var pid: i32 = try std.test.expect_system(std.process.fork());
      if (pid == 0) {
        match check_descriptor_zero() {
          _Result.Ok => {},
          _Result.Err(e) => {
            std.process.exit_now(1);
          }
        };
        std.process.exit_now(0);
      }
      var status: i32 = try std.test.expect_system(std.process.wait_pid(pid, 0));
      try std.test.assert(std.process.exited(status), "the socket child exited normally");
      try std.test.assert_eq(std.process.exit_status(status), 0);
    }

    /** Exercise every socket acquisition path with descriptor zero available. */
    function check_descriptor_zero() _Result<void, std.test.AssertionError> {
      unsafe { c_close(0); };
      for (var mode: i32 = 0; mode < 3; mode = mode + 1) {
        var listener = TcpListener();
        if (mode == 0) {
          try std.test.expect_system_success(listener.bind_port(0));
        } else if (mode == 1) {
          try std.test.expect_system_success(listener.bind_loopback(0));
        } else {
          try std.test.expect_system_success(listener.bind_addr(ipv4_loopback(), 0));
        }
        try std.test.assert_eq(listener.get_fd(), 0);
        try std.test.assert(listener.is_open(), "a listener can own descriptor zero");
        try std.test.expect_system_success(listener.listen(1));
        listener.close();
        listener.close();
        try std.test.assert(not listener.is_open(), "the listener is closed");
        try std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);
      }

      // Occupy zero while opening the server, then release it for each client.
      var reserve = UdpSocket();
      try std.test.expect_system_success(reserve.bind(ipv4_loopback(), 0));
      var listener = TcpListener();
      try std.test.expect_system_success(listener.bind_loopback(0));
      try std.test.expect_system_success(listener.listen(1));
      reserve.close();
      for (var mode: i32 = 0; mode < 2; mode = mode + 1) {
        var stream = TcpStream();
        if (mode == 0) {
          try std.test.expect_system_success(stream.connect_local(try std.test.expect_system(listener.local_port())));
        } else {
          try std.test.expect_system_success(stream.connect_ip(INADDR_LOOPBACK, try std.test.expect_system(listener.local_port())));
        }
        try std.test.assert_eq(stream.get_fd(), 0);
        try std.test.assert(stream.is_open(), "a connected stream can own descriptor zero");
        var peer = try std.test.expect_system(listener.accept());
        try std.test.assert_eq(try std.test.expect_system(stream.send_str("ping")), 4);
        stream.close();
        stream.close();
        try std.test.assert(not stream.is_open(), "the stream is closed");
        try std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);
      }

      try std.test.expect_system_success(reserve.bind(ipv4_loopback(), 0));
      var client = TcpStream();
      try std.test.expect_system_success(client.connect_local(try std.test.expect_system(listener.local_port())));
      reserve.close();
      if (true) {
        var accepted = try std.test.expect_system(listener.accept());
        try std.test.assert_eq(accepted.get_fd(), 0);
        try std.test.assert(accepted.is_open(), "an accepted stream can own descriptor zero");
        try std.test.assert_eq(try std.test.expect_system(accepted.send_str("ping")), 4);
      }
      try std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);

      if (true) {
        var socket = UdpSocket();
        try std.test.expect_system_success(socket.bind(ipv4_loopback(), 0));
        try std.test.assert_eq(socket.get_fd(), 0);
        try std.test.assert(socket.is_open(), "a UDP socket can own descriptor zero");
        try std.test.assert((try std.test.expect_system(socket.local_port())) > 0, "the UDP socket is bound");
        socket.close();
        socket.close();
        try std.test.assert(not socket.is_open(), "the UDP socket is closed");
        try std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);
        try std.test.expect_system_success(socket.bind(ipv4_loopback(), 0));
        try std.test.assert_eq(socket.get_fd(), 0);
      }
      try std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, -1);
      return _Result.Ok;
    }

    /** Check that removing and dropping a TcpStream preserves stdin. */
    test_function removed_stream_preserves_stdin() {
      var alloc = make_heap_allocator();
      var stdin_flags: i32 = unsafe { c_fcntl(0, F_GETFL); };
      try std.test.assert(stdin_flags >= 0, "stdin is open before the test");
      if (true) {
        var sockets = Vec<TcpStream>(alloc, 1);
        var listener = TcpListener();
        try std.test.expect_system_success(listener.bind_loopback(0));
        try std.test.expect_system_success(listener.listen(1));
        var socket = TcpStream();
        try std.test.expect_system_success(socket.connect_local(try std.test.expect_system(listener.local_port())));
        var peer = try std.test.expect_system(listener.accept());
        sockets.push(socket);
        var taken = try std.test.expect_access(sockets.remove(0));
        try std.test.assert_eq(sockets.size(), 0);
        sockets.clear();
        try std.test.assert(taken.is_open(), "the taken stream is open");
        try std.test.assert_eq(try std.test.expect_system(taken.send_str("ping")), 4);
        var buf = ContiguousBuffer<u8>(alloc, 4);
        try std.test.assert((try std.test.expect_system(peer.recv(buf))) > 0, "the taken stream can send data");
        taken.close();
        taken.close();
        try std.test.assert(not taken.is_open(), "the socket is closed");
      }
      try std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, stdin_flags);
    }

    /** Check that removing and dropping a TcpListener preserves stdin. */
    test_function removed_listener_preserves_stdin() {
      var alloc = make_heap_allocator();
      var stdin_flags: i32 = unsafe { c_fcntl(0, F_GETFL); };
      try std.test.assert(stdin_flags >= 0, "stdin is open before the test");
      if (true) {
        var sockets = Vec<TcpListener>(alloc, 1);
        var socket = TcpListener();
        try std.test.expect_system_success(socket.bind_loopback(0));
        sockets.push(socket);
        var taken = try std.test.expect_access(sockets.remove(0));
        try std.test.assert_eq(sockets.size(), 0);
        sockets.clear();
        try std.test.assert(taken.is_open(), "the taken socket is open");
        try std.test.assert((try std.test.expect_system(taken.local_port())) > 0, "the taken socket remains bound");
        taken.close();
        taken.close();
        try std.test.assert(not taken.is_open(), "the socket is closed");
      }
      try std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, stdin_flags);
    }

    /** Check that removing and dropping a UdpSocket preserves stdin. */
    test_function removed_udp_socket_preserves_stdin() {
      var alloc = make_heap_allocator();
      var stdin_flags: i32 = unsafe { c_fcntl(0, F_GETFL); };
      try std.test.assert(stdin_flags >= 0, "stdin is open before the test");
      if (true) {
        var sockets = Vec<UdpSocket>(alloc, 1);
        var socket = UdpSocket();
        try std.test.expect_system_success(socket.bind(ipv4_loopback(), 0));
        sockets.push(socket);
        var taken = try std.test.expect_access(sockets.remove(0));
        try std.test.assert_eq(sockets.size(), 0);
        sockets.clear();
        try std.test.assert(taken.is_open(), "the taken socket is open");
        try std.test.assert((try std.test.expect_system(taken.local_port())) > 0, "the taken socket remains bound");
        taken.close();
        taken.close();
        try std.test.assert(not taken.is_open(), "the socket is closed");
      }
      try std.test.assert_eq(unsafe { c_fcntl(0, F_GETFL); }, stdin_flags);
    }

    /**
     * A non-blocking read on a connected stream with nothing to read fails
     * with a would-block code instead of waiting.
     */
    test_function nonblocking_recv_reports_would_block() {
      var alloc = make_heap_allocator();
      var listener = TcpListener();
      try std.test.expect_system_success(listener.bind_loopback(0));
      try std.test.expect_system_success(listener.listen(1));
      var stream = TcpStream();
      try std.test.expect_system_success(stream.connect_local(try std.test.expect_system(listener.local_port())));
      try std.test.expect_system_success(stream.set_nonblocking(true));
      var buf = ContiguousBuffer<u8>(alloc, 16);
      var would_block: bool = false;
      match stream.recv(buf) {
        SystemResult.Ok(_) => {},
        SystemResult.Error(e) => {
          would_block = is_would_block(e.code());
        }
      };
      try std.test.assert(would_block, "recv on an idle non-blocking stream reports would-block");
      try std.test.expect_system_success(stream.set_nonblocking(false));
      stream.close();
      listener.close();
    }

    /**
     * A socket that was never opened has no descriptor, so the OS answers
     * EBADF (9 on every supported target), which is not a would-block code.
     * The error carries the real errno, whatever the operation.
     */
    test_function unopened_sockets_report_ebadf() {
      var alloc = make_heap_allocator();
      var stream = TcpStream();
      var buf = ContiguousBuffer<u8>(alloc, 1);
      var recv_code: i32 = 0;
      match stream.recv(buf) {
        SystemResult.Ok(_) => {},
        SystemResult.Error(e) => {
          recv_code = e.code();
        }
      };
      try std.test.assert_eq(recv_code, 9);
      try std.test.assert(not is_would_block(recv_code), "EBADF is not a would-block code");

      var listener = TcpListener();
      var listener_code: i32 = 0;
      match listener.set_nonblocking(true) {
        SystemResult.Ok => {},
        SystemResult.Error(e) => {
          listener_code = e.code();
        }
      };
      try std.test.assert_eq(listener_code, 9);
    }

    /** Checks resolves localhost to loopback. */
    test_function resolves_localhost_to_loopback() {
      var alloc = make_heap_allocator();
      var host = String(alloc, "localhost");
      try std.test.assert_eq(try std.test.expect_system(resolve_host_ipv4(host)), INADDR_LOOPBACK);
    }

    /** Checks unresolvable host throws. */
    test_function unresolvable_host_throws() {
      var alloc = make_heap_allocator();
      var host = String(alloc, "no-such-host.invalid");
      var threw: bool = false;
      match resolve_host_ipv4(host) {
        SystemResult.Ok(_) => {},
        SystemResult.Error(e) => {
          threw = true;
        }
      };
      try std.test.assert(threw, "a name under .invalid never resolves");
    }
  }  // module networking_tests
}  // module std
