// stdlib/contiguous_buffer.sun - Bounds-checked contiguous memory buffer
//
// ContiguousBuffer<T> is a fixed-size, bounds-checked array backed by contiguous memory.
// Unlike Vec, it has fixed capacity (no grow/push); resizing requires explicit reallocation.
// All get/set operations perform bounds checking and throw IndexOutOfBoundsError on violation.
// Uses HeapAllocator for memory management.
//
// Usage:
//   import "stdlib/contiguous_buffer.sun";
//   using std;
//   
//   var allocator = make_heap_allocator();
//   var buf = ContiguousBuffer<i32>(allocator, 10);
//   try { buf.set(0, 42); } catch (e: IError) { }
//   try { var val = buf.get(0); } catch (e: IError) { }  // borrows 42
//   var len = buf.size();  // 10

// ============================================================================
// ContiguousBuffer<T> - Fixed-size Bounds-checked Array
// ============================================================================

public module std {
  public class ContiguousBuffer<T> implements IIterable<ref T, ContiguousBuffer<T>> {
    var data: Unique<u8>;  // Element storage (owned, auto-freed)
    var alloc: HeapAllocator;  // Allocator (stored via copy)
    var alloc: HeapAllocator;  // Allocator (stored via copy)
    var size_: i64;  // Number of elements (fixed after init)

    // Constructor with allocator and size
    init(allocator: const ref HeapAllocator, size: i64) {
      this.alloc = allocator.copy();
      this.size_ = size;
      this.data = Unique<u8>(this.alloc.alloc_raw(size * _sizeof<T>()));
    }

    // ========================================================================
    // Bounds-checked Accessors
    // ========================================================================

    // Borrow element at index (bounds-checked). The buffer keeps ownership, so
    // this hands back a reference — copying the element out would leave two
    // owners of anything it holds.
    public const method get(index: i64) ref T throws IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index >= this.size_) {
        throw IndexOutOfBoundsError(index);
      }
      return this.get_unchecked(index);
    }

    // Set element at index (bounds-checked)
    public method set(index: i64, value: T) void throws IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index >= this.size_) {
        throw IndexOutOfBoundsError(index);
      }
      unsafe { _store<T>(this.data.get_raw(), index, value); };
    }

    // ========================================================================
    // Unchecked Accessors (for performance-critical code)
    // ========================================================================

    // Borrow element at index (no bounds check)
    public const method get_unchecked(index: i64) ref T {
      return unsafe { _to_ref<T>(_ptr_as_raw<T>(_ptr_offset(this.data.get_raw(), index * _sizeof<T>()))); };
    }

    // Move the element at index out of the buffer, leaving the slot zeroed so
    // it drops as a no-op. Only for callers that are giving up the slot.
    public method take_unchecked(index: i64) T {
      var value: T = unsafe { _load<T>(this.data.get_raw(), index); };
      unsafe {
        _memset(
          _ptr_offset(this.data.get_raw(), index * _sizeof<T>()),
          0,
          _sizeof<T>()
        );
      };
      return value;
    }

    // Set element at index (no bounds check)
    public method set_unchecked(index: i64, value: T) void {
      unsafe { _store<T>(this.data.get_raw(), index, value); };
    }

    // ========================================================================
    // Utility Methods
    // ========================================================================

    // Get buffer size
    public const method size() i64 {
      return this.size_;
    }

    // Check if buffer is empty
    public const method is_empty() bool {
      return this.size_ == 0;
    }

    // Create a deep copy of this buffer
    public const method clone() ContiguousBuffer<T> {
      var copy: ContiguousBuffer<T> = ContiguousBuffer<T>(this.alloc, this.size_);
      var byte_count: i64 = this.size_ * _sizeof<T>();
      unsafe {
        _memcpy(copy.raw_data(), this.data.get_raw(), byte_count);
      };
      return copy;
    }

    // Fill entire buffer with value
    public method fill(value: T) void {
      for (var i: i64 = 0; i < this.size_; i = i + 1) {
        unsafe { _store<T>(this.data.get_raw(), i, value); };
      }
    }

    // Write elements from another buffer into this buffer (bounds-checked)
    public method write_from(source: const ref ContiguousBuffer<T>, src_offset: i64, dst_offset: i64, count: i64) void throws IError {
      // Validate source bounds
      if (src_offset < 0) {
        throw IndexOutOfBoundsError(src_offset);
      }
      if (src_offset + count > source.size()) {
        throw IndexOutOfBoundsError(src_offset);
      }
      // Validate destination bounds
      if (dst_offset < 0) {
        throw IndexOutOfBoundsError(dst_offset);
      }
      if (dst_offset + count > this.size_) {
        throw IndexOutOfBoundsError(dst_offset);
      }
      // Copy elements using fast memcpy
      var byte_count: i64 = count * _sizeof<T>();
      var src_ptr: raw_ptr<u8> = source.raw_data();
      var dst_ptr: raw_ptr<u8> = this.data.get_raw();
      var src_byte_offset: i64 = src_offset * _sizeof<T>();
      var dst_byte_offset: i64 = dst_offset * _sizeof<T>();
      unsafe {
        _memcpy(
          _ptr_offset(dst_ptr, dst_byte_offset),
          _ptr_offset(src_ptr, src_byte_offset),
          byte_count
        );
      };
    }

    // Get raw data pointer (escape hatch for interop)
    public const method raw_data() raw_ptr<u8> {
      return this.data.get_raw();
    }

    // Resize buffer to new size, preserving min(old_size, new_size) elements
    // New elements (if growing) are uninitialized
    public method resize_to(new_size: i64) void {
      if (new_size == this.size_) {
        return;
      }

      // Allocate new buffer
      var new_data: raw_ptr<u8> = this.alloc.alloc_raw(new_size * _sizeof<T>());

      // Copy existing elements (up to min of old and new size)
      var copy_count: i64 = this.size_;
      if (new_size < copy_count) {
        copy_count = new_size;
      }
      for (var i: i64 = 0; i < copy_count; i = i + 1) {
        var value: T = unsafe { _load<T>(this.data.get_raw(), i); };
        unsafe { _store<T>(new_data, i, value); };
      }

      // Replace old data with new (Unique handles freeing old buffer)
      this.data = Unique<u8>(new_data);
      this.size_ = new_size;
    }

    // Borrow first element (bounds-checked)
    public const method first() ref T throws IError {
      if (this.size_ == 0) {
        throw IndexOutOfBoundsError(0);
      }
      return this.get_unchecked(0);
    }

    // Borrow last element (bounds-checked)
    public const method last() ref T throws IError {
      if (this.size_ == 0) {
        throw IndexOutOfBoundsError(0);
      }
      return this.get_unchecked(this.size_ - 1);
    }

    // ========================================================================
    // Indexing Support
    // ========================================================================

    // Operator overload for indexing: buf[i] calls __index__([i])
    // Note: Uses unchecked access for performance; use get() for bounds checking
    public const method __index__(indices: const ref array<i64>) ref T {
      return this.get_unchecked(indices[0]);
    }

    // Operator overload for indexed assignment: buf[i] = val calls __setindex__([i], val)
    // Note: Uses unchecked access for performance; use set() for bounds checking
    public method __setindex__(indices: const ref array<i64>, value: T) void {
      this.set_unchecked(indices[0], value);
    }

    // ========================================================================
    // Iteration Support
    // ========================================================================

    // Return iterator over elements
    public const method iter() ContiguousBufferIterator<T> {
      return ContiguousBufferIterator<T>();
    }
  }

  // ============================================================================
  // ContiguousBufferIterator<T> - Iterator over ContiguousBuffer elements
  // ============================================================================

  public class ContiguousBufferIterator<T> implements IIterator<ref T, ContiguousBuffer<T>> {
    var current: i64;

    // Build an iterator positioned before the first element.
    init() {
      this.current = 0;
    }

    // Next element, or None once the buffer is exhausted. Elements are
    // borrowed: the buffer still owns them.
    public method next(buf: ref ContiguousBuffer<T>) Option<ref T> {
      if (this.current >= buf.size()) {
        return Option.None;
      }
      var index: i64 = this.current;
      this.current = this.current + 1;
      return Option.Some(buf.get_unchecked(index));
    }
  }

  // ============================================================================
  // Precompiled Specializations
  // ============================================================================

  // ContiguousBuffer specializations
  public declare ContiguousBuffer_u8 = ContiguousBuffer<u8>;
  public declare ContiguousBuffer_i32 = ContiguousBuffer<i32>;
  public declare ContiguousBuffer_i64 = ContiguousBuffer<i64>;
  public declare ContiguousBuffer_f32 = ContiguousBuffer<f32>;
  public declare ContiguousBuffer_f64 = ContiguousBuffer<f64>;

  // ContiguousBufferIterator specializations
  public declare ContiguousBufferIterator_u8 = ContiguousBufferIterator<u8>;
  public declare ContiguousBufferIterator_i32 = ContiguousBufferIterator<i32>;
  public declare ContiguousBufferIterator_i64 = ContiguousBufferIterator<i64>;
  public declare ContiguousBufferIterator_f32 = ContiguousBufferIterator<f32>;
  public declare ContiguousBufferIterator_f64 = ContiguousBufferIterator<f64>;
}  // module std
