// stdlib/vec.sun - Dynamic growable array
//
// Vec<T> is a generic growable array backed by contiguous memory.
// Automatically resizes when capacity is exceeded.
// Uses HeapAllocator for memory management.
//
// Usage:
//   import "stdlib/vec.sun";
//   using std;
//   
//   var allocator = make_heap_allocator();
//   var v = Vec<i32>(allocator);
//   v.push(10);
//   v.push(20);
//   v.push(30);
//   var val = v.get(0);      // borrows element 0 (10)
//   v.set(1, 25);            // Update index 1 to 25
//   var last = v.pop();      // Option.Some(30), size decreases
//   var len = v.size();      // 2
//
// get()/first()/last()/v[i] and iteration borrow: the Vec keeps ownership of
// the element. take()/pop() move an element out.

// ============================================================================
// Vec<T> - Dynamic Growable Array
// ============================================================================

public module std {
  public class Vec<T> implements IIterable<ref T, Vec<T>> {
    var data: ContiguousBuffer<T>;  // Element storage (bounds-checked, auto-freed)
    var capacity_: i64;  // Allocated capacity
    var size_: i64;  // Current number of elements

    // Constructor with allocator and capacity
    init(allocator: const ref HeapAllocator, capacity: i64) {
      this.data = ContiguousBuffer<T>(allocator, capacity);
      this.capacity_ = capacity;
      this.size_ = 0;
    }

    // Destructor - drop live elements (the buffer memory itself is freed by
    // the ContiguousBuffer/Unique field recursion)
    deinit() {
      this.drop_range(0, this.size_);
    }

    // Drop elements in [from, to) in place (no-op for element types without
    // deinit). Internal helper for deinit/clear/set.
    method drop_range(from: i64, to: i64) void {
      for (var i: i64 = from; i < to; i = i + 1) {
        unsafe { _deinit<T>(_ptr_offset(this.data.raw_data(), i * _sizeof<T>())); };
      }
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    // Append element to end, grows if needed
    public method push(value: T) void {
      if (this.size_ >= this.capacity_) {
        this.grow();
      }
      this.data.set_unchecked(this.size_, value);
      this.size_ = this.size_ + 1;
    }

    // Remove and return the last element; None when empty. Ownership moves
    // to the caller.
    public method pop() Option<T> {
      if (this.size_ == 0) {
        return Option.None;
      }
      this.size_ = this.size_ - 1;
      return Option.Some(this.data.take_unchecked(this.size_));
    }

    // Borrow the element at index (bounds-checked against size). The Vec keeps
    // ownership, so this hands back a reference: a copy of an element that owns
    // heap memory would be released twice. Use take()/pop() to move one out.
    public const method get(index: i64) ref T throws IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index >= this.size_) {
        throw IndexOutOfBoundsError(index);
      }
      return this.data.get_unchecked(index);
    }

    // Borrow the element at index (no bounds check)
    public const method get_unchecked(index: i64) ref T {
      return this.data.get_unchecked(index);
    }

    // Set element at index (bounds-checked against size).
    // The previous element is dropped before being overwritten.
    public method set(index: i64, value: T) void throws IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index >= this.size_) {
        throw IndexOutOfBoundsError(index);
      }
      this.drop_range(index, index + 1);
      this.data.set_unchecked(index, value);
    }

    // Set element at index (no bounds check)
    public method set_unchecked(index: i64, value: T) void {
      this.data.set_unchecked(index, value);
    }

    // Get current size
    public const method size() i64 {
      return this.size_;
    }

    // Get current capacity
    public const method capacity() i64 {
      return this.capacity_;
    }

    // Check if empty
    public const method is_empty() bool {
      return this.size_ == 0;
    }

    // Reserve capacity for at least n elements (doesn't change size)
    public method reserve(n: i64) void {
      if (n > this.capacity_) {
        this.data.resize_to(n);
        this.capacity_ = n;
      }
    }

    // Clear all elements (doesn't deallocate). Live elements are dropped.
    public method clear() void {
      this.drop_range(0, this.size_);
      this.size_ = 0;
    }

    // Move the element at index out of the Vec (bounds-checked). The slot is
    // zeroed so it drops as a no-op; ownership transfers to the caller.
    // Use this instead of get() for element types that own heap memory.
    public method take(index: i64) T throws IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index >= this.size_) {
        throw IndexOutOfBoundsError(index);
      }
      return this.data.take_unchecked(index);
    }

    // Get raw data pointer (for interop)
    public const method raw_data() raw_ptr<u8> {
      return this.data.raw_data();
    }

    // Borrow the last element; None when empty
    public const method last() Option<ref T> {
      if (this.size_ == 0) {
        return Option.None;
      }
      return Option.Some(this.data.get_unchecked(this.size_ - 1));
    }

    // Borrow the first element; None when empty
    public const method first() Option<ref T> {
      if (this.size_ == 0) {
        return Option.None;
      }
      return Option.Some(this.data.get_unchecked(0));
    }

    // ========================================================================
    // Internal Methods
    // ========================================================================

    // Double capacity and copy elements
    method grow() void {
      var new_capacity: i64 = this.capacity_ * 2;
      this.data.resize_to(new_capacity);
      this.capacity_ = new_capacity;
    }

    // ========================================================================
    // Indexing Support
    // ========================================================================

    // Operator overload for indexing: v[i] calls __index__([i])
    // Uses unchecked access for performance; use get() for bounds checking
    public const method __index__(indices: const ref array<i64>) ref T {
      return this.data.get_unchecked(indices[0]);
    }

    // Operator overload for indexed assignment: v[i] = val calls __setindex__([i], val)
    // Uses unchecked access for performance; use set() for bounds checking
    public method __setindex__(indices: const ref array<i64>, value: T) void {
      this.data.set_unchecked(indices[0], value);
    }

    // ========================================================================
    // Iteration Support
    // ========================================================================

    // Return iterator over elements
    public const method iter() VecIterator<T> {
      return VecIterator<T>();
    }
  }

  // ============================================================================
  // VecIterator<T> - Iterator over Vec elements
  // ============================================================================

  public class VecIterator<T> implements IIterator<ref T, Vec<T>> {
    var current: i64;

    // Build an iterator positioned before the first element.
    init() {
      this.current = 0;
    }

    // Next element, or None once the Vec is exhausted. Elements are borrowed:
    // the Vec still owns them.
    public method next(vec: ref Vec<T>) Option<ref T> {
      if (this.current >= vec.size()) {
        return Option.None;
      }
      var index: i64 = this.current;
      this.current = this.current + 1;
      return Option.Some(vec.get_unchecked(index));
    }
  }

  // ============================================================================
  // Precompiled Specializations
  // ============================================================================

  // Vec specializations (must be declared before VecIterator since VecIterator<T> references Vec<T>)
  public declare Vec_i8 = Vec<i8>;
  public declare Vec_i32 = Vec<i32>;
  public declare Vec_i64 = Vec<i64>;
  public declare Vec_f32 = Vec<f32>;
  public declare Vec_f64 = Vec<f64>;

  // VecIterator specializations
  public declare VecIterator_i8 = VecIterator<i8>;
  public declare VecIterator_i32 = VecIterator<i32>;
  public declare VecIterator_i64 = VecIterator<i64>;
  public declare VecIterator_f32 = VecIterator<f32>;
  public declare VecIterator_f64 = VecIterator<f64>;
}  // module std
