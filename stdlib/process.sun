// stdlib/process.sun - Process identity, signals, and running child processes
//
// Usage:
//   using sun.process;
//
//   var cmd = Command(alloc, "/bin/sh");
//   cmd.arg("-c");
//   cmd.arg("echo hello");
//   var out = cmd.output();
//   println(out.stdout());
//
// The raw POSIX calls (fork, exec, pipes, waitpid) are here too, for programs
// that need to drive the fork themselves.

public module sun {
  public module process {
    using sun.io;

    // Signal numbers, from Linux's asm-generic set.
    public var SIGHUP: i32 = 1;
    public var SIGINT: i32 = 2;
    public var SIGQUIT: i32 = 3;
    public var SIGKILL: i32 = 9;
    public var SIGSEGV: i32 = 11;
    public var SIGPIPE: i32 = 13;
    public var SIGALRM: i32 = 14;
    public var SIGTERM: i32 = 15;
    public var SIGCHLD: i32 = 17;
    public var SIGCONT: i32 = 18;
    public var SIGSTOP: i32 = 19;

    // waitpid options
    public var WNOHANG: i32 = 1;

    var O_WRONLY: i32 = 1;
    var O_RDONLY: i32 = 0;

    // -------------------------------------------------------------------
    // Identity
    // -------------------------------------------------------------------

    public function pid() i32 {
      return unsafe { c_getpid(); };
    }

    public function parent_pid() i32 {
      return unsafe { c_getppid(); };
    }

    public function uid() u32 {
      return unsafe { c_getuid(); };
    }

    public function euid() u32 {
      return unsafe { c_geteuid(); };
    }

    // -------------------------------------------------------------------
    // Signals, process groups, exit
    // -------------------------------------------------------------------

    public function kill(target: i32, sig: i32) void, IError {
      if (unsafe { c_kill(target, sig); } != 0) {
        throw Error(errno(), "failed to signal process");
      }
    }

    // Put a process in a process group. pid or pgid of 0 means "this one".
    public function set_pgid(target: i32, pgid: i32) void, IError {
      if (unsafe { c_setpgid(target, pgid); } != 0) {
        throw Error(errno(), "failed to set process group");
      }
    }

    // Start a new session, detaching from the controlling terminal.
    // Returns the new session id.
    public function new_session() i32, IError {
      var sid: i32 = unsafe { c_setsid(); };
      if (sid < 0) {
        throw Error(errno(), "failed to start a new session");
      }
      return sid;
    }

    // Leave the program, running atexit handlers and flushing streams.
    public function exit(code: i32) void {
      unsafe { c_exit(code); };
    }

    // Leave immediately, running nothing. This is what a forked child must
    // use when its exec fails: the parent's atexit handlers and buffered
    // output are not the child's to run.
    public function exit_now(code: i32) void {
      unsafe { c_exit_now(code); };
    }

    // -------------------------------------------------------------------
    // Raw process control
    // -------------------------------------------------------------------

    // Duplicate this process. Returns 0 in the child and the child's pid in
    // the parent.
    //
    // Between fork and exec the child may only call things that are safe in a
    // signal handler — no allocation, no method calls that might allocate. Use
    // Command below unless you have a reason not to.
    public function fork() i32, IError {
      var result: i32 = unsafe { c_fork(); };
      if (result < 0) {
        throw Error(errno(), "failed to fork");
      }
      return result;
    }

    // Replace this process with `cmd`, searching PATH. Only returns on
    // failure.
    public function exec(cmd: ref Command) void, IError {
      var argv: ContiguousBuffer<raw_ptr<u8>> = cmd.argv_array();
      unsafe { c_execvp(cmd.program(), argv.rawData()); };
      throw Error(errno(), "failed to exec");
    }

    // Wait for a child. `target` of -1 means any child. Returns the raw wait
    // status; read it with exited / exit_status / signaled / term_signal.
    // With WNOHANG and no child ready, returns 0 for the pid, so the status
    // is meaningless — use Child.try_wait for that case.
    public function wait_pid(target: i32, options: i32) i32, IError {
      var status: i32 = 0;
      var got: i32 = unsafe {
        c_waitpid(
          target,
          _address_of<i32>(status),
          options
        );
      };
      if (got < 0) {
        throw Error(errno(), "failed to wait for child");
      }
      return status;
    }

    // Did the child exit normally, rather than dying from a signal?
    public function exited(status: i32) bool {
      return (status & 127) == 0;
    }

    // The code the child passed to exit(). Only meaningful when exited().
    public function exit_status(status: i32) i32 {
      return (status >> 8) & 255;
    }

    public function signaled(status: i32) bool {
      return not exited(status) and (status & 127) != 127;
    }

    // The signal that killed the child. Only meaningful when signaled().
    public function term_signal(status: i32) i32 {
      return status & 127;
    }

    // A pipe's two ends. Closing is manual: the ends usually outlive this
    // object, having been handed to a child.
    public class Pipe {
      var read_fd_: i32;
      var write_fd_: i32;

      public function init(read_fd: i32, write_fd: i32) {
        this.read_fd_ = read_fd;
        this.write_fd_ = write_fd;
      }

      public function read_fd() i32 {
        return this.read_fd_;
      }

      public function write_fd() i32 {
        return this.write_fd_;
      }

      public function close_read() void {
        if (this.read_fd_ > 0) {
          unsafe { c_close(this.read_fd_); };
          this.read_fd_ = 0;
        }
      }

      public function close_write() void {
        if (this.write_fd_ > 0) {
          unsafe { c_close(this.write_fd_); };
          this.write_fd_ = 0;
        }
      }
    }

    public function open_pipe(alloc: ref HeapAllocator) Pipe, IError {
      var fds: ContiguousBuffer<i32> = ContiguousBuffer<i32>(alloc, 2);
      fds.set_unchecked(0, 0);
      fds.set_unchecked(1, 0);
      if (unsafe { c_pipe(_ptr_as_raw<i32>(fds.rawData())); } != 0) {
        throw Error(errno(), "failed to create pipe");
      }
      var read_end: i32 = fds.get_unchecked(0);
      var write_end: i32 = fds.get_unchecked(1);
      return Pipe(read_end, write_end);
    }

    // Point `new_fd` at whatever `old_fd` refers to, closing `new_fd` first.
    public function dup_fd(old_fd: i32, new_fd: i32) void, IError {
      if (unsafe { c_dup2(old_fd, new_fd); } < 0) {
        throw Error(errno(), "failed to duplicate descriptor");
      }
    }

    // -------------------------------------------------------------------
    // Command / Child / Output
    // -------------------------------------------------------------------

    // What to do with one of a child's standard streams.
    public enum Stdio {
      Inherit,  // share this process's
      Piped,  // give the parent a pipe to it
      Null  // /dev/null
    }

    // A program and its arguments, ready to run.
    public class Command {
      var alloc: HeapAllocator;
      // "prog\0arg1\0arg2\0" in one allocation, with the offset of each
      // argument. Storing a Vec<String> instead would mean NUL-terminating
      // every element through a borrow, and the pointers would be scattered.
      var blob: String;
      var offsets: Vec<i64>;
      var stdin_mode: Stdio;
      var stdout_mode: Stdio;
      var stderr_mode: Stdio;

      public function init(allocator: ref HeapAllocator, program: static_ptr<u8>) {
        this.alloc = allocator.copy();
        this.blob = String(allocator, "");
        this.offsets = Vec<i64>(allocator, 4);
        this.stdin_mode = Stdio.Inherit;
        this.stdout_mode = Stdio.Inherit;
        this.stderr_mode = Stdio.Inherit;
        this.arg(program);
      }

      public function init(allocator: ref HeapAllocator, program: ref String) {
        this.alloc = allocator.copy();
        this.blob = String(allocator, "");
        this.offsets = Vec<i64>(allocator, 4);
        this.stdin_mode = Stdio.Inherit;
        this.stdout_mode = Stdio.Inherit;
        this.stderr_mode = Stdio.Inherit;
        this.arg(program);
      }

      // Append one argument. The program itself is argv[0].
      public function arg(value: static_ptr<u8>) void {
        this.offsets.push(this.blob.length());
        var data: raw_ptr<u8> = value.raw();
        var len: i64 = value.length();
        for (var i: i64 = 0; i < len; i = i + 1) {
          this.blob.append_char(unsafe { _load<u8>(data, i); });
        }
        this.blob.append_char(0);
      }

      public function arg(value: ref String) void {
        this.offsets.push(this.blob.length());
        for (var i: i64 = 0; i < value.length(); i = i + 1) {
          this.blob.append_char(value.at(i));
        }
        this.blob.append_char(0);
      }

      public function stdin(mode: Stdio) void {
        this.stdin_mode = mode;
      }

      public function stdout(mode: Stdio) void {
        this.stdout_mode = mode;
      }

      public function stderr(mode: Stdio) void {
        this.stderr_mode = mode;
      }

      // The program name as a C string.
      public function program() raw_ptr<u8> {
        return this.blob.c_str();
      }

      // A NUL-terminated char** for execvp. Built from one base pointer, so
      // it stays valid as long as the blob is not appended to.
      public function argv_array() ContiguousBuffer<raw_ptr<u8>> {
        var count: i64 = this.offsets.size();
        var argv: ContiguousBuffer<raw_ptr<u8>> = ContiguousBuffer<raw_ptr<u8>>(this.alloc, count + 1);
        var base: raw_ptr<u8> = this.blob.c_str();
        for (var i: i64 = 0; i < count; i = i + 1) {
          var at: i64 = this.offsets.get_unchecked(i);
          argv.set_unchecked(i, unsafe { _ptr_offset(base, at); });
        }
        argv.set_unchecked(count, null);
        return argv;
      }

      // Run the program in a new process. The child's end of every pipe is
      // closed here, so reading from Child hits end-of-file when it exits.
      public function start() Child, IError {
        // Everything the child touches is prepared first: after fork it may
        // only call things that are safe in a signal handler.
        var argv: ContiguousBuffer<raw_ptr<u8>> = this.argv_array();
        var prog: raw_ptr<u8> = unsafe { _load<raw_ptr<u8>>(argv.rawData(), 0); };

        var in_read: i32 = 0;
        var in_write: i32 = 0;
        var out_read: i32 = 0;
        var out_write: i32 = 0;
        var err_read: i32 = 0;
        var err_write: i32 = 0;
        var devnull: i32 = 0;

        if (this.stdin_mode == Stdio.Piped) {
          var p: Pipe = open_pipe(this.alloc);
          in_read = p.read_fd();
          in_write = p.write_fd();
        }
        if (this.stdout_mode == Stdio.Piped) {
          var p: Pipe = open_pipe(this.alloc);
          out_read = p.read_fd();
          out_write = p.write_fd();
        }
        if (this.stderr_mode == Stdio.Piped) {
          var p: Pipe = open_pipe(this.alloc);
          err_read = p.read_fd();
          err_write = p.write_fd();
        }
        if (this.stdin_mode == Stdio.Null or this.stdout_mode == Stdio.Null or this.stderr_mode == Stdio.Null) {
          devnull = unsafe { c_open("/dev/null", 2, 0); };
        }

        var child: i32 = unsafe { c_fork(); };
        if (child < 0) {
          throw Error(errno(), "failed to fork");
        }

        if (child == 0) {
          // In the child. Only async-signal-safe calls from here on: no
          // allocation, no String, no throw.
          unsafe {
            if (in_read > 0) {
              c_dup2(in_read, 0);
              c_close(in_read);
            }
            if (in_write > 0) {
              c_close(in_write);
            }
            if (out_write > 0) {
              c_dup2(out_write, 1);
              c_close(out_write);
            }
            if (out_read > 0) {
              c_close(out_read);
            }
            if (err_write > 0) {
              c_dup2(err_write, 2);
              c_close(err_write);
            }
            if (err_read > 0) {
              c_close(err_read);
            }
            if (devnull > 0) {
              if (this.stdin_mode == Stdio.Null) {
                c_dup2(devnull, 0);
              }
              if (this.stdout_mode == Stdio.Null) {
                c_dup2(devnull, 1);
              }
              if (this.stderr_mode == Stdio.Null) {
                c_dup2(devnull, 2);
              }
              c_close(devnull);
            }
            c_execvp(prog, argv.rawData());
            // Only reached if exec failed. 127 is what a shell reports for
            // "command not found".
            c_exit_now(127);
          };
        }

        // In the parent: the child owns its ends now.
        unsafe {
          if (in_read > 0) {
            c_close(in_read);
          }
          if (out_write > 0) {
            c_close(out_write);
          }
          if (err_write > 0) {
            c_close(err_write);
          }
          if (devnull > 0) {
            c_close(devnull);
          }
        };

        return Child(child, in_write, out_read, err_read);
      }

      // Run to completion, inheriting the streams. Returns the exit code.
      public function status() i32, IError {
        var child: Child = this.start();
        return child.wait();
      }

      // Run to completion with stdout and stderr captured.
      public function output() Output, IError {
        this.stdout_mode = Stdio.Piped;
        this.stderr_mode = Stdio.Piped;
        var child: Child = this.start();
        return child.collect(this.alloc);
      }
    }

    // A running (or finished) child process.
    public class Child {
      // 0 means "no child". Never -1: a moved-from Child is zeroed, and
      // waiting on -1 would reap somebody else's child while signalling 0
      // would hit this whole process group.
      var pid_: i32;
      var stdin_fd: i32;
      var stdout_fd: i32;
      var stderr_fd: i32;

      public function init(child_pid: i32, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) {
        this.pid_ = child_pid;
        this.stdin_fd = stdin_fd;
        this.stdout_fd = stdout_fd;
        this.stderr_fd = stderr_fd;
      }

      public function id() i32 {
        return this.pid_;
      }

      // Write to the child's stdin. Requires stdin(Stdio.Piped).
      public function write_stdin(data: ref String) i64 {
        if (this.stdin_fd <= 0) {
          return -1;
        }
        return unsafe { c_write(this.stdin_fd, data.c_str(), data.length()); };
      }

      // Close the child's stdin, so a program reading to end-of-input stops.
      public function close_stdin() void {
        if (this.stdin_fd > 0) {
          unsafe { c_close(this.stdin_fd); };
          this.stdin_fd = 0;
        }
      }

      // Wait for the child and return its exit code. A child killed by a
      // signal reports 128 + the signal, as a shell does.
      public function wait() i32, IError {
        if (this.pid_ <= 0) {
          throw Error(-1, "no child to wait for");
        }
        this.close_stdin();
        var status: i32 = wait_pid(this.pid_, 0);
        this.pid_ = 0;
        if (signaled(status)) {
          return 128 + term_signal(status);
        }
        return exit_status(status);
      }

      // The exit code if the child has already finished, None if it is still
      // running.
      public function try_wait() Option<i32>, IError {
        if (this.pid_ <= 0) {
          return Option.None;
        }
        var status: i32 = 0;
        var got: i32 = unsafe {
          c_waitpid(
            this.pid_,
            _address_of<i32>(status),
            WNOHANG
          );
        };
        if (got < 0) {
          throw Error(errno(), "failed to poll child");
        }
        if (got == 0) {
          return Option.None;
        }
        this.pid_ = 0;
        if (signaled(status)) {
          return Option.Some(128 + term_signal(status));
        }
        return Option.Some(exit_status(status));
      }

      public function kill(sig: i32) void, IError {
        if (this.pid_ <= 0) {
          throw Error(-1, "no child to signal");
        }
        if (unsafe { c_kill(this.pid_, sig); } != 0) {
          throw Error(errno(), "failed to signal child");
        }
      }

      // Hand the stdout pipe over. The Child stops owning it.
      public function take_stdout() i32 {
        var fd: i32 = this.stdout_fd;
        this.stdout_fd = 0;
        return fd;
      }

      public function take_stderr() i32 {
        var fd: i32 = this.stderr_fd;
        this.stderr_fd = 0;
        return fd;
      }

      // Drain both pipes and wait. Polls rather than draining one then the
      // other: a child that fills the stderr pipe while the parent is stuck
      // reading stdout would deadlock.
      public function collect(alloc: ref HeapAllocator) Output, IError {
        var out: String = String(alloc, "");
        var err: String = String(alloc, "");
        var buf: ContiguousBuffer<u8> = ContiguousBuffer<u8>(alloc, 4096);
        var poller: Poller = Poller(alloc);

        var out_open: bool = this.stdout_fd > 0;
        var err_open: bool = this.stderr_fd > 0;

        while (out_open or err_open) {
          poller.clear();
          if (out_open) {
            poller.add_read(this.stdout_fd);
          }
          if (err_open) {
            poller.add_read(this.stderr_fd);
          }
          poller.wait(-1);

          var slot: i64 = 0;
          if (out_open) {
            if (poller.is_readable(slot) or poller.is_hup(slot)) {
              var n: i64 = unsafe {
                c_read(
                  this.stdout_fd,
                  buf.rawData(),
                  4096
                );
              };
              if (n <= 0) {
                unsafe { c_close(this.stdout_fd); };
                this.stdout_fd = 0;
                out_open = false;
              } else {
                for (var i: i64 = 0; i < n; i = i + 1) {
                  out.append_char(buf.get_unchecked(i));
                }
              }
            }
            slot = slot + 1;
          }
          if (err_open) {
            if (poller.is_readable(slot) or poller.is_hup(slot)) {
              var n: i64 = unsafe {
                c_read(
                  this.stderr_fd,
                  buf.rawData(),
                  4096
                );
              };
              if (n <= 0) {
                unsafe { c_close(this.stderr_fd); };
                this.stderr_fd = 0;
                err_open = false;
              } else {
                for (var i: i64 = 0; i < n; i = i + 1) {
                  err.append_char(buf.get_unchecked(i));
                }
              }
            }
          }
        }

        var code: i32 = this.wait();
        return Output(code, out, err);
      }

      // Releases the pipes this Child still holds. It never waits and never
      // signals: a moved-from Child is all zeroes, and reaping or killing on
      // that would touch a process this object no longer stands for.
      function deinit() void {
        this.close_stdin();
        if (this.stdout_fd > 0) {
          unsafe { c_close(this.stdout_fd); };
          this.stdout_fd = 0;
        }
        if (this.stderr_fd > 0) {
          unsafe { c_close(this.stderr_fd); };
          this.stderr_fd = 0;
        }
      }
    }

    // What a finished child produced.
    public class Output {
      var status_: i32;
      var out: String;
      var err: String;

      public function init(status: i32, out: String, err: String) {
        this.status_ = status;
        this.out = out;
        this.err = err;
      }

      public function status() i32 {
        return this.status_;
      }

      // Borrowed: the Output keeps them.
      public function stdout() ref String {
        return unsafe { _to_ref<String>(_address_of<String>(this.out)); };
      }

      public function stderr() ref String {
        return unsafe { _to_ref<String>(_address_of<String>(this.err)); };
      }
    }
  }  // module sun.process
}
