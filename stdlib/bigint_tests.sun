// stdlib/bigint_tests.sun - Tests for bigint.sun (BigUint).
// The bare intrinsics BigUint builds on (_mul_hi_u64/_ctlz_u64/_cttz_u64)
// are tested in tests/builtins/test_intrinsics.cpp.

using std;

public module std {
  module bigint_tests {
    // Build a BigUint from decimal text.
    function make_bigint(alloc: ref HeapAllocator, text: static_ptr<u8>) BigUint {
      var s = String(alloc, text);
      var n = BigUint(alloc);
      n.set_decimal(s);
      return n;
    }

    // True when the number renders to exactly this decimal text.
    function renders_as(alloc: ref HeapAllocator, n: ref BigUint, text: static_ptr<u8>) bool {
      var s = String(alloc, "");
      n.append_decimal(s);
      return s.equals_literal(text);
    }

    test_function factorial_and_decimal_round_trip() {
      var alloc = make_heap_allocator();
      var n = BigUint(alloc, 1);
      for (var i: u64 = 2; i <= 30; i = i + 1) {
        n.mul_small(i);
      }
      var text = String(alloc, "");
      n.append_decimal(text);
      std.test.assert(
        text.equals_literal("265252859812191058636308480000000"),
        "30! renders wrong"
      );
      std.test.assert_eq(n.bit_length(), 108);
      std.test.assert_eq(n.limb_count(), 2);
      var back = BigUint(alloc);
      std.test.assert(back.set_decimal(text), "30! text should parse");
      std.test.assert(back.equals(n), "parsed 30! differs from the original");
      var square = n.clone();
      square.mul(n);
      var sq_text = String(alloc, "");
      square.append_decimal(sq_text);
      std.test.assert(
        sq_text.equals_literal("70359079638545882374689246780656119576032161719910400000000000000"),
        "(30!)^2 renders wrong"
      );
      var bad = String(alloc, "12x");
      std.test.assert(back.set_decimal(bad) == false, "bad digits should not parse");
      std.test.assert(back.is_zero(), "a failed parse leaves zero");
      var zero = BigUint(alloc);
      var zt = String(alloc, "");
      zero.append_decimal(zt);
      std.test.assert(zt.equals_literal("0"), "zero renders as 0");
    }

    test_function multi_limb_arithmetic() {
      var alloc = make_heap_allocator();
      // a = 2^200 + 12345, b = 3^150 + 7
      var a = make_bigint(alloc, "1606938044258990275541962092341162602522202993782792835313721");
      var b = make_bigint(alloc, "369988485035126972924700782451696644186473100389722973815184405301748256");
      var sum = a.clone();
      sum.add(b);
      std.test.assert(
        renders_as(alloc, sum, "369988485036733910968959772727238606278814262992245176808967198137061977"),
        "a + b wrong"
      );
      var diff = b.clone();
      diff.sub(a);
      std.test.assert(
        renders_as(alloc, diff, "369988485033520034880441792176154682094131937787200770821401612466434535"),
        "b - a wrong"
      );
      var prod = a.clone();
      prod.mul(b);
      std.test.assert(
        renders_as(alloc, prod, "594548572540693628849860287507659082019984411858745114670193959411490296520390392243035028084963886526203367157948222586215524620576"),
        "a * b wrong"
      );
      prod.shr(77);
      std.test.assert(
        renders_as(alloc, prod, "3934392419413913323894585204914305526281585972813365664542781201694709080391154784167284198954246014261865110"),
        "(a * b) >> 77 wrong"
      );
      var scaled = a.clone();
      scaled.mul_pow10(40);
      std.test.assert(
        renders_as(alloc, scaled, "16069380442589902755419620923411626025222029937827928353137210000000000000000000000000000000000000000"),
        "a * 10^40 wrong"
      );
      std.test.assert_eq(a.compare(b), -1);
      std.test.assert_eq(b.compare(a), 1);
      std.test.assert_eq(a.compare(a), 0);
      // Subtracting a larger number throws
      var small = a.clone();
      var threw: bool = false;
      try {
        small.sub(b);
      } catch (e: IError) {
        threw = true;
      }
      std.test.assert(threw, "subtracting a larger number should throw");
      // 2^100 via shift, back down via shift
      var p = BigUint(alloc, 1);
      p.shl(100);
      std.test.assert(renders_as(alloc, p, "1267650600228229401496703205376"), "2^100 wrong");
      std.test.assert_eq(p.bit_length(), 101);
      p.shr(99);
      std.test.assert_eq(p.compare_u64(2), 0);
      p.shr(5);
      std.test.assert(p.is_zero(), "2 >> 5 should be zero");
      // divmod peels digits from the bottom
      var d = make_bigint(alloc, "123456789012345678901234567890");
      var rem: u32 = d.divmod_small(1000);
      std.test.assert_eq(rem, 890);
      std.test.assert(renders_as(alloc, d, "123456789012345678901234567"), "divmod quotient wrong");
      d.mul_small(1000);
      d.add_small(890);
      std.test.assert(renders_as(alloc, d, "123456789012345678901234567890"), "divmod round trip wrong");
      // Carries across a limb boundary
      var c = BigUint(alloc, 0 - _convert<u64>(1));
      c.add_small(1);
      std.test.assert_eq(c.limb_count(), 2);
      std.test.assert_eq(c.limb(0), 0);
      std.test.assert_eq(c.limb(1), 1);
      var fits: bool = match c.to_u64() {
        Option.Some(v) => true,
        Option.None => false
      };
      std.test.assert(fits == false, "2^64 does not fit a u64");
      c.set_u64(7);
      var v: u64 = match c.to_u64() {
        Option.Some(x) => x,
        Option.None => 0
      };
      std.test.assert_eq(v, 7);
    }
  }  // module bigint_tests
}  // module std
