// stdlib/option_tests.sun - Tests for option.sun (Option/Result) and the
// stdlib APIs that signal absence through them.
// Replaces the C++ suite Stdlib_Option.

using std;

public module std {
  module option_tests {
    // Classifies an i32 for the Result tests: negative values are an error.
    function parse_positive(x: i32) Result<i32, i32> {
      if (x < 0) {
        return Result.Err(-1);
      }
      return Result.Ok(x);
    }

    test_function OptionFromStdlib() {
      var a = Option.Some(40);
      var b: Option<i32> = Option.None;
      var av = match a {
        Option.Some(v) => v,
        Option.None => 0
      };
      var bv = match b {
        Option.Some(v) => v,
        Option.None => 2
      };
      std.test.assert_eq(av + bv, 42);
    }

    test_function ResultFromStdlib() {
      var good = parse_positive(41);
      var bad = parse_positive(-5);
      var g = match good {
        Result.Ok(v) => v,
        Result.Err(e) => 0
      };
      var b = match bad {
        Result.Ok(v) => 0,
        Result.Err(e) => 1
      };
      std.test.assert_eq(g + b, 42);
    }

    // find() borrows the stored value: the map still owns it
    test_function MapFind() {
      var allocator = make_heap_allocator();
      var m = Map<i64, i32>(allocator, 16);
      m.insert(1, 40);
      var hit = match m.find(1) {
        Option.Some(v) => v,
        Option.None => 0
      };
      var miss = match m.find(99) {
        Option.Some(v) => 0,
        Option.None => 2
      };
      std.test.assert_eq(hit + miss, 42);
    }

    test_function StringFindChar() {
      var allocator = make_heap_allocator();
      var s = String(allocator, "hello world");
      // first 'o' at 4
      var first = match s.find_char(111) {
        Option.Some(i) => i,
        Option.None => -1
      };
      // last 'o' at 7
      var last = match s.rfind_char(111) {
        Option.Some(i) => i,
        Option.None => -1
      };
      // no 'x'
      var missing = match s.find_char(120) {
        Option.Some(i) => i,
        Option.None => 31
      };
      std.test.assert_eq(first + last + missing, 42);  // 4 + 7 + 31
    }

    // first()/last() borrow the element: the Vec still owns it
    test_function VecFirstLast() {
      var allocator = make_heap_allocator();
      var v = Vec<i32>(allocator, 8);
      var empty = match v.first() {
        Option.Some(x) => 0,
        Option.None => 2
      };
      v.push(10);
      v.push(30);
      var f = match v.first() {
        Option.Some(x) => x,
        Option.None => 0
      };
      var l = match v.last() {
        Option.Some(x) => x,
        Option.None => 0
      };
      std.test.assert_eq(empty + f + l, 42);  // 2 + 10 + 30
    }

    // A new user specialization of a stdlib generic whose methods return Option
    test_function NewVecSpecializationWithOption() {
      var allocator = make_heap_allocator();
      var v = Vec<u32>(allocator, 4);
      v.push(42);
      var got: u32 = match v.last() {
        Option.Some(x) => x,
        Option.None => 0
      };
      std.test.assert_eq(got, 42);
    }

    // A value with one number inside, for the interface-payload test.
    interface IValue {
      method get() i32;
    }
    class Num implements IValue {
      var n: i32;
      init(v: i32) {
        this.n = v;
      }
      method get() i32 {
        return this.n;
      }
    }

    // Interface payloads: Vec<IValue>.first() yields Option<IValue>
    test_function InterfacePayloadOption() {
      var alloc = make_heap_allocator();
      var items = Vec<IValue>(alloc, 4);
      items.push(Num(42));
      var got = match items.first() {
        Option.Some(item) => item.get(),
        Option.None => 0
      };
      std.test.assert_eq(got, 42);
    }

    test_function LinkedListFirstLast() {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      var empty = match ll.first() {
        Option.Some(x) => 0,
        Option.None => 2
      };
      ll.push_back(10);
      ll.push_back(30);
      var f = match ll.first() {
        Option.Some(x) => x,
        Option.None => 0
      };
      var l = match ll.last() {
        Option.Some(x) => x,
        Option.None => 0
      };
      std.test.assert_eq(empty + f + l, 42);  // 2 + 10 + 30
    }

    test_function VecPop() {
      var allocator = make_heap_allocator();
      var v = Vec<i32>(allocator, 4);
      v.push(30);
      v.push(10);
      var a = match v.pop() {
        Option.Some(x) => x,
        Option.None => 0
      };
      var b = match v.pop() {
        Option.Some(x) => x,
        Option.None => 0
      };
      var c = match v.pop() {
        Option.Some(x) => 0,
        Option.None => 2
      };
      std.test.assert_eq(a + b + c + v.size(), 42);  // 10 + 30 + 2 + 0
    }

    // Iterators are driven by next() -> Option<T>; the sequence ends at None
    test_function IteratorNextReturnsOption() {
      var allocator = make_heap_allocator();
      var v = Vec<i32>(allocator, 4);
      v.push(20);
      v.push(22);
      var it = v.iter();
      var sum: i32 = 0;
      var going = true;
      while (going) {
        match it.next(v) {
          Option.Some(x) => {
            sum = sum + x;
          },
          Option.None => {
            going = false;
          }
        };
      }
      std.test.assert_eq(sum, 42);
      // Exhausted iterators keep returning None
      var again = match it.next(v) {
        Option.Some(x) => 0,
        Option.None => 1
      };
      std.test.assert_eq(again, 1);
    }

    // for-in over every stdlib container goes through next() -> Option<T>
    test_function ForInOverStdlibContainers() {
      var allocator = make_heap_allocator();
      var v = Vec<i32>(allocator, 4);
      v.push(1);
      v.push(2);
      var ll = LinkedList<i32>(allocator);
      ll.push_back(3);
      ll.push_back(4);
      var m = Map<i64, i32>(allocator, 8);
      m.insert(1, 5);
      m.insert(2, 6);
      var buf = ContiguousBuffer<i32>(allocator, 2);
      buf[0] = 7;
      buf[1] = 14;
      var sum: i32 = 0;
      for (var x: i32 in v) {
        sum = sum + x;
      }
      for (var x: i32 in ll) {
        sum = sum + x;
      }
      for (var x: i32 in m) {
        sum = sum + x;
      }
      for (var x: i32 in buf) {
        sum = sum + x;
      }
      std.test.assert_eq(sum, 42);  // 3 + 7 + 11 + 21
    }

    // for-in over an empty container never enters the body
    test_function ForInOverEmptyContainer() {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      var count: i32 = 42;
      for (var x: i32 in ll) {
        count = 0;
      }
      std.test.assert_eq(count, 42);
    }
  }  // module option_tests
}  // module std
