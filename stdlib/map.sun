// stdlib/map.sun - Hash map (unordered) with open addressing
//
// Map<K, V> is a generic hash map using open addressing with linear probing.
// Supports i32, i64, and String keys. Values can be any type.
// Uses HeapAllocator for memory management.
//
// Usage:
//   import "stdlib/map.sun";
//   using sun;
//   
//   var allocator = make_heap_allocator();
//   var m = Map<i64, i32>(allocator);
//   m.insert(42, 100);
//   var val = m.get(42);              // Borrows 100, throws if not found
//   var fallback = 0;
//   var val2 = m.getOrDefault(99, fallback); // Borrows the default: 99 absent
//   m.remove(42);                     // Removes and returns value
//
//   // Check existence
//   if (m.contains(42)) { ... }
//
//   // Iteration over values
//   for (var v: i32 in m) { ... }

public module sun {
  // Entry states for open addressing
  // 0 = EMPTY (never used)
  // 1 = OCCUPIED (has key-value)
  // 2 = DELETED (tombstone for linear probing)

  // ============================================================================
  // Hash Functions
  // ============================================================================

  // Simple multiplicative hash for integers
  // Uses Knuth's multiplicative method
  function hash_i64(key: i64) i64 {
    // Knuth's multiplicative constant (golden ratio based)
    // 2654435769 = floor(2^32 / phi)
    var multiplier: i64 = 2654435769;

    var hash: i64 = key * multiplier;

    // Ensure positive result
    if (hash < 0) {
      hash = 0 - hash;
    }
    return hash;
  }

  // Hash for 32-bit integers
  function hash_i32(key: i32) i64 {
    return hash_i64(key);
  }

  // Hash for String (simple polynomial rolling hash)
  function hash_string(s: const ref String) i64 {
    var hash: i64 = 0;
    var base: i64 = 31;  // Prime base
    var multiplier: i64 = 1;

    var len: i64 = s.length();
    for (var i: i64 = 0; i < len; i = i + 1) {
      var byte: i64 = s.at(i);
      hash = hash + byte * multiplier;
      multiplier = multiplier * base;
    }

    if (hash < 0) {
      hash = 0 - hash;
    }
    return hash;
  }

  // Key hashing/equality dispatched by key type. Overloads resolve per Map
  // specialization, so Map<i64, V>, Map<i32, V>, Map<u32, V> and
  // Map<String, V> each pick the matching pair. String keys are compared by
  // content through references (never copied out of the bucket).
  function map_key_hash(k: i64) i64 {
    return hash_i64(k);
  }
  function map_key_hash(k: i32) i64 {
    return hash_i64(k);
  }
  function map_key_hash(k: u32) i64 {
    return hash_i64(k);
  }
  function map_key_hash(k: u64) i64 {
    return hash_i64(_convert<i64>(k));
  }
  function map_key_hash(k: const ref String) i64 {
    return hash_string(k);
  }

  function map_keys_equal(a: const ref i64, b: i64) bool {
    return a == b;
  }
  function map_keys_equal(a: const ref i32, b: i32) bool {
    return a == b;
  }
  function map_keys_equal(a: const ref u32, b: u32) bool {
    return a == b;
  }
  function map_keys_equal(a: const ref u64, b: u64) bool {
    return a == b;
  }
  function map_keys_equal(a: const ref String, b: const ref String) bool {
    return a.equals(b);
  }

  // Modulo operation (a mod b)
  function mod(a: i64, b: i64) i64 {
    return a - (a / b) * b;
  }

  // ============================================================================
  // Map<K, V> - Generic Hash Map
  // ============================================================================

  public class Map<K, V> implements IIterable<ref V, Map<K, V>> {
    var keys: ContiguousBuffer<K>;  // Key storage
    var values: ContiguousBuffer<V>;  // Value storage  
    var states: ContiguousBuffer<i8>;  // State array: 0=empty, 1=occupied, 2=deleted
    var alloc: HeapAllocator;  // Allocator (stored via copy)
    var capacity_: i64;  // Number of buckets
    var size_: i64;  // Number of occupied entries

    // Constructor with allocator and capacity
    public function init(allocator: const ref HeapAllocator, capacity: i64) {
      this.alloc = allocator.copy();
      this.capacity_ = capacity;
      this.size_ = 0;

      // Allocate ContiguousBuffer storage - size equals capacity
      this.keys = ContiguousBuffer<K>(allocator, capacity);
      this.values = ContiguousBuffer<V>(allocator, capacity);
      this.states = ContiguousBuffer<i8>(allocator, capacity);

      // Initialize all states to EMPTY (0)
      this.states.fill(0);
    }

    // Destructor - drop live keys/values (buffer memory itself is freed by
    // the ContiguousBuffer/Unique field recursion)
    function deinit() void {
      for (var i: i64 = 0; i < this.capacity_; i = i + 1) {
        if (this.states.get_unchecked(i) == 1) {
          this.drop_key(i);
          this.drop_value(i);
        }
      }
    }

    // Drop the key stored at bucket probe (no-op for non-owning key types)
    function drop_key(probe: i64) void {
      unsafe { _deinit<K>(_ptr_offset(this.keys.rawData(), probe * _sizeof<K>())); };
    }

    // Drop the value stored at bucket probe (no-op for non-owning value types)
    function drop_value(probe: i64) void {
      unsafe { _deinit<V>(_ptr_offset(this.values.rawData(), probe * _sizeof<V>())); };
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    // Insert or update a key-value pair
    public function insert(key: K, value: V) void {
      // Check load factor and grow if needed (> 70%)
      var threshold: i64 = (this.capacity_ * 7) / 10;
      if (this.size_ >= threshold) {
        this.grow();
      }

      var hash: i64 = map_key_hash(key);
      var start: i64 = mod(hash, this.capacity_);
      var first_deleted: i64 = -1;

      // Linear probing
      for (var i: i64 = 0; i < this.capacity_; i = i + 1) {
        var probe: i64 = mod(start + i, this.capacity_);
        var state: i8 = this.states.get(probe);

        if (state == 0) {
          // EMPTY slot - insert here (or at first deleted if found)
          if (first_deleted >= 0) {
            probe = first_deleted;
          }
          this.keys.set(probe, key);
          this.values.set(probe, value);
          this.states.set(probe, 1);
          this.size_ = this.size_ + 1;
          return;
        }

        if (state == 2) {
          // DELETED slot - remember first one for reuse
          if (first_deleted < 0) {
            first_deleted = probe;
          }
        }

        if (state == 1) {
          // OCCUPIED - check if same key (update); the stored key is
          // borrowed in place, never copied out
          if (this.key_at_equals(probe, key)) {
            // Update value (dropping the old one); the incoming key is
            // dropped since the bucket keeps its own
            this.drop_value(probe);
            this.values.set(probe, value);
            unsafe { _deinit<K>(_address_of<K>(key)); };
            return;
          }
        }
      }

      // Should not reach here if load factor is maintained
      // But if we do, use first deleted slot
      if (first_deleted >= 0) {
        this.keys.set(first_deleted, key);
        this.values.set(first_deleted, value);
        this.states.set(first_deleted, 1);
        this.size_ = this.size_ + 1;
      }
    }

    // Borrow the value stored under key; throws if not found. The map keeps
    // ownership, so this hands back a reference — copying the value out would
    // leave two owners of anything it holds. Use remove() to move it out.
    public const function get(key: K) ref V, IError {
      var probe: i64 = this.findIndex(key);
      if (probe < 0) {
        throw NotFoundError();
      }
      return this.values.get_unchecked(probe);
    }

    // Borrow the value stored under key; None if not present
    public const function find(key: K) Option<ref V> {
      var probe: i64 = this.findIndex(key);
      if (probe < 0) {
        return Option.None;
      }
      return Option.Some(this.values.get_unchecked(probe));
    }

    // Borrow the value stored under key, or the caller's default when absent
    public const function getOrDefault(key: K, default_value: ref V) ref V {
      var probe: i64 = this.findIndex(key);
      if (probe < 0) {
        return default_value;
      }
      return this.values.get_unchecked(probe);
    }

    // Remove key and return its value, throws IError if not found
    public function remove(key: K) V, IError {
      var probe: i64 = this.findIndex(key);
      if (probe < 0) {
        throw NotFoundError();
      }

      var value: V = this.values.take_unchecked(probe);
      this.drop_key(probe);  // Value moved out; the key is dropped here
      this.states.set(probe, 2);  // Mark as DELETED
      this.size_ = this.size_ - 1;
      return value;
    }

    // Check if key exists
    public const function contains(key: K) bool {
      return this.findIndex(key) >= 0;
    }

    // Get number of elements
    public const function size() i64 {
      return this.size_;
    }

    // Get bucket count
    public const function capacity() i64 {
      return this.capacity_;
    }

    // Check if map is empty
    public const function isEmpty() bool {
      return this.size_ == 0;
    }

    // Clear all entries. Live keys/values are dropped.
    public function clear() void {
      for (var i: i64 = 0; i < this.capacity_; i = i + 1) {
        if (this.states.get_unchecked(i) == 1) {
          this.drop_key(i);
          this.drop_value(i);
        }
        this.states.set(i, 0);
      }
      this.size_ = 0;
    }

    // ========================================================================
    // Internal Methods
    // ========================================================================

    // ========================================================================
    // Bucket-level access (for serializers/iterators that must borrow keys
    // and values in place rather than copy them out)
    // ========================================================================

    // True if bucket i holds a live entry
    public const function bucket_occupied(i: i64) bool {
      return this.states.get_unchecked(i) == 1;
    }

    // Borrow the key stored in bucket i (must be occupied)
    public const function bucket_key(i: i64) ref K {
      return unsafe { _to_ref<K>(_ptr_as_raw<K>(_ptr_offset(this.keys.rawData(), i * _sizeof<K>()))); };
    }

    // Borrow the value stored in bucket i (must be occupied)
    public const function bucket_value(i: i64) ref V {
      return unsafe { _to_ref<V>(_ptr_as_raw<V>(_ptr_offset(this.values.rawData(), i * _sizeof<V>()))); };
    }

    // Compare the key stored in bucket probe against `key` in place
    const function key_at_equals(probe: i64, key: const ref K) bool {
      var slot: raw_ptr<K> = unsafe { _ptr_as_raw<K>(_ptr_offset(this.keys.rawData(), probe * _sizeof<K>())); };
      return unsafe { map_keys_equal(_to_ref<K>(slot), key); };
    }

    // Find index of key, returns -1 if not found. The key is borrowed for
    // the comparisons and dropped when this call ends (String keys own their
    // buffer; the bucket keeps its own copy).
    const function findIndex(key: K) i64 {
      var hash: i64 = map_key_hash(key);
      var start: i64 = mod(hash, this.capacity_);

      for (var i: i64 = 0; i < this.capacity_; i = i + 1) {
        var probe: i64 = mod(start + i, this.capacity_);
        var state: i8 = this.states.get(probe);

        if (state == 0) {
          // EMPTY - key not in map
          return -1;
        }

        if (state == 1) {
          // OCCUPIED - check key (borrowed in place)
          if (this.key_at_equals(probe, key)) {
            return probe;
          }
        }
        // state == 2 (DELETED) - continue probing
      }

      return -1;
    }

    // Grow capacity and rehash all entries
    function grow() void {
      // Move old buffers out of this (move semantics: old_* now owns the data,
      // this.keys/values/states are zeroed to prevent double-free)
      var old_keys = this.keys;
      var old_values = this.values;
      var old_states = this.states;
      var old_capacity = this.capacity_;

      // Double capacity
      var new_capacity: i64 = old_capacity * 2;
      this.capacity_ = new_capacity;

      // Allocate new ContiguousBuffer storage
      this.keys = ContiguousBuffer<K>(this.alloc, new_capacity);
      this.values = ContiguousBuffer<V>(this.alloc, new_capacity);
      this.states = ContiguousBuffer<i8>(this.alloc, new_capacity);

      // Initialize new states to EMPTY
      this.states.fill(0);

      // Rehash occupied entries from old buffers
      this.size_ = 0;

      for (var i: i64 = 0; i < old_capacity; i = i + 1) {
        var state: i8 = old_states.get(i);
        if (state == 1) {
          // OCCUPIED - rehash into new table
          var key: K = old_keys.take_unchecked(i);
          var value: V = old_values.take_unchecked(i);
          this.insert(key, value);
        }
      }

      // old_* go out of scope - their destructor frees the old memory
    }

    // ========================================================================
    // Iteration Support
    // ========================================================================

    // Return iterator over values
    public const function iter() MapIterator<K, V> {
      return MapIterator<K, V>();
    }
  }

  // ============================================================================
  // MapIterator<K, V> - Iterator over map values
  // ============================================================================

  public class MapIterator<K, V> implements IIterator<ref V, Map<K, V>> {
    var current: i64;

    public function init() {
      this.current = 0;
    }

    // Value in the next occupied slot, or None once the map is exhausted
    // Values are borrowed: the map still owns them.
    public function next(map: ref Map<K, V>) Option<ref V> {
      var capacity: i64 = map.capacity();
      while (this.current < capacity) {
        var state: i8 = map.states.get_unchecked(this.current);
        if (state == 1) {
          var index: i64 = this.current;
          this.current = this.current + 1;
          return Option.Some(map.values.get_unchecked(index));
        }
        this.current = this.current + 1;
      }
      return Option.None;
    }
  }

  // ============================================================================
  // Precompiled Specializations
  // ============================================================================

  // Map specializations - must be declared before MapIterator since MapIterator<K, V> references Map<K, V>
  // (only i64 keys supported - hash_i64 requires i64)
  public declare Map_i64_i32 = Map<i64, i32>;
  public declare Map_i64_i64 = Map<i64, i64>;

  // MapIterator specializations
  public declare MapIterator_i64_i32 = MapIterator<i64, i32>;
  public declare MapIterator_i64_i64 = MapIterator<i64, i64>;
}  // module sun
