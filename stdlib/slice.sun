// stdlib/slice.sun - SliceRange type for indexing/slicing syntax
//
// SliceRange represents a single dimension's slice bounds.
// Used by __slice__ methods to receive parsed slice syntax like M[a:b, :, 1:].
//
// The compiler translates slice syntax to SliceRange values:
//   a:b  -> SliceRange(a, b, true, true)
//   a:   -> SliceRange(a, 0, true, false)
//   :b   -> SliceRange(0, b, false, true)
//   :    -> SliceRange(0, 0, false, false)
//
// When has_start=false, start should be treated as 0 (beginning of dimension).
// When has_end=false, end should be treated as dimension size (end of dimension).

public module sun {
  public class SliceRange {
    public var start: i64;  // Start index (ignored if has_start=false)
    public var end: i64;  // End index, exclusive (ignored if has_end=false)
    public var has_start: bool;  // true if explicit start was provided
    public var has_end: bool;  // true if explicit end was provided

    // Build a range from all four fields. The compiler emits this shape
    // directly, so the field order here is part of the slicing ABI.
    init(start_: i64, end_: i64, has_start_: bool, has_end_: bool) {
      this.start = start_;
      this.end = end_;
      this.has_start = has_start_;
      this.has_end = has_end_;
    }

    // Return the index this range starts at, or 0 when the slice left the
    // start blank.
    public const function get_start() i64 {
      if (this.has_start) {
        return this.start;
      }
      return 0;
    }

    // Return the index this range stops before, or the dimension's size when
    // the slice left the end blank.
    public const function get_end(dim_size: i64) i64 {
      if (this.has_end) {
        return this.end;
      }
      return dim_size;
    }

    // Report whether this range covers a whole dimension, as a bare ':' does.
    public const function is_full_range() bool {
      if (this.has_start) {
        return false;
      }
      if (this.has_end) {
        return false;
      }
      return true;
    }

    // Return how many elements this range selects out of a dimension of the
    // given size.
    public const function compute_size(dim_size: i64) i64 {
      var s: i64 = this.get_start();
      var e: i64 = this.get_end(dim_size);
      return e - s;
    }
  }

  // Build the range written ':' — every element of the dimension.
  public function create_full_range() SliceRange {
    var zero: i64 = 0;
    return SliceRange(zero, zero, false, false);
  }

  // Build the range written 'start:end', with both ends given.
  public function create_range(start: i64, end: i64) SliceRange {
    return SliceRange(start, end, true, true);
  }

  // Build the range written 'start:' — from an index to the end of the
  // dimension.
  public function create_range_from(start: i64) SliceRange {
    var zero: i64 = 0;
    return SliceRange(start, zero, true, false);
  }

  // Build the range written ':end' — from the start of the dimension up to an
  // index.
  public function create_range_to(end: i64) SliceRange {
    var zero: i64 = 0;
    return SliceRange(zero, end, false, true);
  }
}  // module sun
