// stdlib/linked_list_tests.sun - Tests for linked_list.sun.
// Replaces the C++ suite(s) Stdlib_Collections_LinkedList.
// The two DISABLED memory-safety UB demonstrations stay in
// tests/stdlib/collections/test_linked_list.cpp.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /** Groups tests for the linked list library behavior. */
  module linked_list_tests {
    /** Combines assertion failures with errors from borrowed reads. */
    enum TestError { Assertion(std.test.AssertionError), Read(NotFoundError) }

    /**
     * A 2-D point used by the class-element tests.
     */
    class Point {
      var x: i32;
      var y: i32;

      /** Initializes the fixture fields used by this example or regression test. */
      init(x_: i32, y_: i32) {
        this.x = x_;
        this.y = y_;
      }

      /**
       * The sum of both coordinates.
       */
      method sum() i32 {
        return this.x + this.y;
      }
    }

    /**
     * A pair of factors used by the class-element tests.
     */
    class Pair {
      var a: i32;
      var b: i32;

      /** Initializes the fixture fields used by this example or regression test. */
      init(a_: i32, b_: i32) {
        this.a = a_;
        this.b = b_;
      }

      /**
       * The product of both factors.
       */
      method product() i32 {
        return this.a * this.b;
      }
    }

    /**
     * A wrapped weight value used by the class-element iteration test.
     */
    class Weight {
      var value: i32;

      /** Initializes the fixture fields used by this example or regression test. */
      init(v: i32) {
        this.value = v;
      }

      /**
       * The wrapped value.
       */
      method get_value() i32 {
        return this.value;
      }
    }

    /** Checks empty list. */
    test_function empty_list() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      try std.test.assert(ll.is_empty());
      try std.test.assert_eq(ll.size(), 0);
    }

    /** Checks push back. */
    test_function push_back() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(10);
      ll.push_back(20);
      ll.push_back(30);
      var f = match ll.first() {
        Option.Some(x) => x,
        Option.None => -1
      };
      var l = match ll.last() {
        Option.Some(x) => x,
        Option.None => -1
      };
      try std.test.assert_eq(f, 10);
      try std.test.assert_eq(l, 30);
      try std.test.assert_eq(ll.size(), 3);
    }

    /** Checks push front. */
    test_function push_front() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_front(3);
      ll.push_front(2);
      ll.push_front(1);
      // List: 1 -> 2 -> 3
      var f = match ll.first() {
        Option.Some(x) => x,
        Option.None => -1
      };
      var l = match ll.last() {
        Option.Some(x) => x,
        Option.None => -1
      };
      try std.test.assert_eq(f, 1);
      try std.test.assert_eq(l, 3);
    }

    /** Checks pop front. */
    test_function pop_front() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(10);
      ll.push_back(20);
      ll.push_back(30);
      try std.test.assert_eq(try std.test.expect_pop(ll.pop_front()), 10);
      try std.test.assert_eq(ll.size(), 2);
    }

    /** Checks pop back. */
    test_function pop_back() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(10);
      ll.push_back(20);
      ll.push_back(30);
      try std.test.assert_eq(try std.test.expect_pop(ll.pop_back()), 30);
      try std.test.assert_eq(ll.size(), 2);
    }

    /** Checks pop empty throws. */
    test_function pop_empty_throws() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      match ll.pop_front() {
        PopResult.Ok(matched_value) => {
          var v: i32 = matched_value;
          try std.test.fail("expected error");
        },
        PopResult.Empty(e) => {}
      };
      match ll.pop_back() {
        PopResult.Ok(matched_value) => {
          var v: i32 = matched_value;
          try std.test.fail("expected error");
        },
        PopResult.Empty(e) => {}
      };
    }

    /** Checks drain list. */
    test_function drain_list() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(1);
      ll.push_back(2);
      ll.push_back(3);
      var sum: i32 = 0;
      sum = sum + (try std.test.expect_pop(ll.pop_front()));
      sum = sum + (try std.test.expect_pop(ll.pop_back()));
      sum = sum + (try std.test.expect_pop(ll.pop_front()));
      try std.test.assert_eq(sum, 6);
      try std.test.assert(ll.is_empty());
    }

    /** Checks get and set. */
    test_function get_and_set() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(10);
      ll.push_back(20);
      ll.push_back(30);
      ll.push_back(40);
      // Annotating i32 copies the scalar out instead of holding a borrow of
      // the list, so the later borrows and set() are legal
      var first: i32 = try std.test.expect_lookup_value(ll.get(0));
      var last: i32 = try std.test.expect_lookup_value(ll.get(3));
      try std.test.expect_lookup_success(ll.set(1, 99));
      var modified: i32 = try std.test.expect_lookup_value(ll.get(1));
      try std.test.assert_eq(first + last + modified, 149);
    }

    /** Checks get out of bounds. */
    test_function get_out_of_bounds() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(10);
      match ll.get(5) {
        LookupResult.Ok(matched_value) => {
          var v: i32 = matched_value;
          try std.test.fail("expected error");
        },
        LookupResult.NotFound(e) => {}
      };
    }

    /** Checks remove nodes. */
    test_function remove_nodes() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(10);
      ll.push_back(20);
      ll.push_back(30);
      ll.push_back(40);
      ll.push_back(50);
      var mid = try std.test.expect_lookup(ll.remove(2));
      var first = try std.test.expect_lookup(ll.remove(0));
      var last = try std.test.expect_lookup(ll.remove(2));
      // Remaining: 20 -> 40
      try std.test.assert_eq(mid, 30);
      try std.test.assert_eq(first, 10);
      try std.test.assert_eq(last, 50);
      try std.test.assert_eq(ll.size(), 2);
    }

    /** Checks clear and reuse. */
    test_function clear_and_reuse() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(10);
      ll.push_back(20);
      ll.push_back(30);
      ll.clear();
      ll.push_back(99);
      var f = match ll.first() {
        Option.Some(x) => x,
        Option.None => -1
      };
      try std.test.assert_eq(f, 99);
      try std.test.assert_eq(ll.size(), 1);
    }

    /** Checks for in iteration. */
    test_function for_in_iteration() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(1);
      ll.push_back(2);
      ll.push_back(4);
      ll.push_back(8);
      // Positional weighted sum to verify order
      var result: i32 = 0;
      var multiplier: i32 = 1;
      for (var v: i32 in ll) {
        result = result + v * multiplier;
        multiplier = multiplier * 10;
      }
      // 1*1 + 2*10 + 4*100 + 8*1000 = 8421
      try std.test.assert_eq(result, 8421);
    }

    /** Checks iterate empty. */
    test_function iterate_empty() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      var sum: i32 = 0;
      for (var v: i32 in ll) {
        sum = sum + v;
      }
      try std.test.assert_eq(sum, 0);
    }

    /** Checks mixed push front back. */
    test_function mixed_push_front_back() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i32>(allocator);
      ll.push_back(2);
      ll.push_front(1);
      ll.push_back(3);
      ll.push_front(0);
      // List: 0 -> 1 -> 2 -> 3
      var sum: i32 = 0;
      for (var v: i32 in ll) {
        sum = sum + v;
      }
      try std.test.assert_eq(sum, 6);
      try std.test.assert_eq(ll.size(), 4);
    }

    /** Checks i64 type. */
    test_function i64_type() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var ll = LinkedList<i64>(allocator);
      ll.push_back(100);
      ll.push_back(200);
      ll.push_back(300);
      var sum: i64 = (try std.test.expect_pop(ll.pop_front())) + (try std.test.expect_pop(ll.pop_back()));
      try std.test.assert_eq(sum, 400);
    }

    /** Checks list of class objects. */
    test_function list_of_class_objects() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var list = LinkedList<Point>(allocator);
      list.push_back(Point(1, 2));
      list.push_back(Point(3, 4));
      list.push_back(Point(5, 6));
      // Access via get. Each borrow is used within its own statement -
      // binding all three at once would hold three borrows of the list
      try std.test.assert_eq((try list.get(0)).sum(), 3);
      try std.test.assert_eq((try list.get(1)).sum(), 7);
      try std.test.assert_eq((try list.get(2)).sum(), 11);
    }

    /** Checks class objects push front pop. */
    test_function class_objects_push_front_pop() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var list = LinkedList<Pair>(allocator);
      list.push_back(Pair(2, 3));
      list.push_back(Pair(4, 5));
      list.push_front(Pair(1, 10));
      // List: (1,10) -> (2,3) -> (4,5)
      var front = try std.test.expect_pop(list.pop_front());
      var back = try std.test.expect_pop(list.pop_back());
      try std.test.assert_eq(front.product() + back.product(), 30);
    }

    /** Checks iterate class objects. */
    test_function iterate_class_objects() _Result<void, std.linked_list_tests.TestError> {
      var allocator = make_heap_allocator();
      var list = LinkedList<Weight>(allocator);
      list.push_back(Weight(10));
      list.push_back(Weight(20));
      list.push_back(Weight(30));
      list.push_back(Weight(40));
      var sum: i32 = 0;
      for (var w: Weight in list) {
        sum = sum + w.get_value();
      }
      try std.test.assert_eq(sum, 100);
    }
  }  // module linked_list_tests
}  // module std
