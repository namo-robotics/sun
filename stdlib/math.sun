// math.sun - Generic math utility functions and numeric limits
public module std {
  // Numeric limits
  public var I64_MAX: i64 = 9223372036854775807;
  public var I64_MIN: i64 = -9223372036854775807 - 1;
  public var F64_MAX: f64 = 1.7976931348623157e308;
  public var F64_MIN_POSITIVE: f64 = 2.2250738585072014e-308;  // smallest normal
  public var F64_EPSILON: f64 = 2.220446049250313e-16;

  // Return whichever of the two values is smaller.
  public function compute_min<T>(a: T, b: T) T {
    if (a < b) {
      return a;
    }
    return b;
  }

  // Return whichever of the two values is larger.
  public function compute_max<T>(a: T, b: T) T {
    if (a > b) {
      return a;
    }
    return b;
  }

  // Return the value with its sign removed. T must support comparison and
  // negation.
  public function compute_abs<T>(x: T) T {
    if (x < 0) {
      return 0 - x;
    }
    return x;
  }

  // Pull a value into the range lo..hi, returning lo or hi when it falls
  // outside.
  public function clamp<T>(x: T, lo: T, hi: T) T {
    if (x < lo) {
      return lo;
    }
    if (x > hi) {
      return hi;
    }
    return x;
  }

  // Return -1 for a negative value, 1 for a positive one, and 0 for zero.
  public function compute_sign<T>(x: T) i32 {
    if (x < 0) {
      return -1;
    }
    if (x > 0) {
      return 1;
    }
    return 0;
  }

  // Report whether a value sits between lo and hi, counting both ends.
  public function is_in_range<T>(x: T, lo: T, hi: T) bool {
    return x >= lo and x <= hi;
  }

  // Return 2 raised to `bits` as an f64. Powers of two are exact in binary
  // floating point, so the result is never rounded.
  function compute_power_of_two(bits: i64) f64 {
    var r: f64 = 1.0;
    var i: i64 = 0;
    while (i < bits) {
      r = r * 2.0;
      i = i + 1;
    }
    return r;
  }

  // Convert a number to another numeric type, checking that the value fits.
  // Throws ConversionError for an integer outside T's range, a float that is
  // NaN or outside T's range, and an f64 too large for f32. A fraction is
  // dropped (truncated toward zero), as _convert does.
  //
  //   var t: i32 = safe_convert<i32>(ms);   // ms: i64
  public function safe_convert<T, U>(x: U) T throws IError {
    var zero: T = _convert<T>(0);
    if (_is<_Integer>(x) and _is<_Integer>(zero)) {
      var y: T = _convert<T>(x);
      // Dropped bits change the value; a flipped sign does not, so check both
      if (_convert<U>(y) != x) {
        throw ConversionError();
      }
      if (_is<_Signed>(x) and _is<_Unsigned>(y) and x < _convert<U>(0)) {
        throw ConversionError();
      }
      if (_is<_Unsigned>(x) and _is<_Signed>(y) and y < zero) {
        throw ConversionError();
      }
      return y;
    }
    if (_is<_Float>(x) and _is<_Integer>(zero)) {
      var f: f64 = _convert<f64>(x);
      if (f != f) {
        throw ConversionError();  // NaN
      }
      var bits: i64 = _sizeof<T>() * 8;
      var lo: f64 = 0.0;
      var hi: f64 = compute_power_of_two(bits);
      if (_is<_Signed>(zero)) {
        hi = compute_power_of_two(bits - 1);
        lo = 0.0 - hi;
      }
      if (f < lo or f >= hi) {
        throw ConversionError();
      }
      return _convert<T>(x);
    }
    if (_is<_Float>(x) and _is<_Float>(zero)) {
      // Only f64 -> f32 can lose range: a finite value that came out infinite
      var src: f64 = _convert<f64>(x);
      var dst: f64 = _convert<f64>(_convert<T>(x));
      if (src <= F64_MAX and src >= 0.0 - F64_MAX) {
        if (dst > F64_MAX or dst < 0.0 - F64_MAX) {
          throw ConversionError();
        }
      }
    }
    // Integer -> float always fits
    return _convert<T>(x);
  }
}
