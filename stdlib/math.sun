// math.sun - Generic math utility functions and numeric limits
public module sun {
  // Numeric limits
  public var I64_MAX: i64 = 9223372036854775807;
  public var I64_MIN: i64 = -9223372036854775807 - 1;
  public var F64_MAX: f64 = 1.7976931348623157e308;
  public var F64_MIN_POSITIVE: f64 = 2.2250738585072014e-308;  // smallest normal
  public var F64_EPSILON: f64 = 2.220446049250313e-16;

  // Return the minimum of two values
  public function min<T>(a: T, b: T) T {
    if (a < b) {
      return a;
    }
    return b;
  }

  // Return the maximum of two values
  public function max<T>(a: T, b: T) T {
    if (a > b) {
      return a;
    }
    return b;
  }

  // Return the absolute value (requires T supports comparison and negation)
  public function abs<T>(x: T) T {
    if (x < 0) {
      return 0 - x;
    }
    return x;
  }

  // Clamp a value between a minimum and maximum
  public function clamp<T>(x: T, lo: T, hi: T) T {
    if (x < lo) {
      return lo;
    }
    if (x > hi) {
      return hi;
    }
    return x;
  }

  // Return the sign of a value: -1, 0, or 1
  public function sign<T>(x: T) i32 {
    if (x < 0) {
      return -1;
    }
    if (x > 0) {
      return 1;
    }
    return 0;
  }

  // Check if a value is within a range [lo, hi] (inclusive)
  public function in_range<T>(x: T, lo: T, hi: T) bool {
    if (x >= lo) {
      if (x <= hi) {
        return true;
      }
    }
    return false;
  }
}
