// stdlib/string.sun - Heap-allocated mutable String class
//
// String wraps Matrix<u8> for heap storage with automatic cleanup.
// Mutable with growth via methods. Sliceable via __slice__ returning StringView.
//
// Usage:
//   import "stdlib/allocator.sun";
//   import "stdlib/string.sun";
//   using sun;
//   
//   var allocator = make_heap_allocator();
//   var s = String(allocator, "Hello");
//   println(s.length());  // 5
//   var ch = s.at(0);         // 'H' (72)
//   s.append_char(33);        // Append '!'
//
//   // Slicing returns a view (no copy)
//   var view = s[1:4];        // "ell"
//
//   // Text manipulation edits in place where the bytes allow it; methods that
//   // build new strings (clone, substr, split) take the allocator to use.
//   s.trim();
//   s.to_lower();
//   s.replace("hello", "goodbye");
//   var words = s.split(allocator, 32);   // on ' '

public module sun {
  // Number formatting/parsing goes through c_snprintf / c_strtod in sys.sun.

  // Space, tab, newline, carriage return, vertical tab, form feed
  function ascii_is_space(ch: u8) bool {
    return ch == 32 or (ch >= 9 and ch <= 13);
  }

  // Non-owning view into a String
  // Provides read-only access to a substring without copying
  // WARNING: StringView must not outlive the parent String!
  // NOTE: Defined before String because String.__slice__ returns StringView
  public class StringView {
    var view: MatrixView<u8>;  // Underlying 1D matrix view

    // Takes the view by value: a view is a class, so it moves in rather than
    // being read out of a borrow
    public function init(mat_view: MatrixView<u8>) {
      this.view = mat_view;
    }

    // Get view length
    public function length() i64 {
      return this.view.size();
    }

    // Get byte at index (relative to view start)
    public function at(i: i64) u8 {
      var idx: array<i64, 1> = [i];
      return this.view.get(idx);
    }

    // Check if view equals a literal
    public function equals_literal(literal: static_ptr<u8>) bool {
      var srcData: raw_ptr<u8> = literal.raw();
      var srcLen: i64 = literal.length();

      var myLen: i64 = this.length();
      if (myLen != srcLen) {
        return false;
      }

      for (var i: i64 = 0; i < srcLen; i = i + 1) {
        var a: u8 = this.at(i);
        var b: u8 = unsafe { _load<u8>(srcData, i); };
        if (a != b) {
          return false;
        }
      }
      return true;
    }
  }

  // Heap-allocated mutable string backed by ContiguousBuffer<u8>
  public class String {
    var data: ContiguousBuffer<u8>;  // Byte storage (owns ptr, auto-freed)
    var capacity_: i64;  // Allocated capacity
    var len: i64;  // Current string length

    // Construct from string literal
    // Copies bytes from static_ptr<u8> (fat pointer) to heap
    public function init(alloc: ref HeapAllocator, literal: static_ptr<u8>) {
      // Extract data pointer and length from fat pointer struct
      var srcData: raw_ptr<u8> = literal.raw();
      var srcLen: i64 = literal.length();

      // Allocate with some extra capacity for growth
      var capacity: i64 = srcLen + 16;
      this.data = ContiguousBuffer<u8>(alloc, capacity);
      this.capacity_ = capacity;
      this.len = srcLen;

      // Copy bytes from literal to heap
      for (var i: i64 = 0; i < srcLen; i = i + 1) {
        var byte: u8 = unsafe { _load<u8>(srcData, i); };
        this.data.set_unchecked(i, byte);
      }
    }

    // Construct from a string literal without naming an allocator.
    // HeapAllocator is stateless, so a fresh one serves; the buffer keeps its
    // own copy and frees itself through it as usual.
    public function init(literal: static_ptr<u8>) {
      var alloc: HeapAllocator = HeapAllocator();
      var srcData: raw_ptr<u8> = literal.raw();
      var srcLen: i64 = literal.length();

      var capacity: i64 = srcLen + 16;
      this.data = ContiguousBuffer<u8>(alloc, capacity);
      this.capacity_ = capacity;
      this.len = srcLen;

      for (var i: i64 = 0; i < srcLen; i = i + 1) {
        var byte: u8 = unsafe { _load<u8>(srcData, i); };
        this.data.set_unchecked(i, byte);
      }
    }

    // Construct from ContiguousBuffer with specified length
    // Copies `length` bytes from buffer to a new heap-allocated string
    // Throws IndexOutOfBoundsError if length > buffer.size()
    public function init(allocator: ref HeapAllocator, buffer: ref ContiguousBuffer<u8>, length: i64) void, IError {
      if (length > buffer.size()) {
        throw IndexOutOfBoundsError(length);
      }

      var capacity: i64 = length + 16;
      this.data = ContiguousBuffer<u8>(allocator, capacity);
      this.capacity_ = capacity;
      this.len = length;

      // Simple byte-by-byte copy (safer for debugging)
      for (var i: i64 = 0; i < length; i = i + 1) {
        var byte: u8 = buffer.get_unchecked(i);
        this.data.set_unchecked(i, byte);
      }
    }

    // Get current string length
    public function length() i64 {
      return this.len;
    }

    // Get allocated capacity
    public function capacity() i64 {
      return this.capacity_;
    }

    // Check if the string has no bytes
    public function isEmpty() bool {
      return this.len == 0;
    }

    // Get byte at index (no bounds checking)
    public function at(i: i64) u8 {
      return this.data.get_unchecked(i);
    }

    // Set byte at index (no bounds checking, must be within len)
    public function set_at(i: i64, val: u8) void {
      this.data.set_unchecked(i, val);
    }

    // Ensure capacity for at least n bytes (doesn't change len)
    public function reserve(n: i64) void {
      if (n > this.capacity_) {
        this.data.resize_to(n);
        this.capacity_ = n;
      }
    }

    // Double capacity
    function grow() void {
      var new_capacity: i64 = this.capacity_ * 2;
      this.data.resize_to(new_capacity);
      this.capacity_ = new_capacity;
    }

    // Ensure we can add n more bytes
    function ensure_capacity(additional: i64) void {
      var needed: i64 = this.len + additional;
      if (needed > this.capacity_) {
        // Double until we have enough
        var new_capacity: i64 = this.capacity_;
        while (new_capacity < needed) {
          new_capacity = new_capacity * 2;
        }
        this.data.resize_to(new_capacity);
        this.capacity_ = new_capacity;
      }
    }

    // NUL-terminate in spare capacity and hand back a pointer to the bytes,
    // for passing a runtime path or argument to C. The terminator sits past
    // the length, so the string itself is unchanged. The pointer is only good
    // until the next mutation.
    public function c_str() raw_ptr<u8> {
      this.ensure_capacity(1);
      this.data.set_unchecked(this.len, 0);
      return this.data.rawData();
    }

    // Append a single byte/character
    public function append_char(ch: u8) void {
      this.ensure_capacity(1);
      this.data.set_unchecked(this.len, ch);
      this.len = this.len + 1;
    }

    // Append another string
    public function append(other: ref String) void {
      var otherLen: i64 = other.length();
      this.ensure_capacity(otherLen);
      for (var i: i64 = 0; i < otherLen; i = i + 1) {
        var ch: u8 = other.at(i);
        this.data.set_unchecked(this.len, ch);
        this.len = this.len + 1;
      }
    }

    // ========================================================================
    // Overloaded append() for String Interpolation
    // These enable `${expr}` interpolation via overload resolution
    // ========================================================================

    // Append string literal (overload for interpolation)
    public function append(literal: static_ptr<u8>) void {
      this.append_literal(literal);
    }

    // Append signed 64-bit integer (overload for interpolation)
    public function append(val: i64) void {
      this.append_i64(val);
    }

    // Append signed 32-bit integer (overload for interpolation)
    public function append(val: i32) void {
      this.append_i64(val);
    }

    // Append unsigned 64-bit integer (overload for interpolation)  
    public function append(val: u64) void {
      this.append_u64(val);
    }

    // Append unsigned 32-bit integer (overload for interpolation)
    public function append(val: u32) void {
      this.append_u64(val);
    }

    // Append boolean (overload for interpolation)
    public function append(val: bool) void {
      this.append_bool(val);
    }

    // Append 64-bit float (overload for interpolation)
    public function append(val: f64) void {
      this.append_f64(val);
    }

    // Append 32-bit float (overload for interpolation)
    public function append(val: f32) void {
      this.append_f64(val);
    }

    // Append string literal
    public function append_literal(literal: static_ptr<u8>) void {
      var srcData: raw_ptr<u8> = literal.raw();
      var srcLen: i64 = literal.length();

      this.ensure_capacity(srcLen);
      for (var i: i64 = 0; i < srcLen; i = i + 1) {
        var byte: u8 = unsafe { _load<u8>(srcData, i); };
        this.data.set_unchecked(this.len, byte);
        this.len = this.len + 1;
      }
    }

    // Check if string equals a literal
    public function equals_literal(literal: static_ptr<u8>) bool {
      var srcData: raw_ptr<u8> = literal.raw();
      var srcLen: i64 = literal.length();

      if (this.len != srcLen) {
        return false;
      }

      for (var i: i64 = 0; i < srcLen; i = i + 1) {
        var a: u8 = this.at(i);
        var b: u8 = unsafe { _load<u8>(srcData, i); };
        if (a != b) {
          return false;
        }
      }
      return true;
    }

    // ========================================================================
    // Core Manipulation Methods
    // ========================================================================

    // Clear string (reset length to 0, keep capacity)
    public function clear() void {
      this.len = 0;
    }

    // Remove and return last byte
    public function pop() u8, IError {
      if (this.len == 0) {
        throw EmptyError();
      }
      this.len = this.len - 1;
      return this.data.get_unchecked(this.len);
    }

    // Truncate to given length (does nothing if new_len >= len)
    public function truncate(new_len: i64) void {
      if (new_len < this.len) {
        this.len = new_len;
      }
    }

    // Remove byte at index, shifting remaining bytes left
    public function remove(index: i64) u8, IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index >= this.len) {
        throw IndexOutOfBoundsError(index);
      }
      var removed: u8 = this.data.get_unchecked(index);
      // Shift remaining bytes left
      for (var i: i64 = index; i < this.len - 1; i = i + 1) {
        var next: u8 = this.data.get_unchecked(i + 1);
        this.data.set_unchecked(i, next);
      }
      this.len = this.len - 1;
      return removed;
    }

    // Insert byte at index, shifting remaining bytes right
    public function insert_char(index: i64, ch: u8) void, IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index > this.len) {
        throw IndexOutOfBoundsError(index);
      }
      this.ensure_capacity(1);
      // Shift bytes right from end
      for (var i: i64 = this.len; i > index; i = i - 1) {
        var prev: u8 = this.data.get_unchecked(i - 1);
        this.data.set_unchecked(i, prev);
      }
      this.data.set_unchecked(index, ch);
      this.len = this.len + 1;
    }

    // ========================================================================
    // Search Methods
    // ========================================================================

    // Find first occurrence of byte; None if not found
    public function find_char(ch: u8) Option<i64> {
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        if (this.data.get_unchecked(i) == ch) {
          return Option.Some(i);
        }
      }
      return Option.None;
    }

    // Find last occurrence of byte; None if not found
    public function rfind_char(ch: u8) Option<i64> {
      var i: i64 = this.len - 1;
      while (i >= 0) {
        if (this.data.get_unchecked(i) == ch) {
          return Option.Some(i);
        }
        i = i - 1;
      }
      return Option.None;
    }

    // Check if string contains byte
    public function contains_char(ch: u8) bool {
      return match this.find_char(ch) {
        Option.Some(i) => true,
        Option.None => false
      };
    }

    // Check if string starts with literal
    public function starts_with(literal: static_ptr<u8>) bool {
      var srcData: raw_ptr<u8> = literal.raw();
      var srcLen: i64 = literal.length();

      if (srcLen > this.len) {
        return false;
      }

      for (var i: i64 = 0; i < srcLen; i = i + 1) {
        var a: u8 = this.data.get_unchecked(i);
        var b: u8 = unsafe { _load<u8>(srcData, i); };
        if (a != b) {
          return false;
        }
      }
      return true;
    }

    // Check if string ends with literal
    public function ends_with(literal: static_ptr<u8>) bool {
      var srcData: raw_ptr<u8> = literal.raw();
      var srcLen: i64 = literal.length();

      if (srcLen > this.len) {
        return false;
      }

      var offset: i64 = this.len - srcLen;
      for (var i: i64 = 0; i < srcLen; i = i + 1) {
        var a: u8 = this.data.get_unchecked(offset + i);
        var b: u8 = unsafe { _load<u8>(srcData, i); };
        if (a != b) {
          return false;
        }
      }
      return true;
    }

    // Check if string starts with another string
    public function starts_with(other: ref String) bool {
      if (other.len > this.len) {
        return false;
      }
      for (var i: i64 = 0; i < other.len; i = i + 1) {
        if (this.data.get_unchecked(i) != other.data.get_unchecked(i)) {
          return false;
        }
      }
      return true;
    }

    // Check if string ends with another string
    public function ends_with(other: ref String) bool {
      if (other.len > this.len) {
        return false;
      }
      var offset: i64 = this.len - other.len;
      for (var i: i64 = 0; i < other.len; i = i + 1) {
        if (this.data.get_unchecked(offset + i) != other.data.get_unchecked(i)) {
          return false;
        }
      }
      return true;
    }

    // Helper: first index at or after `start` where `needle` occurs
    function find_bytes(needle: raw_ptr<u8>, needle_len: i64, start: i64) Option<i64> {
      if (needle_len == 0) {
        return Option.Some(start);
      }
      var last: i64 = this.len - needle_len;
      for (var i: i64 = start; i <= last; i = i + 1) {
        var matched: bool = true;
        for (var j: i64 = 0; j < needle_len; j = j + 1) {
          var b: u8 = unsafe { _load<u8>(needle, j); };
          if (this.data.get_unchecked(i + j) != b) {
            matched = false;
            break;
          }
        }
        if (matched) {
          return Option.Some(i);
        }
      }
      return Option.None;
    }

    // Find first occurrence of a literal; None if not found
    public function find(needle: static_ptr<u8>) Option<i64> {
      return this.find_bytes(needle.raw(), needle.length(), 0);
    }

    // Find first occurrence of another string; None if not found
    public function find(needle: ref String) Option<i64> {
      return this.find_bytes(needle.data.rawData(), needle.len, 0);
    }

    // Check if string contains a literal
    public function contains(needle: static_ptr<u8>) bool {
      return match this.find(needle) {
        Option.Some(i) => true,
        Option.None => false
      };
    }

    // Check if string contains another string
    public function contains(needle: ref String) bool {
      return match this.find(needle) {
        Option.Some(i) => true,
        Option.None => false
      };
    }

    // Compare with another string: -1 if less, 0 if equal, 1 if greater
    public function compare(other: ref String) i64 {
      var min_len: i64 = this.len;
      if (other.len < min_len) {
        min_len = other.len;
      }

      for (var i: i64 = 0; i < min_len; i = i + 1) {
        var a: u8 = this.data.get_unchecked(i);
        var b: u8 = other.data.get_unchecked(i);
        if (a < b) {
          return -1;
        }
        if (a > b) {
          return 1;
        }
      }

      if (this.len < other.len) {
        return -1;
      }
      if (this.len > other.len) {
        return 1;
      }
      return 0;
    }

    // Check if equal to another string
    public function equals(other: ref String) bool {
      return this.compare(other) == 0;
    }

    // ========================================================================
    // Transformation Methods
    // ========================================================================

    // Reverse string in-place
    public function reverse() void {
      if (this.len <= 1) {
        return;
      }
      var left: i64 = 0;
      var right: i64 = this.len - 1;
      while (left < right) {
        var tmp: u8 = this.data.get_unchecked(left);
        this.data.set_unchecked(left, this.data.get_unchecked(right));
        this.data.set_unchecked(right, tmp);
        left = left + 1;
        right = right - 1;
      }
    }

    // Lowercase ASCII letters in-place; other bytes are left alone
    public function to_lower() void {
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        var ch: u8 = this.data.get_unchecked(i);
        // 'A'..'Z'
        if (ch >= 65 and ch <= 90) {
          this.data.set_unchecked(i, ch + 32);
        }
      }
    }

    // Uppercase ASCII letters in-place; other bytes are left alone
    public function to_upper() void {
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        var ch: u8 = this.data.get_unchecked(i);
        // 'a'..'z'
        if (ch >= 97 and ch <= 122) {
          this.data.set_unchecked(i, ch - 32);
        }
      }
    }

    // Drop leading ASCII whitespace in-place
    public function trim_start() void {
      var start: i64 = 0;
      while (start < this.len and ascii_is_space(this.data.get_unchecked(start))) {
        start = start + 1;
      }
      if (start == 0) {
        return;
      }
      var new_len: i64 = this.len - start;
      for (var i: i64 = 0; i < new_len; i = i + 1) {
        this.data.set_unchecked(i, this.data.get_unchecked(start + i));
      }
      this.len = new_len;
    }

    // Drop trailing ASCII whitespace in-place
    public function trim_end() void {
      while (this.len > 0 and ascii_is_space(this.data.get_unchecked(this.len - 1))) {
        this.len = this.len - 1;
      }
    }

    // Drop leading and trailing ASCII whitespace in-place
    public function trim() void {
      this.trim_end();
      this.trim_start();
    }

    // Helper: replace `count` bytes at `index` with `repl_len` bytes from
    // `repl`, shifting the tail to fit
    function splice_bytes(index: i64, count: i64, repl: raw_ptr<u8>, repl_len: i64) void {
      var delta: i64 = repl_len - count;
      if (delta > 0) {
        this.ensure_capacity(delta);
        // Shift the tail right, back to front, so bytes are not overwritten
        var i: i64 = this.len - 1;
        while (i >= index + count) {
          this.data.set_unchecked(i + delta, this.data.get_unchecked(i));
          i = i - 1;
        }
      } else if (delta < 0) {
        for (var i: i64 = index + count; i < this.len; i = i + 1) {
          this.data.set_unchecked(i + delta, this.data.get_unchecked(i));
        }
      }
      for (var j: i64 = 0; j < repl_len; j = j + 1) {
        var b: u8 = unsafe { _load<u8>(repl, j); };
        this.data.set_unchecked(index + j, b);
      }
      this.len = this.len + delta;
    }

    // Helper: replace every occurrence of one byte run with another
    function replace_bytes(from: raw_ptr<u8>, from_len: i64, to: raw_ptr<u8>, to_len: i64) void {
      if (from_len == 0) {
        return;
      }
      var pos: i64 = 0;
      var searching: bool = true;
      while (searching) {
        match this.find_bytes(from, from_len, pos) {
          Option.Some(i) => {
            this.splice_bytes(i, from_len, to, to_len);
            pos = i + to_len;
          },
          Option.None => {
            searching = false;
          }
        };
      }
    }

    // Replace every occurrence of a literal with another literal, in-place
    public function replace(from: static_ptr<u8>, to: static_ptr<u8>) void {
      this.replace_bytes(
        from.raw(),
        from.length(),
        to.raw(),
        to.length()
      );
    }

    // Replace every occurrence of a string with another string, in-place
    public function replace(from: ref String, to: ref String) void {
      this.replace_bytes(from.data.rawData(), from.len, to.data.rawData(), to.len);
    }

    // ========================================================================
    // Copying Methods
    // ========================================================================

    // Copy `count` bytes starting at `start` into a new string
    function copy_range(alloc: ref HeapAllocator, start: i64, count: i64) String {
      var out: String = String(alloc, "");
      out.ensure_capacity(count);
      for (var i: i64 = 0; i < count; i = i + 1) {
        out.append_char(this.data.get_unchecked(start + i));
      }
      return out;
    }

    // Copy this string into a new one
    public function clone(alloc: ref HeapAllocator) String {
      return this.copy_range(alloc, 0, this.len);
    }

    // Copy `count` bytes starting at `start` into a new string
    // Throws IndexOutOfBoundsError if the range falls outside the string
    public function substr(alloc: ref HeapAllocator, start: i64, count: i64) String, IError {
      if (start < 0 or count < 0) {
        throw IndexOutOfBoundsError(start);
      }
      if (start + count > this.len) {
        throw IndexOutOfBoundsError(start + count);
      }
      return this.copy_range(alloc, start, count);
    }

    // Split on a separator byte into owned strings.
    // Adjacent separators produce empty pieces, so the result always holds
    // one more piece than there are separators.
    public function split(alloc: ref HeapAllocator, sep: u8) Vec<String> {
      var parts: Vec<String> = Vec<String>(alloc, 4);
      var start: i64 = 0;
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        if (this.data.get_unchecked(i) == sep) {
          parts.push(this.copy_range(alloc, start, i - start));
          start = i + 1;
        }
      }
      parts.push(this.copy_range(alloc, start, this.len - start));
      return parts;
    }

    // Split on a separator string into owned strings.
    // An empty separator yields the whole string as a single piece.
    public function split(alloc: ref HeapAllocator, sep: static_ptr<u8>) Vec<String> {
      var sep_data: raw_ptr<u8> = sep.raw();
      var sep_len: i64 = sep.length();
      var parts: Vec<String> = Vec<String>(alloc, 4);
      if (sep_len == 0) {
        parts.push(this.clone(alloc));
        return parts;
      }
      var start: i64 = 0;
      var searching: bool = true;
      while (searching) {
        match this.find_bytes(sep_data, sep_len, start) {
          Option.Some(i) => {
            parts.push(this.copy_range(alloc, start, i - start));
            start = i + sep_len;
          },
          Option.None => {
            searching = false;
          }
        };
      }
      parts.push(this.copy_range(alloc, start, this.len - start));
      return parts;
    }

    // Split on a separator byte, keeping only non-empty pieces.
    // Adjacent, leading, and trailing separators yield nothing.
    public function split_nonempty(alloc: ref HeapAllocator, sep: u8) Vec<String> {
      var parts: Vec<String> = Vec<String>(alloc, 4);
      var start: i64 = 0;
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        if (this.data.get_unchecked(i) == sep) {
          if (i > start) {
            parts.push(this.copy_range(alloc, start, i - start));
          }
          start = i + 1;
        }
      }
      if (this.len > start) {
        parts.push(this.copy_range(alloc, start, this.len - start));
      }
      return parts;
    }

    // Split on a separator string, keeping only non-empty pieces.
    // An empty separator yields the whole string, or nothing if it is empty.
    public function split_nonempty(alloc: ref HeapAllocator, sep: static_ptr<u8>) Vec<String> {
      var sep_data: raw_ptr<u8> = sep.raw();
      var sep_len: i64 = sep.length();
      var parts: Vec<String> = Vec<String>(alloc, 4);
      if (sep_len == 0) {
        if (this.len > 0) {
          parts.push(this.clone(alloc));
        }
        return parts;
      }
      var start: i64 = 0;
      var searching: bool = true;
      while (searching) {
        match this.find_bytes(sep_data, sep_len, start) {
          Option.Some(i) => {
            if (i > start) {
              parts.push(this.copy_range(alloc, start, i - start));
            }
            start = i + sep_len;
          },
          Option.None => {
            searching = false;
          }
        };
      }
      if (this.len > start) {
        parts.push(this.copy_range(alloc, start, this.len - start));
      }
      return parts;
    }

    // Split on runs of ASCII whitespace, keeping only non-empty pieces.
    // Any mix of adjacent spaces, tabs, and newlines counts as one separator.
    public function split_whitespace(alloc: ref HeapAllocator) Vec<String> {
      var parts: Vec<String> = Vec<String>(alloc, 4);
      var start: i64 = 0;
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        if (ascii_is_space(this.data.get_unchecked(i))) {
          if (i > start) {
            parts.push(this.copy_range(alloc, start, i - start));
          }
          start = i + 1;
        }
      }
      if (this.len > start) {
        parts.push(this.copy_range(alloc, start, this.len - start));
      }
      return parts;
    }

    // ========================================================================
    // Numeric Formatting
    // ========================================================================

    // Helper: append a decimal digit (0-9)
    function appendDecDigit(d: i64) void {
      var ch: u8 = match d {
        0 => 48,
        1 => 49,
        2 => 50,
        3 => 51,
        4 => 52,
        5 => 53,
        6 => 54,
        7 => 55,
        8 => 56,
        _ => 57
      };
      this.append_char(ch);
    }

    // Helper: append a hex digit (0-15)
    function appendHexDigit(d: i64) void {
      var ch: u8 = match d {
        0 => 48,
        1 => 49,
        2 => 50,
        3 => 51,
        4 => 52,
        5 => 53,
        6 => 54,
        7 => 55,
        8 => 56,
        9 => 57,
        10 => 97,
        11 => 98,
        12 => 99,
        13 => 100,
        14 => 101,
        _ => 102
      };
      this.append_char(ch);
    }

    // Append an unsigned integer in decimal
    public function append_u64(val: i64) void {
      if (val == 0) {
        this.append_char(48);  // '0'
        return;
      }

      // Write digits in reverse order, then reverse them
      var start: i64 = this.len;
      var n: i64 = val;

      while (n > 0) {
        // n % 10 without modulo operator
        var q: i64 = n / 10;
        var r: i64 = n - q * 10;
        this.appendDecDigit(r);
        n = q;
      }

      // Reverse the digits we just wrote
      var end: i64 = this.len - 1;
      while (start < end) {
        var tmp: u8 = this.data.get_unchecked(start);
        this.data.set_unchecked(start, this.data.get_unchecked(end));
        this.data.set_unchecked(end, tmp);
        start = start + 1;
        end = end - 1;
      }
    }

    // Append a signed integer in decimal
    public function append_i64(val: i64) void {
      if (val >= 0) {
        this.append_u64(val);
        return;
      }
      this.append_char(45);  // '-'
      // Handle i64 min value edge case
      if (val == I64_MIN) {
        this.append_literal("9223372036854775808");
        return;
      }
      this.append_u64(0 - val);
    }

    // Append an integer in hexadecimal (lowercase)
    public function append_hex(val: i64) void {
      if (val == 0) {
        this.append_char(48);  // '0'
        return;
      }

      var start: i64 = this.len;
      var n: i64 = val;

      while (n != 0) {
        // Get lowest 4 bits (0-15)
        var nibble: i64 = n - (n / 16) * 16;
        if (nibble < 0) {
          nibble = nibble + 16;
        }
        this.appendHexDigit(nibble);
        n = n / 16;
      }

      // Reverse the hex digits
      var end: i64 = this.len - 1;
      while (start < end) {
        var tmp: u8 = this.data.get_unchecked(start);
        this.data.set_unchecked(start, this.data.get_unchecked(end));
        this.data.set_unchecked(end, tmp);
        start = start + 1;
        end = end - 1;
      }
    }

    // Append a boolean as "true" or "false"
    public function append_bool(val: bool) void {
      if (val) {
        this.append_literal("true");
        return;
      }
      this.append_literal("false");
    }

    // Append a float using the shortest decimal form that reads back as the
    // same value ("0.1", "1e+21", "3.14"). Non-finite values print as libc
    // spells them ("inf", "-inf", "nan").
    public function append_f64(val: f64) void {
      var room: i64 = 32;
      this.ensure_capacity(room);
      var dst: raw_ptr<u8> = unsafe { _ptr_offset(this.data.rawData(), this.len); };
      var written: i32 = unsafe { c_snprintf(dst, room, "%.15g", val); };
      var back: f64 = unsafe { c_strtod(dst, null); };
      if (back != val) {
        written = unsafe { c_snprintf(dst, room, "%.16g", val); };
        back = unsafe { c_strtod(dst, null); };
        if (back != val) {
          written = unsafe { c_snprintf(dst, room, "%.17g", val); };
        }
      }
      if (written < 0) {
        return;
      }
      this.len = this.len + written;
    }

    // ========================================================================
    // Numeric Parsing
    // ========================================================================

    // Parse the whole string as a signed decimal integer ("-42"). None if the
    // text is not exactly an optional '-' followed by digits, or on overflow.
    public function parse_i64() Option<i64> {
      var i: i64 = 0;
      var negative: bool = false;
      if (this.len > 0) {
        if (this.at(0) == 45) {
          // '-'
          negative = true;
          i = 1;
        }
      }
      if (i >= this.len) {
        return Option.None;
      }
      // Accumulate as a negative number so i64 min is representable
      var acc: i64 = 0;
      var limit: i64 = I64_MIN / 10;
      while (i < this.len) {
        var ch: u8 = this.at(i);
        if (ch < 48) {
          return Option.None;
        }
        if (ch > 57) {
          return Option.None;
        }
        var digit: i64 = _convert<i64>(ch) - 48;
        if (acc < limit) {
          return Option.None;
        }
        acc = acc * 10;
        if (acc < I64_MIN + digit) {
          return Option.None;
        }
        acc = acc - digit;
        i = i + 1;
      }
      if (negative) {
        return Option.Some(acc);
      }
      if (acc == I64_MIN) {
        return Option.None;
      }
      var positive: i64 = 0 - acc;
      return Option.Some(positive);
    }

    // True if the whole string is a decimal float: optional '-', digits,
    // optional fraction, optional exponent (as JSON spells numbers, but a
    // leading '+' or extra leading zeros are also accepted).
    function is_decimal_float() bool {
      var i: i64 = 0;
      if (i < this.len) {
        var sign: u8 = this.at(i);
        if (sign == 45 or sign == 43) {
          // '-' '+'
          i = i + 1;
        }
      }
      var int_digits: i64 = 0;
      while (i < this.len and this.at(i) >= 48 and this.at(i) <= 57) {
        i = i + 1;
        int_digits = int_digits + 1;
      }
      var frac_digits: i64 = 0;
      if (i < this.len and this.at(i) == 46) {
        // '.'
        i = i + 1;
        while (i < this.len and this.at(i) >= 48 and this.at(i) <= 57) {
          i = i + 1;
          frac_digits = frac_digits + 1;
        }
      }
      if (int_digits + frac_digits == 0) {
        return false;
      }
      if (i < this.len and (this.at(i) == 101 or this.at(i) == 69)) {
        // 'e' 'E'
        i = i + 1;
        if (i < this.len and (this.at(i) == 45 or this.at(i) == 43)) {
          i = i + 1;
        }
        var exp_digits: i64 = 0;
        while (i < this.len and this.at(i) >= 48 and this.at(i) <= 57) {
          i = i + 1;
          exp_digits = exp_digits + 1;
        }
        if (exp_digits == 0) {
          return false;
        }
      }
      return i == this.len;
    }

    // Parse the whole string as a decimal float ("3.25", "-1e-9", "42").
    // None if the text is not a decimal float.
    public function parse_f64() Option<f64> {
      if (not this.is_decimal_float()) {
        return Option.None;
      }
      var value: f64 = unsafe { c_strtod(this.c_str(), null); };
      return Option.Some(value);
    }

    // ========================================================================
    // Slicing
    // ========================================================================

    // Slicing via __slice__ method: s[a:b] -> StringView
    // Returns a non-owning view into the string data
    public function __slice__(ranges: ref array<SliceRange>) StringView {
      // For strings, we only support 1D slicing
      var range: SliceRange = ranges[0];
      var start: i64 = range.getStart();
      var end: i64 = range.getEnd(this.len);

      // Build shape and strides for the view
      var new_shape: array<i64, 1> = [end - start];
      var strides: array<i64, 1> = [1];  // 1D contiguous

      // Create MatrixView from raw pointer
      var matView: MatrixView<u8> = MatrixView<u8>(this.data.rawData(), start, new_shape, strides);
      return StringView(matView);
    }
  }

  // ============================================================================
  // Precompiled Specializations
  // ============================================================================

  public declare Vec_String = Vec<String>;

  // Copy a NUL-terminated C string into an owned String.
  // A free function rather than an init overload: static_ptr<u8> matches
  // raw_ptr<u8> in overload resolution, so String(alloc, "literal") would
  // become ambiguous.
  public function from_c_str(alloc: ref HeapAllocator, s: raw_ptr<u8>) String {
    var out: String = String(alloc, "");
    if (s == null) {
      return out;
    }
    var len: i64 = unsafe { c_strlen(s); };
    out.reserve(len + 1);
    for (var i: i64 = 0; i < len; i = i + 1) {
      out.append_char(unsafe { _load<u8>(s, i); });
    }
    return out;
  }

  // Concatenate strings with a separator between them
  public function join(alloc: ref HeapAllocator, parts: ref Vec<String>, sep: static_ptr<u8>) String {
    var out: String = String(alloc, "");
    for (var i: i64 = 0; i < parts.size(); i = i + 1) {
      if (i > 0) {
        out.append_literal(sep);
      }
      out.append(parts.get_unchecked(i));
    }
    return out;
  }
}  // module sun
