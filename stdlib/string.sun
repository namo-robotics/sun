// stdlib/string.sun - Mutable strings with inline storage for short text
//
// String keeps short text inline and owns heap storage for longer text.
// Mutable with growth via methods. Sliceable via __slice__ returning StringView.
//
// Usage:
//   import "stdlib/allocator.sun";
//   import "stdlib/string.sun";
//   using std;
//   
//   var allocator = make_heap_allocator();
//   var s = String(allocator, "Hello");
//   println(s.length());  // 5
//   var ch = s.at(0);         // b'H'
//   s.append_char(b'!');
//
//   // Slicing returns a view (no copy)
//   var view = s[1:4];        // "ell"
//
//   // Text manipulation edits in place where the bytes allow it; methods that
//   // build new strings (clone, substr, split) take the allocator to use.
//   s.trim();
//   s.to_lower();
//   s.replace("hello", "goodbye");
//   var words = s.split(allocator, 32);   // on ' '

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  // Number formatting/parsing goes through c_snprintf / c_strtod in sys.sun.

  /**
   * Space, tab, newline, carriage return, vertical tab, form feed
   */
  function is_ascii_space(ch: u8) bool {
    return ch == b' ' or (ch >= b'\t' and ch <= b'\r');
  }

  // ---- UTF-8 ----------------------------------------------------------
  // The one UTF-8 codec in the stdlib; json.sun encodes through it too.

  // U+FFFD, substituted for anything that is not a Unicode scalar value so
  // that encoding never produces invalid UTF-8.
  const REPLACEMENT: i64 = 65533;

  /**
   * Pass a code point through unchanged when it is a Unicode scalar value, and
   * substitute U+FFFD when it is not. Everything that encodes goes through here,
   * so the encoder can never emit invalid UTF-8.
   */
  function resolve_utf8_scalar(code: i64) i64 {
    if (code < 0 or code > 1114111) {
      return REPLACEMENT;
    }
    if (code >= 55296 and code <= 57343) {
      return REPLACEMENT;  // surrogate
    }
    return code;
  }

  /**
   * Bytes the UTF-8 encoding of `code` occupies.
   */
  public function compute_utf8_len(code: i64) i64 {
    var c: i64 = resolve_utf8_scalar(code);
    if (c < 128) {
      return 1;
    }
    if (c < 2048) {
      return 2;
    }
    if (c < 65536) {
      return 3;
    }
    return 4;
  }

  /**
   * Bytes in the UTF-8 sequence that starts with `lead`, or 0 if `lead`
   * cannot start one.
   */
  function compute_utf8_sequence_len(lead: u8) i64 {
    if (lead < 128) {
      return 1;
    }
    if ((lead & 224) == 192) {
      return 2;
    }
    if ((lead & 240) == 224) {
      return 3;
    }
    if ((lead & 248) == 240) {
      return 4;
    }
    return 0;
  }

  /**
   * Smallest scalar value a sequence of `len` bytes may encode. Anything
   * below this is an overlong form and must be rejected.
   */
  function compute_utf8_min(len: i64) i64 {
    if (len == 2) {
      return 128;
    }
    if (len == 3) {
      return 2048;
    }
    if (len == 4) {
      return 65536;
    }
    return 0;
  }

  /**
   * Byte `j` of the UTF-8 encoding of `code`, for j < compute_utf8_len(code).
   * Every encode in the stdlib goes through this.
   */
  public function encode_utf8_byte(code: i64, j: i64) u8 {
    var c: i64 = resolve_utf8_scalar(code);
    var width: i64 = compute_utf8_len(c);
    if (j == width - 1) {
      // The last byte is the low 6 bits, plain for ASCII.
      if (width == 1) {
        return _convert<u8>(c);
      }
      return _convert<u8>(128 | (c & 63));
    }
    if (j == 0) {
      if (width == 2) {
        return _convert<u8>(192 | (c >> 6));
      }
      if (width == 3) {
        return _convert<u8>(224 | (c >> 12));
      }
      return _convert<u8>(240 | (c >> 18));
    }
    // A middle continuation byte: shift past the bytes that follow it.
    var shift: i64 = (width - 1 - j) * 6;
    return _convert<u8>(128 | ((c >> shift) & 63));
  }

  /**
   * A char from a code point, or None if it is not a Unicode scalar value.
   * The checked counterpart to _convert<char>(v).
   */
  public function char_of(code: i64) Option<char> {
    if (code < 0 or code > 1114111) {
      return Option.None;
    }
    if (code >= 55296 and code <= 57343) {
      return Option.None;
    }
    return Option.Some(_convert<char>(code));
  }

  /**
   * The code point of a char. Always defined, so it needs no Option.
   */
  public function code_of(c: char) i64 {
    return _convert<i64>(c);
  }

  /**
   * Non-owning view into a String
   * Provides read-only access to a substring without copying
   * WARNING: StringView must not outlive the parent String!
   * NOTE: Defined before String because String.__slice__ returns StringView
   * A non-owning window into a String's bytes. Every field is a plain
   * scalar, so the view references nothing but the String's own buffer —
   * it stays valid exactly as long as that String does. (A MatrixView is
   * not usable here: it keeps the shape and stride arrays it was built
   * with, and __slice__'s arrays die with its frame.)
   */
  public class StringView {
    var data: raw_ptr<u8>;  // The String's buffer (non-owning)
    var start: i64;  // First byte of the view
    var len: i64;  // Bytes in the view

    /**
     * Build a view over [start_, start_ + len_) of a String's buffer. The
     * caller keeps that String alive, unmoved, and unmodified while the view is used.
     */
    init(data_: raw_ptr<u8>, start_: i64, len_: i64) {
      this.data = data_;
      this.start = start_;
      this.len = len_;
    }

    /**
     * Get view length
     */
    public const method length() i64 {
      return this.len;
    }

    /** Read a byte, or throw when the index is outside the view. */
    public const method at(i: i64) u8 throws IError {
      if (i < 0 or i >= this.len) {
        throw IndexOutOfBoundsError(i);
      }
      return unsafe { this.unsafe_at(i); };
    }

    /** Read a byte without bounds checks. The caller must ensure 0 <= i < length(). */
    public const unsafe method unsafe_at(i: i64) u8 {
      return unsafe { _load<u8>(this.data, this.start + i); };
    }

    /**
     * Check if view equals a literal
     */
    public const method equals_literal(literal: static_ptr<u8>) bool {
      var src_data: raw_ptr<u8> = literal.raw();
      var src_len: i64 = literal.length();

      var my_len: i64 = this.length();
      if (my_len != src_len) {
        return false;
      }

      for (var i: i64 = 0; i < src_len; i = i + 1) {
        var a: u8 = unsafe { this.unsafe_at(i); };
        var b: u8 = unsafe { _load<u8>(src_data, i); };
        if (a != b) {
          return false;
        }
      }
      return true;
    }
  }

  /**
   * Decodes a String's bytes as Unicode scalar values. Malformed bytes yield
   * U+FFFD and advance one byte, so iteration always terminates and always
   * covers the whole string.
   *
   * WARNING: a Chars must not outlive the String it reads, and any mutation
   * or move of that String invalidates it.
   * NOTE: Defined before String because String.iterate_chars() returns one.
   */
  public class Chars implements IIterator<char, Chars> {
    var data: raw_ptr<u8>;
    var len: i64;
    var pos: i64 = 0;

    /**
     * Build an iterator over a byte range. The caller must keep the bytes alive
     * for as long as the iterator is used.
     */
    init(data: raw_ptr<u8>, len: i64) {
      this.data = data;
      this.len = len;
    }

    /**
     * Byte offset of the scalar value that next() will return.
     */
    public const method offset() i64 {
      return this.pos;
    }

    /**
     * The raw byte at an offset, with no bounds check.
     */
    const method byte_at(i: i64) u8 {
      return unsafe { _load<u8>(this.data, i); };
    }

    /**
     * Decode the character at the current position and step past it, or return
     * None at the end. Malformed bytes yield U+FFFD and advance one byte, so a
     * corrupt string still iterates to completion.
     */
    public method next(self: ref Chars) Option<char> {
      if (this.pos >= this.len) {
        return Option.None;
      }

      var lead: u8 = this.byte_at(this.pos);
      var width: i64 = compute_utf8_sequence_len(lead);

      // A bad lead byte, or a sequence running past the end: one U+FFFD for
      // the offending byte, then carry on from the next one.
      if (width == 0 or this.pos + width > this.len) {
        this.pos = this.pos + 1;
        return char_of(REPLACEMENT);
      }

      var code: i64 = 0;
      if (width == 1) {
        code = _convert<i64>(lead);
      } else if (width == 2) {
        code = _convert<i64>(lead & 31);
      } else if (width == 3) {
        code = _convert<i64>(lead & 15);
      } else {
        code = _convert<i64>(lead & 7);
      }

      for (var i: i64 = 1; i < width; i = i + 1) {
        var cont: u8 = this.byte_at(this.pos + i);
        if ((cont & 192) != 128) {
          // Truncated sequence: consume only the lead byte.
          this.pos = this.pos + 1;
          return char_of(REPLACEMENT);
        }
        code = (code << 6) | _convert<i64>(cont & 63);
      }

      this.pos = this.pos + width;

      // Overlong forms and surrogates are not valid UTF-8.
      if (code < compute_utf8_min(width)) {
        return char_of(REPLACEMENT);
      }
      return match char_of(code) {
        Option.Some(c) => Option.Some(c),
        Option.None => char_of(REPLACEMENT)
      };
    }
  }

  /** Stores short byte sequences inline and owns heap storage after growing.
     Inline addresses are computed when borrowed, so moving this value never
     leaves a pointer into its former location. */
  class StringStorage {
    var inline_words: array<u64, 2> = [0u64, 0u64];
    var heap: Unique<u8>;

    /** Allocate only when the requested capacity exceeds the inline buffer. */
    init(alloc: const ref HeapAllocator, size: i64) {
      this.heap = Unique<u8>(null);
      if (size > 16) {
        var allocator = alloc.copy();
        this.heap = Unique<u8>(allocator.alloc_raw(size));
      }
    }

    /** Borrow storage until the owner is moved, resized, or destroyed. */
    public const method raw_data() raw_ptr<u8> {
      if (this.heap.is_null()) {
        return unsafe { _ptr_as_raw<u8>(_address_of<u64>(this.inline_words[0])); };
      }
      return this.heap.get_raw();
    }

    /** Read an initialized byte at an index below the storage capacity. */
    public const unsafe method get_unchecked(index: i64) u8 {
      return unsafe { _load<u8>(this.raw_data(), index); };
    }

    /** Write a byte at a nonnegative index below the storage capacity. */
    public unsafe method set_unchecked(index: i64, value: u8) void {
      unsafe { _store<u8>(this.raw_data(), index, value); };
    }

    /** Allocate larger storage and preserve count initialized bytes. The caller
       supplies a larger capacity and a count within the current storage. */
    public method resize_to(size: i64, count: i64) void {
      var alloc = HeapAllocator();
      var next = Unique<u8>(alloc.alloc_raw(size));
      unsafe { _memcpy(next.get_raw(), this.raw_data(), count); };
      this.heap = next;
    }
  }

  /** Owns mutable text, keeping short strings inline and growing onto the heap.
     Moving a String invalidates pointers, views, and iterators into its bytes. */
  public class String {
    var data: StringStorage;  // Inline bytes or an owned heap allocation
    var capacity_: i64;  // Allocated capacity
    var len: i64;  // Current string length

    /**
     * Construct from string literal
     * Copies bytes from a literal into owned inline or heap storage
     */
    init(alloc: const ref HeapAllocator, literal: static_ptr<u8>) {
      // Extract data pointer and length from fat pointer struct
      var src_data: raw_ptr<u8> = literal.raw();
      var src_len: i64 = literal.length();

      // Allocate with some extra capacity for growth
      var capacity: i64 = src_len + 1;
      if (capacity < 16) {
        capacity = 16;
      }
      this.data = StringStorage(alloc, capacity);
      this.capacity_ = capacity;
      this.len = src_len;

      // Copy the literal into the owned storage.
      if (src_len > 0) {
        unsafe { _memcpy(this.data.raw_data(), src_data, src_len); };
      }
    }

    /**
     * Construct from a string literal without naming an allocator.
     * HeapAllocator is stateless; longer strings own the allocation it creates.
     */
    init(literal: static_ptr<u8>) {
      var alloc: HeapAllocator = HeapAllocator();
      var src_data: raw_ptr<u8> = literal.raw();
      var src_len: i64 = literal.length();

      var capacity: i64 = src_len + 1;
      if (capacity < 16) {
        capacity = 16;
      }
      this.data = StringStorage(alloc, capacity);
      this.capacity_ = capacity;
      this.len = src_len;

      for (var i: i64 = 0; i < src_len; i = i + 1) {
        var byte: u8 = unsafe { _load<u8>(src_data, i); };
        unsafe { this.data.set_unchecked(i, byte); };
      }
    }

    /**
     * Construct from ContiguousBuffer with specified length
     * Copies length bytes into a new owned string. Throws IndexOutOfBoundsError
     * when length is negative or exceeds the source buffer size.
     */
    init(allocator: const ref HeapAllocator, buffer: ref ContiguousBuffer<u8>, length: i64) throws IError {
      if (length < 0 or length > buffer.size()) {
        throw IndexOutOfBoundsError(length);
      }

      var capacity: i64 = length + 1;
      if (capacity < 16) {
        capacity = 16;
      }
      this.data = StringStorage(allocator, capacity);
      this.capacity_ = capacity;
      this.len = length;

      // Simple byte-by-byte copy (safer for debugging)
      for (var i: i64 = 0; i < length; i = i + 1) {
        var byte: u8 = unsafe { buffer.get_unchecked(i); };
        unsafe { this.data.set_unchecked(i, byte); };
      }
    }

    /**
     * Get current string length
     */
    public const method length() i64 {
      return this.len;
    }

    /**
     * Get allocated capacity
     */
    public const method capacity() i64 {
      return this.capacity_;
    }

    /**
     * Check if the string has no bytes
     */
    public const method is_empty() bool {
      return this.len == 0;
    }

    /** Read a byte, or throw when the index is outside the string. */
    public const method at(i: i64) u8 throws IError {
      if (i < 0 or i >= this.len) {
        throw IndexOutOfBoundsError(i);
      }
      return unsafe { this.unsafe_at(i); };
    }

    /** Write a byte, or throw when the index is outside the string. */
    public method set_at(i: i64, val: u8) void throws IError {
      if (i < 0 or i >= this.len) {
        throw IndexOutOfBoundsError(i);
      }
      unsafe { this.unsafe_set_at(i, val); };
    }

    /** Read a byte without bounds checks. The caller must ensure 0 <= i < length(). */
    public const unsafe method unsafe_at(i: i64) u8 {
      return unsafe { this.data.get_unchecked(i); };
    }

    /** Write a byte without bounds checks. The caller must ensure 0 <= i < length(). */
    public unsafe method unsafe_set_at(i: i64, val: u8) void {
      unsafe { this.data.set_unchecked(i, val); };
    }

    /**
     * Ensure capacity for at least n bytes (doesn't change len)
     */
    public method reserve(n: i64) void {
      if (n > this.capacity_) {
        this.data.resize_to(n, this.len);
        this.capacity_ = n;
      }
    }

    /**
     * Double capacity
     */
    method grow() void {
      var new_capacity: i64 = this.capacity_ * 2;
      this.data.resize_to(new_capacity, this.len);
      this.capacity_ = new_capacity;
    }

    /**
     * Ensure we can add n more bytes
     */
    method ensure_capacity(additional: i64) void {
      var needed: i64 = this.len + additional;
      if (needed > this.capacity_) {
        // Double until we have enough
        var new_capacity: i64 = this.capacity_;
        while (new_capacity < needed) {
          new_capacity = new_capacity * 2;
        }
        this.data.resize_to(new_capacity, this.len);
        this.capacity_ = new_capacity;
      }
    }

    /** Borrow the bytes without allocating or adding a NUL terminator. Read only
       length() bytes; do not write through the pointer. It remains valid until
       the next mutation, move, or destruction of the String. */
    public const method bytes() raw_ptr<u8> {
      return this.data.raw_data();
    }

    /**
     * NUL-terminate in spare capacity and hand back a pointer to the bytes,
     * for passing a runtime path or argument to C. The terminator sits past
     * the length, so the string itself is unchanged. The pointer is only good
     * until the next mutation, move, or destruction.
     */
    public method c_str() raw_ptr<u8> {
      this.ensure_capacity(1);
      unsafe { this.data.set_unchecked(this.len, 0); };
      return this.data.raw_data();
    }

    /**
     * Append a single byte/character
     */
    public method append_char(ch: u8) void {
      this.ensure_capacity(1);
      unsafe { this.data.set_unchecked(this.len, ch); };
      this.len = this.len + 1;
    }

    /**
     * Append the UTF-8 encoding of a code point. Anything that is not a
     * Unicode scalar value is written as U+FFFD, so the string always stays
     * valid UTF-8. Module-private; push(char) is the public spelling.
     */
    method push_code(code: i64) void {
      var c: i64 = resolve_utf8_scalar(code);
      var width: i64 = compute_utf8_len(c);
      for (var j: i64 = 0; j < width; j = j + 1) {
        this.append_char(encode_utf8_byte(c, j));
      }
    }

    /**
     * Append the UTF-8 encoding of a char (1 to 4 bytes)
     */
    public method push(c: char) void {
      this.push_code(code_of(c));
    }

    /**
     * Append another string
     */
    public method append(other: const ref String) void {
      var other_len: i64 = other.length();
      if (other_len == 0) {
        return;
      }
      this.ensure_capacity(other_len);
      var dst: raw_ptr<u8> = unsafe { _ptr_offset(this.data.raw_data(), this.len); };
      unsafe { _memcpy(dst, other.data.raw_data(), other_len); };
      this.len = this.len + other_len;
    }

    // ========================================================================
    // Overloaded append() for String Interpolation
    // These enable `${expr}` interpolation via overload resolution
    // ========================================================================

    /**
     * Append string literal (overload for interpolation)
     */
    public method append(literal: static_ptr<u8>) void {
      this.append_literal(literal);
    }

    /**
     * Append signed 64-bit integer (overload for interpolation)
     */
    public method append(val: i64) void {
      this.append_i64(val);
    }

    /**
     * Append signed 32-bit integer (overload for interpolation)
     */
    public method append(val: i32) void {
      this.append_i64(val);
    }

    /**
     * Append unsigned 64-bit integer (overload for interpolation)
     */
    public method append(val: u64) void {
      this.append_u64(val);
    }

    /**
     * Append unsigned 32-bit integer (overload for interpolation)
     */
    public method append(val: u32) void {
      this.append_u64(val);
    }

    /**
     * Append boolean (overload for interpolation)
     */
    public method append(val: bool) void {
      this.append_bool(val);
    }

    /**
     * Append a char (overload for interpolation)
     */
    public method append(val: char) void {
      this.push(val);
    }

    /**
     * Append 64-bit float (overload for interpolation)
     */
    public method append(val: f64) void {
      this.append_f64(val);
    }

    /**
     * Append 32-bit float (overload for interpolation)
     */
    public method append(val: f32) void {
      this.append_f64(val);
    }

    /**
     * Append string literal
     */
    public method append_literal(literal: static_ptr<u8>) void {
      var src_len: i64 = literal.length();
      if (src_len == 0) {
        return;
      }
      this.ensure_capacity(src_len);
      var dst: raw_ptr<u8> = unsafe { _ptr_offset(this.data.raw_data(), this.len); };
      unsafe { _memcpy(dst, literal.raw(), src_len); };
      this.len = this.len + src_len;
    }

    /**
     * Whether the `needle_len` bytes at `at` equal `needle`. The one byte-run
     * comparison the search and prefix/suffix methods share.
     */
    const method match_bytes_at(at: i64, needle: raw_ptr<u8>, needle_len: i64) bool {
      for (var j: i64 = 0; j < needle_len; j = j + 1) {
        if (unsafe { this.data.get_unchecked(at + j); } != unsafe { _load<u8>(needle, j); }) {
          return false;
        }
      }
      return true;
    }

    /**
     * Check if string equals a literal
     */
    public const method equals_literal(literal: static_ptr<u8>) bool {
      if (this.len != literal.length()) {
        return false;
      }
      return this.match_bytes_at(0, literal.raw(), literal.length());
    }

    // ========================================================================
    // Core Manipulation Methods
    // ========================================================================

    /**
     * Clear string (reset length to 0, keep capacity)
     */
    public method clear() void {
      this.len = 0;
    }

    /**
     * Remove and return last byte
     */
    public method pop() u8 throws IError {
      if (this.len == 0) {
        throw EmptyError();
      }
      this.len = this.len - 1;
      return unsafe { this.data.get_unchecked(this.len); };
    }

    /**
     * Truncate to given length (does nothing if new_len >= len)
     */
    public method truncate(new_len: i64) void {
      if (new_len < this.len) {
        this.len = new_len;
      }
    }

    /**
     * Remove byte at index, shifting remaining bytes left
     */
    public method remove(index: i64) u8 throws IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index >= this.len) {
        throw IndexOutOfBoundsError(index);
      }
      var removed: u8 = unsafe { this.data.get_unchecked(index); };
      // Shift remaining bytes left
      for (var i: i64 = index; i < this.len - 1; i = i + 1) {
        var next: u8 = unsafe { this.data.get_unchecked(i + 1); };
        unsafe { this.data.set_unchecked(i, next); };
      }
      this.len = this.len - 1;
      return removed;
    }

    /**
     * Insert byte at index, shifting remaining bytes right
     */
    public method insert_char(index: i64, ch: u8) void throws IError {
      if (index < 0) {
        throw IndexOutOfBoundsError(index);
      }
      if (index > this.len) {
        throw IndexOutOfBoundsError(index);
      }
      this.ensure_capacity(1);
      // Shift bytes right from end
      for (var i: i64 = this.len; i > index; i = i - 1) {
        var prev: u8 = unsafe { this.data.get_unchecked(i - 1); };
        unsafe { this.data.set_unchecked(i, prev); };
      }
      unsafe { this.data.set_unchecked(index, ch); };
      this.len = this.len + 1;
    }

    // ========================================================================
    // Search Methods
    // ========================================================================

    /**
     * Find first occurrence of byte; None if not found
     */
    public const method find_char(ch: u8) Option<i64> {
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        if (unsafe { this.data.get_unchecked(i); } == ch) {
          return Option.Some(i);
        }
      }
      return Option.None;
    }

    /**
     * Find last occurrence of byte; None if not found
     */
    public const method rfind_char(ch: u8) Option<i64> {
      var i: i64 = this.len - 1;
      while (i >= 0) {
        if (unsafe { this.data.get_unchecked(i); } == ch) {
          return Option.Some(i);
        }
        i = i - 1;
      }
      return Option.None;
    }

    /**
     * Check if string contains byte
     */
    public const method contains_char(ch: u8) bool {
      return match this.find_char(ch) {
        Option.Some(i) => true,
        Option.None => false
      };
    }

    /**
     * Iterate the string as Unicode scalar values rather than bytes:
     *   for (var c: char in s.iterate_chars()) { ... }
     */
    public const method iterate_chars() Chars {
      return Chars(this.data.raw_data(), this.len);
    }

    /**
     * Number of Unicode scalar values, which is length() only for ASCII.
     */
    public const method count_chars() i64 {
      var n: i64 = 0;
      var it = this.iterate_chars();
      for (var c: char in it) {
        n = n + 1;
      }
      return n;
    }

    /**
     * Byte index of the first occurrence of a char; None if absent.
     * UTF-8 is self-synchronizing, so matching the encoded bytes is exact:
     * a multi-byte sequence never appears inside another one.
     */
    public const method find(c: char) Option<i64> {
      var code: i64 = code_of(c);
      var width: i64 = compute_utf8_len(code);
      var i: i64 = 0;
      while (i + width <= this.len) {
        if (this.matches_at(code, width, i)) {
          return Option.Some(i);
        }
        i = i + 1;
      }
      return Option.None;
    }

    /**
     * Byte index of the last occurrence of a char; None if absent.
     */
    public const method rfind(c: char) Option<i64> {
      var code: i64 = code_of(c);
      var width: i64 = compute_utf8_len(code);
      var i: i64 = this.len - width;
      while (i >= 0) {
        if (this.matches_at(code, width, i)) {
          return Option.Some(i);
        }
        i = i - 1;
      }
      return Option.None;
    }

    /**
     * Whether the string contains a char.
     */
    public const method contains(c: char) bool {
      return match this.find(c) {
        Option.Some(i) => true,
        Option.None => false
      };
    }

    /**
     * Report whether the UTF-8 encoding of a code point sits at a byte offset.
     * The caller supplies the width so it is not recomputed per position.
     */
    const method matches_at(code: i64, width: i64, at: i64) bool {
      for (var j: i64 = 0; j < width; j = j + 1) {
        if (unsafe { this.data.get_unchecked(at + j); } != encode_utf8_byte(code, j)) {
          return false;
        }
      }
      return true;
    }

    /**
     * Check if string starts with literal
     */
    public const method starts_with(literal: static_ptr<u8>) bool {
      if (literal.length() > this.len) {
        return false;
      }
      return this.match_bytes_at(0, literal.raw(), literal.length());
    }

    /**
     * Check if string ends with literal
     */
    public const method ends_with(literal: static_ptr<u8>) bool {
      if (literal.length() > this.len) {
        return false;
      }
      return this.match_bytes_at(this.len - literal.length(), literal.raw(), literal.length());
    }

    /**
     * Check if string starts with another string
     */
    public const method starts_with(other: const ref String) bool {
      if (other.len > this.len) {
        return false;
      }
      return this.match_bytes_at(0, other.data.raw_data(), other.len);
    }

    /**
     * Check if string ends with another string
     */
    public const method ends_with(other: const ref String) bool {
      if (other.len > this.len) {
        return false;
      }
      return this.match_bytes_at(this.len - other.len, other.data.raw_data(), other.len);
    }

    /**
     * Helper: first index at or after `start` where `needle` occurs
     */
    const method find_bytes(needle: raw_ptr<u8>, needle_len: i64, start: i64) Option<i64> {
      if (needle_len == 0) {
        return Option.Some(start);
      }
      var last: i64 = this.len - needle_len;
      for (var i: i64 = start; i <= last; i = i + 1) {
        if (this.match_bytes_at(i, needle, needle_len)) {
          return Option.Some(i);
        }
      }
      return Option.None;
    }

    /**
     * Find first occurrence of a literal; None if not found
     */
    public const method find(needle: static_ptr<u8>) Option<i64> {
      return this.find_bytes(needle.raw(), needle.length(), 0);
    }

    /**
     * Find first occurrence of another string; None if not found
     */
    public const method find(needle: const ref String) Option<i64> {
      return this.find_bytes(needle.data.raw_data(), needle.len, 0);
    }

    /**
     * Check if string contains a literal
     */
    public const method contains(needle: static_ptr<u8>) bool {
      return match this.find(needle) {
        Option.Some(i) => true,
        Option.None => false
      };
    }

    /**
     * Check if string contains another string
     */
    public const method contains(needle: const ref String) bool {
      return match this.find(needle) {
        Option.Some(i) => true,
        Option.None => false
      };
    }

    /**
     * Compare with another string: -1 if less, 0 if equal, 1 if greater
     */
    public const method compare(other: const ref String) i64 {
      var min_len: i64 = this.len;
      if (other.len < min_len) {
        min_len = other.len;
      }

      for (var i: i64 = 0; i < min_len; i = i + 1) {
        var a: u8 = unsafe { this.data.get_unchecked(i); };
        var b: u8 = unsafe { other.data.get_unchecked(i); };
        if (a < b) {
          return -1;
        }
        if (a > b) {
          return 1;
        }
      }

      if (this.len < other.len) {
        return -1;
      }
      if (this.len > other.len) {
        return 1;
      }
      return 0;
    }

    /**
     * Check if equal to another string
     */
    public const method equals(other: const ref String) bool {
      return this.compare(other) == 0;
    }

    // ========================================================================
    // Transformation Methods
    // ========================================================================

    /**
     * Reverse string in-place
     */
    public method reverse() void {
      if (this.len <= 1) {
        return;
      }
      var left: i64 = 0;
      var right: i64 = this.len - 1;
      while (left < right) {
        var tmp: u8 = unsafe { this.data.get_unchecked(left); };
        unsafe { this.data.set_unchecked(left, unsafe { this.data.get_unchecked(right); }); };
        unsafe { this.data.set_unchecked(right, tmp); };
        left = left + 1;
        right = right - 1;
      }
    }

    /**
     * Lowercase ASCII letters in-place; other bytes are left alone
     */
    public method to_lower() void {
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        var ch: u8 = unsafe { this.data.get_unchecked(i); };
        if (ch >= b'A' and ch <= b'Z') {
          unsafe { this.data.set_unchecked(i, ch + (b'a' - b'A')); };
        }
      }
    }

    /**
     * Uppercase ASCII letters in-place; other bytes are left alone
     */
    public method to_upper() void {
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        var ch: u8 = unsafe { this.data.get_unchecked(i); };
        if (ch >= b'a' and ch <= b'z') {
          unsafe { this.data.set_unchecked(i, ch - (b'a' - b'A')); };
        }
      }
    }

    /**
     * Drop leading ASCII whitespace in-place
     */
    public method trim_start() void {
      var start: i64 = 0;
      while (start < this.len and is_ascii_space(unsafe { this.data.get_unchecked(start); })) {
        start = start + 1;
      }
      if (start == 0) {
        return;
      }
      var new_len: i64 = this.len - start;
      for (var i: i64 = 0; i < new_len; i = i + 1) {
        unsafe { this.data.set_unchecked(i, unsafe { this.data.get_unchecked(start + i); }); };
      }
      this.len = new_len;
    }

    /**
     * Drop trailing ASCII whitespace in-place
     */
    public method trim_end() void {
      while (this.len > 0 and is_ascii_space(unsafe { this.data.get_unchecked(this.len - 1); })) {
        this.len = this.len - 1;
      }
    }

    /**
     * Drop leading and trailing ASCII whitespace in-place
     */
    public method trim() void {
      this.trim_end();
      this.trim_start();
    }

    /**
     * Helper: replace `count` bytes at `index` with `repl_len` bytes from
     * `repl`, shifting the tail to fit
     */
    method splice_bytes(index: i64, count: i64, repl: raw_ptr<u8>, repl_len: i64) void {
      var delta: i64 = repl_len - count;
      if (delta > 0) {
        this.ensure_capacity(delta);
        // Shift the tail right, back to front, so bytes are not overwritten
        var i: i64 = this.len - 1;
        while (i >= index + count) {
          unsafe { this.data.set_unchecked(i + delta, unsafe { this.data.get_unchecked(i); }); };
          i = i - 1;
        }
      } else if (delta < 0) {
        for (var i: i64 = index + count; i < this.len; i = i + 1) {
          unsafe { this.data.set_unchecked(i + delta, unsafe { this.data.get_unchecked(i); }); };
        }
      }
      for (var j: i64 = 0; j < repl_len; j = j + 1) {
        var b: u8 = unsafe { _load<u8>(repl, j); };
        unsafe { this.data.set_unchecked(index + j, b); };
      }
      this.len = this.len + delta;
    }

    /**
     * Helper: replace every occurrence of one byte run with another
     */
    method replace_bytes(from: raw_ptr<u8>, from_len: i64, to: raw_ptr<u8>, to_len: i64) void {
      if (from_len == 0) {
        return;
      }
      var pos: i64 = 0;
      var searching: bool = true;
      while (searching) {
        match this.find_bytes(from, from_len, pos) {
          Option.Some(i) => {
            this.splice_bytes(i, from_len, to, to_len);
            pos = i + to_len;
          },
          Option.None => {
            searching = false;
          }
        };
      }
    }

    /**
     * Replace every occurrence of a literal with another literal, in-place
     */
    public method replace(from: static_ptr<u8>, to: static_ptr<u8>) void {
      this.replace_bytes(
        from.raw(),
        from.length(),
        to.raw(),
        to.length()
      );
    }

    /**
     * Replace every occurrence of a string with another string, in-place
     */
    public method replace(from: const ref String, to: const ref String) void {
      this.replace_bytes(from.data.raw_data(), from.len, to.data.raw_data(), to.len);
    }

    // ========================================================================
    // Copying Methods
    // ========================================================================

    /**
     * Copy `count` bytes starting at `start` into a new string
     */
    const method copy_range(alloc: const ref HeapAllocator, start: i64, count: i64) String {
      var out: String = String(alloc, "");
      out.ensure_capacity(count);
      for (var i: i64 = 0; i < count; i = i + 1) {
        out.append_char(unsafe { this.data.get_unchecked(start + i); });
      }
      return out;
    }

    /**
     * Copy this string into a new one
     */
    public const method clone(alloc: const ref HeapAllocator) String {
      return this.copy_range(alloc, 0, this.len);
    }

    /**
     * Copy `count` bytes starting at `start` into a new string
     * Throws IndexOutOfBoundsError if the range falls outside the string
     */
    public const method substr(alloc: const ref HeapAllocator, start: i64, count: i64) String throws IError {
      if (start < 0 or count < 0) {
        throw IndexOutOfBoundsError(start);
      }
      if (start + count > this.len) {
        throw IndexOutOfBoundsError(start + count);
      }
      return this.copy_range(alloc, start, count);
    }

    /**
     * Split on a separator byte into owned strings.
     * Adjacent separators produce empty pieces, so the result always holds
     * one more piece than there are separators.
     */
    public const method split(alloc: const ref HeapAllocator, sep: u8) Vec<String> {
      return this.split_on_byte(alloc, sep, true);
    }

    /**
     * Split on a separator string into owned strings.
     * An empty separator yields the whole string as a single piece.
     */
    public const method split(alloc: const ref HeapAllocator, sep: static_ptr<u8>) Vec<String> {
      return this.split_on_bytes(alloc, sep.raw(), sep.length(), true);
    }

    /**
     * Split on a separator byte, keeping only non-empty pieces.
     * Adjacent, leading, and trailing separators yield nothing.
     */
    public const method split_nonempty(alloc: const ref HeapAllocator, sep: u8) Vec<String> {
      return this.split_on_byte(alloc, sep, false);
    }

    /**
     * Split on a separator string, keeping only non-empty pieces.
     * An empty separator yields the whole string, or nothing if it is empty.
     */
    public const method split_nonempty(alloc: const ref HeapAllocator, sep: static_ptr<u8>) Vec<String> {
      return this.split_on_bytes(alloc, sep.raw(), sep.length(), false);
    }

    /**
     * Split on runs of ASCII whitespace, keeping only non-empty pieces.
     * Any mix of adjacent spaces, tabs, and newlines counts as one separator.
     */
    public const method split_whitespace(alloc: const ref HeapAllocator) Vec<String> {
      var parts: Vec<String> = Vec<String>(alloc, 4);
      var start: i64 = 0;
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        if (is_ascii_space(unsafe { this.data.get_unchecked(i); })) {
          this.push_piece(alloc, parts, start, i, false);
          start = i + 1;
        }
      }
      this.push_piece(alloc, parts, start, this.len, false);
      return parts;
    }

    /**
     * The three split families differ only in how they find a separator and
     * whether empty pieces are kept, so the piece-cutting lives here.
     */
    const method push_piece(alloc: const ref HeapAllocator, parts: ref Vec<String>, start: i64, end: i64, keep_empty: bool) void {
      if (keep_empty or end > start) {
        parts.push(this.copy_range(alloc, start, end - start));
      }
    }

    /**
     * Cut the string at every occurrence of one byte. keep_empty decides whether
     * zero-length pieces survive.
     */
    const method split_on_byte(alloc: const ref HeapAllocator, sep: u8, keep_empty: bool) Vec<String> {
      var parts: Vec<String> = Vec<String>(alloc, 4);
      var start: i64 = 0;
      for (var i: i64 = 0; i < this.len; i = i + 1) {
        if (unsafe { this.data.get_unchecked(i); } == sep) {
          this.push_piece(alloc, parts, start, i, keep_empty);
          start = i + 1;
        }
      }
      this.push_piece(alloc, parts, start, this.len, keep_empty);
      return parts;
    }

    /**
     * Cut the string at every occurrence of a multi-byte separator. An empty
     * separator cuts nothing and yields the whole string as one piece.
     */
    const method split_on_bytes(alloc: const ref HeapAllocator, sep_data: raw_ptr<u8>, sep_len: i64, keep_empty: bool) Vec<String> {
      var parts: Vec<String> = Vec<String>(alloc, 4);
      // An empty separator cuts nothing, so the whole string is the one piece.
      if (sep_len == 0) {
        this.push_piece(alloc, parts, 0, this.len, keep_empty);
        return parts;
      }
      var start: i64 = 0;
      var searching: bool = true;
      while (searching) {
        match this.find_bytes(sep_data, sep_len, start) {
          Option.Some(i) => {
            this.push_piece(alloc, parts, start, i, keep_empty);
            start = i + sep_len;
          },
          Option.None => {
            searching = false;
          }
        };
      }
      this.push_piece(alloc, parts, start, this.len, keep_empty);
      return parts;
    }

    // ========================================================================
    // Numeric Formatting
    // ========================================================================

    /**
     * Helper: append a hex digit (0-15)
     */
    method append_hex_digit(d: i64) void {
      var ch: u8 = match d {
        0 => 48,
        1 => 49,
        2 => 50,
        3 => 51,
        4 => 52,
        5 => 53,
        6 => 54,
        7 => 55,
        8 => 56,
        9 => 57,
        10 => 97,
        11 => 98,
        12 => 99,
        13 => 100,
        14 => 101,
        _ => 102
      };
      this.append_char(ch);
    }

    /**
     * Append an unsigned integer in decimal. The arithmetic stays unsigned so
     * a value above the i64 maximum writes its full digits. Reserve once and
     * fill from the end so each digit is written directly to its final position.
     */
    public method append_u64(val: u64) void {
      var digits: i64 = 1;
      var remaining: u64 = val;
      while (remaining >= 10) {
        remaining = remaining / 10;
        digits = digits + 1;
      }
      this.ensure_capacity(digits);
      var start: i64 = this.len;
      var end: i64 = start + digits;
      var destination: raw_ptr<u8> = this.data.raw_data();
      var index: i64 = end;
      var n: u64 = val;
      while (index > start) {
        var quotient: u64 = n / 10;
        var digit: u8 = _convert<u8>(n - quotient * 10);
        index = index - 1;
        unsafe { _store<u8>(destination, index, b'0' + digit); };
        n = quotient;
      }
      this.len = end;
    }

    /**
     * Append a signed integer in decimal
     */
    public method append_i64(val: i64) void {
      if (val >= 0) {
        this.append_u64(_convert<u64>(val));
        return;
      }
      this.append_char(b'-');
      // Handle i64 min value edge case
      if (val == I64_MIN) {
        this.append_literal("9223372036854775808");
        return;
      }
      this.append_u64(_convert<u64>(0 - val));
    }

    /**
     * Append an integer in hexadecimal (lowercase)
     */
    public method append_hex(val: i64) void {
      if (val == 0) {
        this.append_char(b'0');
        return;
      }

      var start: i64 = this.len;
      var n: i64 = val;

      while (n != 0) {
        // Get lowest 4 bits (0-15)
        var nibble: i64 = n - (n / 16) * 16;
        if (nibble < 0) {
          nibble = nibble + 16;
        }
        this.append_hex_digit(nibble);
        n = n / 16;
      }

      // Reverse the hex digits
      var end: i64 = this.len - 1;
      while (start < end) {
        var tmp: u8 = unsafe { this.data.get_unchecked(start); };
        unsafe { this.data.set_unchecked(start, unsafe { this.data.get_unchecked(end); }); };
        unsafe { this.data.set_unchecked(end, tmp); };
        start = start + 1;
        end = end - 1;
      }
    }

    /**
     * Append a boolean as "true" or "false"
     */
    public method append_bool(val: bool) void {
      if (val) {
        this.append_literal("true");
        return;
      }
      this.append_literal("false");
    }

    /**
     * Append a float using the shortest decimal form that reads back as the
     * same value ("0.1", "1e+21", "3.14"). Non-finite values print as libc
     * spells them ("inf", "-inf", "nan").
     */
    public method append_f64(val: f64) void {
      var room: i64 = 32;
      this.ensure_capacity(room);
      var dst: raw_ptr<u8> = unsafe { _ptr_offset(this.data.raw_data(), this.len); };
      var written: i32 = unsafe { c_snprintf(dst, room, "%.15g", val); };
      var back: f64 = unsafe { c_strtod(dst, null); };
      if (back != val) {
        written = unsafe { c_snprintf(dst, room, "%.16g", val); };
        back = unsafe { c_strtod(dst, null); };
        if (back != val) {
          written = unsafe { c_snprintf(dst, room, "%.17g", val); };
        }
      }
      if (written < 0) {
        return;
      }
      this.len = this.len + written;
    }

    // ========================================================================
    // Numeric Parsing
    // ========================================================================

    /**
     * Parse the whole string as a signed decimal integer ("-42"). None if the
     * text is not exactly an optional '-' followed by digits, or on overflow.
     */
    public const method parse_i64() Option<i64> {
      var i: i64 = 0;
      var negative: bool = false;
      if (this.len > 0 and unsafe { this.unsafe_at(0); } == b'-') {
        negative = true;
        i = 1;
      }
      if (i >= this.len) {
        return Option.None;
      }
      // Accumulate as a negative number so i64 min is representable
      var acc: i64 = 0;
      var limit: i64 = I64_MIN / 10;
      while (i < this.len) {
        var ch: u8 = unsafe { this.unsafe_at(i); };
        if (ch < 48) {
          return Option.None;
        }
        if (ch > 57) {
          return Option.None;
        }
        var digit: i64 = _convert<i64>(ch) - 48;
        if (acc < limit) {
          return Option.None;
        }
        acc = acc * 10;
        if (acc < I64_MIN + digit) {
          return Option.None;
        }
        acc = acc - digit;
        i = i + 1;
      }
      if (negative) {
        return Option.Some(acc);
      }
      if (acc == I64_MIN) {
        return Option.None;
      }
      var positive: i64 = 0 - acc;
      return Option.Some(positive);
    }

    /**
     * True if the whole string is a decimal float: optional '-', digits,
     * optional fraction, optional exponent (as JSON spells numbers, but a
     * leading '+' or extra leading zeros are also accepted).
     */
    const method is_decimal_float() bool {
      var i: i64 = 0;
      if (i < this.len) {
        var sign: u8 = unsafe { this.unsafe_at(i); };
        if (sign == b'-' or sign == b'+') {
          // '-' '+'
          i = i + 1;
        }
      }
      var int_digits: i64 = 0;
      while (i < this.len and unsafe { this.unsafe_at(i); } >= b'0' and unsafe { this.unsafe_at(i); } <= b'9') {
        i = i + 1;
        int_digits = int_digits + 1;
      }
      var frac_digits: i64 = 0;
      if (i < this.len and unsafe { this.unsafe_at(i); } == b'.') {
        // '.'
        i = i + 1;
        while (i < this.len and unsafe { this.unsafe_at(i); } >= b'0' and unsafe { this.unsafe_at(i); } <= b'9') {
          i = i + 1;
          frac_digits = frac_digits + 1;
        }
      }
      if (int_digits + frac_digits == 0) {
        return false;
      }
      if (i < this.len and (unsafe { this.unsafe_at(i); } == b'e' or unsafe { this.unsafe_at(i); } == b'E')) {
        // 'e' 'E'
        i = i + 1;
        if (i < this.len and (unsafe { this.unsafe_at(i); } == b'-' or unsafe { this.unsafe_at(i); } == b'+')) {
          i = i + 1;
        }
        var exp_digits: i64 = 0;
        while (i < this.len and unsafe { this.unsafe_at(i); } >= b'0' and unsafe { this.unsafe_at(i); } <= b'9') {
          i = i + 1;
          exp_digits = exp_digits + 1;
        }
        if (exp_digits == 0) {
          return false;
        }
      }
      return i == this.len;
    }

    /**
     * Parse the whole string as a decimal float ("3.25", "-1e-9", "42").
     * None if the text is not a decimal float.
     */
    public method parse_f64() Option<f64> {
      if (not this.is_decimal_float()) {
        return Option.None;
      }
      var value: f64 = unsafe { c_strtod(this.c_str(), null); };
      return Option.Some(value);
    }

    // ========================================================================
    // Slicing
    // ========================================================================

    /**
     * Slicing via __slice__ method: s[a:b] -> StringView
     * Returns a non-owning view into the string data
     */
    public const method __slice__(ranges: const ref array<SliceRange>) StringView {
      // For strings, we only support 1D slicing
      const ref range = ranges[0];
      var start: i64 = range.get_start();
      var end: i64 = range.get_end(this.len);
      return StringView(this.data.raw_data(), start, end - start);
    }
  }

  // ============================================================================
  // Precompiled Specializations
  // ============================================================================

  public declare Vec_String = Vec<String>;

  /**
   * Copy a NUL-terminated C string into an owned String.
   * A free function rather than an init overload: static_ptr<u8> matches
   * raw_ptr<u8> in overload resolution, so String(alloc, "literal") would
   * become ambiguous.
   */
  public function from_c_str(alloc: const ref HeapAllocator, s: raw_ptr<u8>) String {
    var out: String = String(alloc, "");
    if (s == null) {
      return out;
    }
    var len: i64 = unsafe { c_strlen(s); };
    out.reserve(len + 1);
    for (var i: i64 = 0; i < len; i = i + 1) {
      out.append_char(unsafe { _load<u8>(s, i); });
    }
    return out;
  }

  /**
   * Concatenate strings with a separator between them
   */
  public function join(alloc: const ref HeapAllocator, parts: const ref Vec<String>, sep: static_ptr<u8>) String {
    var out: String = String(alloc, "");
    for (var i: i64 = 0; i < parts.size(); i = i + 1) {
      if (i > 0) {
        out.append_literal(sep);
      }
      out.append(unsafe { parts.get_unchecked(i); });
    }
    return out;
  }
}  // module std
