// stdlib/io.sun - Files, directories and descriptor polling
//
// Usage:
//   using std.io;
//
//   var f = File();
//   try {
//       f.open("test.txt", FileMode.Write);
//       f.write("Hello, World!");
//       f.close();
//   } catch (e: IError) {
//       // Handle error
//   }
//
// Every path is taken two ways: as a static_ptr<u8> — what a string literal
// is — and as a `ref String` for a path put together at runtime. Both feed the
// same private worker, which talks to C through a raw NUL-terminated pointer.

public module std {
  public module io {
    // How to open a file.
    //   Read   — the file must exist
    //   Write  — create, or truncate what is there
    //   Append — create if missing, write at the end
    // These are enums rather than integer constants because a bundle exports
    // its enums but not its module-level variables.
    public enum FileMode { Read, Write, Append }

    // Where a seek offset is measured from.
    public enum Whence { Start, Current, End }

    // What a directory entry is. Some filesystems do not report a kind, in
    // which case it is Unknown and is_dir(path) answers the question.
    public enum FileKind { Unknown, File, Dir, Symlink, Other }

    // open(2) flags. O_RDONLY is 0 everywhere; the composable write flags
    // differ per OS and live in target_<os>.sun.
    var O_RDONLY: i32 = 0;
    var CREATE_MODE: i32 = 420;  // 0644

    // Standard descriptors
    public var STDIN_FD: i32 = 0;
    public var STDOUT_FD: i32 = 1;
    public var STDERR_FD: i32 = 2;

    // poll(2) event bits, for Poller.add. The add_read / add_write / is_*
    // helpers cover the common cases without assembling a bitmask.
    public var POLLIN: i16 = 1;
    public var POLLPRI: i16 = 2;
    public var POLLOUT: i16 = 4;
    public var POLLERR: i16 = 8;
    public var POLLHUP: i16 = 16;
    public var POLLNVAL: i16 = 32;

    // struct pollfd — { int, short, short }, 8 bytes, same layout on every
    // Linux ABI. Public because Poller stores a Vec of these, and a bundled
    // specialization over a private type is not visible to importers.
    public class PollFd {
      var fd: i32;
      var events: i16;
      var revents: i16;

      // Build a poll record for one descriptor and the events to watch for.
      init(fd: i32, events: i16) {
        this.fd = fd;
        this.events = events;
        this.revents = 0;
      }
    }

    // Translate a FileMode into the C open() flag bits it stands for.
    function open_flags(mode: FileMode) i32 {
      return match mode {
        FileMode.Read => O_RDONLY,
        FileMode.Write => O_WRONLY_CREAT_TRUNC,
        FileMode.Append => O_WRONLY_CREAT_APPEND
      };
    }

    // Translate a Whence into the C lseek() constant it stands for.
    function convert_whence(w: Whence) i32 {
      return match w {
        Whence.Start => 0,
        Whence.Current => 1,
        Whence.End => 2
      };
    }

    // File handle wrapper
    public class File {
      // 0 means "holds nothing". A moved-from File is zeroed, and closing
      // fd 0 would close stdin.
      var fd: i32;

      // Build a File that holds no descriptor. Open or adopt one before use.
      init() {
        this.fd = 0;
      }

      // Open a file with the specified mode
      public method open(path: static_ptr<u8>, mode: FileMode) void throws IError {
        this.open_cstr(path.raw(), mode);
      }

      // Open a file named at runtime. Throws if the system refuses.
      public method open(path: ref String, mode: FileMode) void throws IError {
        this.open_cstr(path.c_str(), mode);
      }

      // Open a file named by a C string. The one place the open syscall is made.
      method open_cstr(path: raw_ptr<u8>, mode: FileMode) void throws IError {
        var result: i32 = unsafe { c_open(path, open_flags(mode), CREATE_MODE); };
        if (result < 0) {
          throw Error(errno(), "failed to open file");
        }
        this.fd = result;
      }

      // Adopt an already-open descriptor. The File owns it from here.
      public method adopt(fd: i32) void {
        this.close();
        this.fd = fd;
      }

      // Write string data to the file
      // Returns number of bytes written, or negative on error
      public method write(data: static_ptr<u8>) i64 {
        return unsafe { c_write(this.fd, data.raw(), data.length()); };
      }

      // Write a String's bytes. Returns how many bytes went out, or a negative
      // value on failure.
      public method write(data: ref String) i64 {
        return unsafe { c_write(this.fd, data.c_str(), data.length()); };
      }

      // Read the rest of the file into a String
      public method read_all(alloc: ref HeapAllocator) String throws IError {
        var out: String = String(alloc, "");
        var chunk: ContiguousBuffer<u8> = ContiguousBuffer<u8>(alloc, 4096);
        var n: i64 = unsafe { c_read(this.fd, chunk.raw_data(), 4096); };
        while (n > 0) {
          for (var i: i64 = 0; i < n; i = i + 1) {
            out.append_char(chunk.get_unchecked(i));
          }
          n = unsafe { c_read(this.fd, chunk.raw_data(), 4096); };
        }
        if (n < 0) {
          throw Error(errno(), "failed to read file");
        }
        return out;
      }

      // Close the file. Safe to call more than once.
      public method close() void {
        if (this.fd > 0) {
          unsafe { c_close(this.fd); };
          this.fd = 0;
        }
      }

      // Report whether this File still holds a descriptor.
      public method is_open() bool {
        return this.fd > 0;
      }

      // The underlying descriptor. The File still owns it.
      public method get_fd() i32 {
        return this.fd;
      }

      // Seek to a position in the file
      // Returns the new offset from the beginning of the file
      public method seek(offset: i64, whence: Whence) i64 {
        return unsafe { c_lseek(this.fd, offset, convert_whence(whence)); };
      }

      // The current read/write offset from the start of the file.
      public method tell() i64 {
        return this.seek(0, Whence.Current);
      }

      // Flush file data to disk
      public method sync() void throws IError {
        var result: i32 = unsafe { c_fsync(this.fd); };
        if (result < 0) {
          throw Error(errno(), "failed to sync file");
        }
      }

      // Truncate or extend file to specified length
      public method truncate(length: i64) void throws IError {
        var result: i32 = unsafe { c_ftruncate(this.fd, length); };
        if (result < 0) {
          throw Error(errno(), "failed to truncate file");
        }
      }

      // Get file size by seeking to end and back
      public method size() i64 {
        var current: i64 = this.tell();
        var end_pos: i64 = this.seek(0, Whence.End);
        this.seek(current, Whence.Start);
        return end_pos;
      }

      // Write raw bytes to file
      public method write_bytes(buf: raw_ptr<u8>, len: i64) i64 {
        return unsafe { c_write(this.fd, buf, len); };
      }

      // Read raw bytes into provided buffer
      public method read_into(buf: raw_ptr<u8>, len: i64) i64 {
        return unsafe { c_read(this.fd, buf, len); };
      }

      // Close the descriptor if the File still holds one.
      deinit() {
        this.close();
      }
    }

    // -------------------------------------------------------------------
    // Whole-file helpers
    // -------------------------------------------------------------------

    public function read_to_string(alloc: ref HeapAllocator, path: static_ptr<u8>) String throws IError {
      var f: File = File();
      f.open(path, FileMode.Read);
      var text: String = f.read_all(alloc);
      f.close();
      return text;
    }

    // Read a whole file named at runtime into a new String.
    public function read_to_string(alloc: ref HeapAllocator, path: ref String) String throws IError {
      var f: File = File();
      f.open(path, FileMode.Read);
      var text: String = f.read_all(alloc);
      f.close();
      return text;
    }

    // Write a String over a file named by a literal, replacing what was there.
    public function write_string(path: static_ptr<u8>, contents: ref String) void throws IError {
      var f: File = File();
      f.open(path, FileMode.Write);
      if (f.write(contents) < 0) {
        throw Error(errno(), "failed to write file");
      }
      f.close();
    }

    // Write a String over a file named at runtime, replacing what was there.
    public function write_string(path: ref String, contents: ref String) void throws IError {
      var f: File = File();
      f.open(path, FileMode.Write);
      if (f.write(contents) < 0) {
        throw Error(errno(), "failed to write file");
      }
      f.close();
    }

    // -------------------------------------------------------------------
    // Paths
    // -------------------------------------------------------------------

    function remove_file_cstr(path: raw_ptr<u8>) void throws IError {
      var result: i32 = unsafe { c_unlink(path); };
      if (result < 0) {
        throw Error(errno(), "failed to remove file");
      }
    }

    // Remove a file
    public function remove_file(path: static_ptr<u8>) void throws IError {
      remove_file_cstr(path.raw());
    }

    // Delete a file named at runtime. Throws if it cannot be removed.
    public function remove_file(path: ref String) void throws IError {
      remove_file_cstr(path.c_str());
    }

    // Rename a file, both paths as C strings. The one place the rename syscall is
    // made.
    function rename_file_cstr(old_path: raw_ptr<u8>, new_path: raw_ptr<u8>) void throws IError {
      var result: i32 = unsafe { c_rename(old_path, new_path); };
      if (result < 0) {
        throw Error(errno(), "failed to rename file");
      }
    }

    // Rename or move a file
    public function rename_file(old_path: static_ptr<u8>, new_path: static_ptr<u8>) void throws IError {
      rename_file_cstr(old_path.raw(), new_path.raw());
    }

    // Rename a file from a literal path to one built at runtime.
    public function rename_file(old_path: static_ptr<u8>, new_path: ref String) void throws IError {
      rename_file_cstr(old_path.raw(), new_path.c_str());
    }

    // Rename a file from a path built at runtime to a literal one.
    public function rename_file(old_path: ref String, new_path: static_ptr<u8>) void throws IError {
      rename_file_cstr(old_path.c_str(), new_path.raw());
    }

    // Rename a file, both paths built at runtime.
    public function rename_file(old_path: ref String, new_path: ref String) void throws IError {
      rename_file_cstr(old_path.c_str(), new_path.c_str());
    }

    // Create a directory named by a C string. The one place the mkdir syscall is
    // made.
    function make_dir_cstr(path: raw_ptr<u8>, mode: i32) void throws IError {
      var result: i32 = unsafe { c_mkdir(path, mode); };
      if (result < 0) {
        throw Error(errno(), "failed to create directory");
      }
    }

    // Create a directory with the specified mode (e.g. 0755 = 493)
    public function make_dir(path: static_ptr<u8>, mode: i32) void throws IError {
      make_dir_cstr(path.raw(), mode);
    }

    // Create a directory named at runtime, with the given permission bits.
    public function make_dir(path: ref String, mode: i32) void throws IError {
      make_dir_cstr(path.c_str(), mode);
    }

    // Remove a directory named by a C string. The one place the rmdir syscall is
    // made.
    function remove_dir_cstr(path: raw_ptr<u8>) void throws IError {
      var result: i32 = unsafe { c_rmdir(path); };
      if (result < 0) {
        throw Error(errno(), "failed to remove directory");
      }
    }

    // Remove an empty directory
    public function remove_dir(path: static_ptr<u8>) void throws IError {
      remove_dir_cstr(path.raw());
    }

    // Remove a directory named at runtime. It must already be empty.
    public function remove_dir(path: ref String) void throws IError {
      remove_dir_cstr(path.c_str());
    }

    // -------------------------------------------------------------------
    // Metadata
    // -------------------------------------------------------------------
    // Answered with access/opendir/lseek rather than stat: `struct stat` has a
    // different field order and padding on x86-64 and aarch64 glibc, and the
    // stdlib is compiled from one source for both.

    function exists_cstr(path: raw_ptr<u8>) bool {
      return unsafe { c_access(path, 0); } == 0;
    }

    // Does the path exist? access(path, F_OK)
    public function exists(path: static_ptr<u8>) bool {
      return exists_cstr(path.raw());
    }

    // Report whether anything exists at a path built at runtime.
    public function exists(path: ref String) bool {
      return exists_cstr(path.c_str());
    }

    // Report whether a path named by a C string is a directory.
    function is_dir_cstr(path: raw_ptr<u8>) bool {
      var dir: raw_ptr<u8> = unsafe { c_opendir(path); };
      if (dir == null) {
        return false;
      }
      unsafe { c_closedir(dir); };
      return true;
    }

    // Report whether a literal path is a directory.
    public function is_dir(path: static_ptr<u8>) bool {
      return is_dir_cstr(path.raw());
    }

    // Report whether a path built at runtime is a directory.
    public function is_dir(path: ref String) bool {
      return is_dir_cstr(path.c_str());
    }

    // Report whether a literal path is an ordinary file.
    public function is_file(path: static_ptr<u8>) bool {
      return exists(path) and not is_dir(path);
    }

    // Report whether a path built at runtime is an ordinary file.
    public function is_file(path: ref String) bool {
      return exists(path) and not is_dir(path);
    }

    // The size in bytes of the file at a literal path. Throws if it cannot be
    // opened.
    public function get_file_size(path: static_ptr<u8>) i64 throws IError {
      var f: File = File();
      f.open(path, FileMode.Read);
      var size: i64 = f.seek(0, Whence.End);
      f.close();
      if (size < 0) {
        throw Error(errno(), "failed to size file");
      }
      return size;
    }

    // The size in bytes of the file at a path built at runtime.
    public function get_file_size(path: ref String) i64 throws IError {
      var f: File = File();
      f.open(path, FileMode.Read);
      var size: i64 = f.seek(0, Whence.End);
      f.close();
      if (size < 0) {
        throw Error(errno(), "failed to size file");
      }
      return size;
    }

    // -------------------------------------------------------------------
    // Directories
    // -------------------------------------------------------------------

    // One entry from read_dir. The kind comes from the directory record, so
    // no extra syscall is needed to tell a file from a subdirectory.
    public class DirEntry {
      var name_: String;
      var kind_: FileKind;

      // Build a directory entry. The name moves in.
      init(name: String, kind: FileKind) {
        this.name_ = name;
        this.kind_ = kind;
      }

      // Borrowed: the entry keeps the name.
      public method name() ref String {
        return unsafe { _to_ref<String>(_address_of<String>(this.name_)); };
      }

      // Whether the entry is a file, a directory, or something else.
      public method kind() FileKind {
        return this.kind_;
      }

      // Report whether this entry is a directory.
      public method is_dir() bool {
        return this.kind_ == FileKind.Dir;
      }

      // Report whether this entry is an ordinary file.
      public method is_file() bool {
        return this.kind_ == FileKind.File;
      }
    }

    // DT_* values from the directory record's d_type byte.
    function kind_of(d_type: u8) FileKind {
      return match d_type {
        4 => FileKind.Dir,
        8 => FileKind.File,
        10 => FileKind.Symlink,
        0 => FileKind.Unknown,
        _ => FileKind.Other
      };
    }

    // Is the record's name "." or ".."?
    function is_dot_entry(name: raw_ptr<u8>) bool {
      var first: u8 = unsafe { _load<u8>(name, 0); };
      if (first != b'.') {
        return false;
      }
      var second: u8 = unsafe { _load<u8>(name, 1); };
      if (second == 0) {
        return true;
      }
      if (second != b'.') {
        return false;
      }
      return unsafe { _load<u8>(name, 2); } == 0;
    }

    // List a directory. "." and ".." are left out; the order is whatever the
    // filesystem gives, not sorted.
    function read_dir_cstr(alloc: ref HeapAllocator, path: raw_ptr<u8>) Vec<DirEntry> throws IError {
      var dir: raw_ptr<u8> = unsafe { c_opendir(path); };
      if (dir == null) {
        throw Error(errno(), "failed to open directory");
      }

      var entries: Vec<DirEntry> = Vec<DirEntry>(alloc, 8);
      var rec: raw_ptr<u8> = unsafe { c_readdir(dir); };
      while (rec != null) {
        // struct dirent's head differs per OS; the two byte offsets that
        // matter come from target_<os>.sun. d_name is a flexible char[] at
        // the end of the record's fixed head.
        var name: raw_ptr<u8> = unsafe { _ptr_offset(rec, DIRENT_NAME_OFFSET); };
        if (not is_dot_entry(name)) {
          var d_type: u8 = unsafe { _load<u8>(rec, DIRENT_TYPE_OFFSET); };
          entries.push(DirEntry(from_c_str(alloc, name), kind_of(d_type)));
        }
        rec = unsafe { c_readdir(dir); };
      }

      unsafe { c_closedir(dir); };
      return entries;
    }

    // List the entries of a directory at a literal path. '.' and '..' are left
    // out.
    public function read_dir(alloc: ref HeapAllocator, path: static_ptr<u8>) Vec<DirEntry> throws IError {
      return read_dir_cstr(alloc, path.raw());
    }

    // List the entries of a directory at a path built at runtime.
    public function read_dir(alloc: ref HeapAllocator, path: ref String) Vec<DirEntry> throws IError {
      return read_dir_cstr(alloc, path.c_str());
    }

    // -------------------------------------------------------------------
    // Standard input
    // -------------------------------------------------------------------

    // Read one line from stdin, without the trailing newline. None at end of
    // input with nothing read. Unbuffered on purpose: a buffered reader would
    // swallow bytes a later child process expects to find on the descriptor.
    public function read_line(alloc: ref HeapAllocator) Option<String> {
      var line: String = String(alloc, "");
      var byte: ContiguousBuffer<u8> = ContiguousBuffer<u8>(alloc, 1);
      var got_any: bool = false;

      var n: i64 = unsafe { c_read(STDIN_FD, byte.raw_data(), 1); };
      while (n > 0) {
        got_any = true;
        var ch: u8 = byte.get_unchecked(0);
        if (ch == 10) {
          return Option.Some(line);
        }
        line.append_char(ch);
        n = unsafe { c_read(STDIN_FD, byte.raw_data(), 1); };
      }

      if (not got_any) {
        return Option.None;
      }
      return Option.Some(line);
    }

    // -------------------------------------------------------------------
    // Polling
    // -------------------------------------------------------------------

    // Waits for readiness on a set of descriptors. The descriptors keep their
    // positions, so revents(i) answers for the fd added i-th.
    public class Poller {
      var fds: Vec<PollFd>;

      // Build an empty poller. Add descriptors before waiting.
      init(alloc: ref HeapAllocator) {
        this.fds = Vec<PollFd>(alloc, 4);
      }

      // Watch for an arbitrary combination of the POLL* bits.
      public method add(fd: i32, events: i16) void {
        this.fds.push(PollFd(fd, events));
      }

      // Watch for readable data (or the peer hanging up).
      public method add_read(fd: i32) void {
        this.fds.push(PollFd(fd, POLLIN));
      }

      // Watch for room to write.
      public method add_write(fd: i32) void {
        this.fds.push(PollFd(fd, POLLOUT));
      }

      // Watch a descriptor for both readable data and room to write.
      public method add_read_write(fd: i32) void {
        this.fds.push(PollFd(fd, POLLIN | POLLOUT));
      }

      // Forget every descriptor. Positions restart from zero after this.
      public method clear() void {
        this.fds.clear();
      }

      // How many descriptors are being watched.
      public method count() i64 {
        return this.fds.size();
      }

      // Blocks until something is ready, the timeout expires, or a signal
      // arrives. -1 waits forever. Returns how many descriptors are ready.
      public method wait(timeout_ms: i32) i32 throws IError {
        if (this.fds.size() == 0) {
          return 0;
        }
        var ready: i32 = unsafe {
          c_poll(
            this.fds.raw_data(),
            this.fds.size(),
            timeout_ms
          );
        };
        if (ready < 0) {
          throw Error(errno(), "poll failed");
        }
        return ready;
      }

      // The descriptor added i-th.
      public method fd_at(i: i64) i32 {
        return this.fds.get_unchecked(i).fd;
      }

      // The raw POLL* bits the system reported for the descriptor added i-th.
      public method revents(i: i64) i16 {
        return this.fds.get_unchecked(i).revents;
      }

      // Report whether the descriptor added i-th has data to read.
      public method is_readable(i: i64) bool {
        return (this.revents(i) & POLLIN) != 0;
      }

      // Report whether the descriptor added i-th has room to write.
      public method is_writable(i: i64) bool {
        return (this.revents(i) & POLLOUT) != 0;
      }

      // The peer closed its end. Any buffered bytes are still readable.
      public method is_hup(i: i64) bool {
        return (this.revents(i) & POLLHUP) != 0;
      }

      // Report whether the system flagged an error on the descriptor added i-th.
      public method is_error(i: i64) bool {
        return (this.revents(i) & POLLERR) != 0;
      }
    }
  }  // module std.io
}
