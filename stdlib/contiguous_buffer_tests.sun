// stdlib/contiguous_buffer_tests.sun - Tests for contiguous_buffer.sun.
// Replaces the C++ suite(s) Stdlib_Collections_ContiguousBuffer.

using std;

/** Provides the standard-library declarations implemented in this source file. */
public module std {
  /** Groups tests for the contiguous buffer library behavior. */
  module contiguous_buffer_tests {
    /** Checks basic allocation and size. */
    test_function basic_allocation_and_size() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 10);
      std.test.assert_eq(buf.size(), 10);
    }

    /** Checks empty buffer. */
    test_function empty_buffer() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 0);
      std.test.assert(buf.is_empty());
    }

    /** Checks non empty buffer. */
    test_function non_empty_buffer() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 5);
      std.test.assert(buf.is_empty() == false);
    }

    /** Checks get set valid index. */
    test_function get_set_valid_index() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 5);
      buf.set(0, 42);
      buf.set(2, 100);
      buf.set(4, 77);
      std.test.assert_eq(buf.get(0) + buf.get(2) + buf.get(4), 219);
    }

    /** Checks get out of bounds throws. */
    test_function get_out_of_bounds_throws() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 5);
      try {
        var x: i32 = buf.get(10);
        std.test.fail("expected error");
      } catch (e: ref IError) {}
    }

    /** Checks get negative index throws. */
    test_function get_negative_index_throws() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 5);
      try {
        var x: i32 = buf.get(-1);
        std.test.fail("expected error");
      } catch (e: ref IError) {}
    }

    /** Checks set out of bounds throws. */
    test_function set_out_of_bounds_throws() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 5);
      try {
        buf.set(10, 42);
        std.test.fail("expected error");
      } catch (e: ref IError) {}
    }

    /** Checks get set unchecked. */
    test_function get_set_unchecked() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 3);
      unsafe { buf.set_unchecked(0, 10); };
      unsafe { buf.set_unchecked(1, 20); };
      unsafe { buf.set_unchecked(2, 30); };
      std.test.assert_eq(
        unsafe { buf.get_unchecked(0); } + unsafe { buf.get_unchecked(1); } + unsafe { buf.get_unchecked(2); },
        60
      );
    }

    /** Checks fill buffer. */
    test_function fill_buffer() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 5);
      buf.fill(7);
      var sum: i32 = 0;
      for (var i: i64 = 0; i < buf.size(); i = i + 1) {
        sum = sum + unsafe { buf.get_unchecked(i); };
      }
      std.test.assert_eq(sum, 35);
    }

    /** Checks copy from valid. */
    test_function copy_from_valid() {
      var alloc = make_heap_allocator();
      var src = ContiguousBuffer<i32>(alloc, 5);
      var dst = ContiguousBuffer<i32>(alloc, 5);
      unsafe { src.set_unchecked(0, 10); };
      unsafe { src.set_unchecked(1, 20); };
      unsafe { src.set_unchecked(2, 30); };
      unsafe { src.set_unchecked(3, 40); };
      unsafe { src.set_unchecked(4, 50); };
      dst.fill(0);
      // Copy the middle three elements of src into the front of dst.
      dst.write_from(src, 1, 0, 3);
      // dst is now: 20, 30, 40, 0, 0
      std.test.assert_eq(
        unsafe { dst.get_unchecked(0); } + unsafe { dst.get_unchecked(1); } + unsafe { dst.get_unchecked(2); },
        90
      );
    }

    /** Checks copy from out of bounds src. */
    test_function copy_from_out_of_bounds_src() {
      var alloc = make_heap_allocator();
      var src = ContiguousBuffer<i32>(alloc, 3);
      var dst = ContiguousBuffer<i32>(alloc, 5);
      src.fill(1);
      dst.fill(0);
      try {
        // Reads past the end of the 3-element source.
        dst.write_from(src, 1, 0, 3);
        std.test.fail("expected error");
      } catch (e: ref IError) {}
    }

    /** Checks copy from out of bounds dst. */
    test_function copy_from_out_of_bounds_dst() {
      var alloc = make_heap_allocator();
      var src = ContiguousBuffer<i32>(alloc, 5);
      var dst = ContiguousBuffer<i32>(alloc, 3);
      src.fill(7);
      dst.fill(0);
      try {
        // Writes past the end of the 3-element destination.
        dst.write_from(src, 0, 1, 3);
        std.test.fail("expected error");
      } catch (e: ref IError) {}
    }

    /** Checks first and lsyntax tree. */
    test_function first_and_last() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 4);
      unsafe { buf.set_unchecked(0, 10); };
      unsafe { buf.set_unchecked(1, 20); };
      unsafe { buf.set_unchecked(2, 30); };
      unsafe { buf.set_unchecked(3, 40); };
      var f: i32 = buf.first();
      var l: i32 = buf.last();
      std.test.assert_eq(f + l, 50);
    }

    /** Checks first on empty throws. */
    test_function first_on_empty_throws() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 0);
      try {
        var x: i32 = buf.first();
        std.test.fail("expected error");
      } catch (e: ref IError) {}
    }

    /** Checks lsyntax tree on empty throws. */
    test_function last_on_empty_throws() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 0);
      try {
        var x: i32 = buf.last();
        std.test.fail("expected error");
      } catch (e: ref IError) {}
    }

    /** Checks index operator. */
    test_function index_operator() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 3);
      buf[0] = 100;
      buf[1] = 200;
      buf[2] = 300;
      std.test.assert_eq(buf[0] + buf[1] + buf[2], 600);
    }

    /** Checks iterator sum. */
    test_function iterator_sum() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 4);
      buf[0] = 1;
      buf[1] = 2;
      buf[2] = 3;
      buf[3] = 4;
      var sum: i32 = 0;
      for (var x: i32 in buf) {
        sum = sum + x;
      }
      std.test.assert_eq(sum, 10);
    }

    /** Checks f64 buffer. */
    test_function f64_buffer() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<f64>(alloc, 3);
      buf[0] = 1.5;
      buf[1] = 2.5;
      buf[2] = 3.0;
      std.test.assert_eq(buf[0] + buf[1] + buf[2], 7.0);
    }

    /** Checks i64 buffer. */
    test_function i64_buffer() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i64>(alloc, 3);
      buf.set(0, 1000000000);
      buf.set(1, 2000000000);
      buf.set(2, 3000000000);
      std.test.assert_eq(buf.get(0) + buf.get(1) + buf.get(2), 6000000000);
    }

    /** Checks resize preserves elements. */
    test_function resize_preserves_elements() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i64>(alloc, 3);
      buf.set(0, 1000000000);
      buf.set(1, 2000000000);
      buf.set(2, 3000000000);
      buf.resize_to(5);
      std.test.assert_eq(buf.size(), 5);
      std.test.assert_eq(buf.get(0) + buf.get(1) + buf.get(2), 6000000000);
      buf.set(3, 4000000000);
      buf.set(4, 5000000000);
      buf.resize_to(2);
      std.test.assert_eq(buf.size(), 2);
      std.test.assert_eq(buf.get(0) + buf.get(1), 3000000000);
      buf.resize_to(2);
      std.test.assert_eq(buf.get(1), 2000000000);
      buf.resize_to(0);
      std.test.assert(buf.is_empty());
      buf.resize_to(1);
      buf.set(0, 42);
      std.test.assert_eq(buf.get(0), 42);
    }

    /** Checks raw data not null. */
    test_function raw_data_not_null() {
      var alloc = make_heap_allocator();
      var buf = ContiguousBuffer<i32>(alloc, 5);
      std.test.assert(buf.raw_data() != null, "raw data pointer is null");
    }
  }  // module contiguous_buffer_tests
}  // module std
