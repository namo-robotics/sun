                "OPENSSL_LIBS_LINUX": "third_party/openssl/aarch64-linux-musl"
            },
            "entrypoints": [
                {
                    "path": "stdlib/stdlib.sun",
                    "type": "library",
                    "output_name": "build/aarch64-linux-gnu/stdlib",
                    "test_binary_name": "build/aarch64-linux-gnu/stdlib_tests_test"
                },
                {
                    "path": "tls/tls.sun",
                    "type": "library",
                    "output_name": "build/aarch64-linux-gnu/tls",
                    "test_binary_name": "build/aarch64-linux-gnu/tls_tests_test"
                }
            ]
        },
        "aarch64-linux-musl": {
            "sun_path": ["build/aarch64-linux-musl"],
            "path_variables": {
                "OPENSSL_LIBS_LINUX": "third_party/openssl/aarch64-linux-musl"
            },
            "entrypoints": [
                {
                    "path": "stdlib/stdlib.sun",
                    "type": "library",
                    "output_name": "build/aarch64-linux-musl/stdlib",
                    "test_binary_name": "build/aarch64-linux-musl/stdlib_tests_test"
                },
                {
                    "path": "tls/tls.sun",
                    "type": "library",
                    "output_name": "build/aarch64-linux-musl/tls",
                    "test_binary_name": "build/aarch64-linux-musl/tls_tests_test"
