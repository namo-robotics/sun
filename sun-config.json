                {
                    "path": "stdlib/stdlib.sun",
                    "type": "library",
                    "output_name": "build/stdlib",
                    "test_binary_name": "build/stdlib_tests_test"
                },
                {
                    "path": "tls/tls.sun",
                    "type": "library",
                    "output_name": "build/tls",
                    "test_binary_name": "build/tls_tests_test"
                }
            ]
        },
        "aarch64-linux-gnu": {
            "sun_path": ["build/aarch64-linux-gnu"],
