#!/usr/bin/make -f

# See debhelper(7) for more information
export DH_VERBOSE = 1

# Hardening flags
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Disable the separate -dbgsym package (avoids permission issues with parent
# dir). dh_strip still strips the shipped binaries, keeping the .deb small.
# Append to the inherited value: dpkg-buildpackage passes parallel=N here,
# and overwriting it would force a single-threaded build.
export DEB_BUILD_OPTIONS := $(DEB_BUILD_OPTIONS) noddebs

# Use ccache when available (set up by CI)
ifneq (,$(shell command -v ccache 2>/dev/null))
CCACHE_ARGS = -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache
endif

%:
	dh $@

# debhelper passes -DFETCHCONTENT_FULLY_DISCONNECTED=ON (Debian archive
# builds may not touch the network), which would skip downloading the bundled
# protobuf and break configure. This package builds in CI with network
# access, so turn it back off; flags here come after debhelper's defaults
# and win.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
		$(CCACHE_ARGS)

override_dh_auto_install:
	dh_auto_install
	# Install the sun binary to /usr/bin
	install -D -m 755 obj-*/sun debian/sun/usr/bin/sun
	# Install the sun language server binary to /usr/bin
	install -D -m 755 obj-*/sun-lsp debian/sun/usr/bin/sun-lsp
	# Install the precompiled stdlib
	install -D -m 644 obj-*/stdlib.moon debian/sun/usr/lib/sun/stdlib.moon
	# Install the TLS bundle (carries its own static OpenSSL)
	install -D -m 644 obj-*/tls.moon debian/sun/usr/lib/sun/tls.moon
	# Install stdlib source files (for reference/debugging)
	install -d debian/sun/usr/share/sun/stdlib
	install -m 644 stdlib/*.sun debian/sun/usr/share/sun/stdlib/
	# Install tls source files (for reference/debugging)
	install -d debian/sun/usr/share/sun/tls
	install -m 644 tls/*.sun debian/sun/usr/share/sun/tls/

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info
