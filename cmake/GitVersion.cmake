# Writes SUN_GIT_HASH / SUN_VERSION_NAME into OUTPUT_FILE. Runs at every build so
# the hash tracks HEAD; the file is only rewritten when the content changes so
# the files that include it are not needlessly recompiled.
#
# Inputs: SOURCE_DIR, OUTPUT_FILE, and optionally SUN_VERSION_NAME (defaults to a clean release tag,
# then "dev").

include("${CMAKE_CURRENT_LIST_DIR}/abi/ReleaseIdentity.cmake")

set(GIT_HASH "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} rev-parse --short=12 HEAD
        OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE rc ERROR_QUIET)
    if(rc EQUAL 0 AND NOT hash STREQUAL "")
        set(GIT_HASH "${hash}")
        # debian/changelog is rewritten by scripts/build-deb.sh, so it must
        # not count as a local modification.
        execute_process(
            COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} status --porcelain
                    --untracked-files=no -- . ":!debian/changelog"
            OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE rc ERROR_QUIET)
        if(rc EQUAL 0 AND NOT dirty STREQUAL "")
            set(GIT_HASH "${GIT_HASH}-dirty")
        endif()
    endif()
endif()

# An explicit empty override suppresses the display name.
if(NOT DEFINED SUN_VERSION_NAME)
    set(SUN_VERSION_NAME "dev")
    if(GIT_FOUND AND GIT_HASH AND NOT GIT_HASH STREQUAL "unknown"
            AND rc EQUAL 0 AND dirty STREQUAL "")
        execute_process(
            COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} tag --points-at HEAD
            OUTPUT_VARIABLE tags OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE tag_rc ERROR_QUIET)
        if(tag_rc EQUAL 0)
            string(REPLACE "\n" ";" tags "${tags}")
            list(FILTER tags INCLUDE REGEX "^v?[0-9]")
            list(SORT tags)
            list(LENGTH tags tag_count)
            if(tag_count GREATER 0)
                list(GET tags 0 SUN_VERSION_NAME)
            endif()
        endif()
    endif()
endif()
# Escape opaque names before embedding them in C++ source.
string(REPLACE "\\" "\\\\" SUN_VERSION_NAME "${SUN_VERSION_NAME}")
string(REPLACE "\"" "\\\"" SUN_VERSION_NAME "${SUN_VERSION_NAME}")
string(REPLACE "\n" "\\n" SUN_VERSION_NAME "${SUN_VERSION_NAME}")
string(REPLACE "\r" "\\r" SUN_VERSION_NAME "${SUN_VERSION_NAME}")

set(content "// Generated by cmake/GitVersion.cmake - do not edit
#pragma once
#define SUN_VERSION_NAME \"${SUN_VERSION_NAME}\"
#define SUN_GIT_HASH \"${GIT_HASH}\"
#define SUN_RELEASE_ORDER ${SUN_RELEASE_ORDER}ULL
#define SUN_RELEASE_SERIES \"${SUN_RELEASE_SERIES}\"
")

set(old "")
if(EXISTS ${OUTPUT_FILE})
    file(READ ${OUTPUT_FILE} old)
endif()
if(NOT old STREQUAL content)
    file(WRITE ${OUTPUT_FILE} "${content}")
endif()
