{
    // === CMake + Build ===
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": true,
    // === IntelliSense (clangd) ===
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.default.configurationProvider": "",
    "clangd.arguments": [
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}/build",
        "--header-insertion=iwyu",
        "--all-scopes-completion",
        "--completion-style=detailed"
    ],
    // === Formatting ===
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_fallbackStyle": "Google",
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false
    },
    "[plaintext]": {
        "editor.formatOnSave": false
    },
    "[makefile]": {
        "editor.formatOnSave": false
    },
    // === Editor UI ===
    "editor.rulers": [
        80,
        120
    ],
    "testMate.cpp.test.stderrDecorator": true,
    "testMate.cpp.log.logpanel": true,
    "testMate.cpp.test.workingDirectory": "${workspaceFolder}",
    "testMate.cpp.test.parallelExecutionLimit": 8,
    // All tests live in one binary (sun_tests); parallelizationLimit lets
    // TestMate split its tests across up to 8 concurrent processes
    "testMate.cpp.test.advancedExecutables": [
        {
            "pattern": "build/tests/sun_tests",
            "cwd": "${workspaceFolder}",
            "parallelizationLimit": 8,
            // Suite names mirror tests/ on disk (tests/functions/generic/
            // test_constraints.cpp defines Functions_Generic_Constraints), so
            // splitting a test id into its segments reproduces the directory
            // tree in the Test Explorer:
            // Functions > Generic > Constraints > numeric_accepts_integer.
            //
            // The leading backtick makes splitBy a regex. It splits on '.'
            // (suite/test boundary) and on '_' before a capital - the shape
            // of a suite segment - but the lookbehind stops it once a '.'
            // has been seen, so snake_case test names stay whole. Without
            // that guard, names like cannot_redefine_IError_as_class and
            // DISABLED_ThroughputMBps would be torn apart.
            "testGrouping": {
                "groupBySplittedTestName": {
                    "splitBy": "`(?<!\\.[^.]*)_(?=[A-Z])|\\."
                }
            }
        }
    ],
    // Hide ctest's generated test-discovery files (rewritten on every ctest
    // run by gtest_discover_tests PRE_TEST mode) from the explorer/watcher
    "files.exclude": {
        "build/tests/*.cmake": true
    },
    "files.watcherExclude": {
        "build/tests/*.cmake": true
    },
    "files.associations": {
        "debian/rules": "makefile",
        "debian/control": "plaintext",
        "debian/copyright": "plaintext",
        "debian/changelog": "plaintext",
        "debian/source/format": "plaintext",
        "debian/install": "plaintext",
        "*.proto": "proto"
    },
    // === Project-Specific ===
    "sun.sun_path": [
        "build",
        "/workspaces/sun"
    ],
    "sun.lsp_path": "build/sun-lsp",
    "sun.sun_configs": [
        "sun-config.json"
    ],
    // === LLDB (for debugging) ===
    // Wrapper unsets DEBUGINFOD_URLS, which otherwise hangs lldb in the
    // container (unreachable symbol server, no timeout). Absolute path: the
    // lldb-dap extension does not substitute ${workspaceFolder} here.
    "lldb-dap.executable-path": "/workspaces/sun/.vscode/lldb-dap-wrapper.sh",
    // Allow gutter breakpoints in .sun files (cppdbg only whitelists
    // C-family languages by default)
    "debug.allowBreakpointsEverywhere": true,
}