using std.net;
using std.io;

// Talker: connects and sends a message
using std;

/** Performs the operation and propagates returned failures. */
function run() Result<void> {
  var stream = TcpStream();
  try stream.connect_local(8080);
  println("Connected to 127.0.0.1:8080");

  try stream.send_str("Hello from talker!");
  println("Message sent");

  stream.close();

  return Result.Ok;
}

/** Reports errors and sets the process exit code. */
function main() i32 {
  return match run() {
    (e: const ref IError) => {
      match e.message() {
        AllocationResult.Ok(message) => println(message),
        _ => println("unable to allocate error message")
      };
      1;
    },
    _ => 0
  };
}

manifest {
  libraries: [
    "stdlib.moon"
  ]
}
