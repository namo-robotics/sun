using std.net;
using std.io;

// Talker: connects and sends a message
using std;

/** Performs the operation and propagates exceptions. */
function run() void throws {
  var stream = TcpStream();
  stream.connect_local(8080);
  println("Connected to 127.0.0.1:8080");

  stream.send_str("Hello from talker!");
  println("Message sent");

  stream.close();

  return;
}

/** Runs the example; an uncaught exception produces a failing exit code. */
function main() i32 throws {
  run();
  return 0;
}

manifest {
  libraries: [
    "stdlib.moon"
  ]
}
