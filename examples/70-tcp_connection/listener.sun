using std.net;
using std.io;

// Listener: accepts one connection and prints received message
using std;

/** Performs the operation and propagates exceptions. */
function run() void throws {
  var buf = ContiguousBuffer<u8>(global_allocator, 256);

  var listener = TcpListener();
  listener.bind_loopback(8080);
  listener.listen(1);
  println("Listening on 127.0.0.1:8080...");

  var client = listener.accept();
  println("Client connected");

  while (true) {
    var n = client.recv(buf);
    if (n <= 0) {
      println("Connection closed");
      break;
    }
    var str = String(global_allocator, buf, n);
    println(str);
  }

  client.close();
  listener.close();

  return;
}

/** Runs the example; an uncaught exception produces a failing exit code. */
function main() i32 throws {
  run();
  return 0;
}

manifest {
  libraries: [
    "stdlib.moon"
  ]
}
