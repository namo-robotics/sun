using std.io;

// An HTTPS GET with the tls bundle's HttpsClient.
//
// The certificate is verified against the system CA store and checked
// against the hostname; a bad certificate throws an exception.

using std;
using tls;

/** Performs the operation and propagates exceptions. */
function run() void throws {
  var client = HttpsClient(global_allocator);
  var host = String(global_allocator, "example.com");

  var response = client.get(host, "/");

  print("status: ");
  println(response.status);
  print("body bytes: ");
  println(response.body.length());

  // Print the first line of the body
  var end: i64 = 0;
  while (end < response.body.length() and (response.body.at(end)) != b'\n') {
    end = end + 1;
  }
  var first_line = response.body.substr(global_allocator, 0, end);
  println(first_line);

  return;
}

/** Runs the example; an uncaught exception produces a failing exit code. */
function main() i32 throws {
  run();
  return 0;
}

manifest {
  libraries: [
    "stdlib.moon",
    "tls.moon"
  ]
}
