using std.http;
using std.io;

// HTTP server: serves a small webpage on http://127.0.0.1:8080
using std;

/** Runs the example that serves HTTP requests. */
function main() i32 {
  var server = HttpServer(global_allocator);
  match server.bind_loopback(8080) {
    SystemResult.Ok => {},
    SystemResult.Error(e) => {
      match e.message() {
        AllocationResult.Ok(message) => println(message),
        _ => println("unable to allocate error message")
      };
      return 1;
    },
    SystemResult.Allocation(e) => {
      match e.message() {
        AllocationResult.Ok(message) => println(message),
        _ => println("unable to allocate error message")
      };
      return 1;
    },
    SystemResult.InvalidArgument(e) => {
      match e.message() {
        AllocationResult.Ok(message) => println(message),
        _ => println("unable to allocate error message")
      };
      return 1;
    },
    SystemResult.Overflow(e) => {
      match e.message() {
        AllocationResult.Ok(message) => println(message),
        _ => println("unable to allocate error message")
      };
      return 1;
    }
  };
  println("Serving on http://127.0.0.1:8080");

  match server.serve(
    (req: ref HttpRequest, resp: ref HttpResponse) => Result<void> {
      if (req.path.equals_literal("/")) {
        try resp.set_body("<html><body><h1>Hello from Sun!</h1></body></html>");
      } else {
        resp.set_status(404);
        try resp.set_body("<html><body><h1>404 Not Found</h1></body></html>");
      }
      return Result.Ok;
    }
  ) {
    Result.Ok => {},
    (error: const ref IError) => {
      match error.message() {
        AllocationResult.Ok(message) => eprintln(message),
        _ => eprintln("unable to allocate error message")
      };
      return 1;
    }
  };
  return 0;
}

manifest {
  libraries: [
    "stdlib.moon"
  ]
}
