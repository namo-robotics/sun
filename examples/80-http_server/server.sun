using std.http;
using std.io;

// HTTP server: serves a small webpage on http://127.0.0.1:8080
using std;

/** Runs the example that serves HTTP requests. */
function main() i32 throws {
  var server = HttpServer(global_allocator);
  server.bind_loopback(8080);
  println("Serving on http://127.0.0.1:8080");

  server.serve(
    (req: ref HttpRequest, resp: ref HttpResponse) => void throws {
      if (req.path.equals_literal("/")) {
        resp.set_body("<html><body><h1>Hello from Sun!</h1></body></html>");
      } else {
        resp.set_status(404);
        resp.set_body("<html><body><h1>404 Not Found</h1></body></html>");
      }
      return;
    }
  );
  return 0;
}

manifest {
  libraries: [
    "stdlib.moon"
  ]
}
