using std.xml;
using std.io;

using std;

/** Produces a small SVG with namespace declarations and escaped text. */
function draw(alloc: const ref HeapAllocator, output: ref String) void throws {
  var writer = XmlWriter(alloc, output);
  writer.declaration();
  var svg = XmlName(
    String(alloc, "http://www.w3.org/2000/svg"),
    String(alloc, "svg"),
    String(alloc, "")
  );
  writer.start_element(svg);
  var view_box = XmlName(
    String(alloc, ""),
    String(alloc, "viewBox"),
    String(alloc, "")
  );
  var bounds = String(alloc, "0 0 300 60");
  writer.attribute(view_box, bounds);
  var text = XmlName(
    String(alloc, "http://www.w3.org/2000/svg"),
    String(alloc, "text"),
    String(alloc, "")
  );
  writer.start_element(text);
  var y = XmlName(String(alloc, ""), String(alloc, "y"), String(alloc, ""));
  var baseline = String(alloc, "30");
  writer.attribute(y, baseline);
  var label = String(alloc, "Sun <XML> & SVG");
  writer.text(label);
  writer.end_element();
  writer.end_element();
  writer.finish();
  return;
}

/** Prints a complete SVG document that can be redirected to a file. */
function run_main() i32 throws {
  var output = String(global_allocator, "");
  draw(global_allocator, output);
  println(output);
  return 0;
}

/** Uses only the standard library. */
manifest {
  libraries: [
    "stdlib.moon"
  ]
}

/** Runs the example; an uncaught exception produces a failing exit code. */
function main() i32 throws {
  return run_main();
}
