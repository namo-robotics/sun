using std.linalg;
using std.io;

/** Multiplies two matrices on the GPU and prints the result. */
manifest {
  libraries: [
    "stdlib.moon",
    "cuda.moon"
  ]
}
using std;
using cuda;

/** Uploads a matrix twice, multiplies on the GPU, and downloads the product. */
function run() void throws {
  var gpu = open_device(0);
  var a_cpu = Matrix<f32>([[1.0f32, 2.0f32], [3.0f32, 4.0f32]], global_allocator);
  var b_cpu = Matrix<f32>([[1.0f32, 2.0f32], [3.0f32, 4.0f32]], global_allocator);
  var a = gpu.upload(a_cpu);
  var b = gpu.upload(b_cpu);
  var c = (a * b);
  var c_cpu = Matrix<f32>(global_allocator, [2, 2]);
  c.copy_to_host(c_cpu);
  println(c_cpu[0, 0]);
  println(c_cpu[0, 1]);
  println(c_cpu[1, 0]);
  println(c_cpu[1, 1]);
  return;
}

/** Runs the example and reports uncaught exceptions with a failing exit code. */
function main() i32 throws {
  run();
  return 0;
}
