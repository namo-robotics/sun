using std.net;
using std.io;

// Sender: sends one datagram to the receiver
using std;

/** Performs the operation and propagates exceptions. */
function run() void throws {
  var socket = UdpSocket();
  socket.bind(ipv4_any(), 0);  // port 0: the OS picks a free port
  socket.send_str_to("Hello from sender!", ipv4_loopback(), 9090);
  println("Datagram sent");

  socket.close();

  return;
}

/** Runs the example; an uncaught exception produces a failing exit code. */
function main() i32 throws {
  run();
  return 0;
}

manifest {
  libraries: [
    "stdlib.moon"
  ]
}
