// Receiver: binds a UDP port and prints one datagram and its sender
using std;

/** Runs the example that exchanges datagrams over UDP. */
function main() i32 {
  var alloc = make_heap_allocator();
  var buf = ContiguousBuffer<u8>(alloc, 256);

  // Socket operations can fail, so they run inside a `try` block.
  try {
    var socket = UdpSocket();
    socket.bind(ipv4_loopback(), 9090);
    println("Waiting on 127.0.0.1:9090...");

    var datagram = socket.recv_from(buf);
    var text = String(alloc, buf, datagram.length());
    println(text);

    var from = datagram.addr();
    println("From address:");
    println(from.to_string(alloc));

    socket.close();
  } catch (e: IError) {
    println("Network error:");
    println(e.message());
    return 1;
  }
  return 0;
}

manifest {
    libraries: ["stdlib.moon"]
}
