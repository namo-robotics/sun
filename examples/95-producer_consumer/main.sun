using std;
using std.io;
using std.thread;
using std.time;

/** Owns pending work and records completion even when the producer fails. */
class WorkQueue {
  public var items: Queue<i64>;
  public var done: bool = false;

  /** Creates an empty queue; nodes are allocated when items are pushed. */
  init() {
    this.items = Queue<i64>(global_allocator);
  }
}

/** Distinguishes temporary emptiness from a producer that has finished. */
enum NextItem { Value(i64), Waiting, Done }

/** Reads an item and completion under the same lock. */
function take_one(queue: const ref Shared<WorkQueue>) NextItem {
  var guard = queue.lock();
  return match guard.get().items.pop() {
    Option.Some(value) => NextItem.Value(value),
    Option.None => guard.get().done ? NextItem.Done : NextItem.Waiting
  };
}

/** Enqueues squares, releasing the lock on both success and allocation failure. */
function produce_items(queue: const ref Shared<WorkQueue>) AllocationResult<void> {
  for (var i: i64 = 1; i <= 10; i += 1) {
    var guard = queue.lock();
    try guard.get().items.push(i * i);
  }
  return AllocationResult.Ok;
}

/** Marks completion after production succeeds or fails, so the consumer can finish. */
var produce = (queue: Shared<WorkQueue>) => AllocationResult<void> {
  var result = produce_items(queue);
  if (true) {
    var guard = queue.lock();
    guard.get().done = true;
  }
  return result;
};

/** Consumes queued work until the producer has finished and the queue is empty. */
var consume = (queue: Shared<WorkQueue>) => i32 {
  var total: i64 = 0;
  while (true) {
    match take_one(queue) {
      NextItem.Value(value) => {
        total += value;
      },
      NextItem.Waiting => {
        sleep(create_duration_micros(100));
      },
      NextItem.Done => {
        return _convert<i32>(total);
      }
    };
  }
  return _convert<i32>(total);
};

/** Joins both threads and propagates allocation failures after they have finished. */
function run() AllocationResult<void> {
  var queue = try Shared<WorkQueue>(global_allocator, WorkQueue());
  var producer = try spawn(produce, queue.clone());
  var consumer = try spawn(consume, queue.clone());
  var result = producer.join();
  var total = consumer.join();
  try result;
  var guard = queue.lock();
  println(try `items left: ${guard.get().items.size()}`);
  println(try `total: ${total}`);
  return AllocationResult.Ok;
}

/** Reports failures even when allocating an error message fails. */
function main() i32 {
  return match run() {
    AllocationResult.Ok => 0,
    (error: const ref IError) => {
      match error.message() {
        AllocationResult.Ok(message) => eprintln(message),
        _ => eprintln("unable to allocate error message")
      };
      1;
    }
  };
}

manifest {
  libraries: [
    "stdlib.moon"
  ]
}
