/** Retains a generic body for compilation by its consumer. */
public module reader {

  /** Describes the operation required by the generic body. */
  public interface Value {
    /** Returns an integer result. */
    public method value() i32;
  }

  /** Requires the concrete type to supply a value method returning i32. */
  public function read<T: Value>(item: ref T) i32 {
    return item.value();
  }
}
