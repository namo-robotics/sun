using std.io;

manifest {
  libraries: [
    "stdlib.moon",
    "$SUN_SERVE/lib/sun_serve.moon"
  ]
}

using std;
using sun_serve;

/** Checks polling results and HTTP helpers from the imported library. */
function check_library() i32 throws {
  var layout = probe_epoll_layout(global_allocator);
  var poller = Epoll(global_allocator, layout, 1);
  if (poller.wait(0)) != 0 {
    return 3;
  }
  // An invalid descriptor must propagate an exception across the Moon boundary.
  var rejected = false;
  try {
    poller.add(-1, 0, 0);
  } catch {
    rejected = true;
  }
  if not rejected {
    return 4;
  }
  if status_has_no_body(200) {
    return 1;
  }
  if status_has_no_body(204) {
    println(version());
    println(reason_phrase(200));
    return 0;
  }
  return 2;
}

/** Reports unexpected library failures and returns the integration status. */
function main() i32 throws {
  return check_library();
}
