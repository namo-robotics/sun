using std.linalg;
using std.io;

/** Exercises public GPU arithmetic through both the JIT and native compilation. */
manifest {
  libraries: [
    "stdlib.moon",
    "cuda.moon"
  ]
}
using std;
using cuda;

/** Compares floating-point results without requiring identical reduction order. */
function near(actual: f64, expected: f64) void throws {
  std.test.assert(actual >= expected - 0.00001 and actual <= expected + 0.00001);
  return;
}

/** Checks each operation and allocation reuse for one supported precision. */
function check_precision<T: _Float>(device: const ref Device) void throws {
  var host_a = Matrix<T>(global_allocator, [2, 3]);
  var host_b = Matrix<T>(global_allocator, [3, 2]);
  for (var i: i64 = 0; i < 2; i = i + 1) {
    for (var j: i64 = 0; j < 3; j = j + 1) {
      host_a[i, j] = _convert<T>(i * 3 + j + 1);
      host_b[j, i] = _convert<T>(j * 2 + i + 1);
    }
  }
  var a = device.upload(host_a);
  var b = device.allocate<T>([3i64, 2i64]);
  a.copy_from_host(host_a);
  b.copy_from_host(host_b);
  var c = a.matmul(b);
  var operator_c = (a * b);
  var result = Matrix<T>(global_allocator, [2, 2]);
  c.copy_to_host(result);
  near(_convert<f64>(result[0, 0]), 22.0);
  near(_convert<f64>(result[0, 1]), 28.0);
  near(_convert<f64>(result[1, 0]), 49.0);
  near(_convert<f64>(result[1, 1]), 64.0);
  a.matmul_into(b, operator_c);
  var sum = (c + operator_c);
  sum.copy_to_host(result);
  near(_convert<f64>(result[1, 1]), 128.0);
  c.add_into(operator_c, sum);
  var scaled = (c * _convert<T>(2));
  c.scale_into(_convert<T>(3), scaled);
  scaled.scale_in_place(_convert<T>(2));
  scaled.copy_to_host(result);
  near(_convert<f64>(result[1, 1]), 384.0);
  c.copy_to_host(result);
  near(_convert<f64>(result[1, 1]), 64.0);
  var vector_host = Matrix<T>(global_allocator, [3]);
  vector_host[0] = _convert<T>(1);
  vector_host[1] = _convert<T>(2);
  vector_host[2] = _convert<T>(3);
  var vector = device.allocate<T>([3i64]);
  vector.copy_from_host(vector_host);
  near(_convert<f64>(vector.dot(vector)), 14.0);
  var product = a.matvec(vector);
  a.matvec_into(vector, product);
  var product_host = Matrix<T>(global_allocator, [2]);
  product.copy_to_host(product_host);
  near(_convert<f64>(product_host[0]), 14.0);
  near(_convert<f64>(product_host[1]), 32.0);
  var zero = device.allocate<T>([2i64]);
  zero.copy_to_host(product_host);
  near(_convert<f64>(product_host[0]), 0.0);
  near(_convert<f64>(product_host[1]), 0.0);
  var moved = zero;
  moved.copy_to_host(product_host);
  return;
}

/** Returns an allocation whose public device owner has already been dropped. */
function retained_matrix() DeviceMatrix<f32> throws {
  var device = open_device(0);
  return device.allocate<f32>([1i64]);
}

/** Checks rejected shapes, transfers, and independent device contexts. */
function check_errors(device: const ref Device) void throws {
  var caught_1 = false;
  try {
    device.allocate<f32>([0i64]);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -1);
    caught_1 = true;
  }
  std.test.assert(caught_1, "expected GPU validation failure");
  var caught_2 = false;
  try {
    device.allocate<f32>([2i64, 2i64, 2i64]);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -1);
    caught_2 = true;
  }
  std.test.assert(caught_2, "expected GPU validation failure");
  var caught_3 = false;
  try {
    device.allocate<f32>([2147483648i64]);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -2);
    caught_3 = true;
  }
  std.test.assert(caught_3, "expected GPU validation failure");
  var a = device.allocate<f32>([2i64, 3i64]);
  var b = device.allocate<f32>([2i64, 2i64]);
  var caught_4 = false;
  try {
    a.matmul(b);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -1);
    caught_4 = true;
  }
  std.test.assert(caught_4, "expected GPU validation failure");
  var caught_5 = false;
  try {
    a.add(b);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -1);
    caught_5 = true;
  }
  std.test.assert(caught_5, "expected GPU validation failure");
  var caught_6 = false;
  try {
    a.dot(b);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -1);
    caught_6 = true;
  }
  std.test.assert(caught_6, "expected GPU validation failure");
  var second = open_device(0);
  var other = second.allocate<f32>([2i64, 3i64]);
  var caught_7 = false;
  try {
    a.add(other);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -3);
    caught_7 = true;
  }
  std.test.assert(caught_7, "expected GPU validation failure");
  var wrong_shape = Matrix<f32>(global_allocator, [2, 2]);
  var caught_8 = false;
  try {
    a.copy_to_host(wrong_shape);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -1);
    caught_8 = true;
  }
  std.test.assert(caught_8, "expected GPU validation failure");
  var caught_9 = false;
  try {
    a.copy_from_host(wrong_shape);
  } catch (error: GpuError) {
    std.test.assert_eq(error.code(), -1);
    caught_9 = true;
  }
  std.test.assert(caught_9, "expected GPU validation failure");
  var scalar_host = Matrix<f32>(global_allocator, [1, 1]);
  scalar_host[0, 0] = 3.0f32;
  var scalar = device.upload(scalar_host);
  var squared = scalar.matmul(scalar);
  squared.copy_to_host(scalar_host);
  near(_convert<f64>(scalar_host[0, 0]), 9.0);
  return;
}

/** Uses an owning GPU matrix transferred to a worker thread. */
function scale_on_worker(matrix: DeviceMatrix<f32>) bool {
  try {
    matrix.scale_in_place(2.0f32);
    return true;
  } catch {
    return false;
  }
}

/** Runs both precisions and checks retained ownership. */
function run_checks(device: const ref Device) void throws {
  check_errors(device);
  check_precision<f32>(device);
  check_precision<f64>(device);
  var matrix = retained_matrix();
  matrix.scale_in_place(2.0f32);
  var worker = std.thread.spawn(scale_on_worker, matrix);
  std.test.assert(worker.join());
  return;
}

/** Reports failures after a device has been opened without treating them as a skip. */
function run_available(device: const ref Device) i32 {
  try {
    run_checks(device);
    return 0;
  } catch {
    println("GPU checks failed");
    return 1;
  }
}

/** Returns a distinct skip status only when no CUDA device can be opened. */
function main() i32 {
  try {
    var device = open_device(0);
    return run_available(device);
  } catch (error: GpuError) {
    println("No usable CUDA device");
    return 77;
  } catch {
    return 1;
  }
}
