// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "Sun Compiler",
	"build": {
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": "..",
		// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "../Dockerfile"
	},
	// perf_event_open() is blocked for unprivileged containers, so `perf stat`
	// and `perf record` fail with "No permission to enable task-clock event".
	// CAP_PERFMON is the minimal capability that enables them. valgrind
	// --tool=callgrind needs none of this and works either way.
	"runArgs": [
		"--cap-add=PERFMON"
	],
	"mounts": [
		"source=vscode-user-data,target=/home/ubuntu/.vscode-server/data/User,type=volume",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/ubuntu/.ssh,type=bind,readonly",
		"source=sun-ccache,target=/home/ubuntu/.cache/ccache,type=volume",
		// Claude Code state: session transcripts (projects/), plans/, memory,
		// settings and credentials. Bound from the host's ~/.claude so sessions
		// are shared with the host and survive container rebuilds. Requires
		// ~/.claude to exist on the host.
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/ubuntu/.claude,type=bind",
		// Codex sessions, settings and credentials bound from the host's
		// ~/.codex. Requires ~/.codex to exist on the host.
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex,target=/home/ubuntu/.codex,type=bind",
		// Host-created chats retain absolute history paths. Expose those paths
		// too so the container can read and fork their history (POSIX hosts).
		"source=${localEnv:HOME}/.codex,target=${localEnv:HOME}/.codex,type=bind",
		// GitHub CLI credentials (hosts.yml) bound from the host, so the
		// container shares the host's `gh auth login` instead of needing its
		// own. Requires ~/.config/gh to exist on the host.
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh,target=/home/ubuntu/.config/gh,type=bind"
	],
	"updateRemoteUserUID": true,
	"containerEnv": {
		"CCACHE_DIR": "/home/ubuntu/.cache/ccache",
		"CCACHE_MAXSIZE": "20G",
		"CCACHE_SLOPPINESS": "pch_defines,time_macros"
	},
	// Fix volume ownership and fetch TLS archives into the mounted workspace.
	"postCreateCommand": "bash .devcontainer/post-create.sh && if [ ! -f third_party/openssl/x86_64-linux-musl/libssl.a ] || [ ! -f third_party/openssl/x86_64-linux-musl/libcrypto.a ]; then ./scripts/fetch-openssl.sh; fi",
	"postAttachCommand": "bash",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"cmake.configureOnOpen": false,
				"[sun]": {
					"editor.defaultFormatter": "namo-robotics.sun-language",
					"editor.formatOnSave": true
				},
				"[cpp]": {
					"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
				}
			},
			"extensions": [
				"ms-vscode.cpptools-extension-pack",
				"vadimcn.vscode-lldb",
				"namo-robotics.sun-language",
				"llvm-vs-code-extensions.lldb-dap",
				"MermaidChart.vscode-mermaid-chart",
				"ms-vscode.cmake-tools",
				"llvm-vs-code-extensions.vscode-clangd",
				"Anthropic.claude-code",
				"openai.chatgpt",
				"namo-robotics.cpp-test-explorer"
			]
		}
	}
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Uncomment the next line to run commands after the container is created.
	// "postCreateCommand": "cat /etc/os-release",
	// Configure tool-specific properties.
	// "customizations": {},
}
